---
const { currentTool } = Astro.props;

const allTools = [
  { id: 'compress',           title: 'Compress to KB',      href: '/compress-image',       icon: '🎯', desc: 'Hit exact file size targets' },
  { id: 'passport-maker',     title: 'Passport Photo',       href: '/passport-size-photo',  icon: '📸', desc: 'Official 3.5×4.5cm photos' },
  { id: 'signature',          title: 'Signature Maker',      href: '/signature-maker',      icon: '✍️', desc: '60+ cursive fonts, PNG export' },
  { id: 'crop',               title: 'Crop Image',           href: '/crop-image',           icon: '✂️', desc: 'Any ratio: 1:1, 4:3, 16:9' },
  { id: 'resize',             title: 'Resize Image',         href: '/resize-image',         icon: '📏', desc: 'Custom pixel dimensions' },
  { id: 'convert',            title: 'Format Converter',     href: '/convert-image',        icon: '🔄', desc: 'JPG ↔ PNG ↔ WebP' },
  { id: 'merge-pdf',          title: 'Merge PDF',            href: '/merge-pdf',            icon: '🔗', desc: 'Combine PDFs offline' },
  { id: 'image-to-pdf',       title: 'Image to PDF',         href: '/image-to-pdf',         icon: '📄', desc: 'Multiple images → one PDF' },
  { id: 'pdf-to-image',       title: 'PDF to Image',         href: '/pdf-to-image',         icon: '🖼️', desc: 'Extract PDF pages as JPG' },
  { id: 'split-pdf',          title: 'Split PDF',            href: '/split-pdf',            icon: '✂️', desc: 'Extract specific pages' },
  { id: 'rotate-pdf',         title: 'Rotate PDF',           href: '/rotate-pdf',           icon: '🔄', desc: 'Fix upside-down pages' },
  { id: 'bg-remover',         title: 'Remove BG',            href: '/background-remover',   icon: '🪄', desc: 'AI background removal' },
  { id: 'black-and-white',    title: 'B&W Filter',           href: '/black-and-white',      icon: '🔲', desc: 'Elegant grayscale filter' },
  { id: 'photo-to-sketch',    title: 'Pencil Sketch',        href: '/photo-to-sketch',      icon: '✏️', desc: 'Turn photo into art' },
  { id: 'ocr',                title: 'Image to Text',      href: '/image-to-text',       icon: '🔍', desc: 'Extract text from docs' },
  { id: 'resume',             title: 'Resume Builder',     href: '/resume-builder',      icon: '👔', desc: '1-min professional CV' },
  { id: 'handwriting',        title: 'Assignment Maker',     href: '/text-to-handwriting',  icon: '✍️', desc: 'Text to realistic handwriting' },
  { id: 'blur',               title: 'Blur & Censor',        href: '/blur-image',           icon: '🌫️', desc: 'Redact sensitive info' },
  { id: 'watermark',          title: 'Add Watermark',        href: '/watermark-image',      icon: '🏷️', desc: 'Protect your photos' },
  { id: 'qr-code-generator',  title: 'QR Code Generator',   href: '/qr-code-generator',    icon: '📱', desc: 'Branded, permanent QR codes' },
  { id: 'password-generator', title: 'Password Generator',   href: '/password-generator',   icon: '🔐', desc: 'Military-grade passwords' },
  { id: 'circle-crop',        title: 'Circle Crop',          href: '/circle-crop',          icon: '⭕', desc: 'Perfect circular avatars' },
];

// Define logical groups for interlinking
const imageTools = ['compress', 'passport-maker', 'crop', 'resize', 'circle-crop', 'bg-remover', 'black-and-white', 'photo-to-sketch', 'blur', 'watermark', 'convert'];
const pdfTools = ['merge-pdf', 'image-to-pdf', 'pdf-to-image', 'split-pdf', 'rotate-pdf'];
const utilTools = ['qr-code-generator', 'password-generator', 'file-size-converter', 'percentage-calculator', 'age-calculator', 'ocr', 'resume', 'handwriting'];

let relatedTools = [];

if (imageTools.includes(currentTool)) {
    // If it's an image tool, recommend other image tools first
    relatedTools = allTools.filter(t => t.id !== currentTool && imageTools.includes(t.id)).slice(0, 5);
    // Add one PDF tool for variety
    relatedTools.push(allTools.find(t => t.id === 'merge-pdf'));
} else if (pdfTools.includes(currentTool)) {
    // If it's a PDF tool, recommend other PDF tools
    relatedTools = allTools.filter(t => t.id !== currentTool && pdfTools.includes(t.id));
    // Fill up to 6 with common image tools
    if (relatedTools.length < 6) {
        relatedTools.push(...allTools.filter(t => t.id === 'compress' || t.id === 'image-to-pdf').slice(0, 6 - relatedTools.length));
    }
} else {
    // Default to a mix of popular tools
    const popularIds = ['compress', 'merge-pdf', 'passport-maker', 'qr-code-generator', 'resume', 'bg-remover'];
    relatedTools = allTools.filter(t => t.id !== currentTool && popularIds.includes(t.id)).slice(0, 6);
}
---

<section class="related-section" aria-label="Related tools">
    <div class="related-header">
        <h3>Try Other Free Tools</h3>
        <a href="/tools" class="related-view-all">View All 30+ Tools →</a>
    </div>
    <div class="related-grid">
        {relatedTools.map(tool => (
            <a href={tool.href} class="related-card" title={tool.title}>
                <span class="r-icon" aria-hidden="true">{tool.icon}</span>
                <div class="r-content">
                    <span class="r-title">{tool.title}</span>
                    <span class="r-desc">{tool.desc}</span>
                </div>
                <span class="r-arrow" aria-hidden="true">→</span>
            </a>
        ))}
    </div>
</section>

<style>
    .related-section {
        margin-top: 32px;
        padding-top: 32px;
        border-top: 1px solid var(--border-subtle);
    }

    .related-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 24px;
        flex-wrap: wrap;
        gap: 12px;
    }
    .related-header h3 {
        font-size: 1.3rem;
        font-weight:600;
        color: var(--text-primary);
    }
    .related-view-all {
        font-size: 0.85rem;
        font-weight:600;
        color: var(--accent-primary);
        text-decoration: none;
    }
    .related-view-all:hover { opacity: 0.75; }

    .related-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: 16px;
    }

    .related-card {
        display: flex;
        align-items: center;
        gap: 16px;
        background: var(--surface-3);
        border: 1px solid var(--border-subtle);
        border-radius: var(--radius-md);
        padding: 16px;
        text-decoration: none;
        position: relative;
    }
    .related-card:hover {
        border-color: var(--accent-primary);
    }
    .related-card:hover .r-title { color: var(--accent-primary); }

    .r-icon {
        font-size: 1.6rem;
        width: 42px; height: 42px;
        background: var(--surface-2);
        border-radius: 12px;
        display: flex; align-items: center; justify-content: center;
        flex-shrink: 0;
    }
    .related-card:hover .r-icon {
        background: var(--accent-soft);
    }

    .r-content {
        display: flex;
        flex-direction: column;
        gap: 2px;
        flex: 1;
        min-width: 0;
    }
    .r-title {
        font-weight:600;
        color: var(--text-primary);
        font-size: 0.88rem;
        line-height: 1.3;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    .r-desc {
        font-size: 0.75rem;
        color: var(--text-muted);
        font-weight: 600;
        line-height: 1.3;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .r-arrow {
        font-size: 0.9rem;
        color: var(--text-muted);
        flex-shrink: 0;
        opacity: 0;
        font-weight:600;
        transition: opacity 0.2s;
    }
    .related-card:hover .r-arrow { opacity: 1; }

    @media (max-width: 768px) {
        .related-grid { grid-template-columns: 1fr 1fr; gap: 10px; }
        .r-desc { display: none; }
        .related-card { padding: 14px 16px; border-radius: 14px; }
    }
    @media (max-width: 480px) {
        .related-grid { grid-template-columns: 1fr; }
    }
</style>
