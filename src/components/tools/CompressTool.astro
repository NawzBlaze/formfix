---
import UploadBox from '../UploadBox.astro';
const { initialTarget = 'auto' } = Astro.props;
---

<div class="compress-workspace">
    <!-- 1. Selection Stage -->
    <div id="u-box-container" class="stage-entry">
        <UploadBox />
    </div>

    <!-- 2. Optimization controls -->
    <div id="controls" class="stage-panel hidden">
        <div class="settings-hub glass-card">
            <div class="config-header">
                <h3>Optimization Settings</h3>
                <p>Choose your target file size below.</p>
                <div id="orig-size-badge" class="orig-size-badge hidden">
                    <span class="size-label">Original Size</span>
                    <span id="orig-size-val" class="size-value">0 KB</span>
                </div>
            </div>
            
            <div class="section-group">
                <label class="group-label">Common Presets</label>
                <div class="preset-grid">
                    <button class={`preset-chip ${initialTarget == 20 ? 'active' : ''}`} data-kb="20">20 KB</button>
                    <button class={`preset-chip ${initialTarget == 50 ? 'active' : ''}`} data-kb="50">50 KB</button>
                    <button class={`preset-chip ${initialTarget == 100 ? 'active' : ''}`} data-kb="100">100 KB</button>
                    <button class={`preset-chip ${initialTarget == 200 ? 'active' : ''}`} data-kb="200">200 KB</button>
                </div>
            </div>

            <div class="section-group">
                <label class="group-label">Output Format</label>
                <div class="toggle-pill-group">
                    <button class="setting-pill active" data-format="jpeg">JPG</button>
                    <button class="setting-pill" data-format="png">PNG</button>
                    <button class="setting-pill" data-format="webp">WebP</button>
                </div>
            </div>

            <div class="section-group">
                <label class="group-label">Quality Override</label>
                <div class="quality-slider-wrap">
                    <input type="range" id="quality-slider" min="1" max="100" value="0" class="quality-slider" />
                    <div class="quality-label-row">
                        <span class="quality-val" id="quality-val">Auto</span>
                        <span class="quality-hint">Leave at 0 for auto-detection</span>
                    </div>
                </div>
            </div>

            <div class="section-group">
                <label class="group-label">Custom Target</label>
                <div class="custom-input-wrap">
                    <input type="number" id="custom-kb" placeholder="Custom size..." min="5" max="10000" value={initialTarget === 'auto' ? '' : initialTarget} class="premium-field" />
                    <span class="field-suffix">Kilobytes</span>
                </div>
            </div>

            <div class="action-footer">
                <button id="compress-btn" class="primary-btn btn-glow lg-btn">
                    <span id="btn-label">Optimize Image Now</span>
                    <div id="loader" class="fun-spinner-sm hidden"></div>
                </button>
                <div id="progress-bar-wrap" class="hidden" style="width:100%;margin-top:12px;">
                    <div style="display:flex;justify-content:space-between;margin-bottom:4px;">
                        <span id="progress-text" style="font-size:0.8rem;font-weight:600;color:var(--text-muted);">Analyzing...</span>
                        <span id="progress-pct" style="font-size:0.8rem;font-weight:600;color:var(--primary);">0%</span>
                    </div>
                    <div style="width:100%;height:6px;background:var(--surface-100);border-radius:100px;overflow:hidden;">
                        <div id="progress-fill" style="height:100%;width:0%;background:var(--primary);border-radius:100px;transition:width 0.3s;"></div>
                    </div>
                </div>
                <p class="privacy-tiny">🔒 Securely processed offline on your GPU</p>
            </div>
        </div>
    </div>

    <!-- 3. Result Stage -->
    <div id="advanced-result" class="stage-panel hidden">
        <div class="result-hub">
            <div class="success-indicator animate-in">
                <div class="icon-pulse">✓</div>
                <div class="text-content">
                    <h4>Compression Complete</h4>
                    <p>Successfully hit target with high fidelity.</p>
                </div>
            </div>

            <div class="stats-row mb-32">
                <div class="data-card">
                    <span class="d-label">Original</span>
                    <span id="orig-stat" class="d-value">0 KB</span>
                </div>
                <div class="data-card active">
                    <span class="d-label">Compressed</span>
                    <span id="final-stat" class="d-value">0 KB</span>
                </div>
                <div class="data-card">
                    <span class="d-label">Saved</span>
                    <span id="saved-stat" class="d-value">0%</span>
                </div>
            </div>

            <div class="comparison-visuals mb-40">
                <div class="compare-box">
                    <span class="badge">Original</span>
                    <div class="display-pane">
                        <img id="orig-preview" src="" alt="Before" loading="lazy" decoding="async" />
                    </div>
                </div>
                <div class="compare-box active">
                    <span class="badge accent">Result</span>
                    <div class="display-pane">
                        <img id="final-preview" src="" alt="After" loading="lazy" decoding="async" />
                    </div>
                </div>
            </div>

            <div class="final-actions">
                <a id="download-btn" href="#" class="primary-btn btn-glow flex-2" style="text-decoration:none;">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
                    Download Optimized Image
                </a>
                <button id="reset-tool" class="secondary-btn flex-1">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M23 4v6h-6"></path><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"></path></svg>
                    New Image
                </button>
            </div>

            <div class="viral-share-row mt-24">
                <p class="share-hint">Love FormFix? Spread the word!</p>
                <div class="share-flex">
                    <a id="share-x" href="#" target="_blank" class="mini-share-btn x-color">Share on X</a>
                    <a id="share-wa" href="#" target="_blank" class="mini-share-btn wa-color">WhatsApp</a>
                </div>
            </div>
        </div>
    </div>
</div>

<script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
        const fileIn = document.getElementById('file-input');
        const ctrl = document.getElementById('controls');
        const uBox = document.getElementById('u-box-container');
        const cBtn = document.getElementById('compress-btn');
        const btnTxt = document.getElementById('btn-label');
        const ldr = document.getElementById('loader');
        const presets = document.querySelectorAll('.preset-chip');
        const customIn = document.getElementById('custom-kb');
        const resBox = document.getElementById('advanced-result');

        let fileObj = null, targetKB = document.querySelector('.preset-chip.active')?.dataset.kb || 20;
        let outputFormat = 'jpeg';
        let manualQuality = 0;

        const formatPills = document.querySelectorAll('.setting-pill[data-format]');
        formatPills.forEach(btn => {
            btn.addEventListener('click', () => {
                formatPills.forEach(b => b.classList.remove('active'));
                btn.classList.add('active');
                outputFormat = btn.dataset.format;
            });
        });

        const qualitySlider = document.getElementById('quality-slider');
        const qualityVal = document.getElementById('quality-val');
        if (qualitySlider) {
            qualitySlider.addEventListener('input', () => {
                manualQuality = parseInt(qualitySlider.value);
                qualityVal.textContent = manualQuality === 0 ? 'Auto' : manualQuality + '%';
            });
        }

        if (fileIn) {
            fileIn.addEventListener('change', (e) => {
                const f = e.target.files[0]; if(!f) return;
                fileObj = f; 
                uBox?.classList.add('hidden'); 
                ctrl?.classList.remove('hidden');

                const origSizeBadge = document.getElementById('orig-size-badge');
                const origSizeVal = document.getElementById('orig-size-val');
                if (origSizeBadge && origSizeVal) {
                    origSizeBadge.classList.remove('hidden');
                    origSizeVal.textContent = f.size < 1024 ? f.size + ' B' : (f.size / 1024).toFixed(1) + ' KB';
                }
                
                const r = new FileReader(); 
                r.onload = (ev) => {
                    const img = document.getElementById('orig-preview');
                    if (img) img.src = ev.target.result;
                }; 
                r.readAsDataURL(f);
            });
        }

        presets.forEach(p => p.onclick = () => {
             presets.forEach(b => b.classList.remove('active')); p.classList.add('active');
             targetKB = p.dataset.kb; customIn.value = targetKB;
        });

        if (customIn) {
            customIn.oninput = () => {
                 if(customIn.value) {
                     presets.forEach(b => b.classList.remove('active')); targetKB = customIn.value;
                     const m = document.querySelector(`.preset-chip[data-kb="${customIn.value}"]`); if(m) m.classList.add('active');
                 }
            };
        }

        if (cBtn) {
            cBtn.onclick = async () => {
                if(!fileObj) return;
                btnTxt.textContent = 'Analyzing Layers...'; ldr?.classList.remove('hidden'); cBtn.disabled = true;
                const progWrap = document.getElementById('progress-bar-wrap');
                const progFill = document.getElementById('progress-fill');
                const progText = document.getElementById('progress-text');
                const progPct = document.getElementById('progress-pct');
                progWrap?.classList.remove('hidden');
                if(progFill) progFill.style.width = '0%';
                if(progPct) progPct.textContent = '0%';
                if(progText) progText.textContent = 'Initializing...';
                try {
                    const res = await runRBQS(fileObj, parseInt(targetKB), outputFormat, manualQuality, (pct, msg) => {
                        if(progFill) progFill.style.width = pct + '%';
                        if(progPct) progPct.textContent = pct + '%';
                        if (msg && progText) progText.textContent = msg;
                    });
                    if(res) {
                        const url = URL.createObjectURL(res.blob);
                        const fp = document.getElementById('final-preview'); if(fp) fp.src = url;
                        const fs = document.getElementById('final-stat'); if(fs) fs.textContent = (res.blob.size / 1024).toFixed(1) + ' KB';
                        const origKB = fileObj.size / 1024;
                        const compKB = res.blob.size / 1024;
                        const savedPct = origKB > 0 ? Math.max(0, ((1 - compKB / origKB) * 100)) : 0;
                        const origStat = document.getElementById('orig-stat'); if(origStat) origStat.textContent = origKB.toFixed(1) + ' KB';
                        const savedStat = document.getElementById('saved-stat'); if(savedStat) savedStat.textContent = savedPct.toFixed(0) + '%';
                        
                        const ext = outputFormat === 'jpeg' ? 'jpg' : outputFormat;
                        const dl = document.getElementById('download-btn'); if(dl) { dl.href = url; dl.download = FormFix.sanitizeFilename(fileObj.name.replace(/\.[^/.]+$/, '') + `-compressed.${ext}`); }
                        ctrl?.classList.add('hidden'); resBox?.classList.remove('hidden');
                        
                        const shareX = document.getElementById('share-x');
                        const shareWA = document.getElementById('share-wa');
                        const shareTxt = `I just compressed my photo to ${targetKB}KB exactly using FormFix! It's 100% private and runs in the browser. No uploads. Check it out: ` + window.__SITE_URL;
                        
                        if(shareX) shareX.href = `https://x.com/intent/tweet?text=${encodeURIComponent(shareTxt)}`;
                        if(shareWA) shareWA.href = `https://wa.me/?text=${encodeURIComponent(shareTxt)}`;

                        if (typeof window.triggerConfetti === 'function') window.triggerConfetti();
                    }
                } catch(e) {
                    ldr?.classList.add('hidden');
                    btnTxt.textContent = 'Compress';
                    cBtn.disabled = false;
                    progWrap?.classList.add('hidden');
                    if (window.ffNotice) window.ffNotice('Compression failed. Try a different image.', 'error');
                } finally {
                    btnTxt.textContent = 'Optimize Image Now'; ldr?.classList.add('hidden'); cBtn.disabled = false;
                    const pbw = document.getElementById('progress-bar-wrap'); if(pbw) pbw.classList.add('hidden');
                }
            };
        }

        async function runRBQS(file, target, format, manualQ, onProgress) {
            const mimeType = format === 'jpeg' ? 'image/jpeg' : format === 'png' ? 'image/png' : 'image/webp';
            const img = await createImageBitmap(file), targetBytes = target * 1024;
            let scale = target < 30 ? 0.6 : target < 80 ? 0.8 : 1.0;
            let w = Math.max(1, Math.floor(img.width * scale)), h = Math.max(1, Math.floor(img.height * scale));
            let best = null; const cvs = document.createElement('canvas'), ctx = cvs.getContext('2d', {alpha:false});
            const totalSteps = 3 * 7;
            let step = 0;
            if (onProgress) onProgress(5, 'Preparing image...');
            await new Promise(r => setTimeout(r, 50));

            if (manualQ > 0) {
                cvs.width = w; cvs.height = h; ctx.fillStyle="#fff"; ctx.fillRect(0,0,w,h); ctx.drawImage(img,0,0,w,h);
                if (onProgress) onProgress(50, 'Applying quality ' + manualQ + '%...');
                best = await new Promise(r => cvs.toBlob(bl => r(bl), mimeType, manualQ / 100));
            } else {
                for(let s=0; s<3; s++) {
                    cvs.width = w; cvs.height = h; ctx.fillStyle="#fff"; ctx.fillRect(0,0,w,h); ctx.drawImage(img,0,0,w,h);
                    if (onProgress) onProgress(Math.round(10 + (s / 3) * 20), 'Scale pass ' + (s+1) + '/3...');
                    let low=0.01, hi=0.98;
                    for(let i=0; i<7; i++) {
                        let q = (low+hi)/2; let b = await new Promise(r => cvs.toBlob(bl => r(bl), mimeType, q));
                        step++;
                        const pct = Math.round(10 + (step / totalSteps) * 80);
                        if (onProgress) onProgress(pct, 'Testing quality ' + Math.round(q * 100) + '%...');
                        if(b.size <= targetBytes) { best = b; low = q; if(targetBytes-b.size < 512) break; } else hi = q;
                    }
                    if(best) break; w = Math.floor(w*0.75); h = Math.floor(h*0.75);
                }
            }
            if(!best) best = await new Promise(r => cvs.toBlob(bl => r(bl), mimeType, 0.01));
            if (onProgress) onProgress(100, 'Compression complete!');
            return { blob: best };
        }

        const resetBtn = document.getElementById('reset-tool');
        if (resetBtn) {
            resetBtn.onclick = () => location.reload();
        }

        document.addEventListener('keydown', (e) => {
            if (e.ctrlKey && e.key === 'o') { e.preventDefault(); fileIn?.click(); }
            if (e.ctrlKey && e.key === 'Enter') { e.preventDefault(); cBtn?.click(); }
        });
    });
</script>

<style>
    .compress-workspace { width: 100%; max-width: 800px; margin: 0 auto; }
    
    .settings-hub { padding: 40px; background: var(--surface-3); }
    .config-header { margin-bottom: 32px; }
    .config-header h3 { font-size: 1.5rem; font-weight:600; margin-bottom: 4px; }
    .config-header p { color: var(--text-muted); font-size: 0.95rem; font-weight: 500; }
    .orig-size-badge { display: inline-flex; align-items: center; gap: 8px; background: var(--accent-soft); border: 1px solid var(--accent-primary); padding: 6px 14px; border-radius: 100px; margin-top: 12px; }
    .orig-size-badge .size-label { font-size: 0.7rem; font-weight: 600; color: var(--text-muted); text-transform: uppercase; }
    .orig-size-badge .size-value { font-size: 0.85rem; font-weight: 700; color: var(--accent-primary); }

    .section-group { margin-bottom: 32px; }
    .group-label { display: block; font-size: 0.75rem; font-weight:600; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 16px; }

    .preset-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; }
    .preset-chip { height: 52px; background: var(--surface-3); border: 1.5px solid var(--border-subtle); border-radius: 12px; font-weight:600; font-size: 0.9rem; cursor: pointer; transition: 0.2s; color: var(--text-primary); }
    .preset-chip:hover { border-color: var(--accent-primary); color: var(--accent-primary); }
    .preset-chip.active { background: var(--accent-primary); color: #fff; border-color: var(--accent-primary); box-shadow: var(--shadow-md); }

    .custom-input-wrap { position: relative; display: flex; align-items: center; }
    .premium-field { width: 100%; height: 56px; padding: 0 100px 0 20px; border-radius: 14px; border: 1.5px solid var(--border-subtle); background: var(--surface-3); font-weight:600; font-size: 1rem; outline: none; transition: 0.2s; }
    .premium-field:focus { border-color: var(--accent-primary); background: var(--surface-3); box-shadow: 0 0 0 4px var(--accent-soft); }
    .field-suffix { position: absolute; right: 20px; font-size: 0.75rem; font-weight:600; color: var(--text-muted); text-transform: uppercase; pointer-events: none; }

    .toggle-pill-group { display: flex; gap: 8px; }
    .setting-pill { flex: 1; height: 48px; background: var(--surface-3); border: 1.5px solid var(--border-subtle); border-radius: 12px; font-weight:600; font-size: 0.9rem; cursor: pointer; transition: 0.2s; color: var(--text-primary); }
    .setting-pill:hover { border-color: var(--accent-primary); color: var(--accent-primary); }
    .setting-pill.active { background: var(--accent-primary); color: #fff; border-color: var(--accent-primary); box-shadow: var(--shadow-md); }

    .quality-slider-wrap { display: flex; flex-direction: column; gap: 8px; }
    .quality-slider { width: 100%; height: 6px; -webkit-appearance: none; appearance: none; background: var(--surface-100); border-radius: 100px; outline: none; }
    .quality-slider::-webkit-slider-thumb { -webkit-appearance: none; appearance: none; width: 20px; height: 20px; background: var(--accent-primary); border-radius: 50%; cursor: pointer; box-shadow: 0 2px 6px rgba(0,0,0,0.2); }
    .quality-slider::-moz-range-thumb { width: 20px; height: 20px; background: var(--accent-primary); border: none; border-radius: 50%; cursor: pointer; box-shadow: 0 2px 6px rgba(0,0,0,0.2); }
    .quality-label-row { display: flex; justify-content: space-between; align-items: center; }
    .quality-val { font-size: 0.85rem; font-weight: 700; color: var(--accent-primary); }
    .quality-hint { font-size: 0.7rem; color: var(--text-muted); font-weight: 500; }

    .lg-btn { height: 64px; font-size: 1.1rem; border-radius: 18px; margin-top: 12px; }
    .fun-spinner-sm { width: 22px; height: 22px; border: 3px solid rgba(255,255,255,0.3); border-top-color: #fff; border-radius: 50%; animation: spin 0.8s linear infinite; margin-left: 12px; }
    @keyframes spin { to { transform: rotate(360deg); } }
    .privacy-tiny { font-size: 0.75rem; color: var(--text-muted); font-weight: 600; text-align: center; margin-top: 16px; font-style: italic; }

    /* Result UI */
    .result-hub { animation: fadeSlideUp 0.6s cubic-bezier(0.2, 0.8, 0.2, 1); }
    .success-indicator { display: flex; align-items: center; gap: 20px; background: var(--surface-3); border: 1.5px solid var(--border-subtle); padding: 24px; border-radius: 20px; margin-bottom: 32px; }
    .icon-pulse { width: 44px; height: 44px; background: var(--success); color: #fff; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 1.25rem; font-weight:600; }
    .text-content h4 { font-size: 1.15rem; font-weight:600; margin-bottom: 2px; color: var(--success, var(--success)); }
    .text-content p { color: var(--success, var(--success)); opacity: 0.8; font-size: 0.9rem; font-weight: 600; }

    .stats-row { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 16px; }
    .data-card { background: var(--surface-3); border: 1.5px solid var(--border-subtle); padding: 24px; border-radius: 20px; text-align: center; transition: 0.3s; }
    .data-card.active { border-color: var(--accent-primary); background: var(--accent-soft); transform: translateY(-2px); }
    .d-label { font-size: 0.7rem; font-weight:600; color: var(--text-muted); text-transform: uppercase; display: block; margin-bottom: 8px; }
    .d-value { font-size: 1.75rem; font-weight:600; color: var(--text-primary); }
    .data-card.active .d-value { color: var(--accent-primary); }

    .comparison-visuals { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
    .compare-box { display: flex; flex-direction: column; gap: 12px; position: relative; }
    .badge { position: absolute; top: 12px; left: 12px; background: rgba(0,0,0,0.75); padding: 6px 14px; border-radius: 100px; font-size: 0.7rem; font-weight:600; color: #fff; text-transform: uppercase; z-index: 10; backdrop-filter: blur(8px); }
    .badge.accent { background: var(--accent-primary); }
    .display-pane { background: var(--surface-3); border: 1px solid var(--border-subtle); border-radius: 20px; height: 320px; display: flex; align-items: center; justify-content: center; overflow: hidden; }
    .display-pane img { max-width: 100%; max-height: 100%; object-fit: contain; }
    .compare-box.active .display-pane { border: 2px solid var(--accent-primary); background: var(--surface-3); }

    .final-actions { display: flex; gap: 16px; }
    .flex-1 { flex: 1; height: 60px; font-weight:600; border-radius: 16px; }
    .flex-2 { flex: 2; height: 60px; font-weight:600; border-radius: 16px; display: flex; gap: 10px; align-items: center; justify-content: center; }

    .viral-share-row { text-align: center; border-top: 1.5px dashed var(--border-subtle); padding-top: 24px; }
    .share-hint { font-size: 0.85rem; font-weight:600; color: var(--text-muted); margin-bottom: 12px; text-transform: uppercase; letter-spacing: 0.1em; }
    .share-flex { display: flex; gap: 12px; justify-content: center; }
    .mini-share-btn { padding: 10px 20px; border-radius: 99px; font-size: 0.85rem; font-weight:600; text-decoration: none; color: #fff; transition: 0.2s; }
    .mini-share-btn:hover { transform: scale(1.05); filter: brightness(1.1); }
    .x-color { background: #000; }
    .wa-color { background: #25d366; }

    .mt-24 { margin-top: 24px; }
    .mb-32 { margin-bottom: 32px; }
    .mb-40 { margin-bottom: 40px; }
    .hidden { display: none !important; }

    @media (max-width: 600px) {
        .preset-grid { grid-template-columns: repeat(2, 1fr); gap: 10px; }
        .toggle-pill-group { flex-direction: column; }
        .stats-row, .comparison-visuals, .final-actions { grid-template-columns: 1fr; display: flex; flex-direction: column; gap: 16px; }
        .display-pane { height: 260px; }
        .settings-hub { padding: 24px 16px; }
        .success-indicator { padding: 16px; gap: 12px; }
        .d-value { font-size: 1.4rem; }
    }
</style>
