---
const { active = 'home' } = Astro.props;

const navItems = [
    { name: 'Compress', href: '/compress-image', id: 'compress' },
    { name: 'Passport Photo', href: '/passport-size-photo', id: 'passport-maker' },
    { name: 'Sign Maker', href: '/signature-maker', id: 'signature' },
    { name: 'PDF Tools', href: '/merge-pdf', id: 'pdf' },
    { name: 'All Tools', href: '/tools', id: 'tools' },
];
---

<header class="site-header" id="main-header" role="banner">
    <div class="container header-inner">
        <div class="header-left">
            <a href="/" class="logo" aria-label="FormFix Home">
                <div class="logo-mark">
                    <img src="/favicon.png?v=5" alt="" width="24" height="24" loading="eager" decoding="async" />
                </div>
                <span class="logo-text">FormFix</span>
            </a>
        </div>

        <nav class="desktop-nav no-mobile" aria-label="Primary">
            <ul class="nav-list">
                {navItems.map(item => (
                    <li>
                        <a href={item.href} class={`nav-link ${active === item.id ? 'active' : ''}`} aria-current={active === item.id ? 'page' : undefined}>
                            {item.name}
                        </a>
                    </li>
                ))}
            </ul>
        </nav>

        <div class="header-right">
            <button id="theme-toggle" class="icon-btn" aria-label="Toggle dark mode" type="button">
                <svg class="sun-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
                <svg class="moon-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
            </button>

            <a href="/tools" class="header-cta no-mobile">
                Open Tools
            </a>

            <button class="menu-toggle" id="menu-toggle" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-drawer" type="button">
                <span aria-hidden="true"></span><span aria-hidden="true"></span><span aria-hidden="true"></span>
            </button>
        </div>
    </div>
</header>

<aside class="mobile-drawer" id="mobile-drawer" aria-label="Mobile navigation" aria-hidden="true">
    <div class="drawer-header">
        <span class="logo-text">FormFix</span>
        <button id="drawer-close" aria-label="Close menu" type="button">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
    </div>
    <nav class="drawer-nav" aria-label="Mobile">
        {navItems.map(item => (
            <a href={item.href} class="drawer-link" aria-current={active === item.id ? 'page' : undefined}>{item.name}</a>
        ))}
        <button id="mobile-theme-toggle" class="drawer-link text-left" type="button">Switch Theme</button>
    </nav>
</aside>
<div class="drawer-overlay" id="drawer-overlay" aria-hidden="true"></div>

<style>
.site-header {
    position: sticky;
    top: 0;
    z-index: 1000;
    background: var(--surface-1);
    border-bottom: 1px solid var(--border-subtle);
}

.site-header.scrolled {
    background: var(--surface-2);
}

.header-inner {
    height: 56px;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.logo { display: flex; align-items: center; gap: 8px; text-decoration: none; }
.logo-mark { width: 28px; height: 28px; display: flex; align-items: center; justify-content: center; border-radius: var(--radius-xs); overflow: hidden; }
.logo-text { font-weight: 600; font-size: 1rem; color: var(--text-primary); letter-spacing: -0.02em; }

.nav-list { display: flex; gap: 2px; list-style: none; padding: 0; margin: 0; }
.nav-link {
    padding: 6px 12px;
    border-radius: var(--radius-sm);
    font-weight: 500;
    font-size: 0.8rem;
    color: var(--text-secondary);
    text-decoration: none;
    display: inline-block;
}
.nav-link:hover { color: var(--text-primary); }
.nav-link.active { color: var(--accent-primary); }

.header-right { display: flex; align-items: center; gap: 6px; }

.icon-btn {
    background: transparent;
    border: 1px solid var(--border-subtle);
    color: var(--text-secondary);
    width: 32px;
    height: 32px;
    border-radius: var(--radius-sm);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
}
.icon-btn:hover {
    color: var(--text-primary);
    border-color: var(--border-strong);
}

.moon-icon { display: none; }
:global(.dark) .sun-icon { display: none; }
:global(.dark) .moon-icon { display: block; }

.header-cta {
    background: var(--text-primary);
    color: var(--surface-1) !important;
    padding: 6px 14px;
    border-radius: var(--radius-sm);
    font-weight: 500;
    font-size: 0.8rem;
    text-decoration: none;
}
.header-cta:hover {
    opacity: 0.9;
}

.menu-toggle { display: none; flex-direction: column; justify-content: center; align-items: center; gap: 4px; border: none; background: transparent; width: 32px; height: 32px; border-radius: var(--radius-sm); cursor: pointer; }
.menu-toggle span { width: 16px; height: 1.5px; background: var(--text-primary); border-radius: 1px; transition: 0.2s; }

/* Mobile Drawer */
.mobile-drawer {
    position: fixed;
    right: -100%;
    top: 0;
    width: 85%;
    max-width: 300px;
    height: 100vh;
    height: 100dvh;
    background: var(--surface-1);
    z-index: 1001;
    transition: right 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    padding: 20px;
    border-left: 1px solid var(--border-subtle);
}
.mobile-drawer.open { right: 0; }
.drawer-overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.4); opacity: 0; pointer-events: none; transition: 0.2s; z-index: 1000; }
.drawer-overlay.open { opacity: 1; pointer-events: all; }

.drawer-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; padding-bottom: 14px; border-bottom: 1px solid var(--border-subtle); }
.drawer-header button { background: none; border: none; color: var(--text-secondary); cursor: pointer; padding: 4px; display: flex; }
.drawer-nav { display: flex; flex-direction: column; gap: 2px; }
.drawer-link {
    padding: 10px 14px;
    color: var(--text-primary);
    text-decoration: none;
    font-weight: 500;
    font-size: 0.9rem;
    border-radius: var(--radius-sm);
    background: none;
    border: none;
    text-align: left;
    cursor: pointer;
    font-family: inherit;
}
.drawer-link:hover { background: var(--surface-2); }
.text-left { text-align: left; }

@media (max-width: 960px) {
    .no-mobile { display: none; }
    .menu-toggle { display: flex; }
}
</style>

<script>
    const header = document.getElementById('main-header');
    const toggle = document.getElementById('menu-toggle');
    const drawer = document.getElementById('mobile-drawer');
    const overlay = document.getElementById('drawer-overlay');
    const close = document.getElementById('drawer-close');
    const themeBtn = document.getElementById('theme-toggle');
    const mobileThemeBtn = document.getElementById('mobile-theme-toggle');

    window.addEventListener('scroll', () => {
        header?.classList.toggle('scrolled', window.scrollY > 20);
    }, { passive: true });

    const toggleTheme = () => {
        const isDark = document.documentElement.classList.toggle('dark');
        try { localStorage.setItem('ff-theme', isDark ? 'dark' : 'light'); } catch (e) {}
    };

    themeBtn?.addEventListener('click', toggleTheme);
    mobileThemeBtn?.addEventListener('click', () => {
        toggleTheme();
        drawer?.classList.remove('open');
        overlay?.classList.remove('open');
        toggle?.setAttribute('aria-expanded', 'false');
    });

    const openDrawer = () => {
        drawer?.classList.add('open');
        overlay?.classList.add('open');
        toggle?.setAttribute('aria-expanded', 'true');
        drawer?.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
    };
    const closeDrawer = () => {
        drawer?.classList.remove('open');
        overlay?.classList.remove('open');
        toggle?.setAttribute('aria-expanded', 'false');
        drawer?.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
    };

    toggle?.addEventListener('click', openDrawer);
    [close, overlay].forEach(el => el?.addEventListener('click', closeDrawer));

    document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeDrawer();
    });
</script>
