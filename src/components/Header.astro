---
const { active = 'home' } = Astro.props;

const navItems = [
    { name: 'Compress', href: '/compress-image', id: 'compress' },
    { name: 'Passport Photo', href: '/passport-size-photo', id: 'passport-maker' },
    { name: 'Sign Maker', href: '/signature-maker', id: 'signature' },
    { name: 'PDF Tools', href: '/merge-pdf', id: 'pdf' },
    { name: 'All Tools', href: '/tools', id: 'tools' },
];
---

<header class="prism-header" id="main-header">
    <div class="container header-inner">
        <div class="header-left">
            <a href="/" class="logo" aria-label="FormFix Home">
                <div class="logo-box">
                    <img src="/favicon.png?v=5" alt="FormFix" width="36" height="36" />
                </div>
                <span class="logo-text">FormFix</span>
            </a>
        </div>

        <nav class="desktop-nav no-mobile" aria-label="Main">
            <ul class="nav-list">
                {navItems.map(item => (
                    <li>
                        <a href={item.href} class={`nav-link ${active === item.id ? 'active' : ''}`}>
                            {item.name}
                        </a>
                    </li>
                ))}
            </ul>
        </nav>

        <div class="header-right">
            <div class="trust-pill no-mobile">
                <span class="dot"></span>
                Secure Workspace
            </div>
            <a href="/tools" class="primary-btn dashboard-btn">
                Launch Dashboard
            </a>
            
            <button class="menu-toggle" id="menu-toggle" aria-label="Toggle Menu">
                <span></span><span></span><span></span>
            </button>
        </div>
    </div>
</header>

<div class="mobile-drawer" id="mobile-drawer">
    <div class="drawer-header">
        <span class="logo-text">FormFix</span>
        <button id="drawer-close">✕</button>
    </div>
    <nav class="drawer-nav">
        {navItems.map(item => (
            <a href={item.href} class="drawer-link">{item.name}</a>
        ))}
    </nav>
</div>
<div class="drawer-overlay" id="drawer-overlay"></div>

<style>
.prism-header {
    position: sticky;
    top: 0;
    z-index: 1000;
    background: rgba(255,255,255,0.7);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(0,0,0,0.05);
    transition: all 0.3s var(--spring);
}
.prism-header.scrolled {
    background: rgba(255,255,255,0.95);
    padding: 10px 0;
    box-shadow: 0 10px 30px rgba(0,0,0,0.05);
}

.header-inner {
    height: 80px;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.logo { display: flex; align-items: center; gap: 12px; text-decoration: none; }
.logo-box { width: 40px; height: 40px; display: flex; align-items: center; justify-content: center; transition: 0.3s; }
.logo:hover .logo-box { transform: rotate(-5deg) scale(1.1); }
.logo-text { font-family: 'Lexend', sans-serif; font-weight: 800; font-size: 1.4rem; background: var(--grad-prism); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }

.nav-list { display: flex; gap: 8px; list-style: none; }
.nav-link { 
    padding: 8px 16px; 
    border-radius: var(--radius-sm); 
    font-weight: 600; 
    font-size: 0.95rem; 
    color: var(--surface-500);
    transition: 0.2s;
}
.nav-link:hover { color: var(--primary); background: var(--surface-200); }
.nav-link.active { color: var(--primary); background: rgba(83,64,255,0.05); }

.header-right { display: flex; align-items: center; gap: 20px; }
.trust-pill { 
    display: inline-flex; align-items: center; gap: 8px; 
    padding: 6px 14px; background: rgba(16,185,129,0.1); 
    color: #059669; font-weight: 700; font-size: 0.75rem; 
    border-radius: var(--radius-full);
}
.trust-pill .dot { width: 6px; height: 6px; background: #10b981; border-radius: 50%; }

.dashboard-btn { padding: 10px 20px !important; font-size: 0.9rem !important; }

.menu-toggle { display: none; flex-direction: column; justify-content: center; align-items: center; gap: 5px; border: none; background: transparent; width: 48px; height: 48px; border-radius: var(--radius-sm); cursor: pointer; transition: background 0.2s; }
.menu-toggle:active { background: var(--surface-200); }
.menu-toggle span { width: 24px; height: 2px; background: var(--surface-800); border-radius: 2px; }

/* Drawer styles */
.mobile-drawer { position: fixed; right: -320px; top: 0; width: 300px; height: 100vh; background: #fff; z-index: 1001; transition: 0.4s var(--spring); padding: 40px 24px; }
.mobile-drawer.open { right: 0; }
.drawer-overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.5); opacity: 0; pointer-events: none; transition: 0.3s; z-index: 1000; }
.drawer-overlay.open { opacity: 1; pointer-events: all; }
.drawer-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 40px; }
.drawer-nav { display: flex; flex-direction: column; gap: 8px; }
.drawer-link { padding: 12px 16px; border-radius: 8px; font-weight: 700; color: var(--surface-700); text-decoration: none; }
.drawer-link:active { background: var(--surface-200); }

@media (max-width: 960px) {
    .no-mobile { display: none; }
    .menu-toggle { display: flex; }
    .header-inner { height: 64px; }
}
</style>

<script>
    const header = document.getElementById('main-header');
    const toggle = document.getElementById('menu-toggle');
    const drawer = document.getElementById('mobile-drawer');
    const overlay = document.getElementById('drawer-overlay');
    const close = document.getElementById('drawer-close');

    window.addEventListener('scroll', () => {
        header?.classList.toggle('scrolled', window.scrollY > 20);
    });

    toggle?.addEventListener('click', () => {
        drawer?.classList.add('open');
        overlay?.classList.add('open');
    });

    [close, overlay].forEach(el => el?.addEventListener('click', () => {
        drawer?.classList.remove('open');
        overlay?.classList.remove('open');
    }));
</script>
