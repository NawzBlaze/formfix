---
const { title, subtitle, currentTool } = Astro.props;
const encodedUrl = encodeURIComponent(Astro.url.href);
import RelatedTools from './RelatedTools.astro';
import SocialShare from './SocialShare.astro';
---

<div class="tool-tension-layout">
    <div class="container">
        <!-- Dramatic Header -->
        <header class="tool-header-dramatic">
            <div class="header-glow"></div>
            <h1 class="dominant-title">{title}</h1>
            <p class="subtitle-muted">{subtitle}</p>
        </header>

        <!-- Layered Workspace -->
        <div class="workspace-outer-layer">
            <div class="outer-edge-highlight"></div>
            <div class="ambient-glow-layer"></div>
            
            <div class="workspace-inner-layer">
                <slot name="tool-ui" />
            </div>
        </div>

        <div class="tool-sharing-row">
            <SocialShare title={title} url={Astro.url.href} />
        </div>

        <div class="related-tools-wrap">
            <RelatedTools currentTool={currentTool} />
        </div>
    </div>
</div>

<style>
    .tool-tension-layout {
        padding: 100px 0 140px;
        min-height: 80vh;
        position: relative;
    }

    /* Dramatic Header */
    .tool-header-dramatic {
        text-align: center;
        margin-bottom: 80px;
        position: relative;
    }

    .header-glow {
        position: absolute;
        top: 50%; left: 50%; transform: translate(-50%, -50%);
        width: 600px; height: 300px;
        background: radial-gradient(ellipse, var(--accent-glow) 0%, transparent 70%);
        z-index: -1; pointer-events: none; opacity: 0.6;
    }

    .dominant-title {
        font-size: clamp(3rem, 6vw, 4.5rem);
        font-weight: 900;
        letter-spacing: -0.05em;
        line-height: 1.1;
        margin-bottom: 16px;
        color: var(--text-primary);
        text-shadow: 0 10px 30px rgba(0,0,0,0.1);
    }
    .dark .dominant-title { text-shadow: 0 10px 30px rgba(0,0,0,0.5); }

    .subtitle-muted {
        font-size: 1.3rem;
        color: var(--text-secondary);
        font-weight: 500;
        max-width: 600px;
        margin: 0 auto;
    }

    /* Outer Container (Dark/Deep Surface) */
    .workspace-outer-layer {
        position: relative;
        background: var(--surface-3); /* #111827 in dark, #fff in light */
        border-radius: 32px;
        padding: 24px;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25), 0 0 40px rgba(0,0,0,0.05);
        border: 1px solid var(--border-strong);
        margin-bottom: 80px;
        z-index: 10;
        overflow: hidden;
    }
    .dark .workspace-outer-layer {
        background: linear-gradient(180deg, #1f2937 0%, #111827 100%);
        box-shadow: 0 30px 60px -15px rgba(0, 0, 0, 0.7), 0 0 30px var(--accent-soft);
    }

    .outer-edge-highlight {
        position: absolute; top: 0; left: 0; right: 0; height: 1px;
        background: linear-gradient(90deg, transparent, rgba(255,255,255,0.4), transparent);
        z-index: 20; opacity: 0.6; pointer-events: none;
    }
    .dark .outer-edge-highlight { background: linear-gradient(90deg, transparent, rgba(255,255,255,0.1), transparent); }

    .ambient-glow-layer {
        position: absolute; top: -50px; left: -50px; width: 300px; height: 300px;
        background: radial-gradient(circle, var(--accent-glow) 0%, transparent 70%);
        z-index: 0; pointer-events: none; opacity: 0.5;
    }

    /* Inner Panel (Soft/Readable Surface) */
    .workspace-inner-layer {
        position: relative;
        background: var(--surface-1); /* #f8fafc in light, #020617 in dark */
        border-radius: 20px;
        padding: 60px;
        box-shadow: inset 0 2px 10px rgba(0,0,0,0.02);
        border: 1px solid var(--card-border);
        z-index: 10;
        min-height: 400px;
    }
    .dark .workspace-inner-layer {
        background: #0f172a; /* Deep slate, better than pure black for tools */
        box-shadow: inset 0 2px 10px rgba(0,0,0,0.5);
    }

    .related-tools-wrap {
        margin-top: 100px;
        border-top: 1px solid var(--border-subtle);
        padding-top: 80px;
    }

    @media (max-width: 768px) {
        .tool-tension-layout { padding: 60px 0 100px; }
        .workspace-outer-layer { padding: 12px; border-radius: 24px; }
        .workspace-inner-layer { padding: 30px 20px; border-radius: 16px; }
        .dominant-title { font-size: 2.5rem; }
    }
</style>
