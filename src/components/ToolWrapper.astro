---
const { title, subtitle, currentTool } = Astro.props;
import RelatedTools from './RelatedTools.astro';
import SocialShare from './SocialShare.astro';
---

<div class="tool-page">
    <div class="container tool-container">
        
        <header class="tool-header">
            <h1>{title}</h1>
            <p>{subtitle}</p>
        </header>

        <div class="tool-card">
            <div class="tool-active-area">
                <slot name="tool-ui" />
            </div>
        </div>

        <div class="tool-secondary">
            <div class="tool-info-section">
                <slot name="tool-info" />
            </div>

            <div class="tool-share">
                <SocialShare title={title} url={Astro.url.href} />
            </div>

            <div class="tool-related">
                <RelatedTools currentTool={currentTool} />
            </div>
        </div>
    </div>
</div>

<style>
    .tool-page {
        padding: 48px 0 80px;
    }

    .tool-container {
        max-width: 900px;
    }

    .tool-header {
        text-align: center;
        margin-bottom: 40px;
    }

    .tool-header h1 {
        font-size: clamp(1.5rem, 4vw, 2.2rem);
        font-weight: 600;
        letter-spacing: -0.02em;
        margin-bottom: 8px;
    }

    .tool-header p {
        font-size: 0.95rem;
        color: var(--text-secondary);
        max-width: 500px;
        margin: 0 auto;
    }

    .tool-card {
        background: var(--surface-3);
        border: 1px solid var(--card-border);
        border-radius: var(--radius-lg);
        padding: 32px;
        margin-bottom: 48px;
    }

    .tool-active-area {
        min-height: 280px;
    }

    .tool-secondary {
        opacity: 0.9;
    }

    .tool-info-section {
        margin-bottom: 40px;
    }

    .tool-info-section h2 {
        font-size: 1.4rem;
        font-weight: 600;
        margin-bottom: 12px;
        color: var(--text-primary);
    }

    .tool-info-section h3 {
        font-size: 1.1rem;
        font-weight: 600;
        margin-top: 24px;
        margin-bottom: 8px;
        color: var(--text-primary);
    }

    .tool-info-section p {
        font-size: 0.95rem;
        line-height: 1.7;
        color: var(--text-secondary);
        margin-bottom: 12px;
    }

    .tool-info-section ul, .tool-info-section ol {
        padding-left: 20px;
        margin-bottom: 16px;
    }

    .tool-info-section li {
        font-size: 0.95rem;
        line-height: 1.7;
        color: var(--text-secondary);
        margin-bottom: 6px;
    }

    .tool-info-section strong {
        color: var(--text-primary);
    }

    .tool-info-section a {
        color: var(--accent-primary);
        text-decoration: underline;
    }

    .tool-secondary:hover {
        opacity: 1;
    }

    .tool-related {
        margin-top: 60px;
        border-top: 1px solid var(--border-subtle);
        padding-top: 40px;
    }

    @media (max-width: 768px) {
        .tool-page { padding: 32px 0 60px; }
        .tool-card { padding: 20px; border-radius: var(--radius-md); }
        .tool-header { margin-bottom: 28px; }
    }
</style>
