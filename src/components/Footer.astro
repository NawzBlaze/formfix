---
const YEAR = new Date().getFullYear();
---

<footer class="premium-footer" role="contentinfo">
    <div class="container footer-grid">
        <div class="footer-block-brand">
            <a href="/" class="f-logo">
                <div class="f-logo-box">
                    <img src="/favicon.png?v=5" alt="FormFix" width="28" height="28" />
                </div>
                <span class="f-logo-text">FormFix</span>
            </a>
            <p class="f-tagline">
                The web's most private digital toolkit. 100% browser-based processing for images, PDFs, and essential tools.
            </p>
            <div class="f-social-row">
                <a href="https://github.com/NawzBlaze/Formfix" target="_blank" aria-label="GitHub">
                   <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
                </a>
            </div>
        </div>

        <div class="footer-block-links">
            <h4 class="f-title">Solutions</h4>
            <ul class="f-list">
                <li><a href="/compress-image">Image Compressor</a></li>
                <li><a href="/passport-size-photo">Passport Photo Maker</a></li>
                <li><a href="/signature-maker">Digital Signature</a></li>
                <li><a href="/merge-pdf">PDF Merger</a></li>
                <li><a href="/tools">Tools Dashboard</a></li>
            </ul>
        </div>

        <div class="footer-block-links">
            <h4 class="f-title">Resources</h4>
            <ul class="f-list">
                <li><a href="/about">About Us</a></li>
                <li><a href="/compress-image-to-20kb">20KB Guide</a></li>
                <li><a href="/official-passport-photo-maker">Global Standards</a></li>
                <li><a href="/contact">Contact Support</a></li>
            </ul>
        </div>

        <div class="footer-block-links">
            <h4 class="f-title">Legal</h4>
            <ul class="f-list">
                <li><a href="/privacy">Privacy Policy</a></li>
                <li><a href="/terms">Terms of Service</a></li>
                <li><a href="/cookie-policy">Cookie Policy</a></li>
                <li><a href="/security">Security Protocol</a></li>
            </ul>
        </div>
    </div>

    <div class="footer-bottom">
        <div class="container fb-inner">
            <div class="fb-left">
                &copy; {YEAR} FormFix. Privacy first, globally.
            </div>
            <div class="fb-right">
                <span class="fb-status">
                    <span class="dot"></span> All Systems Operational
                </span>
            </div>
        </div>
    </div>
</footer>

<style>
.premium-footer {
    background: var(--surface-2);
    color: var(--text-secondary);
    padding-top: 80px;
    border-top: 1px solid var(--border-subtle);
    position: relative;
    z-index: 10;
}

.footer-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1fr;
    gap: 40px;
    padding-bottom: 60px;
}

.f-logo { display: flex; align-items: center; gap: 12px; text-decoration: none; margin-bottom: 24px; }
.f-logo-box { width: 36px; height: 36px; display: flex; align-items: center; justify-content: center; background: var(--surface-3); border-radius: 8px; border: 1px solid var(--border-subtle); }
.f-logo-text { font-family: 'Lexend', sans-serif; font-weight: 800; font-size: 1.25rem; color: var(--text-primary); }

.f-tagline { font-size: 0.95rem; line-height: 1.6; max-width: 300px; margin-bottom: 24px; color: var(--text-muted); }

.f-social-row { display: flex; gap: 16px; }
.f-social-row a { color: var(--text-muted); transition: 0.3s; }
.f-social-row a:hover { color: var(--accent-primary); transform: translateY(-3px); }

.f-title { font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.15em; font-weight: 800; color: var(--text-primary); margin-bottom: 24px; }
.f-list { list-style: none; display: flex; flex-direction: column; gap: 14px; }
.f-list a { text-decoration: none; color: var(--text-muted); font-size: 0.95rem; font-weight: 500; transition: 0.2s; }
.f-list a:hover { color: var(--accent-primary); transform: translateX(5px); }

.footer-bottom { border-top: 1px solid var(--border-subtle); padding: 32px 0; font-size: 0.85rem; color: var(--text-muted); }
.fb-inner { display: flex; justify-content: space-between; align-items: center; }

.fb-status { display: inline-flex; align-items: center; gap: 8px; padding: 6px 14px; background: rgba(16,185,129,0.06); color: #10b981; border-radius: 100px; font-weight: 700; font-size: 0.75rem; border: 1px solid rgba(16,185,129,0.1); }
.fb-status .dot { width: 6px; height: 6px; background: #10b981; border-radius: 50%; box-shadow: 0 0 8px #10b981; animation: pulse-glow 2s infinite; }

@keyframes pulse-glow {
    0% { transform: scale(1); opacity: 1; }
    50% { transform: scale(1.4); opacity: 0.6; }
    100% { transform: scale(1); opacity: 1; }
}

@media (max-width: 1024px) {
    .footer-grid { grid-template-columns: 1fr 1fr; gap: 48px; }
}

@media (max-width: 640px) {
    .footer-grid { grid-template-columns: 1fr; }
    .fb-inner { flex-direction: column; gap: 20px; text-align: center; }
}
</style>
