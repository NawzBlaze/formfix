---
const YEAR = new Date().getFullYear();
---

<footer class="site-footer" role="contentinfo" aria-label="Site footer">
    <div class="container footer-grid">
        <section class="footer-brand" aria-label="About FormFix">
            <a href="/" class="f-logo" aria-label="FormFix Home">
                <div class="f-logo-mark">
                    <img src="/favicon.png?v=5" alt="FormFix logo" width="20" height="20" loading="lazy" decoding="async" />
                </div>
                <span class="f-logo-text">FormFix</span>
            </a>
            <p class="f-desc">
                Free browser-based tools for images, PDFs, and more. Your files stay on your device.
            </p>
            <div class="f-social">
                <a href="https://github.com/NawzBlaze/formfix" target="_blank" rel="noopener noreferrer" aria-label="GitHub" class="social-link">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
                </a>
                <a href="https://twitter.com/formfix" target="_blank" rel="noopener noreferrer" aria-label="X" class="social-link">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
                </a>
                <a href="mailto:formfix.support@gmail.com" aria-label="Email" class="social-link">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                </a>
            </div>
        </section>

        <nav class="footer-links" aria-label="Tools">
            <h2 class="f-heading">Tools</h2>
            <ul class="f-list">
                <li><a href="/compress-image">Image Compressor</a></li>
                <li><a href="/passport-size-photo">Passport Photo</a></li>
                <li><a href="/signature-maker">Signature Maker</a></li>
                <li><a href="/merge-pdf">PDF Merger</a></li>
                <li><a href="/tools">All 30+ Tools</a></li>
            </ul>
        </nav>

        <nav class="footer-links" aria-label="Resources">
            <h2 class="f-heading">Resources</h2>
            <ul class="f-list">
                <li><a href="/about">About</a></li>
                <li><a href="/guides/how-to-compress-image-to-20kb">20KB Guide</a></li>
                <li><a href="/guides/passport-photo-specifications">Passport Specs</a></li>
                <li><a href="/contact">Contact</a></li>
            </ul>
        </nav>

        <nav class="footer-links" aria-label="Legal">
            <h2 class="f-heading">Legal</h2>
            <ul class="f-list">
                <li><a href="/privacy">Privacy</a></li>
                <li><a href="/terms">Terms</a></li>
                <li><a href="/security">Security</a></li>
                <li><a href="/sitemap-index.xml">Sitemap</a></li>
            </ul>
        </nav>
    </div>

    <div class="footer-bottom">
        <div class="container fb-inner">
            <span>&copy; {YEAR} FormFix</span>
            <span class="fb-tagline">Your files stay yours.</span>
        </div>
    </div>
</footer>

<style>
.site-footer {
    background: var(--surface-2);
    border-top: 1px solid var(--border-subtle);
    padding-top: 60px;
    margin-top: 80px;
}

.footer-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1fr;
    gap: 40px;
    padding-bottom: 48px;
}

.f-logo { display: flex; align-items: center; gap: 8px; text-decoration: none; margin-bottom: 16px; }
.f-logo-mark { width: 24px; height: 24px; display: flex; align-items: center; justify-content: center; border-radius: var(--radius-xs); overflow: hidden; }
.f-logo-text { font-weight: 600; font-size: 0.95rem; color: var(--text-primary); letter-spacing: -0.02em; }

.f-desc { font-size: 0.8rem; line-height: 1.6; max-width: 260px; margin-bottom: 16px; color: var(--text-muted); }

.f-social { display: flex; gap: 6px; }
.social-link {
    color: var(--text-muted);
    display: inline-flex;
    width: 44px;
    height: 44px;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-subtle);
    background: transparent;
}
.social-link:hover { color: var(--text-primary); border-color: var(--border-strong); }

.f-heading {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 600;
    color: var(--text-muted);
    margin-bottom: 16px;
}

.f-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 10px; }
.f-list a {
    text-decoration: none;
    color: var(--text-secondary);
    font-size: 0.8rem;
    font-weight: 400;
}
.f-list a:hover { color: var(--text-primary); }

.footer-bottom {
    border-top: 1px solid var(--border-subtle);
    padding: 20px 0;
    font-size: 0.75rem;
    color: var(--text-muted);
}
.fb-inner { display: flex; justify-content: space-between; align-items: center; }
.fb-tagline { color: var(--text-muted); }

@media (max-width: 1024px) {
    .footer-grid { grid-template-columns: 1fr 1fr; gap: 32px; }
}

@media (max-width: 640px) {
    .footer-grid { grid-template-columns: 1fr; }
    .fb-inner { flex-direction: column; gap: 8px; text-align: center; }
}
</style>
