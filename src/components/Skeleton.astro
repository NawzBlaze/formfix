---
interface Props {
    type?: 'card' | 'text' | 'image' | 'tool';
    lines?: number;
}
const { type = 'card', lines = 3 } = Astro.props;
---

{type === 'card' && (
    <div class="skeleton skeleton-card" role="status" aria-label="Loading content">
        <div class="skeleton-image"></div>
        <div class="skeleton-body">
            <div class="skeleton-line w-75"></div>
            <div class="skeleton-line w-50"></div>
            <div class="skeleton-line w-100"></div>
        </div>
    </div>
)}

{type === 'text' && (
    <div class="skeleton skeleton-text" role="status" aria-label="Loading content">
        {Array.from({ length: lines }).map((_, i) => (
            <div class={`skeleton-line ${i === lines - 1 ? 'w-60' : 'w-100'}`}></div>
        ))}
    </div>
)}

{type === 'image' && (
    <div class="skeleton skeleton-image-wrapper" role="status" aria-label="Loading image">
        <div class="skeleton-image"></div>
    </div>
)}

{type === 'tool' && (
    <div class="skeleton skeleton-tool" role="status" aria-label="Loading tool">
        <div class="skeleton-tool-sidebar">
            <div class="skeleton-line w-75"></div>
            <div class="skeleton-line w-100"></div>
            <div class="skeleton-line w-50"></div>
            <div class="skeleton-block mt-16"></div>
        </div>
        <div class="skeleton-tool-main">
            <div class="skeleton-image-lg"></div>
        </div>
    </div>
)}

<style>
    .skeleton {
        animation: skeleton-pulse 1.5s ease-in-out infinite;
    }
    @keyframes skeleton-pulse {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.4; }
    }

    .skeleton-card {
        background: var(--surface-3, #fff);
        border: 1px solid var(--border-subtle);
        border-radius: 16px;
        overflow: hidden;
    }
    .skeleton-image {
        width: 100%;
        height: 180px;
        background: var(--surface-2, var(--surface-2));
    }
    .skeleton-image-lg {
        width: 100%;
        height: 400px;
        background: var(--surface-2, var(--surface-2));
        border-radius: 16px;
    }
    .skeleton-body {
        padding: 20px;
        display: flex;
        flex-direction: column;
        gap: 10px;
    }
    .skeleton-text {
        display: flex;
        flex-direction: column;
        gap: 10px;
        padding: 16px 0;
    }
    .skeleton-line {
        height: 14px;
        background: var(--surface-2, var(--surface-2));
        border-radius: 8px;
    }
    .skeleton-block {
        height: 48px;
        background: var(--surface-2, var(--surface-2));
        border-radius: 12px;
    }
    .w-100 { width: 100%; }
    .w-75 { width: 75%; }
    .w-60 { width: 60%; }
    .w-50 { width: 50%; }
    .mt-16 { margin-top: 16px; }

    .skeleton-tool {
        display: grid;
        grid-template-columns: 300px 1fr;
        gap: 24px;
        max-width: 1000px;
        margin: 0 auto;
    }
    .skeleton-tool-sidebar {
        display: flex;
        flex-direction: column;
        gap: 12px;
        padding: 24px;
        background: var(--surface-3, #fff);
        border: 1px solid var(--border-subtle);
        border-radius: 16px;
    }
    .skeleton-tool-main {
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .skeleton-image-wrapper {
        width: 100%;
        border-radius: 16px;
        overflow: hidden;
    }

    @media (max-width: 768px) {
        .skeleton-tool { grid-template-columns: 1fr; }
    }
</style>
