---
import BaseLayout from '../components/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import ToolWrapper from '../components/ToolWrapper.astro';

const PAGE_TITLE = 'Crop Image Online Free (Custom & Ratio Crop) | FormFix';
const PAGE_DESC = 'Easily crop JPG, PNG or WebP images online for free. Custom aspect ratios (1:1, 16:9, 4:3) and pro resolution selection. 100% private cropping.';
const PAGE_KEYWORDS = 'crop image online, free image cropper, crop photo for instagram, official document cropper, photo cropper online';

const customSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      "name": "Crop Image Online - FormFix",
      "operatingSystem": "All Platforms",
      "applicationCategory": "DesignApplication",
      "description": "Easily crop JPG, PNG or WebP images online for free. Custom aspect ratios and pro resolution selection.",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      }
    }
  ]
};

const faqs = [
  { q: "Does it change image resolution?", a: "Cropping naturally removes pixels, so the final file will have a smaller width/height than the original. However, the DPI and sharpness of the remaining area stay 100% untouched." },
  { q: "Is my photo privacy protected?", a: "Absolutely. 100% of the cropping process is handled by your browser's local engine. We do not use servers to store or process your personal photos. Your privacy is mathematically guaranteed." },
];
---

<BaseLayout title={PAGE_TITLE} description={PAGE_DESC} keywords={PAGE_KEYWORDS} customSchema={customSchema} active="tools" canonicalPath="/crop-image" faq={faqs}>
    <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
        try {
        const uploadBox = document.getElementById('u-box-container');
        const controls = document.getElementById('controls');
        const fileInput = document.getElementById('crop-input');
        
        const viewport = document.getElementById('viewport');
        const imgContainer = document.getElementById('img-container');
        const source = document.getElementById('source');
        const cropBox = document.getElementById('crop-box');
        
        const ratioBtns = document.querySelectorAll('.preset-btn');
        const zoomSlider = document.getElementById('zoom-slider');
        const zoomVal = document.getElementById('zoom-val');
        const applyBtn = document.getElementById('apply-btn');
        const resultStage = document.getElementById('result-stage');

        let activeRatio = 'free';
        let originalImg = null;
        let ticking = false;
        let sourceFileType = 'image/jpeg';
        let sourceFileName = 'formfix-crop';
        let outputFormat = 'image/jpeg';
        let exifOrientation = 1;

        const fmtBtns = document.querySelectorAll('.fmt-btn');
        fmtBtns.forEach(btn => btn.addEventListener('click', () => {
            fmtBtns.forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            outputFormat = 'image/' + btn.dataset.fmt;
        }));

        fileInput.addEventListener('change', (e) => {
            const file = e.target.files?.[0];
            if (file) handleFile(file);
        });

        uploadBox.addEventListener('dragover', (e) => {
             e.preventDefault();
             uploadBox.querySelector('.upload-box').classList.add('drag-active');
        });
        uploadBox.addEventListener('dragleave', () => {
             uploadBox.querySelector('.upload-box').classList.remove('drag-active');
        });
        uploadBox.addEventListener('drop', (e) => {
             e.preventDefault();
             uploadBox.querySelector('.upload-box').classList.remove('drag-active');
             if (e.dataTransfer?.files.length) {
                 fileInput.files = e.dataTransfer.files;
                 handleFile(e.dataTransfer.files[0]);
             }
        });

        function handleFile(file) {
            if (!file || !['image/png','image/jpeg','image/webp'].includes(file.type)) {
                if (typeof window.ffNotice === 'function') window.ffNotice('Please select a PNG, JPG, or WebP image.', 'error');
                return;
            }
            sourceFileType = file.type === 'image/png' ? 'image/png' : file.type === 'image/webp' ? 'image/webp' : 'image/jpeg';
            sourceFileName = file.name ? file.name.replace(/\.[^/.]+$/, '') : 'formfix-crop';
            const reader = new FileReader();
            reader.onload = (e) => {
                source.src = e.target.result;
                source.onload = () => {
                    originalImg = source;
                    uploadBox.classList.add('hidden');
                    controls.classList.remove('hidden');
                    setTimeout(initCropBox, 50);
                };
            };
            reader.readAsDataURL(file);
            const exifReader = new FileReader();
            exifReader.onload = (exifEv) => {
                exifOrientation = (window.FormFix && window.FormFix.readExifOrientation) ? window.FormFix.readExifOrientation(exifEv.target.result) : 1;
            };
            exifReader.readAsArrayBuffer(file);
        }

        function initCropBox() {
            const iRect = source.getBoundingClientRect();
            const bW = iRect.width * 0.8, bH = iRect.height * 0.8;
            cropBox.style.width = bW + 'px'; cropBox.style.height = bH + 'px';
            
            // Center it relative to the viewport
            const vW = viewport.clientWidth, vH = viewport.clientHeight;
            // wait, crop box is positioned absolutely within viewport
            // source is scaled and centered. Let's match cropBox to image boundaries if needed.
            // for simplicity, centering it in viewport
            cropBox.style.left = (vW - bW) / 2 + 'px';
            cropBox.style.top = (vH - bH) / 2 + 'px';
        }

        // --- Zoom Control ---
        zoomSlider.addEventListener('input', (e) => {
            const z = parseFloat(e.target.value);
            zoomVal.textContent = z.toFixed(1) + 'x';
            imgContainer.style.transform = `scale(${z})`;
        });

        // ── Pointer Interaction ──
        let cap = '', sx = 0, sy = 0, bl = 0, bt = 0, bw = 0, bh = 0;
        
        const onStart = (e, type) => {
            e.preventDefault();
            cap = type; sx = e.clientX; sy = e.clientY;
            bl = cropBox.offsetLeft; bt = cropBox.offsetTop;
            bw = cropBox.clientWidth; bh = cropBox.clientHeight;
            e.target.setPointerCapture(e.pointerId);
        };

        const onMove = (e) => {
            if (!cap) return;
            e.preventDefault();
            if (!ticking) {
                requestAnimationFrame(() => {
                    updateBox(e.clientX, e.clientY);
                    ticking = false;
                });
                ticking = true;
            }
        };

        function updateBox(clientX, clientY) {
            const dx = clientX - sx, dy = clientY - sy;
            const iRect = source.getBoundingClientRect();
            const vRect = viewport.getBoundingClientRect();
            
            // Limits based on scaled image position relative to viewport
            const minX = Math.max(0, iRect.left - vRect.left);
            const maxX = Math.min(vRect.width, iRect.right - vRect.left);
            const minY = Math.max(0, iRect.top - vRect.top);
            const maxY = Math.min(vRect.height, iRect.bottom - vRect.top);

            if (cap === 'move') {
                let L = bl + dx, T = bt + dy;
                L = Math.max(minX, Math.min(L, maxX - cropBox.clientWidth));
                T = Math.max(minY, Math.min(T, maxY - cropBox.clientHeight));
                cropBox.style.left = L + 'px'; cropBox.style.top = T + 'px';
            } else {
                let newW = bw, newH = bh, newL = bl, newT = bt;
                if (cap.includes('r')) newW = Math.min(bw + dx, maxX - bl);
                if (cap.includes('b')) newH = Math.min(bh + dy, maxY - bt);
                if (cap.includes('l')) { newL = Math.max(minX, bl + dx); newW = bw - (newL - bl); }
                if (cap.includes('t')) { newT = Math.max(minY, bt + dy); newH = bh - (newT - bt); }

                if (activeRatio !== 'free') {
                    const r = activeRatio;
                    // basic ratio lock
                    if (cap.includes('r') || cap.includes('l')) {
                        newH = newW / r;
                        if (newT + newH > maxY) { newH = maxY - newT; newW = newH * r; if(cap.includes('l')) newL = bl + (bw-newW); }
                    } else {
                        newW = newH * r;
                        if (newL + newW > maxX) { newW = maxX - newL; newH = newW / r; if(cap.includes('t')) newT = bt + (bh-newH); }
                    }
                }

                if (newW > 40 && newH > 40) {
                    cropBox.style.width = newW + 'px'; cropBox.style.height = newH + 'px';
                    cropBox.style.left = newL + 'px'; cropBox.style.top = newT + 'px';
                }
            }
        }

        const onEnd = (e) => { 
            cap = ''; 
            e.target.releasePointerCapture(e.pointerId);
        };

        cropBox.addEventListener('pointerdown', (e) => onStart(e, 'move'));
        cropBox.addEventListener('pointermove', onMove);
        cropBox.addEventListener('pointerup', onEnd);
        cropBox.addEventListener('pointercancel', onEnd);
        
        cropBox.querySelectorAll('.drag-handle').forEach(h => {
             h.addEventListener('pointerdown', (e) => { e.stopPropagation(); onStart(e, e.target.dataset.dir); });
             h.addEventListener('pointerup', onEnd);
             h.addEventListener('pointercancel', onEnd);
        });

        ratioBtns.forEach(btn => btn.addEventListener('click', () => {
             ratioBtns.forEach(b => b.classList.remove('active'));
             btn.classList.add('active');
             activeRatio = btn.dataset.ratio === 'free' ? 'free' : parseFloat(btn.dataset.ratio);
             
             if (activeRatio !== 'free') {
                 // Adjust current box to fit ratio quickly
                 let newW = cropBox.clientWidth;
                 let newH = newW / activeRatio;
                 if (cropBox.offsetTop + newH > viewport.clientHeight) {
                     newH = viewport.clientHeight - cropBox.offsetTop;
                     newW = newH * activeRatio;
                 }
                 cropBox.style.width = newW + 'px';
                 cropBox.style.height = newH + 'px';
             }
        }));

        applyBtn.addEventListener('click', () => {
            applyBtn.textContent = 'Processing...'; applyBtn.disabled = true;
            document.getElementById('crop-overlay-loading')?.classList.add('active');
            
            const canvas = document.createElement('canvas');
            const ctx = canvas.getContext('2d');
            const iRect = source.getBoundingClientRect();
            const bRect = cropBox.getBoundingClientRect();
            
            const scaleX = source.naturalWidth / iRect.width;
            
            const rx = (bRect.left - iRect.left) * scaleX;
            const ry = (bRect.top - iRect.top) * scaleX;
            const rw = bRect.width * scaleX;
            const rh = bRect.height * scaleX;
            
            canvas.width = rw; canvas.height = rh;

            if (window.FormFix && window.FormFix.applyExifOrientation && exifOrientation > 1) {
                const _tmp = document.createElement('canvas');
                _tmp.width = source.naturalWidth; _tmp.height = source.naturalHeight;
                const _tmpCtx = _tmp.getContext('2d');
                window.FormFix.applyExifOrientation(_tmpCtx, source, exifOrientation, 0, 0, source.naturalWidth, source.naturalHeight);
                ctx.drawImage(_tmp, rx, ry, rw, rh, 0, 0, rw, rh);
            } else {
                ctx.drawImage(source, rx, ry, rw, rh, 0, 0, rw, rh);
            }
            canvas.toBlob(blob => {
                 const ext = outputFormat === 'image/png' ? 'png' : outputFormat === 'image/webp' ? 'webp' : 'jpg';
                 const url = URL.createObjectURL(blob);
                 document.getElementById('image-preview').src = url;
                 document.getElementById('final-res').textContent = `${Math.round(rw)} x ${Math.round(rh)}`;
                 document.getElementById('download-btn').href = url;
                 document.getElementById('download-btn').download = `${sourceFileName}-cropped.${ext}`;
                 
                 controls.classList.add('hidden');
                 resultStage.classList.remove('hidden'); 
                 resultStage.scrollIntoView({ behavior: 'smooth' });
                 
                 if (typeof window.triggerConfetti === 'function') window.triggerConfetti();
                 var shareTxt = encodeURIComponent("I just cropped my image using FormFix! 100% private. Try it: " + window.__SITE_URL + "/crop-image");
                 var existing = document.getElementById('post-crop-share');
                 if (!existing) {
                     var div = document.createElement('div');
                     div.id = 'post-crop-share';
                     div.style.cssText = 'margin-top:20px;text-align:center;';
                     div.innerHTML = '<p style="font-weight:600;margin-bottom:10px;color:var(--success);">Love FormFix? Share it!</p><div style="display:flex;gap:8px;justify-content:center;"><a href="https://x.com/intent/tweet?text=' + shareTxt + '" target="_blank" style="padding:8px 16px;border-radius:8px;background:#000;color:#fff;text-decoration:none;font-weight:600;font-size:0.85rem;">Share on X</a><a href="https://wa.me/?text=' + shareTxt + '" target="_blank" style="padding:8px 16px;border-radius:8px;background:#25D366;color:#fff;text-decoration:none;font-weight:600;font-size:0.85rem;">WhatsApp</a></div>';
                     resultStage.appendChild(div);
                 }
                 
                 document.getElementById('crop-overlay-loading')?.classList.remove('active');
                 applyBtn.textContent = '⬇️ Execute Crop & Save'; applyBtn.disabled = false;
            }, outputFormat, outputFormat === 'image/png' ? undefined : 0.95);
        });
        } catch(err) { console.error('Crop tool error:', err); if (typeof window.ffNotice === 'function') window.ffNotice('Something went wrong cropping your image. Please try again.', 'error'); }
    });
</script>

    <Breadcrumb items={[{ name: 'Home', path: '/' }, { name: "Crop Image Online Free (Custom & Ratio Crop)", path: "/crop-image" }]} />

    <ToolWrapper title="Crop Image Online" subtitle="Custom aspect ratios and high-precision cutting for any document or photo." currentTool="crop-image">
        
        <div slot="tool-ui">
             <div class="workspace-editor">
                  <!-- 1. Selection Stage -->
                  <div id="u-box-container" class="upload-container">
                       <div class="upload-box shadow-sm" id="drop-zone" onclick="document.getElementById('crop-input').click()">
                            <input type="file" id="crop-input" accept="image/png, image/jpeg, image/webp" class="hidden" />
                            <div class="upload-content">
                                 <div class="upload-icon">✂️</div>
                                 <h3 class="font-850 m-0 mb-8">Select Image to Crop</h3>
                                 <p class="text-muted m-0 mb-24 font-600">High-precision cropping. Works offline in your browser.</p>
                                 <button class="primary-btn px-40">Browse Photo</button>
                            </div>
                       </div>
                  </div>

                  <!-- 2. Editor Stage -->
                   <div id="controls" class="hidden">
                        <div id="crop-overlay-loading" class="processing-overlay">
                             <div class="processing-spinner"></div>
                             <span class="processing-text">Cropping...</span>
                        </div>
                        <div class="crop-grid">
                            <div class="preview-panel shadow-sm p-0 overflow-hidden">
                                 <div id="viewport" class="crop-viewport" style="touch-action: none;">
                                      <div id="img-container" class="img-zoom-box" style="touch-action: none;">
                                           <img id="source" draggable="false" style="touch-action: none;" alt="Master file" loading="lazy" decoding="async" />
                                      </div>
                                      <div id="crop-box" class="crop-box-handle" style="touch-action: none;">
                                           <div class="drag-handle tl" data-dir="tl"></div>
                                           <div class="drag-handle tr" data-dir="tr"></div>
                                           <div class="drag-handle bl" data-dir="bl"></div>
                                           <div class="drag-handle br" data-dir="br"></div>
                                           <div class="rule-grid"></div>
                                      </div>
                                 </div>
                            </div>

                            <div class="controls-sidebar">
                                 <div class="settings-card shadow-sm mb-24">
                                      <div class="section mb-24">
                                           <label class="section-label m-0 mb-12">Aspect Ratio</label>
                                           <div class="toggle-pill-group flex-wrap">
                                                <button class="setting-pill active preset-btn" data-ratio="free">Custom</button>
                                                <button class="setting-pill preset-btn" data-ratio="1">1:1</button>
                                                <button class="setting-pill preset-btn" data-ratio="1.333">4:3</button>
                                                <button class="setting-pill preset-btn" data-ratio="1.777">16:9</button>
                                           </div>
                                      </div>
                                      
                                       <div class="section">
                                            <div class="d-flex justify-between align-center mb-8">
                                                 <label class="section-label m-0">🔍 Image Zoom</label>
                                                 <span id="zoom-val" class="status-pill">1.0x</span>
                                            </div>
                                            <input type="range" id="zoom-slider" class="unified-slider" min="1" max="5" step="0.1" value="1" />
                                       </div>

                                       <div class="section mt-16">
                                            <label class="section-label m-0 mb-12">Output Format</label>
                                            <div class="toggle-pill-group">
                                                 <button class="setting-pill active fmt-btn" data-fmt="jpeg">JPG</button>
                                                 <button class="setting-pill fmt-btn" data-fmt="png">PNG</button>
                                                 <button class="setting-pill fmt-btn" data-fmt="webp">WebP</button>
                                            </div>
                                       </div>
                                  </div>

                                 <div class="action-stack">
                                      <button id="apply-btn" class="primary-btn wide-btn pulse-glow mb-12">⬇️ Execute Crop & Save</button>
                                      <button class="secondary-btn wide-btn" onclick="location.reload()">↺ Change Photo</button>
                                 </div>
                                 <p class="privacy-note text-center mt-16 mb-0 font-600 text-muted">🔒 Local Processing. No uploads.</p>
                            </div>
                       </div>
                  </div>

                  <!-- 3. Result Stage -->
                  <div id="result-stage" class="result-stage hidden">
                       <div class="result-card shadow-sm">
                            <div class="success-banner mb-32">
                                 <div class="check-icon">✔</div>
                                 <div class="success-info">
                                      <h4 class="font-850 m-0 mb-8">Image Cut Complete</h4>
                                      <p class="text-muted m-0 small font-600">Perfectly cropped to your specifications.</p>
                                 </div>
                            </div>

                            <div class="preview-panel checkerboard shadow-sm mb-32 d-flex justify-center">
                                 <img id="image-preview" src="" alt="Cropped result" class="styled-canvas" loading="lazy" decoding="async" />
                            </div>

                            <div class="stats-grid mb-32">
                                 <div class="mini-stat active">
                                      <label>Final Resolution</label>
                                      <span id="final-res">1920 x 1080</span>
                                 </div>
                                 <div class="mini-stat">
                                      <label>Protection</label>
                                      <span>100% Secure</span>
                                 </div>
                            </div>

                            <div class="d-flex gap-16">
                                 <a id="download-btn" href="#" class="primary-btn flex-2 wide-btn" style="text-decoration:none;">⬇️ Download Cropped Image</a>
                                 <button class="secondary-btn flex-1 wide-btn" onclick="location.reload()">↺ New Crop</button>
                            </div>
                       </div>
                  </div>
             </div>
        </div>

        <div slot="tool-info">
             <h2>The Professional Online Image Cropper</h2>
             <p>FormFix offers a industrial-grade <strong>online image cropper</strong> that works entirely in your browser. Whether you need to <strong>crop image to 1:1</strong> for Instagram or use a <strong>custom aspect ratio</strong> for a web banner, our tool ensures pixel-perfect results.</p>
             
             <div class="how-it-works mt-32">
                  <h3>How It Works</h3>
                  <ol class="steps">
                       <li><strong>Step 1:</strong> Upload your image</li>
                       <li><strong>Step 2:</strong> Select crop area or ratio</li>
                       <li><strong>Step 3:</strong> Download cropped image</li>
                  </ol>
             </div>

             <div class="faq-grid mt-32">
                  <details class="faq-item">
                       <summary>Does it change image resolution?</summary>
                       <p>Cropping naturally removes pixels, so the final file will have a smaller width/height than the original. However, the <strong>DPI and sharpness</strong> of the remaining area stay 100% untouched.</p>
                  </details>
                  <details class="faq-item">
                       <summary>Is my photo privacy protected?</summary>
                       <p>Absolutely. 100% of the cropping process is handled by your browser's local engine. We do not use servers to store or process your personal photos. Your privacy is mathematically guaranteed.</p>
                  </details>
             </div>
        </div>
    </ToolWrapper>
</BaseLayout><style>
    .preview-panel { background: #111; padding: 0; height: 500px; align-items: center; justify-content: center; }
    .crop-viewport { position: relative; width: 100%; height: 100%; overflow: hidden; }
    .img-zoom-box { position: absolute; width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; transform-origin: center; transition: transform 0.1s ease-out; }
    #source { max-width: 90%; max-height: 90%; display: block; filter: brightness(0.7); }
    .crop-box-handle { position: absolute; border: 2px solid var(--border-subtle); box-shadow: 0 0 0 9999px rgba(0,0,0,0.6); z-index: 10; cursor: move; box-sizing: border-box; }
    .rule-grid { position: absolute; inset: 0; pointer-events: none; border: 1px solid rgba(255,255,255,0.2); }
    .rule-grid::before, .rule-grid::after { content: ''; position: absolute; background: rgba(255,255,255,0.2); }
    .rule-grid::before { left: 33.33%; right: 33.33%; top: 0; bottom: 0; width: 33.33%; border-inline: 1px solid rgba(255,255,255,0.2); }
    .rule-grid::after { top: 33.33%; bottom: 33.33%; left: 0; right: 0; height: 33.33%; border-block: 1px solid rgba(255,255,255,0.2); }
    .drag-handle { position: absolute; width: 44px; height: 44px; background: var(--surface-3); border: 3px solid var(--accent-primary); border-radius: 50%; box-shadow: var(--shadow-md); z-index: 20; }
    .drag-handle.tl { top: -22px; left: -22px; cursor: nwse-resize; }
    .drag-handle.tr { top: -22px; right: -22px; cursor: nesw-resize; }
    .drag-handle.bl { bottom: -22px; left: -22px; cursor: nesw-resize; }
    .drag-handle.br { bottom: -22px; right: -22px; cursor: nwse-resize; }

    @media (max-width: 900px) {
        .crop-grid { grid-template-columns: 1fr; }
        .preview-panel { height: 300px; }
        .stats-grid { grid-template-columns: 1fr; }
        .d-flex.gap-16 { flex-direction: column; }
        .upload-box { padding: 40px 20px; }
    }
</style>
