---
import BaseLayout from '../../components/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const posts = [
  {
    slug: 'how-to-compress-image-to-20kb',
    title: 'How to Compress Image to 20KB Instantly',
    desc: 'A comprehensive guide to reducing your image size to exactly 20KB without losing critical quality using safe browser tools.',
    date: '2026-01-15',
    readTime: '3 min read',
    badge: 'Compression'
  },
  {
    slug: 'best-image-size-for-online-forms',
    title: 'The Best Image Size for Online Forms & Portals',
    desc: 'Discover the standardized image dimensions and file sizes required for seamless online form submissions globally.',
    date: '2026-02-10',
    readTime: '4 min read',
    badge: 'Guides'
  },
  {
    slug: 'reduce-image-size-without-losing-quality',
    title: 'How to Reduce Image Size Without Losing Quality',
    desc: 'Learn advanced techniques to compress photo weights while maintaining high-definition visual fidelity for web usage.',
    date: '2026-03-05',
    readTime: '3 min read',
    badge: 'Tips & Tricks'
  }
];
---

<BaseLayout title="Blog - FormFix Guides & Tips" description="Read guides, tips, and tutorials on image compression, PDF tools, and online form submissions." active="home" canonicalPath="/blog">
    <Breadcrumb items={[{ name: 'Home', path: '/' }, { name: 'Blog', path: '/blog' }]} />

    <div class="blog-index-wrapper">
        <header class="blog-index-header text-center">
            <div class="brand-badge box-shadow-subtle">📚 Blog</div>
            <h1 class="main-h1">FormFix Blog</h1>
            <p class="hero-sub">Guides, tips, and tutorials on image compression, PDF tools, and online form submissions.</p>
        </header>

        <div class="blog-grid">
            {posts.map((post) => (
                <a href={`/blog/${post.slug}`} class="blog-card">
                    <span class="blog-badge">{post.badge}</span>
                    <h2 class="blog-card-title">{post.title}</h2>
                    <p class="blog-card-desc">{post.desc}</p>
                    <div class="blog-card-meta">
                        <span>{new Date(post.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
                        <span>{post.readTime}</span>
                    </div>
                </a>
            ))}
        </div>
    </div>
</BaseLayout>

<style>
    .blog-index-wrapper { max-width: 900px; margin: 0 auto; padding: 64px 20px 100px; }
    .main-h1 { font-size: clamp(2.5rem, 5vw, 3.5rem); font-weight:600; letter-spacing: -0.04em; margin-bottom: 16px; color: var(--text-primary); line-height: 1.1; }
    .hero-sub { color: var(--text-secondary); font-weight: 500; font-size: 1.15rem; margin-bottom: 48px; max-width: 600px; margin-inline: auto; line-height: 1.6; }
    .brand-badge { display: inline-block; padding: 6px 16px; background:var(--surface-3); border: 1px solid var(--border-subtle); border-radius: 100px; font-size: 0.9rem; font-weight:600; margin-bottom: 16px; }
    .blog-grid { display: grid; gap: 24px; }
    .blog-card { display: block; background:var(--surface-3); border: 1px solid var(--border-subtle); border-radius: 16px; padding: 32px; text-decoration: none; transition: transform 0.2s, box-shadow 0.2s; }
    .blog-card:hover { transform: translateY(-3px); box-shadow: 0 8px 24px rgba(0,0,0,0.08); }
    .blog-badge { display: inline-block; padding: 4px 12px; background: var(--accent-soft); color:var(--accent-primary); border-radius: 100px; font-size: 0.75rem; font-weight:600; text-transform: uppercase; letter-spacing: 0.03em; margin-bottom: 12px; }
    .blog-card-title { font-size: 1.4rem; font-weight:600; color:var(--text-primary); margin-bottom: 8px; line-height: 1.3; letter-spacing: -0.02em; }
    .blog-card-desc { color: var(--text-secondary); font-size: 0.95rem; line-height: 1.6; margin-bottom: 16px; }
    .blog-card-meta { display: flex; gap: 16px; font-size: 0.8rem; font-weight: 600; color:var(--text-muted); }

    @media (max-width: 640px) {
        .blog-grid { grid-template-columns: 1fr; }
        .blog-card { padding: 20px; }
        .blog-index-wrapper { padding: 40px 16px 80px; }
    }
</style>
