---
import BaseLayout from '../components/BaseLayout.astro';
import RelatedTools from '../components/RelatedTools.astro';

const PAGE_TITLE = 'Extract PDF to JPG/PNG Online - PDF to Image Converter';
const PAGE_DESC = 'Convert PDF documents to high-quality JPG or PNG images instantly. Free, 100% private, and entirely client-side. Extract every page as a sharp photo.';
const PAGE_KEYWORDS = 'pdf to image online, extract pdf to jpg, convert pdf pages to png, private pdf extractor, high res pdf to image';

const customSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      "name": "PDF to Image Extractor",
      "operatingSystem": "All",
      "applicationCategory": "UtilitiesApplication",
      "description": "Convert PDF pages into high-resolution JPG or PNG images locally in your browser.",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      }
    }
  ]
};
---

<BaseLayout title={PAGE_TITLE} description={PAGE_DESC} keywords={PAGE_KEYWORDS} customSchema={customSchema} active="convert" canonicalPath="/pdf-to-image">
    <div class="tool-wrapper animate-in">
        <header class="tool-intro text-center">
             <div class="brand-badge shadow-sm">📑 Document Extractor v2</div>
             <h1 class="main-h1">PDF to <span class="highlight">Image Online</span></h1>
             <p class="hero-sub">Extract every page of your PDF into high-resolution images instantly.</p>
        </header>

        <div class="glass-card tool-content shadow-lg">
            <div id="u-box-container">
                 <div class="upload-container" id="pdf-upload-box">
                      <div class="upload-circle"><span class="u-icon">📄➡️🖼️</span></div>
                      <h3 class="u-title">Select PDF Document</h3>
                      <p class="u-sub">Click or drag a .pdf file here</p>
                      <button class="primary-btn pulse-glow upload-btn" onclick="document.getElementById('pdf-input').click()">Browse PDF</button>
                      <input type="file" id="pdf-input" class="hidden" accept=".pdf" />
                 </div>
            </div>

            <div id="controls" class="tool-controls hidden">
                <div class="pdf-settings text-center">
                     <label class="section-label">Conversion Settings</label>
                     <p class="hint-text mb-24">Select your desired output format.</p>
                     
                     <div class="pill-row justify-center">
                          <button class="setting-pill active" data-fmt="jpeg">JPEG (Smaller Size)</button>
                          <button class="setting-pill" data-fmt="png">PNG (Best Quality)</button>
                     </div>
                </div>

                <div class="action-footer mt-48">
                    <button id="extract-btn" class="primary-btn wide-btn profile-btn pulse-glow">
                        <span id="btn-label">Extract All Pages</span>
                        <div id="loader" class="mini-spinner hidden"></div>
                    </button>
                    <p class="privacy-note">🔒 Everything happens in your browser. Complete privacy.</p>
                </div>
            </div>
        </div>

        <!-- Result Section -->
        <div id="result-stage" class="result-stage hidden animate-fade-up">
            <div class="glass-card result-panel shadow-lg">
                <div class="res-header text-center">
                     <span class="status-badge">✔ Extraction Complete</span>
                     <h3>Images Ready for Download</h3>
                </div>
                
                <div class="extracted-grid mt-32" id="extracted-grid">
                     <!-- Images injected here -->
                </div>

                <div class="res-footer mt-48 justify-center">
                     <button id="download-zip" class="primary-btn download-btn">Download All as ZIP</button>
                     <button id="reset-tool" class="secondary-btn">Convert Another PDF</button>
                </div>
            </div>
        </div>

        <article class="pro-seo-article container mt-48">
             <h2>Convert PDF to JPG Safely</h2>
             <p>Our completely free <strong>PDF to Image converter</strong> enables you to extract pages from your documents as standard image files (JPG/PNG). This process happens entirely in your local browser, making it completely private and instantly fast, saving you from bandwidth bottlenecks. Whether you need to <strong>extract pages from PDF</strong> for a presentation or turn a multi-page document into social media assets, our tool provides high-fidelity photo extraction every time.</p>
             
             <h3 class="mt-32">Frequently Asked Questions</h3>
             <details class="faq-item">
                  <summary>Are my PDFs uploaded to a server?</summary>
                  <p>No. 100% of the extraction process takes place locally on your device via memory processing. Our <strong>private pdf converter</strong> ensures your sensitive data never touches a server.</p>
             </details>
             <details class="faq-item">
                  <summary>How do I download the images?</summary>
                  <p>You can individually save specific pages by clicking the "Download" button on each thumbnail, or you can use the "Download All as ZIP" button to get every page archived in a single file instantly.</p>
             </details>
             <details class="faq-item">
                  <summary>What is the output resolution?</summary>
                  <p>We extract pages at a high 2.0x scale relative to the standard PDF points, resulting in sharp, high-resolution images suitable for printing or professional web use.</p>
             </details>
             <details class="faq-item">
                  <summary>Can I extract specific pages only?</summary>
                  <p>Currently, our tool extracts all pages from the document. You can then selectively download only the ones you need from the extraction grid.</p>
             </details>
             <details class="faq-item">
                  <summary>Does it work with password-protected PDFs?</summary>
                  <p>For security reasons, we currently only support standard (non-encrypted) PDFs. If your PDF is encrypted, you must remove the passcode before uploading.</p>
             </details>
        </article>

        <RelatedTools currentTool="pdf-to-image" />
    </div>
</BaseLayout>

<script>
    import * as pdfjsLib from 'pdfjs-dist';
    import JSZip from 'jszip';

    // Must set worker using remote CDN to avoid complex vite bundling issues
    pdfjsLib.GlobalWorkerOptions.workerSrc = `https://cdnjs.cloudflare.com/ajax/libs/pdf.js/${pdfjsLib.version}/pdf.worker.min.mjs`;

    document.addEventListener('DOMContentLoaded', () => {
        const fileInput = document.getElementById('pdf-input') as HTMLInputElement;
        const controls = document.getElementById('controls') as HTMLElement;
        const uploadContainer = document.getElementById('u-box-container') as HTMLElement;
        const extractBtn = document.getElementById('extract-btn') as HTMLButtonElement;
        const loader = document.getElementById('loader') as HTMLElement;
        const btnLabel = document.getElementById('btn-label') as HTMLElement;
        const settingPills = document.querySelectorAll('.setting-pill');
        const extractedGrid = document.getElementById('extracted-grid') as HTMLElement;
        const zipBtn = document.getElementById('download-zip') as HTMLButtonElement;

        let selectedFile: File | null = null;
        let pdfDoc: pdfjsLib.PDFDocumentProxy | null = null;
        let outFormat = 'jpeg'; // 'jpeg' or 'png'
        let extractedImages: { url: string, blob: Blob, pageNum: number }[] = [];

        fileInput.addEventListener('change', async (e) => {
             const file = (e.target as HTMLInputElement).files?.[0];
             if (file && file.type === 'application/pdf') {
                 handlePdf(file);
             }
        });

        // Add Drag and Drop Handlers
        uploadContainer.addEventListener('dragover', (e) => {
             e.preventDefault();
             uploadContainer.classList.add('active'); // Will use hover state CSS
        });
        uploadContainer.addEventListener('dragleave', () => {
             uploadContainer.classList.remove('active');
        });
        uploadContainer.addEventListener('drop', (e) => {
             e.preventDefault();
             uploadContainer.classList.remove('active');
             const file = e.dataTransfer?.files[0];
             if (file && file.type === 'application/pdf') {
                 handlePdf(file);
             }
        });

        async function handlePdf(file: File) {
             selectedFile = file;
             const arrayBuffer = await file.arrayBuffer();
             pdfDoc = await pdfjsLib.getDocument(arrayBuffer).promise;
             
             btnLabel.textContent = `Extract ${pdfDoc.numPages} Pages`;
             uploadContainer.classList.add('hidden');
             controls.classList.remove('hidden');
        }

        settingPills.forEach(pill => pill.addEventListener('click', () => {
            settingPills.forEach(p => p.classList.remove('active'));
            pill.classList.add('active');
            outFormat = (pill as HTMLElement).dataset.fmt || 'jpeg';
        }));

        extractBtn.addEventListener('click', async () => {
             if (!pdfDoc) return;
             extractBtn.classList.add('loading');
             btnLabel.textContent = 'Processing pages...';
             loader.classList.remove('hidden');
             extractedGrid.innerHTML = '';
             extractedImages = [];

             try {
                 for (let i = 1; i <= pdfDoc.numPages; i++) {
                     const page = await pdfDoc.getPage(i);
                     const viewport = page.getViewport({ scale: 2.0 }); // High res
                     
                     const canvas = document.createElement('canvas');
                     const ctx = canvas.getContext('2d')!;
                     canvas.width = viewport.width;
                     canvas.height = viewport.height;

                     await page.render({ canvasContext: ctx, viewport, canvas: canvas as any }).promise;

                     const mime = outFormat === 'jpeg' ? 'image/jpeg' : 'image/png';
                     const blob = await new Promise<Blob>(res => canvas.toBlob(b => res(b!), mime, 0.9));
                     const url = URL.createObjectURL(blob);
                     
                     extractedImages.push({ url, blob, pageNum: i });

                     // Create DOM element
                     const item = document.createElement('div');
                     item.className = 'extracted-item shadow-sm';
                     item.innerHTML = `
                         <span class="page-badge">Pg ${i}</span>
                         <img src="${url}" />
                         <div class="e-actions">
                             <a href="${url}" download="page-${i}.${outFormat}" class="mini-dl-btn">Download</a>
                         </div>
                     `;
                     extractedGrid.appendChild(item);
                 }

                 document.querySelector('.tool-content')?.classList.add('hidden');
                 document.getElementById('result-stage')?.classList.remove('hidden');

             } catch (err) {
                 console.error(err);
                 alert('Error extracting pages. The PDF might be corrupted or protected.');
             } finally {
                 extractBtn.classList.remove('loading');
                 btnLabel.textContent = `Extract All Pages`;
                 loader.classList.add('hidden');
             }
        });

        zipBtn.addEventListener('click', async () => {
            if (extractedImages.length === 0) return;
            const originalText = zipBtn.textContent;
            zipBtn.textContent = 'Creating ZIP...';
            zipBtn.style.pointerEvents = 'none';
            
            try {
                const zip = new JSZip();
                const folder = zip.folder("pdf_extracted_images");
                const ext = outFormat === 'jpeg' ? 'jpg' : 'png';
                
                extractedImages.forEach(img => {
                    folder?.file(`page-${img.pageNum}.${ext}`, img.blob);
                });

                const content = await zip.generateAsync({ type: 'blob' });
                const url = URL.createObjectURL(content);
                const a = document.createElement('a');
                a.href = url;
                a.download = `formfix-extracted.${ext}.zip`;
                a.click();
            } catch (err) {
                alert('ZIP creation failed.');
            } finally {
                zipBtn.textContent = originalText;
                zipBtn.style.pointerEvents = 'auto';
            }
        });

        document.getElementById('reset-tool')?.addEventListener('click', () => location.reload());
    });
</script>

<style>
    .main-h1 { font-size: 3rem; font-weight: 1000; letter-spacing: -0.05em; margin-bottom: 12px; color: var(--dark); line-height: 1.1; }
    .hero-sub { color: var(--slate); font-weight: 600; font-size: 1.15rem; margin-bottom: 24px; }
    .tool-wrapper { max-width: 860px; margin: 0 auto; padding-bottom: 100px; }
    
    .upload-container { background: #f8fafc; border: 2.5px dashed var(--border); border-radius: 32px; padding: 60px 20px; text-align: center; cursor: pointer; transition: 0.3s; }
    .upload-container:hover { border-color: var(--primary); background: #f0fdf4; }
    .upload-circle { width: 80px; height: 80px; background: #fff; border-radius: 50%; box-shadow: var(--shadow-sm); display: flex; align-items: center; justify-content: center; margin: 0 auto 20px; font-size: 2rem; }
    .u-title { font-size: 1.6rem; font-weight: 1000; color: var(--dark); margin-bottom: 8px; }
    .u-sub { font-size: 1rem; color: var(--slate); font-weight: 600; margin-bottom: 32px; }
    .upload-btn { padding: 18px 40px; font-size: 1.1rem; border-radius: 100px; }

    .tool-controls { margin-top: 40px; border-top: 1.5px solid var(--border); padding-top: 40px; }
    .pill-row { display: flex; gap: 12px; margin-top: 16px; flex-wrap: wrap; }
    .justify-center { justify-content: center; }
    .setting-pill { padding: 12px 24px; border-radius: 100px; border: 1.5px solid var(--border); background: #fff; font-weight: 850; font-size: 0.95rem; cursor: pointer; transition: 0.2s; color: var(--slate); }
    .setting-pill.active { background: var(--primary); color: white; border-color: var(--primary); }

    .wide-btn { width: 100%; height: 72px; font-size: 1.25rem; font-weight: 1000; border-radius: 20px; margin-top: 20px; }
    .privacy-note { text-align: center; margin-top: 16px; font-size: 0.85rem; color: #94a3b8; font-weight: 700; }

    /* Result Stage */
    .result-stage { margin-top: 40px; }
    
    .extracted-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 20px; max-height: 500px; overflow-y: auto; padding: 16px; background: #f8fafc; border-radius: 20px; border: 1.5px solid var(--border); }
    .extracted-item { position: relative; background: #fff; border-radius: 16px; overflow: hidden; padding-bottom: 48px; border: 1.5px solid var(--border); }
    .extracted-item img { width: 100%; height: 200px; object-fit: cover; display: block; border-bottom: 1px solid var(--border); }
    .page-badge { position: absolute; top: 12px; left: 12px; background: rgba(0,0,0,0.8); color: white; padding: 4px 10px; border-radius: 100px; font-weight: 950; font-size: 0.75rem; }
    .e-actions { position: absolute; bottom: 0; left: 0; right: 0; height: 48px; display: flex; align-items: center; justify-content: center; background: #fff; }
    .mini-dl-btn { text-decoration: none; color: var(--primary); font-weight: 900; font-size: 0.85rem; padding: 6px 16px; background: var(--primary-light); border-radius: 100px; transition: 0.2s; }
    .mini-dl-btn:hover { background: var(--primary); color: white; }

    /* FAQ */
    .faq-item { background: #fff; border: 1.5px solid var(--border); border-radius: 16px; margin-bottom: 16px; overflow: hidden; }
    .faq-item summary { font-weight: 900; font-size: 1.1rem; padding: 20px; cursor: pointer; color: var(--dark); list-style-type: none; position: relative; }
    .faq-item summary::after { content: '+'; position: absolute; right: 24px; font-weight: bold; font-size: 1.4rem; color: var(--primary); }
    .faq-item[open] summary::after { content: '−'; }
    .faq-item p { padding: 0 20px 20px; margin: 0; font-size: 1rem; color: var(--slate); line-height: 1.6; }

    .mt-48 { margin-top: 48px; }
    .mt-32 { margin-top: 32px; }
    .mb-24 { margin-bottom: 24px; }
</style>
