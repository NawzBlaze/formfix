---
import BaseLayout from '../components/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import ToolWrapper from '../components/ToolWrapper.astro';

const PAGE_TITLE = 'Extract PDF to JPG/PNG Online - PDF to Image Converter | FormFix';
const PAGE_DESC = 'Convert PDF documents to high-quality JPG or PNG images instantly. Free, 100% private, and entirely client-side. Extract every page as a sharp photo.';
const PAGE_KEYWORDS = 'pdf to image online, extract pdf to jpg, convert pdf pages to png, private pdf extractor, high res pdf to image';

const customSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      "name": "PDF to Image Extractor",
      "operatingSystem": "All",
      "applicationCategory": "UtilitiesApplication",
      "description": "Convert PDF pages into high-resolution JPG or PNG images locally in your browser.",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      }
    }
  ]
};
---

<BaseLayout title={PAGE_TITLE} description={PAGE_DESC} keywords={PAGE_KEYWORDS} customSchema={customSchema} active="tools" canonicalPath="/pdf-to-image">
    <script>
    import JSZip from 'jszip';

    // Lazy-load pdfjs-dist only when user actually uses the tool
    let pdfjsLib: any = null;

    async function loadPdfJs() {
        if (pdfjsLib) return pdfjsLib;
        const mod = await import('pdfjs-dist');
        pdfjsLib = mod;
        pdfjsLib.GlobalWorkerOptions.workerSrc = new URL('pdfjs-dist/build/pdf.worker.min.mjs', import.meta.url).href;
        return pdfjsLib;
    }

    document.addEventListener('DOMContentLoaded', () => {
        const fileInput = document.getElementById('pdf-input');
        const controls = document.getElementById('controls');
        const uploadBox = document.getElementById('u-box-container');
        const extractBtn = document.getElementById('extract-btn');
        const loader = document.getElementById('loader');
        const btnLabel = document.getElementById('btn-label');
        const settingPills = document.querySelectorAll('.setting-pill');
        const extractedGrid = document.getElementById('extracted-grid');
        const zipBtn = document.getElementById('download-zip');
        const resultStage = document.getElementById('result-stage');

        let pdfDoc = null;
        let outFormat = 'jpeg';
        let extractedImages = [];

        fileInput?.addEventListener('change', async (e) => {
             const file = e.target.files?.[0];
             if (file && file.type === 'application/pdf') {
                 handlePdf(file);
             }
        });

        async function handlePdf(file) {
             // Lazy-load pdfjs-dist on first use (~500KB savings on initial page load)
             if (btnLabel) btnLabel.textContent = 'Loading PDF engine...';
             const lib = await loadPdfJs();
             const arrayBuffer = await file.arrayBuffer();
             pdfDoc = await lib.getDocument(arrayBuffer).promise;

             if (btnLabel) btnLabel.textContent = `Extract ${pdfDoc.numPages} Pages`;
             uploadBox?.classList.add('hidden');
             controls?.classList.remove('hidden');
        }

        settingPills.forEach(pill => pill.addEventListener('click', () => {
            settingPills.forEach(p => p.classList.remove('active'));
            pill.classList.add('active');
            outFormat = pill.dataset.fmt || 'jpeg';
        }));

        extractBtn?.addEventListener('click', async () => {
             if (!pdfDoc) return;
             extractBtn.disabled = true;
             if (btnLabel) btnLabel.textContent = 'Rendering...';
             loader?.classList.remove('hidden');
             extractedGrid.innerHTML = '';
             extractedImages = [];

             try {
                 for (let i = 1; i <= pdfDoc.numPages; i++) {
                     const page = await pdfDoc.getPage(i);
                     const viewport = page.getViewport({ scale: 2.0 });
                     
                     const canvas = document.createElement('canvas');
                     const ctx = canvas.getContext('2d');
                     canvas.width = viewport.width;
                     canvas.height = viewport.height;

                     await page.render({ canvasContext: ctx, viewport, canvas: canvas }).promise;

                     const mime = outFormat === 'jpeg' ? 'image/jpeg' : 'image/png';
                     const blob = await new Promise(res => canvas.toBlob(b => res(b), mime, 0.9));
                     const url = URL.createObjectURL(blob);
                     
                     extractedImages.push({ url, blob, pageNum: i });

                     const item = document.createElement('div');
                     item.className = 'extracted-item shadow-sm';
                     item.innerHTML = `
                         <span class="page-badge">Pg ${i}</span>
                         <img src="${url}" alt="PDF Page ${i} Image Preview" loading="lazy" decoding="async" />
                         <a href="${url}" download="page-${i}.${outFormat}" class="mini-dl-btn">Download</a>
                     `;
                     extractedGrid?.appendChild(item);
                 }

                 controls?.classList.add('hidden');
                 resultStage?.classList.remove('hidden');
                 if (window.triggerConfetti) window.triggerConfetti();

             } catch (err) {
                 console.error(err);
                 if (typeof window.ffNotice === 'function') window.ffNotice('Extraction failed. The PDF may be corrupted or protected.', 'error');
                 controls?.classList.remove('hidden');
                 resultStage?.classList.add('hidden');
             } finally {
                 extractBtn.disabled = false;
                 if (btnLabel) btnLabel.textContent = `Extract All Pages`;
                 loader?.classList.add('hidden');
             }
        });

        zipBtn?.addEventListener('click', async () => {
            if (extractedImages.length === 0) return;
            const originalText = zipBtn.textContent;
            zipBtn.textContent = 'Zipping...';
            
            try {
                const zip = new JSZip();
                const folder = zip.folder("pdf_pages");
                const ext = outFormat === 'jpeg' ? 'jpg' : 'png';
                
                extractedImages.forEach(img => {
                    folder.file(`page-${img.pageNum}.${ext}`, img.blob);
                });

                const content = await zip.generateAsync({ type: 'blob' });
                const url = URL.createObjectURL(content);
                const a = document.createElement('a');
                a.href = url;
                a.download = `extracted_pages.zip`;
                a.click();
            } catch (err) {
                console.error(err);
            } finally {
                zipBtn.textContent = originalText;
            }
        });
    });
</script>

    <Breadcrumb items={[{ name: 'Home', path: '/' }, { name: "Extract PDF to JPG/PNG Online - PDF to Image Converter", path: "/pdf-to-image" }]} />

    <ToolWrapper title="PDF to Image" subtitle="Extract every page of your PDF into high-quality JPEG or PNG images instantly." currentTool="pdf-to-image">
        
        <div slot="tool-ui">
             <div class="workspace-editor">
                  <!-- 1. Selection Step -->
                  <div id="u-box-container" class="upload-container">
                       <div class="upload-box shadow-sm" id="drop-zone" onclick="document.getElementById('pdf-input').click()">
                            <input type="file" id="pdf-input" class="hidden" accept=".pdf" />
                            <div class="upload-content">
                                 <div class="upload-icon">📄</div>
                                 <h3 class="font-850 m-0 mb-8">Select PDF Document</h3>
                                 <p class="text-muted m-0 mb-24 font-600">Extract pages to high-res JPG or PNG. 100% Secure.</p>
                                 <button class="primary-btn px-40">Browse Files</button>
                            </div>
                       </div>
                  </div>

                  <!-- 2. Workspace Step -->
                  <div id="controls" class="hidden">
                       <div class="settings-grid mb-24 shadow-sm">
                            <div class="section m-0">
                                 <label class="section-label m-0 mb-12">1. Preferred Format</label>
                                 <div class="toggle-pill-group">
                                      <button class="setting-pill active" data-fmt="jpeg">JPEG (Fast)</button>
                                      <button class="setting-pill" data-fmt="png">PNG (HD)</button>
                                 </div>
                            </div>
                            
                            <div class="section m-0 d-flex align-end">
                                 <button id="extract-btn" class="primary-btn wide-btn pulse-glow lg-btn">
                                      <span id="btn-label">Extract Pages</span>
                                      <div id="loader" class="mini-spinner hidden"></div>
                                 </button>
                            </div>
                       </div>
                       <p class="privacy-tiny text-center mt-12">🔒 Processing happens locally in your browser memory.</p>
                  </div>

                  <!-- 3. Result Stage -->
                  <div id="result-stage" class="hidden mt-32">
                       <div class="result-card shadow-sm">
                            <div class="success-banner mb-32">
                                 <div class="check-icon">✔</div>
                                 <div class="success-info">
                                      <h4 class="font-850 m-0 mb-8">Extraction Success</h4>
                                      <p class="text-muted m-0 small font-600">Every page has been rendered in high resolution.</p>
                                 </div>
                            </div>
                            
                            <div class="thumbnail-grid scroll-container mb-32" id="extracted-grid">
                                 <!-- Injected by JS -->
                            </div>

                            <div class="d-flex gap-16 wrap-mobile">
                                 <button id="download-zip" class="primary-btn flex-2 wide-btn">⬇️ Download All as ZIP</button>
                                 <button class="secondary-btn flex-1 wide-btn" onclick="location.reload()">↺ Start New</button>
                            </div>
                       </div>
                  </div>
             </div>
        </div>

        <div slot="tool-info">
             <div class="pro-article">
                 <h2>High-Resolution PDF Extraction</h2>
                 <p>Our <strong>PDF to Image converter</strong> uses a powerful local rendering engine to turn your document pages into sharp photos. We extract at 2.0x resolution (approx 150-300 DPI) by default, ensuring all text remains perfectly crisp.</p>
                 
                 <div class="faq-grid mt-32">
                      <details class="faq-item">
                           <summary>Is there a page limit?</summary>
                           <div class="ans">No. You can convert PDFs with any number of pages. The processing speed depends on your device's hardware, as everything happens in your local CPU/RAM.</div>
                      </details>
                      <details class="faq-item">
                           <summary>How do I download individual pages?</summary>
                           <div class="ans">After extraction, click the "Download" button on any specific thumbnail in the grid to save that single page instantly.</div>
                      </details>
                 </div>
             </div>
        </div>
    </ToolWrapper>
</BaseLayout><style>
    .workspace-editor { display: flex; flex-direction: column; width: 100%; }
    
    .upload-box { background: var(--surface-50); border: 2.5px dashed var(--border-subtle); border-radius: 32px; padding: 60px 40px; text-align: center; width: 100%; cursor: pointer; transition: 0.2s; box-sizing: border-box; }
    .upload-box:hover { border-color: var(--accent-primary); background: var(--surface-100); }
    .upload-icon { font-size: 3.5rem; margin-bottom: 24px; line-height: 1; }

    .settings-grid { display: grid; grid-template-columns: 1.2fr 1fr; gap: 24px; padding: 24px; background: var(--surface-50); border-radius: 24px; border: 1px solid var(--border-subtle); align-items: end; }
    .section-label { font-size: 0.75rem; font-weight:600; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em; display: block; }
    
    .toggle-pill-group { display: flex; background: var(--border-subtle); padding: 6px; border-radius: 12px; gap: 4px; }
    .setting-pill { flex: 1; padding: 10px 16px; border-radius: 10px; font-weight:600; font-size: 0.85rem; background: transparent; border: none; cursor: pointer; transition: 0.2s; color: var(--text-muted); text-align: center; }
    .setting-pill.active { background:var(--surface-3); color: var(--accent-primary); box-shadow: var(--shadow-sm); }

    .lg-btn { width: 100%; height: 60px; font-size: 1.1rem; border-radius: 16px; display: flex; align-items: center; justify-content: center; gap: 12px; border: none; cursor: pointer; }
    .privacy-tiny { font-size: 0.75rem; color: var(--text-muted); font-weight: 600; }

    /* Result Stage */
    .result-card { background:var(--surface-3); border: 1px solid var(--border-subtle); border-radius: 32px; padding: 40px; }
    .success-banner { display: flex; align-items: center; gap: 16px; background: var(--surface-50); border: 1px solid var(--border-subtle); padding: 20px; border-radius: 20px; }
    .check-icon { width: 40px; height: 40px; background: var(--accent-primary); color: #fff; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 1.25rem; font-weight:600; }
    
    .thumbnail-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: 16px; background: var(--surface-50); padding: 20px; border-radius: 20px; border: 1px solid var(--border-subtle); max-height: 500px; overflow-y: auto; }
    .extracted-item { background:var(--surface-3); border: 1px solid var(--border-subtle); border-radius: 12px; overflow: hidden; position: relative; }
    .extracted-item img { width: 100%; height: 200px; object-fit: cover; }
    .page-badge { position: absolute; top: 8px; left: 8px; background: rgba(0,0,0,0.8); color: #fff; padding: 2px 8px; border-radius: 6px; font-size: 0.65rem; font-weight:600; }
    .mini-dl-btn { text-decoration: none; display: block; text-align: center; padding: 10px; background:var(--surface-3); color: var(--accent-primary); font-weight:600; font-size: 0.75rem; border-top: 1px solid var(--border-subtle); }
    .mini-dl-btn:hover { background: var(--accent-primary); color: #fff; }

    .faq-grid { display: grid; gap: 16px; }
    .faq-item { background:var(--surface-3); border: 1px solid var(--border-subtle); border-radius: var(--radius-sm); overflow: hidden; }
    .faq-item summary { font-weight:600; font-size: 1rem; padding: 16px 20px; cursor: pointer; list-style: none; position: relative; }
    .faq-item summary::after { content: '+'; position: absolute; right: 20px; color: var(--accent-primary); }
    .ans { padding: 0 20px 20px; color: var(--text-muted); font-size: 0.95rem; }

    .mini-spinner { width: 18px; height: 18px; border: 3px solid rgba(255,255,255,0.3); border-top-color: #fff; border-radius: 50%; animation: spin 0.8s linear infinite; }
    @keyframes spin { to { transform: rotate(360deg); } }

    .wide-btn { height: 60px; font-weight:600; border-radius: 16px; }
    .d-flex { display: flex; }
    .justify-between { justify-content: space-between; }
    .align-end { align-items: flex-end; }
    .gap-16 { gap: 16px; }
    .flex-1 { flex: 1; }
    .flex-2 { flex: 2; }
    .hidden { display: none !important; }

    @media (max-width: 900px) {
        .settings-grid { grid-template-columns: 1fr; }
        .wrap-mobile { flex-direction: column; }
    }
</style>
