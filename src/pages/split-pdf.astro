---
import BaseLayout from '../components/BaseLayout.astro';
import RelatedTools from '../components/RelatedTools.astro';

const PAGE_TITLE = 'Split PDF Online - Extract Pages from PDF for Free';
const PAGE_DESC = 'Easily extract specific pages from your PDF document or split it into multiple files. 100% free, private, and works locally in your browser without uploads.';
const PAGE_KEYWORDS = 'split pdf, extract pdf pages, burst pdf, separate pdf pages online, free pdf splitter, private pdf split';

const customSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      "name": "FormFix Pro PDF Splitter",
      "operatingSystem": "All",
      "applicationCategory": "UtilitiesApplication",
      "description": "Extract specific pages from any PDF document quickly and securely in your browser.",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      }
    }
  ]
};
---

<BaseLayout title={PAGE_TITLE} description={PAGE_DESC} keywords={PAGE_KEYWORDS} customSchema={customSchema} active="tools" canonicalPath="/split-pdf">
    <div class="tool-wrapper animate-in">
        <header class="tool-intro text-center">
             <div class="brand-badge shadow-sm">✂️ PDF Splitter Engine</div>
             <h1 class="main-h1">Split & <span class="highlight">Extract PDF</span></h1>
             <p class="hero-sub">Select pages you want to keep and instantly create a new PDF. 100% private.</p>
        </header>

        <div class="glass-card tool-content shadow-lg max-w-lg mx-auto" id="main-card">
            
            <div id="upload-stage" class="upload-container shadow-sm">
                 <div class="upload-circle mb-16"><span class="u-icon pulse-glow">✂️</span></div>
                 <h3 class="u-title">Select PDF to Split</h3>
                 <p class="u-sub">Load any PDF to extract specific pages.</p>
                 <button class="primary-btn wide-btn profile-btn pulse-glow" onclick="document.getElementById('pdf-upload').click()">Browse PDF</button>
                 <input type="file" id="pdf-upload" class="hidden" accept="application/pdf" />
            </div>

            <div id="loading-stage" class="hidden text-center py-48">
                 <div class="mini-spinner mt-24 mb-16" style="margin: 0 auto; width: 40px; height: 40px;"></div>
                 <p class="font-bold text-lg text-slate">Reading Document...</p>
            </div>

            <div id="editor-stage" class="hidden">
                 
                 <div class="info-banner mb-24 shadow-sm">
                     <span class="f-icon">📜</span>
                     <div class="f-text">
                         <span class="f-name" id="doc-name">document.pdf</span>
                         <span class="f-size" id="doc-pages">1 Page loaded</span>
                     </div>
                 </div>
                 
                 <p class="hint-text text-center mb-16">Click on pages below to select or deselect them. The highlighted pages will be extracted.</p>

                 <!-- Pages Selection Grid -->
                 <div id="pages-grid" class="pages-grid mb-24">
                      <!-- Rendered Pages go here -->
                 </div>
                 
                 <div class="selection-controls mb-24">
                      <button id="select-all-btn" class="secondary-btn text-sm">Select All</button>
                      <button id="clear-all-btn" class="secondary-btn text-sm">Clear Selection</button>
                 </div>
                 
                 <div class="d-flex gap-16 wrap-mobile">
                      <button id="reset-btn" class="secondary-btn wide-btn-half profile-btn">🗑️ Start Over</button>
                      <button id="extract-btn" class="primary-btn wide-btn profile-btn pulse-glow" style="flex:1;">⬇️ Extract Selected Pages</button>
                 </div>
            </div>

        </div>

        <article class="pro-seo-article container mt-48">
             <h2>The Fastest Way to Extract PDF Pages</h2>
             <p>Need just one or two pages from a massive PDF report? Our <strong>Free PDF Splitter</strong> allows you to visually select exactly the pages you need and extract them into a brand new document instantly. The best part? It uses a revolutionary client-side engine meaning your sensitive documents are <strong>never uploaded to a server</strong>. The processing happens instantly right within your computer's RAM.</p>
             
             <h3 class="mt-32">Data Privacy Guaranteed</h3>
             <ul style="color:var(--slate); line-height:1.8; margin-left:20px; font-size:1.1rem">
                <li><strong>No Server Uploads:</strong> Absolutely no risk of data theft. Your files never leave your browser for extraction.</li>
                <li><strong>Retains Quality:</strong> Fixing your documents does not alter text or blurry images. We strictly extract the original vectors to retain a crisp 100% quality.</li>
             </ul>
        </article>

        <RelatedTools currentTool="split-pdf" />
    </div>
</BaseLayout>

<script>
    import { PDFDocument } from 'pdf-lib';
    import * as pdfjsLib from 'pdfjs-dist';

    // Set worker
    pdfjsLib.GlobalWorkerOptions.workerSrc = `https://cdnjs.cloudflare.com/ajax/libs/pdf.js/${pdfjsLib.version}/pdf.worker.min.mjs`;

    document.addEventListener('DOMContentLoaded', () => {
        const fileInput = document.getElementById('pdf-upload') as HTMLInputElement;
        const uploadStage = document.getElementById('upload-stage') as HTMLElement;
        const loadingStage = document.getElementById('loading-stage') as HTMLElement;
        const editorStage = document.getElementById('editor-stage') as HTMLElement;
        const extractBtn = document.getElementById('extract-btn') as HTMLButtonElement;
        const resetBtn = document.getElementById('reset-btn') as HTMLButtonElement;
        const mainCard = document.getElementById('main-card') as HTMLElement;
        
        const docName = document.getElementById('doc-name') as HTMLElement;
        const docPages = document.getElementById('doc-pages') as HTMLElement;
        const pagesGrid = document.getElementById('pages-grid') as HTMLElement;
        const selectAllBtn = document.getElementById('select-all-btn') as HTMLElement;
        const clearAllBtn = document.getElementById('clear-all-btn') as HTMLElement;

        let pdfBytesOriginal: ArrayBuffer | null = null;
        let fileName = 'document.pdf';
        let totalPagesNum = 0;
        let selectedIndices = new Set<number>(); // 0-indexed

        fileInput.addEventListener('change', async (e: any) => {
            const file = e.target.files[0];
            if(!file || file.type !== 'application/pdf') return;
            fileName = file.name;
            
            docName.textContent = fileName;
            uploadStage.classList.add('hidden');
            loadingStage.classList.remove('hidden');
            
            try {
                pdfBytesOriginal = await file.arrayBuffer();
                const loadingTask = pdfjsLib.getDocument({ data: new Uint8Array(pdfBytesOriginal) });
                const pdf = await loadingTask.promise;
                
                totalPagesNum = pdf.numPages;
                docPages.textContent = `${totalPagesNum} Pages loaded`;
                
                pagesGrid.innerHTML = '';
                selectedIndices.clear();

                for (let i = 1; i <= totalPagesNum; i++) {
                    const page = await pdf.getPage(i);
                    const viewport = page.getViewport({ scale: 0.4 });
                    const canvas = document.createElement('canvas');
                    const ctx = canvas.getContext('2d')!;
                    canvas.width = viewport.width;
                    canvas.height = viewport.height;
                    
                    await page.render({ canvasContext: ctx, viewport: viewport }).promise;
                    
                    // Select by default
                    selectedIndices.add(i - 1);
                    
                    const item = document.createElement('div');
                    item.className = 'page-thumbnail selected shadow-sm';
                    item.dataset.index = (i - 1).toString();
                    item.innerHTML = `
                         <img src="${canvas.toDataURL()}" />
                         <label class="p-num">Page ${i}</label>
                         <div class="sel-overlay"></div>
                         <div class="sel-tick">✔</div>
                    `;
                    
                    item.addEventListener('click', () => {
                         const idx = parseInt(item.dataset.index!);
                         if (selectedIndices.has(idx)) {
                             selectedIndices.delete(idx);
                             item.classList.remove('selected');
                         } else {
                             selectedIndices.add(idx);
                             item.classList.add('selected');
                         }
                         updateExtractBtn();
                    });
                    
                    pagesGrid.appendChild(item);
                }
                
                loadingStage.classList.add('hidden');
                editorStage.classList.remove('hidden');
                mainCard.classList.remove('max-w-lg');
                mainCard.classList.add('max-w-xl');
                updateExtractBtn();

            } catch(err) {
                console.error(err);
                alert("Could not load PDF. It might be encrypted or corrupted.");
                loadingStage.classList.add('hidden');
                uploadStage.classList.remove('hidden');
            }
        });
        
        selectAllBtn.addEventListener('click', () => {
             selectedIndices.clear();
             const thumbs = pagesGrid.querySelectorAll('.page-thumbnail');
             thumbs.forEach((thumb, idx) => {
                 selectedIndices.add(idx);
                 thumb.classList.add('selected');
             });
             updateExtractBtn();
        });

        clearAllBtn.addEventListener('click', () => {
             selectedIndices.clear();
             const thumbs = pagesGrid.querySelectorAll('.page-thumbnail');
             thumbs.forEach((thumb, idx) => {
                 thumb.classList.remove('selected');
             });
             updateExtractBtn();
        });

        function updateExtractBtn() {
            if (selectedIndices.size === 0) {
                 extractBtn.disabled = true;
                 extractBtn.textContent = 'Select at least 1 page';
                 extractBtn.style.opacity = '0.5';
            } else {
                 extractBtn.disabled = false;
                 extractBtn.innerHTML = `⬇️ Extract ${selectedIndices.size} Pages`;
                 extractBtn.style.opacity = '1';
            }
        }

        resetBtn.addEventListener('click', () => {
            pdfBytesOriginal = null;
            fileInput.value = '';
            uploadStage.classList.remove('hidden');
            editorStage.classList.add('hidden');
            mainCard.classList.add('max-w-lg');
            mainCard.classList.remove('max-w-xl');
        });

        extractBtn.addEventListener('click', async () => {
            if (!pdfBytesOriginal || selectedIndices.size === 0) return;

            extractBtn.textContent = '⏳ Extracting...';
            extractBtn.style.pointerEvents = 'none';

            try {
                const sourcePdf = await PDFDocument.load(pdfBytesOriginal.slice(0));
                const newPdf = await PDFDocument.create();
                
                const sortedIndices = Array.from(selectedIndices).sort((a,b) => a - b);
                const copiedPages = await newPdf.copyPages(sourcePdf, sortedIndices);
                copiedPages.forEach((page) => newPdf.addPage(page));

                const modifiedPdfBytes = await newPdf.save();
                const blob = new Blob([modifiedPdfBytes], { type: 'application/pdf' });
                const url = URL.createObjectURL(blob);
                
                const link = document.createElement('a');
                link.download = fileName.replace('.pdf', '') + '_extracted.pdf';
                link.href = url;
                link.click();
            } catch (err) {
                 console.error(err);
                 alert('Error generating the split document.');
            } finally {
                 updateExtractBtn();
                 extractBtn.style.pointerEvents = 'all';
            }
        });
    });
</script>

<style>
    .main-h1 { font-size: 3.5rem; font-weight: 1000; letter-spacing: -0.05em; margin-bottom: 12px; color: var(--dark); line-height: 1.1; }
    .hero-sub { color: var(--slate); font-weight: 600; font-size: 1.25rem; margin-bottom: 24px; }
    .tool-wrapper { max-width: 960px; margin: 0 auto; padding-bottom: 100px; }
    .max-w-lg { max-width: 550px; margin-inline: auto;transition: max-width 0.4s;}
    .max-w-xl { max-width: 850px; margin-inline: auto;transition: max-width 0.4s;}
    
    .upload-container { background: #f8fafc; border: 2.5px dashed var(--border); border-radius: 32px; padding: 60px 20px; text-align: center; cursor: pointer; transition: 0.3s; margin-top:16px; min-height: 380px; display: flex; flex-direction: column; align-items: center; justify-content: center; }
    .upload-container:hover { border-color: var(--primary); background: #f0fdf4; transform: translateY(-4px); }
    .upload-circle { width: 90px; height: 90px; background: #fff; border-radius: 50%; box-shadow: 0 10px 25px rgba(0,0,0,0.05); display: flex; align-items: center; justify-content: center; margin: 0 auto 20px; font-size: 3rem; }
    .u-title { font-size: 1.8rem; font-weight: 1000; color: var(--dark); margin-bottom: 8px; }
    .u-sub { font-size: 1.1rem; color: var(--slate); font-weight: 600; margin-bottom: 32px; }

    #editor-stage { background: #fff; padding: 24px; border-radius: 24px; border: 1.5px solid var(--border); }
    
    .pages-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(130px, 1fr)); gap: 16px; max-height: 400px; overflow-y: auto; padding: 12px; border: 1px solid var(--border); border-radius: 12px; background: #f8fafc; }
    
    .page-thumbnail { position: relative; background: #fff; border-radius: 8px; overflow: hidden; cursor: pointer; border: 3px solid transparent; transition: 0.2s; }
    .page-thumbnail img { width: 100%; height: 160px; object-fit: contain; padding: 4px; background: white;}
    .page-thumbnail:hover { transform: scale(1.02); }
    .page-thumbnail .p-num { position: absolute; bottom: 0; left: 0; right: 0; background: rgba(0,0,0,0.7); color: white; text-align: center; font-size: 0.8rem; padding: 4px; font-weight: 700; }
    
    .sel-overlay { position: absolute; top:0; left:0; right:0; bottom:0; background: rgba(59, 130, 246, 0.2); opacity: 0; transition: 0.2s; }
    .sel-tick { position: absolute; top: 8px; right: 8px; background: var(--primary); color: white; width: 24px; height: 24px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 0.9rem; font-weight: 900; opacity: 0; transform: scale(0.5); transition: 0.2s; }
    
    .page-thumbnail.selected { border-color: var(--primary); }
    .page-thumbnail.selected .sel-overlay { opacity: 1; }
    .page-thumbnail.selected .sel-tick { opacity: 1; transform: scale(1); }

    .selection-controls { display: flex; gap: 12px; justify-content: flex-end; }
    .text-sm { font-size: 0.9rem; padding: 8px 16px; min-width: unset; height: auto; }

    .info-banner { display: flex; align-items: center; gap: 16px; padding: 20px; background: #fff; border: 1.5px solid var(--border); border-radius: 16px; }
    .f-icon { font-size: 2.5rem; }
    .f-text { display: flex; flex-direction: column; overflow: hidden; }
    .f-name { font-weight: 900; color: var(--dark); font-size: 1.25rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 300px; }
    .f-size { color: var(--primary); font-size: 1rem; font-weight: 700; margin-top:4px; }

    .d-flex { display: flex; }
    .text-center { text-align: center; }
    .text-lg { font-size: 1.1rem; }
    
    .mb-16 { margin-bottom: 16px; }
    .mb-24 { margin-bottom: 24px; }
    .mt-32 { margin-top: 32px; }
    .mt-48 { margin-top: 48px; }
    .gap-16 { gap: 16px; }
    .py-48 { padding: 48px 0; }
    
    .wide-btn { padding: 22px 24px; font-weight: 1000; font-size: 1.25rem; border-radius: 100px; display: block; }
    .wide-btn-half { padding: 18px 24px; font-weight: 900; border-radius: 100px; flex: 1; border: 2px solid var(--border); background: #fff; }
    
    .hidden { display: none !important; }

    @media (max-width: 640px) {
        .wrap-mobile { flex-direction: column; }
        .wide-btn, .wide-btn-half { width: 100%; }
        .f-name { max-width: 200px; }
        .pages-grid { max-height: 250px; }
    }
</style>
