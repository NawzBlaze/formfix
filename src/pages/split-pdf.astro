---
import BaseLayout from '../components/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import ToolWrapper from '../components/ToolWrapper.astro';

const PAGE_TITLE = 'Split PDF Online - Extract Pages from PDF for Free | FormFix';
const PAGE_DESC = 'Easily extract specific pages from your PDF document or split it into multiple files. 100% free, private, and works locally in your browser without uploads.';
const PAGE_KEYWORDS = 'split pdf, extract pdf pages, burst pdf, separate pdf pages online, free pdf splitter, private pdf split';

const customSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      "name": "FormFix Pro PDF Splitter",
      "operatingSystem": "All",
      "applicationCategory": "UtilitiesApplication",
      "description": "Extract specific pages from any PDF document quickly and securely in your browser.",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      }
    }
  ]
};

const faqs = [
  { q: "Will the extracted PDF be lower quality?", a: "Absolutely not. We extract the original page data directly from the source PDF. This preserves all text vectors, images, and fonts at the original 100% resolution." },
  { q: "Can I extract multiple non-sequential pages?", a: "Yes. You can click on any individual pages across the entire document. Our tool will bundle all selected pages into a single new PDF document in the order they appear." },
];
---

<BaseLayout title={PAGE_TITLE} description={PAGE_DESC} keywords={PAGE_KEYWORDS} customSchema={customSchema} active="pdf" canonicalPath="/split-pdf" faq={faqs}>
    <Breadcrumb items={[{ name: 'Home', path: '/' }, { name: "Split PDF Online - Extract Pages from PDF for Free", path: "/split-pdf" }]} />

    <script type="module">
    import * as pdfjsLib from 'pdfjs-dist';
    import { PDFDocument } from 'pdf-lib';
    pdfjsLib.GlobalWorkerOptions.workerSrc = new URL('pdfjs-dist/build/pdf.worker.min.mjs', import.meta.url).href;
    window.pdfjsLib = pdfjsLib;
    window.PDFLib = { PDFDocument };
    </script>

    <ToolWrapper title="Split PDF Files" subtitle="Extract specific pages from any PDF document quickly and securely." currentTool="split-pdf">
        
        <div slot="tool-ui">
             <div class="workspace-editor">
                  <!-- 1. Selection Step -->
                  <div id="upload-stage" class="upload-zone show">
                       <div class="upload-icon-circle">✂️</div>
                       <h3 class="zone-title">Select PDF to Split</h3>
                       <p class="zone-sub">Upload document to extract or remove pages</p>
                       <button class="primary-btn px-32" onclick="document.getElementById('pdf-upload').click()">Browse PDF File</button>
                   <input type="file" id="pdf-upload" class="hidden" accept="application/pdf" />
               </div>

               <!-- 1b. Loading Step -->
               <div id="loading-stage" class="hidden" style="text-align:center;padding:60px 20px;">
                    <div class="upload-icon-circle" style="animation:pulse 1.5s infinite;">⏳</div>
                    <h3 class="zone-title">Processing PDF...</h3>
                    <p class="zone-sub">Please wait while we load your document</p>
               </div>

               <!-- 2. Workspace Step -->
                  <div id="editor-stage" class="hidden">
                       <div class="workspace-layout">
                            <div class="selection-grid-area">
                                 <div class="grid-header mb-16">
                                      <div class="d-flex align-center gap-12">
                                           <h4 class="m-0 font-800">Select Pages</h4>
                                           <span id="select-count" class="status-pill inverse">0 Selected</span>
                                      </div>
                                      <div class="bulk-actions">
                                           <button id="select-all" class="text-link">Select All</button>
                                           <span class="sep">|</span>
                                           <button id="clear-all" class="text-link">Clear</button>
                                      </div>
                                 </div>
                                 
                                 <div id="pages-grid" class="pages-grid scroll-container shadow-inner">
                                      <!-- Injected by JS -->
                                 </div>
                            </div>

                            <div class="sidebar-controls">
                                 <div class="settings-card shadow-sm mb-24">
                                      <label class="section-label mb-16">File Metadata</label>
                                      <div class="info-pill mb-24">
                                           <span id="doc-name" class="name">document.pdf</span>
                                           <span class="sep">|</span>
                                           <span id="doc-pages" class="count">0 Pages</span>
                                      </div>
                                      
                                      <button id="extract-btn" class="primary-btn wide-btn pulse-glow">Extract Selected Pages</button>
                                 </div>
                                 <div class="action-footer vertical">
                                      <button class="secondary-btn wide-btn" onclick="location.reload()">↺ Change File</button>
                                 </div>
                                 <p class="privacy-note text-center mt-16 font-600">🔒 100% Client-side processing.</p>
                            </div>
                       </div>
                  </div>
             </div>
        </div>

        <div slot="tool-info">
             <h2>The Fastest Way to Extract PDF Pages</h2>
             <p>Need just one or two pages from a massive PDF report? Our <strong>Free PDF Splitter</strong> allows you to visually select exactly the pages you need and extract them into a brand new document instantly. The best part? It uses a revolutionary client-side engine meaning your sensitive documents are <strong>never uploaded to a server</strong>.</p>
             
             <div class="faq-grid mt-32">
                  <details class="faq-item">
                       <summary>Will the extracted PDF be lower quality?</summary>
                       <p>Absolutely not. We extract the original page data directly from the source PDF. This preserves all text vectors, images, and fonts at the original 100% resolution.</p>
                  </details>
                  <details class="faq-item">
                       <summary>Can I extract multiple non-sequential pages?</summary>
                       <p>Yes. You can click on any individual pages across the entire document. Our tool will bundle all selected pages into a single new PDF document in the order they appear.</p>
                  </details>
             </div>
        </div>
    </ToolWrapper>

<script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
        try {
            const fileInput = document.getElementById('pdf-upload');
            const uploadStage = document.getElementById('upload-stage');
            const loadingStage = document.getElementById('loading-stage');
            const editorStage = document.getElementById('editor-stage');
            const extractBtn = document.getElementById('extract-btn');
            const resetBtn = document.querySelector('#editor-stage .secondary-btn');
            const mainCard = document.querySelector('.tool-card');
            
            const docName = document.getElementById('doc-name');
            const docPages = document.getElementById('doc-pages');
            const pagesGrid = document.getElementById('pages-grid');
            const selectAllBtn = document.getElementById('select-all');
            const clearAllBtn = document.getElementById('clear-all');

            let pdfBytesOriginal = null;
            let fileName = 'document.pdf';
            let totalPagesNum = 0;
            let selectedIndices = new Set();

            if (uploadStage) {
                uploadStage.addEventListener('dragover', (e) => { e.preventDefault(); uploadStage.classList.add('drag-active'); });
                uploadStage.addEventListener('dragleave', () => uploadStage.classList.remove('drag-active'));
                uploadStage.addEventListener('drop', (e) => {
                    e.preventDefault();
                    uploadStage.classList.remove('drag-active');
                    if (e.dataTransfer?.files.length) {
                        const fileInput = document.getElementById('pdf-upload');
                        if (fileInput) {
                            fileInput.files = e.dataTransfer.files;
                            fileInput.dispatchEvent(new Event('change'));
                        }
                    }
                });
            }

            function waitForGlobals() {
                return new Promise((resolve, reject) => {
                    let attempts = 0;
                    const maxAttempts = 50;
                    const interval = setInterval(() => {
                        if (window.pdfjsLib && window.PDFLib && window.PDFLib.PDFDocument) {
                            clearInterval(interval);
                            resolve();
                        } else if (++attempts >= maxAttempts) {
                            clearInterval(interval);
                            reject(new Error('PDF libraries failed to load. Please refresh the page.'));
                        }
                    }, 100);
                });
            }

            fileInput?.addEventListener('change', async (e) => {
                const file = e.target.files[0];
                if (!file || file.type !== 'application/pdf') return;
                fileName = file.name;

                if (docName) docName.textContent = fileName;
                uploadStage?.classList.add('hidden');
                loadingStage?.classList.remove('hidden');

                try {
                    await waitForGlobals();

                    pdfBytesOriginal = await file.arrayBuffer();
                    const loadingTask = window.pdfjsLib.getDocument({ data: new Uint8Array(pdfBytesOriginal) });
                    const pdf = await loadingTask.promise;

                    totalPagesNum = pdf.numPages;
                    if (docPages) docPages.textContent = `${totalPagesNum} Pages loaded`;

                    if (pagesGrid) pagesGrid.innerHTML = '';
                    selectedIndices.clear();

                    for (let i = 1; i <= totalPagesNum; i++) {
                        const page = await pdf.getPage(i);
                        const viewport = page.getViewport({ scale: 0.4 });
                        const canvas = document.createElement('canvas');
                        const ctx = canvas.getContext('2d');
                        canvas.width = viewport.width;
                        canvas.height = viewport.height;

                        await page.render({ canvasContext: ctx, viewport: viewport }).promise;

                        selectedIndices.add(i - 1);

                        const item = document.createElement('div');
                        item.className = 'page-thumbnail selected shadow-sm';
                        item.dataset.index = (i - 1).toString();
                        item.innerHTML = `
                             <img src="${canvas.toDataURL()}" alt="PDF segment thumbnail" loading="lazy" decoding="async" />
                             <label class="p-num">Page ${i}</label>
                             <div class="sel-overlay"></div>
                             <div class="sel-tick">✔</div>
                        `;

                        item.addEventListener('click', () => {
                             const idx = parseInt(item.dataset.index);
                             if (selectedIndices.has(idx)) {
                                 selectedIndices.delete(idx);
                                 item.classList.remove('selected');
                             } else {
                                 selectedIndices.add(idx);
                                 item.classList.add('selected');
                             }
                             updateExtractBtn();
                        });

                        if (pagesGrid) pagesGrid.appendChild(item);
                    }

                    loadingStage?.classList.add('hidden');
                    editorStage?.classList.remove('hidden');
                    if (mainCard) mainCard.classList.remove('max-w-lg');
                    if (mainCard) mainCard.classList.add('max-w-xl');
                    updateExtractBtn();

                } catch (err) {
                    console.error(err);
                    window.ffNotice(err.message || "Could not load PDF. It might be encrypted or corrupted.", "error");
                    loadingStage?.classList.add('hidden');
                    uploadStage?.classList.remove('hidden');
                }
            });

            selectAllBtn?.addEventListener('click', () => {
                 selectedIndices.clear();
                 const thumbs = pagesGrid?.querySelectorAll('.page-thumbnail') || [];
                 thumbs.forEach((thumb, idx) => {
                     selectedIndices.add(idx);
                     thumb.classList.add('selected');
                 });
                 updateExtractBtn();
            });

            clearAllBtn?.addEventListener('click', () => {
                 selectedIndices.clear();
                 const thumbs = pagesGrid?.querySelectorAll('.page-thumbnail') || [];
                 thumbs.forEach((thumb) => {
                     thumb.classList.remove('selected');
                 });
                 updateExtractBtn();
            });

            function updateExtractBtn() {
                if (selectedIndices.size === 0) {
                     if (extractBtn) extractBtn.disabled = true;
                     if (extractBtn) extractBtn.textContent = 'Select at least 1 page';
                     if (extractBtn) extractBtn.style.opacity = '0.5';
                } else {
                     if (extractBtn) extractBtn.disabled = false;
                     if (extractBtn) extractBtn.innerHTML = `⬇️ Extract ${selectedIndices.size} Pages`;
                     if (extractBtn) extractBtn.style.opacity = '1';
                }
            }

            resetBtn?.addEventListener('click', () => {
                pdfBytesOriginal = null;
                if (fileInput) fileInput.value = '';
                uploadStage?.classList.remove('hidden');
                loadingStage?.classList.add('hidden');
                editorStage?.classList.add('hidden');
                if (mainCard) mainCard.classList.add('max-w-lg');
                if (mainCard) mainCard.classList.remove('max-w-xl');
            });

            extractBtn?.addEventListener('click', async () => {
                if (!pdfBytesOriginal || selectedIndices.size === 0) return;

                extractBtn.textContent = '⏳ Extracting...';
                extractBtn.style.pointerEvents = 'none';

                try {
                    if (!window.PDFLib || !window.PDFLib.PDFDocument) {
                        throw new Error('PDF library not loaded. Please refresh the page.');
                    }
                    const { PDFDocument } = window.PDFLib;
                    const sourcePdf = await PDFDocument.load(pdfBytesOriginal.slice(0));
                    const newPdf = await PDFDocument.create();

                    const sortedIndices = Array.from(selectedIndices).sort((a, b) => a - b);
                    const copiedPages = await newPdf.copyPages(sourcePdf, sortedIndices);
                    copiedPages.forEach((page) => newPdf.addPage(page));

                    const modifiedPdfBytes = await newPdf.save();
                    const blob = new Blob([modifiedPdfBytes], { type: 'application/pdf' });
                    const url = URL.createObjectURL(blob);

                    const link = document.createElement('a');
                    link.download = fileName.replace('.pdf', '') + '_extracted.pdf';
                    link.href = url;
                    link.click();
                    if (window.triggerConfetti) window.triggerConfetti();
                    var shareTxt = encodeURIComponent("I just extracted pages from a PDF using FormFix! 100% private, no uploads. Try it: " + window.__SITE_URL + "/split-pdf");
                    var existing = document.getElementById('post-split-share');
                    if (!existing) {
                        var div = document.createElement('div');
                        div.id = 'post-split-share';
                        div.style.cssText = 'margin-top:20px;text-align:center;';
                        div.innerHTML = '<p style="font-weight:600;margin-bottom:10px;color:var(--success);">Love FormFix? Share it!</p><div style="display:flex;gap:8px;justify-content:center;"><a href="https://x.com/intent/tweet?text=' + shareTxt + '" target="_blank" style="padding:8px 16px;border-radius:8px;background:#000;color:#fff;text-decoration:none;font-weight:600;font-size:0.85rem;">Share on X</a><a href="https://wa.me/?text=' + shareTxt + '" target="_blank" style="padding:8px 16px;border-radius:8px;background:#25D366;color:#fff;text-decoration:none;font-weight:600;font-size:0.85rem;">WhatsApp</a></div>';
                        extractBtn?.parentElement?.appendChild(div);
                    }
                } catch (err) {
                     console.error(err);
                     window.ffNotice(err.message || 'Error generating the split document.', 'error');
                } finally {
                     updateExtractBtn();
                     if (extractBtn) extractBtn.style.pointerEvents = 'all';
                }
            });
        } catch (err) {
            console.error('Split PDF initialization error:', err);
            if (window.ffNotice) window.ffNotice('Something went wrong initializing the split tool. Please refresh.', 'error');
        }
    });
</script>

<style>
    .main-h1 { font-size: 3.5rem; font-weight:600; letter-spacing: -0.05em; margin-bottom: 12px; color: var(--text-primary); line-height: 1.1; }
    .hero-sub { color: var(--text-secondary); font-weight: 600; font-size: 1.25rem; margin-bottom: 24px; }
    .tool-wrapper { max-width: 960px; margin: 0 auto; padding-bottom: 100px; }
    .max-w-lg { max-width: 550px; margin-inline: auto;transition: max-width 0.4s;}
    .max-w-xl { max-width: 850px; margin-inline: auto;transition: max-width 0.4s;}
    
    .upload-container { background: var(--surface-2); border: 2.5px dashed var(--border); border-radius: 32px; padding: 60px 20px; text-align: center; cursor: pointer; transition: 0.3s; margin-top:16px; min-height: 380px; display: flex; flex-direction: column; align-items: center; justify-content: center; }
    .upload-container:hover { border-color: var(--accent-primary); background: var(--success-soft); transform: translateY(-4px); }
    .upload-circle { width: 90px; height: 90px; background:var(--surface-3); border-radius: 50%; box-shadow: 0 10px 25px rgba(0,0,0,0.05); display: flex; align-items: center; justify-content: center; margin: 0 auto 20px; font-size: 3rem; }
    .u-title { font-size: 1.8rem; font-weight:600; color: var(--text-primary); margin-bottom: 8px; }
    .u-sub { font-size: 1.1rem; color: var(--text-secondary); font-weight: 600; margin-bottom: 32px; }

    #editor-stage { background:var(--surface-3); padding: 24px; border-radius: 24px; border: 1.5px solid var(--border); }
    
    .workspace-layout { display: grid; grid-template-columns: 1fr 280px; gap: 24px; align-items: start; }
    .selection-grid-area { min-width: 0; }
    .sidebar-controls { display: flex; flex-direction: column; gap: 16px; }
    
    .pages-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(130px, 1fr)); gap: 16px; max-height: 400px; overflow-y: auto; padding: 12px; border: 1px solid var(--border); border-radius: 12px; background: var(--surface-2); }
    
    .page-thumbnail { position: relative; background:var(--surface-3); border-radius: 8px; overflow: hidden; cursor: pointer; border: 3px solid transparent; transition: 0.2s; }
    .page-thumbnail img { width: 100%; height: 160px; object-fit: contain; padding: 4px; background: var(--surface-3);}
    .page-thumbnail:hover { transform: scale(1.02); }
    .page-thumbnail .p-num { position: absolute; bottom: 0; left: 0; right: 0; background: rgba(0,0,0,0.75); color: white; text-align: center; font-size: 0.8rem; padding: 4px; font-weight:600; }
    
    .sel-overlay { position: absolute; top:0; left:0; right:0; bottom:0; background: rgba(59, 130, 246, 0.2); opacity: 0; transition: 0.2s; }
    .sel-tick { position: absolute; top: 8px; right: 8px; background: var(--accent-primary); color: white; width: 24px; height: 24px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 0.9rem; font-weight:600; opacity: 0; transform: scale(0.5); transition: 0.2s; }
    
    .page-thumbnail.selected { border-color: var(--accent-primary); }
    .page-thumbnail.selected .sel-overlay { opacity: 1; }
    .page-thumbnail.selected .sel-tick { opacity: 1; transform: scale(1); }

    .selection-controls { display: flex; gap: 12px; justify-content: flex-end; }
    .text-sm { font-size: 0.9rem; padding: 8px 16px; min-width: unset; height: auto; }

    .info-banner { display: flex; align-items: center; gap: 16px; padding: 20px; background:var(--surface-3); border: 1.5px solid var(--border); border-radius: 16px; }
    .f-icon { font-size: 2.5rem; }
    .f-text { display: flex; flex-direction: column; overflow: hidden; }
    .f-name { font-weight:600; color: var(--text-primary); font-size: 1.25rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 300px; }
    .f-size { color: var(--accent-primary); font-size: 1rem; font-weight:600; margin-top:4px; }

    .text-lg { font-size: 1.1rem; }
    
    .py-48 { padding: 48px 0; }
    
    .wide-btn { padding: 22px 24px; font-weight:600; font-size: 1.25rem; border-radius: 100px; display: block; }
    .wide-btn-half { padding: 18px 24px; font-weight:600; border-radius: 100px; flex: 1; border: 2px solid var(--border); background:var(--surface-3); }

    @media (max-width: 640px) {
        .workspace-layout { grid-template-columns: 1fr; gap: 16px; }
        .wrap-mobile { flex-direction: column; }
        .wide-btn, .wide-btn-half { width: 100%; }
        .f-name { max-width: 200px; }
        .pages-grid { max-height: 250px; }
    }
</style>
</BaseLayout>
