---
import BaseLayout from '../components/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import ToolWrapper from '../components/ToolWrapper.astro';

const PAGE_TITLE = 'Passport Photo Maker Online (US, UK, India, EU) | FormFix';
const PAGE_DESC = 'Create official passport size photos for any country. Supports US 2x2, UK 35x45mm, India 3.5x4.5cm, EU standards and more. 100% private, browser-based, free.';
const PAGE_KEYWORDS = 'passport photo maker, 2x2 photo maker online, us passport photo size, uk passport photo maker, 35x45mm photo resize, official passport maker free, visa photo, schengen photo';

const faqs = [
  {
    q: 'Which countries does FormFix support for passport photos?',
    a: 'FormFix supports passport, visa, and ID photo standards for the United States (2x2 inch), United Kingdom (35x45mm), India (3.5x4.5cm), Schengen/EU (35x45mm), Canada, Australia, China, Japan, and most other countries. Each standard enforces a specific dimension and background color.',
  },
  {
    q: 'Can I take a passport photo at home?',
    a: 'Yes. Most countries now accept home-taken digital photos as long as they meet the technical specifications: correct dimensions, plain background, neutral expression, even lighting, and minimum resolution. FormFix handles the cropping and formatting automatically.',
  },
  {
    q: 'What is the 80% face rule?',
    a: 'Many countries (US, UK, Schengen, Canada) require your face to occupy roughly 70–80% of the photograph height. Our alignment guides show you exactly where your eyes, chin, and crown of head should be to meet this rule.',
  },
  {
    q: 'Is the passport photo data private?',
    a: 'Absolutely. FormFix runs entirely in your browser. Your photo is never uploaded to any server. We have no way to see, store, or share your identity document. This is critical for biometrics and passport photos.',
  },
  {
    q: 'What background color should I use?',
    a: 'White background: USA, India, Schengen, most Asian countries. Light grey or cream: UK passport. Off-white: Canada. Our tool lets you replace any background with the required plain color before export.',
  },
  {
    q: 'What resolution do I need?',
    a: 'For a 2x2 inch (51x51mm) photo at 300 DPI, you need at least 600x600 pixels. For 35x45mm at 300 DPI, 413x531 pixels. FormFix outputs high-resolution images that exceed these minimums.',
  },
];

const customSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      "name": "Global Passport Photo Maker - FormFix",
      "operatingSystem": "All",
      "applicationCategory": "MultimediaApplication",
      "description": "Professional tool for creating standardized passport and ID photos for all countries.",
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
    },
    {
      "@type": "FAQPage",
      "mainEntity": faqs.map(({ q, a }) => ({
        "@type": "Question",
        "name": q,
        "acceptedAnswer": { "@type": "Answer", "text": a }
      }))
    }
  ]
};
---

<BaseLayout title={PAGE_TITLE} description={PAGE_DESC} keywords={PAGE_KEYWORDS} customSchema={customSchema} active="tools" canonicalPath="/official-passport-photo-maker" faq={faqs}>
    <Breadcrumb items={[{ name: 'Home', path: '/' }, { name: "Passport Photo Maker", path: "/official-passport-photo-maker" }]} />

    <ToolWrapper
        title="Global Passport Studio"
        subtitle="Format your ID photos to meet official standards for any country, 100% locally."
        currentTool="global-passport"
    >
        <div slot="tool-ui">
             <div class="global-workspace">
                 <div class="global-alert">
                     <strong>Privacy Guaranteed:</strong> Your identity documents stay on your device. We never upload your photos to any server.
                 </div>
                 <div class="tool-actions-centered">
                     <a href="/passport-size-photo" class="primary-btn pulse-glow">Open Passport Studio →</a>
                     <a href="/resize-image" class="secondary-btn">Custom Resize</a>
                 </div>
             </div>
        </div>

        <div slot="tool-info">
             <article class="prose">
                 <h2>International Passport Photo Standards</h2>
                 <p>Different countries enforce very strict, non-negotiable specifications for passport and visa photographs. A photo that doesn't meet the standard gets your application rejected and wastes weeks of processing time. FormFix provides the exact dimensions, background colors, and resolution needed to ensure your application is accepted on the first try.</p>

                 <div class="specs-grid">
                     <div class="spec-card">
                         <h3>🇺🇸 USA Passport / Visa</h3>
                         <p><strong>Size:</strong> 2 x 2 inches (51 x 51 mm)</p>
                         <p><strong>Background:</strong> Plain white</p>
                         <p><strong>Resolution:</strong> 600 x 600 px minimum</p>
                     </div>
                     <div class="spec-card">
                         <h3>🇬🇧 United Kingdom</h3>
                         <p><strong>Size:</strong> 35 x 45 mm</p>
                         <p><strong>Background:</strong> Cream or light grey</p>
                         <p><strong>Resolution:</strong> 413 x 531 px minimum</p>
                     </div>
                     <div class="spec-card">
                         <h3>🇮🇳 India Passport</h3>
                         <p><strong>Size:</strong> 3.5 x 4.5 cm (35 x 45 mm)</p>
                         <p><strong>Background:</strong> White</p>
                         <p><strong>Resolution:</strong> 350 x 450 px minimum</p>
                     </div>
                     <div class="spec-card">
                         <h3>🇪🇺 Schengen / EU</h3>
                         <p><strong>Size:</strong> 35 x 45 mm</p>
                         <p><strong>Background:</strong> Light, plain</p>
                         <p><strong>Resolution:</strong> 413 x 531 px minimum</p>
                     </div>
                     <div class="spec-card">
                         <h3>🇨🇦 Canada</h3>
                         <p><strong>Size:</strong> 50 x 70 mm</p>
                         <p><strong>Background:</strong> White or off-white</p>
                         <p><strong>Resolution:</strong> 590 x 826 px minimum</p>
                     </div>
                     <div class="spec-card">
                         <h3>🇦🇺 Australia</h3>
                         <p><strong>Size:</strong> 35 x 45 mm</p>
                         <p><strong>Background:</strong> Light, plain</p>
                         <p><strong>Resolution:</strong> 413 x 531 px minimum</p>
                     </div>
                 </div>

                 <h2>How to create your passport photo</h2>
                 <ol>
                     <li><strong>Choose standard:</strong> Select your destination country from the preset list in the editor.</li>
                     <li><strong>Upload image:</strong> Pick a clear, well-lit photo with your face straight and centered.</li>
                     <li><strong>Align:</strong> Use the on-screen guides to position your eyes, crown, and chin correctly. Aim for 80% face coverage.</li>
                     <li><strong>Background:</strong> Replace the existing background with the required plain color (white, cream, or light grey).</li>
                     <li><strong>Export:</strong> Download the high-resolution JPG ready for upload to your visa or passport application.</li>
                 </ol>

                 <h2>Why use FormFix instead of a photo booth?</h2>
                 <ul>
                     <li><strong>Privacy:</strong> Photo booths often print multiple copies on receipt paper; FormFix outputs a single digital file that never leaves your device.</li>
                     <li><strong>Free:</strong> No $15 fee per set. Use it as many times as you need.</li>
                     <li><strong>Convenience:</strong> Skip the trip to the drugstore — open FormFix on any device with a camera or take a selfie with your phone.</li>
                     <li><strong>Standards compliance:</strong> Country-specific presets ensure your photo meets official requirements the first time.</li>
                     <li><strong>High resolution:</strong> Outputs at 300 DPI or higher, exceeding minimum requirements for every country.</li>
                 </ul>

                 <h2>Common mistakes to avoid</h2>
                 <ul>
                     <li><strong>Wrong background:</strong> Most rejections are due to non-plain backgrounds (shadows, patterns, walls).</li>
                     <li><strong>Glasses:</strong> The US banned glasses in passport photos since 2016. Most countries now require eyes to be fully visible.</li>
                     <li><strong>Smiling:</strong> Neutral expression only — wide smiles are rejected.</li>
                     <li><strong>Wrong crop:</strong> Head too small or too large in the frame violates the 70–80% rule.</li>
                     <li><strong>Low resolution:</strong> Photos under 600x600 px often fail automated face-recognition checks.</li>
                 </ul>

                 <div class="faq-section mt-48">
                     <h3>Frequently Asked Questions</h3>
                     {faqs.map(({ q, a }) => (
                         <details class="minimal-faq">
                             <summary>{q} <span class="indicator">+</span></summary>
                             <div class="faq-body"><p>{a}</p></div>
                         </details>
                     ))}
                 </div>
             </article>
        </div>
    </ToolWrapper>
</BaseLayout>

<style>
    .specs-grid { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 20px; margin: 32px 0; }
    .spec-card { background: var(--surface-3); border: 1px solid var(--border-subtle); padding: 20px; border-radius: 16px; text-align: left; }
    .spec-card h3 { font-size: 1.05rem; margin-bottom: 12px; color: var(--text-primary); }
    .spec-card p { font-size: 0.88rem; color: var(--text-muted); margin: 4px 0; }
    .spec-card strong { color: var(--text-secondary); font-weight:600; }
    .faq-section { margin-top: 3rem; }
    @media (max-width: 900px) { .specs-grid { grid-template-columns: 1fr 1fr; } }
    @media (max-width: 640px) { .specs-grid { grid-template-columns: 1fr; gap: 12px; } }
</style>