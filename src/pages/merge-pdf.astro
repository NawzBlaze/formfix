---
import BaseLayout from '../components/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import ToolWrapper from '../components/ToolWrapper.astro';

const PAGE_TITLE = 'Merge PDF Online - Combine Multiple PDF Files Free | FormFix';
const PAGE_DESC = 'Merge, combine, and join multiple PDF files into one document for free. 100% secure, offline client-side processing with no server uploads. Safe for documents.';
const PAGE_KEYWORDS = 'merge pdf online, combine pdf files free, join pdf online, free pdf merger, secure pdf combination, formfix pdf';

const customSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      "name": "FormFix Pro PDF Merger",
      "operatingSystem": "All",
      "applicationCategory": "UtilitiesApplication",
      "description": "Securely merge and combine multiple PDF documents into a single file directly in your browser.",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      }
    }
  ]
};

const faqs = [
  { q: "Can I merge password-protected PDFs?", a: "Our tool currently supports merging standard PDFs. If a file is encrypted or password-protected, you must unlock it first before it can be merged through the browser engine." },
  { q: "Is there a file size limit for merging?", a: "Since the merging happens in your computer's RAM, the only limit is your device's available memory. Most modern computers and phones can easily merge files up to several hundred megabytes." },
];
---

<BaseLayout title={PAGE_TITLE} description={PAGE_DESC} keywords={PAGE_KEYWORDS} customSchema={customSchema} active="pdf" canonicalPath="/merge-pdf" faq={faqs}>
<script>
    import { mergePdfs } from '../lib/pdf';

    document.addEventListener('DOMContentLoaded', () => {
    try {
        const fileInput = document.getElementById('pdf-upload');
        const uploadStage = document.getElementById('upload-stage');
        const actionStage = document.getElementById('editor-stage');
        const fileListContainer = document.getElementById('file-list');
        const mergeBtn = document.getElementById('merge-btn');
        const resetBtn = document.querySelector('#editor-stage .secondary-btn');
        const dropZone = document.getElementById('upload-stage');
        
        let pendingFiles = [];
        let draggedIndex = null;
        let touchDragClone: HTMLElement | null = null;
        let touchDragFromIndex: number | null = null;

        async function handleFiles(files: FileList | File[]) {
            const validPdfs = Array.from(files).filter(f => f.type === 'application/pdf' || f.name.toLowerCase().endsWith('.pdf'));
            if(validPdfs.length === 0) {
                 return window.ffNotice("Please select valid PDF files.", "error");
            }
            // Add new files to existing list
            pendingFiles = [...pendingFiles, ...validPdfs];
            renderFileList();
            
            uploadStage?.classList.add('hidden');
            actionStage?.classList.remove('hidden');
        }

        fileInput?.addEventListener('change', (e) => handleFiles(e.target.files));

        // Drag and Drop
        ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(evName => {
            dropZone?.addEventListener(evName, e => e.preventDefault());
        });
        dropZone?.addEventListener('dragover', () => dropZone?.classList.add('drag-active'));
        dropZone?.addEventListener('dragleave', () => dropZone?.classList.remove('drag-active'));
        dropZone?.addEventListener('drop', (e: any) => {
            dropZone?.classList.remove('drag-active');
            if(e.dataTransfer && e.dataTransfer.files) handleFiles(e.dataTransfer.files);
        });

        function renderFileList() {
            if (fileListContainer) fileListContainer.innerHTML = '';
            pendingFiles.forEach((file, index) => {
                const row = document.createElement('div');
                row.className = 'file-row shadow-sm';
                row.setAttribute('draggable', 'true');
                row.dataset.index = index;
                
                const sizeStr = file.size > 1048576 ? (file.size / 1048576).toFixed(1) + ' MB' : (file.size / 1024).toFixed(1) + ' KB';
                const safeName = (window.FormFix && window.FormFix.escapeHtml) ? window.FormFix.escapeHtml(file.name) : file.name.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
                
                row.innerHTML = `
                    <div class="f-info">
                        <span class="drag-handle" title="Drag to reorder">☰</span>
                        <span class="f-icon">📄</span>
                        <div class="f-text">
                            <span class="f-name">${safeName}</span>
                            <span class="f-size">${sizeStr}</span>
                        </div>
                    </div>
                    <button class="remove-btn" data-index="${index}" title="Remove file">❌</button>
                `;
                if (fileListContainer) fileListContainer.appendChild(row);
            });

            document.querySelectorAll('.remove-btn').forEach(btn => {
                btn.addEventListener('click', (e) => {
                    e.stopPropagation();
                    const idx = parseInt(e.currentTarget.dataset.index);
                    pendingFiles.splice(idx, 1);
                    if(pendingFiles.length === 0) {
                        resetApp();
                    } else {
                        renderFileList();
                    }
                });
            });

            fileListContainer?.querySelectorAll('.file-row').forEach(row => {
                row.addEventListener('dragstart', handleDragStart);
                row.addEventListener('dragend', handleDragEnd);
            });

            bindTouchEvents();
            
            if (mergeBtn) mergeBtn.innerHTML = `⚡ Merge ${pendingFiles.length} PDFs`;
            const countPill = document.getElementById('file-count-pill');
            if (countPill) countPill.textContent = `${pendingFiles.length} Files`;
        }

        function resetApp() {
            pendingFiles = [];
            if (fileInput) fileInput.value = '';
            if (fileListContainer) fileListContainer.innerHTML = '';
            uploadStage?.classList.remove('hidden');
            actionStage?.classList.add('hidden');
        }

        resetBtn?.addEventListener('click', resetApp);

        function handleDragStart(this: HTMLElement, e: any) {
            draggedIndex = parseInt(this.dataset.index!);
            this.classList.add('dragging');
            e.dataTransfer.effectAllowed = 'move';
            e.dataTransfer.setData('text/plain', draggedIndex);
        }

        function handleDragEnd(this: HTMLElement, e: any) {
            this.classList.remove('dragging');
            draggedIndex = null;
            fileListContainer?.querySelectorAll('.file-row').forEach(r => r.classList.remove('drag-over'));
        }

        function handleDragOver(e) {
            e.preventDefault();
            e.dataTransfer.dropEffect = 'move';
            const row = e.target.closest('.file-row');
            if (!row) return;
            fileListContainer?.querySelectorAll('.file-row').forEach(r => r.classList.remove('drag-over'));
            row.classList.add('drag-over');
        }

        function handleDragLeave(e: any) {
            const row = e.target.closest('.file-row');
            if (row && !row.contains(e.relatedTarget)) {
                row.classList.remove('drag-over');
            }
        }

        function handleDrop(e: any) {
            e.preventDefault();
            const row = e.target.closest('.file-row');
            if (!row) return;
            const toIndex = parseInt(row.dataset.index);
            if (draggedIndex === null || draggedIndex === toIndex) return;
            const [movedFile] = pendingFiles.splice(draggedIndex, 1);
            pendingFiles.splice(toIndex, 0, movedFile);
            renderFileList();
        }

        fileListContainer?.addEventListener('dragover', handleDragOver);
        fileListContainer?.addEventListener('drop', handleDrop);
        fileListContainer?.addEventListener('dragleave', handleDragLeave);

        function bindTouchEvents() {
            const handles = fileListContainer?.querySelectorAll('.drag-handle') || [];
            handles.forEach(handle => {
                handle.addEventListener('touchstart', handleTouchStart, { passive: false });
                handle.addEventListener('touchmove', handleTouchMove, { passive: false });
                handle.addEventListener('touchend', handleTouchEnd);
            });
        }

        function handleTouchStart(e) {
            const row = e.target.closest('.file-row');
            if (!row) return;
            touchDragFromIndex = parseInt(row.dataset.index);
            row.classList.add('dragging');
            touchDragClone = row.cloneNode(true);
            touchDragClone.style.position = 'fixed';
            touchDragClone.style.pointerEvents = 'none';
            touchDragClone.style.opacity = '0.8';
            touchDragClone.style.zIndex = '9999';
            touchDragClone.style.width = row.offsetWidth + 'px';
            touchDragClone.classList.remove('dragging');
            document.body.appendChild(touchDragClone);
            const touch = e.touches[0];
            touchDragClone.style.left = (touch.clientX - row.offsetWidth / 2) + 'px';
            touchDragClone.style.top = (touch.clientY - 20) + 'px';
        }

        function handleTouchMove(e) {
            e.preventDefault();
            if (!touchDragClone) return;
            const touch = e.touches[0];
            touchDragClone.style.left = (touch.clientX - touchDragClone.offsetWidth / 2) + 'px';
            touchDragClone.style.top = (touch.clientY - 20) + 'px';
            touchDragClone.style.display = 'none';
            const elementBelow = document.elementFromPoint(touch.clientX, touch.clientY);
            touchDragClone.style.display = '';
            const rowBelow = elementBelow?.closest('.file-row');
            fileListContainer?.querySelectorAll('.file-row').forEach(r => r.classList.remove('drag-over'));
            if (rowBelow && parseInt(rowBelow.dataset.index) !== touchDragFromIndex) {
                rowBelow.classList.add('drag-over');
            }
        }

        function handleTouchEnd() {
            if (touchDragClone) {
                document.body.removeChild(touchDragClone);
                touchDragClone = null;
            }
            const overRow = fileListContainer?.querySelector('.file-row.drag-over');
            if (overRow && touchDragFromIndex !== null) {
                const toIndex = parseInt(overRow.dataset.index);
                const [movedFile] = pendingFiles.splice(touchDragFromIndex, 1);
                pendingFiles.splice(toIndex, 0, movedFile);
                renderFileList();
            }
            fileListContainer?.querySelectorAll('.file-row').forEach(r => {
                r.classList.remove('dragging');
                r.classList.remove('drag-over');
            });
            touchDragFromIndex = null;
        }

        mergeBtn?.addEventListener('click', async () => {
             if(pendingFiles.length < 2) return window.ffNotice("You need at least 2 PDF files to merge them!", "error");
             
             if (mergeBtn) mergeBtn.textContent = '⏳ Processing...';
             if (mergeBtn) mergeBtn.style.pointerEvents = 'none';
             document.getElementById('merge-overlay')?.classList.add('active');
             
             try {
                 const mergedPdfBytes = await mergePdfs(pendingFiles);
                 const blob = new Blob([mergedPdfBytes], { type: 'application/pdf' });
                 const url = URL.createObjectURL(blob);
                 const link = document.createElement('a');
                 
                 let finalName = 'formfix_merged_' + Date.now() + '.pdf';
                 if(pendingFiles.length > 0) {
                     finalName = pendingFiles[0].name.replace('.pdf', '') + '_merged.pdf';
                 }

                  link.download = finalName;
                  link.href = url;
                  link.click();
                  if(window.triggerConfetti) window.triggerConfetti();
                  window.ffNotice("PDFs merged successfully!", "success");
                  var shareUrl = encodeURIComponent(window.location.href);
                  var shareTxt = encodeURIComponent("I just merged multiple PDFs into one using FormFix! 100% private, no uploads. Try it: " + window.__SITE_URL + "/merge-pdf");
                  var shareHTML = '<div style="margin-top:20px;text-align:center;"><p style="font-weight:600;margin-bottom:10px;color:var(--success);">Love FormFix? Share it!</p><div style="display:flex;gap:8px;justify-content:center;"><a href="https://x.com/intent/tweet?text=' + shareTxt + '" target="_blank" style="padding:8px 16px;border-radius:8px;background:#000;color:#fff;text-decoration:none;font-weight:600;font-size:0.85rem;">Share on X</a><a href="https://wa.me/?text=' + shareTxt + '" target="_blank" style="padding:8px 16px;border-radius:8px;background:#25D366;color:#fff;text-decoration:none;font-weight:600;font-size:0.85rem;">WhatsApp</a></div></div>';
                  var existing = document.getElementById('post-merge-share');
                  if (!existing) {
                      var shareDiv = document.createElement('div');
                      shareDiv.id = 'post-merge-share';
                      shareDiv.innerHTML = shareHTML;
                      if (mergeBtn) mergeBtn.parentElement.appendChild(shareDiv);
                  }
             } catch (e) {
                 console.error(e);
                 window.ffNotice("There was an error merging your PDFs. One of them might be encrypted or corrupted.", "error");
             } finally {
                 document.getElementById('merge-overlay')?.classList.remove('active');
                 if (mergeBtn) mergeBtn.innerHTML = `⚡ Merge ${pendingFiles.length} PDFs`;
                 if (mergeBtn) mergeBtn.style.pointerEvents = 'all';
             }
        });
    } catch(err) { console.error('merge-pdf error:', err); if (typeof window.ffNotice === 'function') window.ffNotice('Something went wrong. Please try again.', 'error'); }
    });
</script>

    <Breadcrumb items={[{ name: 'Home', path: '/' }, { name: "Merge PDF Online - Combine Multiple PDF Files Free", path: "/merge-pdf" }]} />

    <ToolWrapper title="Merge PDF Files" subtitle="Combine multiple PDF documents into a single file securely and instantly." currentTool="merge-pdf">
        
        <div slot="tool-ui">
             <div class="workspace-editor">
                  <!-- 1. Selection Step -->
                   <div id="upload-stage" class="upload-zone show">
                        <div class="upload-icon-circle">📄</div>
                        <h3 class="zone-title">Add PDF Files</h3>
                        <p class="zone-sub">Select 2 or more PDFs to combine, or drag & drop them here</p>
                        <button class="primary-btn px-32" onclick="document.getElementById('pdf-upload').click()">Select PDF Bundle</button>
                        <input type="file" id="pdf-upload" class="hidden" accept="application/pdf" multiple />
                   </div>

                  <!-- 2. Workspace Step -->
                  <div id="editor-stage" class="hidden">
                       <div id="merge-overlay" class="processing-overlay">
                            <div class="processing-spinner"></div>
                            <span class="processing-text">Merging PDFs...</span>
                       </div>
                       <div class="editor-layout">
                            <div class="file-workspace shadow-sm">
                                 <div class="workspace-header">
                                      <h4 class="m-0 font-800">Combine Sequence</h4>
                                      <span id="file-count-pill" class="status-pill inverse">0 Files</span>
                                 </div>
                                 
                                 <div id="file-list" class="file-list-grid scroll-container mt-24">
                                      <!-- Injected by JS -->
                                 </div>
                                 
                                 <button class="add-more-btn mt-24" onclick="document.getElementById('pdf-upload').click()">
                                      <span>+</span> Add More Documents
                                 </button>
                            </div>

                            <div class="sidebar-controls">
                                 <div class="settings-card shadow-sm mb-24">
                                      <label class="section-label mb-16">Merge Configuration</label>
                                      <p class="setting-desc mb-24">Documents will be joined in the order shown on the left.</p>
                                      <button id="merge-btn" class="primary-btn wide-btn pulse-glow">⚡ Merge to One PDF</button>
                                 </div>
                                 <div class="action-footer vertical">
                                      <button class="secondary-btn wide-btn" onclick="location.reload()">↺ Start New</button>
                                 </div>
                                 <p class="privacy-note text-center mt-16 font-600">🔒 Zero-upload security.</p>
                            </div>
                       </div>
                  </div>
             </div>
        </div>

        <div slot="tool-info">
             <h2>The Safest Way to Combine PDF Files</h2>
             <p>Our <strong>Free PDF Merger</strong> lets you easily bring together multiple digital records, tax documents, or scanned pages into one neat PDF file. The biggest advantage? Your files are processed <strong>100% locally</strong> inside your browser. This means absolutely zero data is uploaded to our servers, keeping your sensitive information completely private.</p>
             
             <div class="how-it-works mt-32">
                  <h3>How It Works</h3>
                  <ol class="steps">
                       <li><strong>Step 1:</strong> Select PDF files</li>
                       <li><strong>Step 2:</strong> Drag to reorder</li>
                       <li><strong>Step 3:</strong> Click Merge</li>
                       <li><strong>Step 4:</strong> Download combined PDF</li>
                  </ol>
             </div>

             <div class="faq-grid mt-32">
                  <details class="faq-item">
                       <summary>Can I merge password-protected PDFs?</summary>
                       <p>Our tool currently supports merging standard PDFs. If a file is encrypted or password-protected, you must unlock it first before it can be merged through the browser engine.</p>
                  </details>
                  <details class="faq-item">
                       <summary>Is there a file size limit for merging?</summary>
                       <p>Since the merging happens in your computer's RAM, the only limit is your device's available memory. Most modern computers and phones can easily merge files up to several hundred megabytes.</p>
                  </details>
             </div>
        </div>
    </ToolWrapper>
</BaseLayout><style>
    .main-h1 { font-size: 3.5rem; font-weight:600; letter-spacing: -0.05em; margin-bottom: 12px; color: var(--text-primary); line-height: 1.1; }
    .hero-sub { color: var(--text-secondary); font-weight: 600; font-size: 1.25rem; margin-bottom: 24px; }
    .tool-wrapper { max-width: 960px; margin: 0 auto; padding-bottom: 100px; }
    .max-w-lg { max-width: 600px; margin-inline: auto; }
    
    .upload-container { background: var(--surface-2); border: 2.5px dashed var(--border); border-radius: 32px; padding: 60px 20px; text-align: center; cursor: pointer; transition: 0.3s; margin-top:16px; min-height: 380px; display: flex; flex-direction: column; align-items: center; justify-content: center; }
    .upload-container:hover, .upload-container.drag-active { border-color: var(--accent-primary); background: var(--success-soft); transform: translateY(-4px); }
    .upload-circle { width: 90px; height: 90px; background:var(--surface-3); border-radius: 50%; box-shadow: 0 10px 25px rgba(0,0,0,0.05); display: flex; align-items: center; justify-content: center; margin: 0 auto 20px; font-size: 3rem; }
    .u-title { font-size: 1.8rem; font-weight:600; color: var(--text-primary); margin-bottom: 8px; }
    .u-sub { font-size: 1.1rem; color: var(--text-secondary); font-weight: 600; margin-bottom: 32px; }

    #action-stage { background:var(--surface-3); padding: 12px; border-radius: 24px; }
    
    .editor-layout { display: grid; grid-template-columns: 1fr 280px; gap: 24px; align-items: start; }
    .file-workspace { min-width: 0; overflow: hidden; }
    .sidebar-controls { display: flex; flex-direction: column; gap: 16px; }
    
    .file-list { display: flex; flex-direction: column; gap: 12px; max-height: 280px; overflow-y: auto; padding-right: 8px; }
    .file-list::-webkit-scrollbar { width: 6px; }
    .file-list::-webkit-scrollbar-thumb { background-color: var(--text-muted); border-radius: 10px; }
    
    .file-row { display: flex; align-items: center; justify-content: space-between; padding: 16px; background: var(--surface-2); border: 1.5px solid var(--border); border-radius: 16px; transition: 0.2s; cursor: default; }
    .file-row:hover { border-color: var(--accent-soft); background:var(--surface-3); }
    .file-row.dragging { opacity: 0.4; border-style: dashed; }
    .file-row.drag-over { border-top: 3px solid var(--accent-primary); margin-top: -3px; }
    .drag-handle { cursor: grab; user-select: none; padding: 8px; font-size: 1.2rem; opacity: 0.5; transition: opacity 0.2s; }
    .drag-handle:hover { opacity: 1; }
    .drag-handle:active { cursor: grabbing; }
    .f-info { display: flex; align-items: center; gap: 16px; overflow: hidden; }
    .f-icon { font-size: 2rem; }
    .f-text { display: flex; flex-direction: column; overflow: hidden; }
    .f-name { font-weight:600; color: var(--text-primary); font-size: 1.1rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 300px; }
    .f-size { color: var(--text-secondary); font-size: 0.85rem; font-weight: 600; margin-top:2px; }
    .remove-btn { background: none; border: none; font-size: 1.2rem; cursor: pointer; opacity: 0.5; transition: 0.2s; padding: 8px; }
    .remove-btn:hover { opacity: 1; transform: scale(1.2); }

    .text-xl { font-size: 1.35rem; color: var(--text-primary); }

    .wide-btn { padding: 22px 24px; font-weight:600; font-size: 1.25rem; border-radius: 100px; display: block; }
    .small-btn { padding: 10px 18px; border-radius: 100px; font-weight:600; font-size: 0.95rem; }

    @media (max-width: 640px) {
        .editor-layout { grid-template-columns: 1fr; gap: 16px; }
        .f-name { max-width: 180px; }
        .upload-container { padding: 40px 16px; min-height: 300px; }
    }

    .how-it-works h3 { font-size: 1.1rem; font-weight: 600; margin-bottom: 12px; color: var(--text-primary); }
    .steps { padding-left: 20px; margin: 0; }
    .steps li { font-size: 0.95rem; line-height: 1.7; color: var(--text-secondary); margin-bottom: 8px; }
    .steps li strong { color: var(--text-primary); }
</style>
