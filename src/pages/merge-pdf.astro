---
import BaseLayout from '../components/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import ToolWrapper from '../components/ToolWrapper.astro';

const PAGE_TITLE = 'Merge PDF Online - Combine Multiple PDF Files Free | FormFix';
const PAGE_DESC = 'Merge, combine, and join multiple PDF files into one document for free. 100% secure, offline client-side processing with no server uploads. Safe for documents.';
const PAGE_KEYWORDS = 'merge pdf online, combine pdf files free, join pdf online, free pdf merger, secure pdf combination, formfix pdf';

const customSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      "name": "FormFix Pro PDF Merger",
      "operatingSystem": "All",
      "applicationCategory": "UtilitiesApplication",
      "description": "Securely merge and combine multiple PDF documents into a single file directly in your browser.",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      }
    }
  ]
};
---

<BaseLayout title={PAGE_TITLE} description={PAGE_DESC} keywords={PAGE_KEYWORDS} customSchema={customSchema} active="tools" canonicalPath="/merge-pdf">
    <script is:inline>
    const loadPdfLib = async () => {
        if (window.PDFLib) return;
        return new Promise((resolve, reject) => {
            const script = document.createElement('script');
            script.src = 'https://cdn.jsdelivr.net/npm/pdf-lib@1.17.1/dist/pdf-lib.min.js';
            script.onload = resolve;
            script.onerror = reject;
            document.head.appendChild(script);
        });
    };

    document.addEventListener('DOMContentLoaded', () => {
        const fileInput = document.getElementById('pdf-upload');
        const uploadStage = document.getElementById('upload-stage');
        const actionStage = document.getElementById('action-stage');
        const fileListContainer = document.getElementById('file-list');
        const mergeBtn = document.getElementById('merge-btn');
        const resetBtn = document.getElementById('reset-btn');
        const dropZone = document.getElementById('drop-zone');
        
        let pendingFiles = [];

        async function handleFiles(files) {
            const validPdfs = Array.from(files).filter(f => f.type === 'application/pdf' || f.name.toLowerCase().endsWith('.pdf'));
            if(validPdfs.length === 0) {
                 return window.ffNotice("Please select valid PDF files.", "error");
            }
            // Add new files to existing list
            pendingFiles = [...pendingFiles, ...validPdfs];
            renderFileList();
            
            uploadStage?.classList.add('hidden');
            actionStage?.classList.remove('hidden');
            
            // Pre-load library while they look at files
            loadPdfLib();
        }

        fileInput?.addEventListener('change', (e) => handleFiles(e.target.files));

        // Drag and Drop
        ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(evName => {
            dropZone?.addEventListener(evName, e => e.preventDefault());
        });
        dropZone?.addEventListener('dragover', () => dropZone?.classList.add('drag-active'));
        dropZone?.addEventListener('dragleave', () => dropZone?.classList.remove('drag-active'));
        dropZone?.addEventListener('drop', (e) => {
            dropZone?.classList.remove('drag-active');
            if(e.dataTransfer && e.dataTransfer.files) handleFiles(e.dataTransfer.files);
        });

        function renderFileList() {
            if (fileListContainer) fileListContainer.innerHTML = '';
            pendingFiles.forEach((file, index) => {
                row.className = 'file-row shadow-sm';
                
                const sizeKb = (file.size / 1024).toFixed(1);
                const safeName = file.name.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
                
                row.innerHTML = `
                    <div class="f-info">
                        <span class="f-icon">📄</span>
                        <div class="f-text">
                            <span class="f-name">${safeName}</span>
                            <span class="f-size">${sizeKb} KB</span>
                        </div>
                    </div>
                    <button class="remove-btn" data-index="${index}" title="Remove file">❌</button>
                `;
                if (fileListContainer) fileListContainer.appendChild(row);
            });

            // Re-bind drops
            document.querySelectorAll('.remove-btn').forEach(btn => {
                btn.addEventListener('click', (e) => {
                    const idx = parseInt(e.currentTarget.dataset.index);
                    pendingFiles.splice(idx, 1);
                    if(pendingFiles.length === 0) {
                        resetApp();
                    } else {
                        renderFileList();
                    }
                });
            });
            
            if (mergeBtn) mergeBtn.innerHTML = `⚡ Merge ${pendingFiles.length} PDFs`;
        }

        function resetApp() {
            pendingFiles = [];
            if (fileInput) fileInput.value = '';
            if (fileListContainer) fileListContainer.innerHTML = '';
            uploadStage?.classList.remove('hidden');
            actionStage?.classList.add('hidden');
        }

        resetBtn?.addEventListener('click', resetApp);

        mergeBtn?.addEventListener('click', async () => {
             if(pendingFiles.length < 2) return window.ffNotice("You need at least 2 PDF files to merge them!", "error");
             
             if (mergeBtn) mergeBtn.textContent = '⏳ Processing...';
             if (mergeBtn) mergeBtn.style.pointerEvents = 'none';
             
             try {
                 await loadPdfLib();
                 const { PDFDocument } = window.PDFLib;
                 const mergedPdf = await PDFDocument.create();

                 for (const file of pendingFiles) {
                     const arrayBuffer = await file.arrayBuffer();
                     const incomingPdf = await PDFDocument.load(arrayBuffer);
                     const copiedPages = await mergedPdf.copyPages(incomingPdf, incomingPdf.getPageIndices());
                     copiedPages.forEach((page) => mergedPdf.addPage(page));
                 }

                 const mergedPdfBytes = await mergedPdf.save();
                 const blob = new Blob([mergedPdfBytes], { type: 'application/pdf' });
                 const url = URL.createObjectURL(blob);
                 const link = document.createElement('a');
                 
                 let finalName = 'formfix_merged_' + Date.now() + '.pdf';
                 if(pendingFiles.length > 0) {
                     finalName = pendingFiles[0].name.replace('.pdf', '') + '_merged.pdf';
                 }

                  link.download = finalName;
                  link.href = url;
                  link.click();
                  if(window.triggerConfetti) window.triggerConfetti();
                  window.ffNotice("PDFs merged successfully!", "success");
                  var shareUrl = encodeURIComponent(window.location.href);
                  var shareTxt = encodeURIComponent("I just merged multiple PDFs into one using FormFix! 100% private, no uploads. Try it: " + window.__SITE_URL + "/merge-pdf");
                  var shareHTML = '<div style="margin-top:20px;text-align:center;"><p style="font-weight:600;margin-bottom:10px;color:var(--success);">Love FormFix? Share it!</p><div style="display:flex;gap:8px;justify-content:center;"><a href="https://twitter.com/intent/tweet?text=' + shareTxt + '" target="_blank" style="padding:8px 16px;border-radius:8px;background:#000;color:#fff;text-decoration:none;font-weight:600;font-size:0.85rem;">Share on X</a><a href="https://wa.me/?text=' + shareTxt + '" target="_blank" style="padding:8px 16px;border-radius:8px;background:#25D366;color:#fff;text-decoration:none;font-weight:600;font-size:0.85rem;">WhatsApp</a></div></div>';
                  var existing = document.getElementById('post-merge-share');
                  if (!existing) {
                      var shareDiv = document.createElement('div');
                      shareDiv.id = 'post-merge-share';
                      shareDiv.innerHTML = shareHTML;
                      if (mergeBtn) mergeBtn.parentElement.appendChild(shareDiv);
                  }
             } catch (e) {
                 console.error(e);
                 window.ffNotice("There was an error merging your PDFs. One of them might be encrypted or corrupted.", "error");
             } finally {
                 if (mergeBtn) mergeBtn.innerHTML = `⚡ Merge ${pendingFiles.length} PDFs`;
                 if (mergeBtn) mergeBtn.style.pointerEvents = 'all';
             }
        });
    });
</script>

    <Breadcrumb items={[{ name: 'Home', path: '/' }, { name: "Merge PDF Online - Combine Multiple PDF Files Free", path: "/merge-pdf" }]} />

    <ToolWrapper title="Merge PDF Files" subtitle="Combine multiple PDF documents into a single file securely and instantly." currentTool="merge-pdf">
        
        <div slot="tool-ui">
             <div class="workspace-editor">
                  <!-- 1. Selection Step -->
                   <div id="upload-stage" class="upload-zone show">
                        <div class="upload-icon-circle">📄</div>
                        <h3 class="zone-title">Add PDF Files</h3>
                        <p class="zone-sub">Select 2 or more PDFs to combine, or drag & drop them here</p>
                        <button class="primary-btn px-32" onclick="document.getElementById('pdf-upload').click()">Select PDF Bundle</button>
                        <input type="file" id="pdf-upload" class="hidden" accept="application/pdf" multiple />
                   </div>

                  <!-- 2. Workspace Step -->
                  <div id="editor-stage" class="hidden">
                       <div class="editor-layout">
                            <div class="file-workspace shadow-sm">
                                 <div class="workspace-header">
                                      <h4 class="m-0 font-800">Combine Sequence</h4>
                                      <span id="file-count-pill" class="status-pill inverse">0 Files</span>
                                 </div>
                                 
                                 <div id="file-list" class="file-list-grid scroll-container mt-24">
                                      <!-- Injected by JS -->
                                 </div>
                                 
                                 <button class="add-more-btn mt-24" onclick="document.getElementById('pdf-upload').click()">
                                      <span>+</span> Add More Documents
                                 </button>
                            </div>

                            <div class="sidebar-controls">
                                 <div class="settings-card shadow-sm mb-24">
                                      <label class="section-label mb-16">Merge Configuration</label>
                                      <p class="setting-desc mb-24">Documents will be joined in the order shown on the left.</p>
                                      <button id="merge-btn" class="primary-btn wide-btn pulse-glow">⚡ Merge to One PDF</button>
                                 </div>
                                 <div class="action-footer vertical">
                                      <button class="secondary-btn wide-btn" onclick="location.reload()">↺ Start New</button>
                                 </div>
                                 <p class="privacy-note text-center mt-16 font-600">🔒 Zero-upload security.</p>
                            </div>
                       </div>
                  </div>
             </div>
        </div>

        <div slot="tool-info">
             <h2>The Safest Way to Combine PDF Files</h2>
             <p>Our <strong>Free PDF Merger</strong> lets you easily bring together multiple digital records, tax documents, or scanned pages into one neat PDF file. The biggest advantage? Your files are processed <strong>100% locally</strong> inside your browser. This means absolutely zero data is uploaded to our servers, keeping your sensitive information completely private.</p>
             
             <div class="faq-grid mt-32">
                  <details class="faq-item">
                       <summary>Can I merge password-protected PDFs?</summary>
                       <p>Our tool currently supports merging standard PDFs. If a file is encrypted or password-protected, you must unlock it first before it can be merged through the browser engine.</p>
                  </details>
                  <details class="faq-item">
                       <summary>Is there a file size limit for merging?</summary>
                       <p>Since the merging happens in your computer's RAM, the only limit is your device's available memory. Most modern computers and phones can easily merge files up to several hundred megabytes.</p>
                  </details>
             </div>
        </div>
    </ToolWrapper>
</BaseLayout><style>
    .main-h1 { font-size: 3.5rem; font-weight:600; letter-spacing: -0.05em; margin-bottom: 12px; color: var(--text-primary); line-height: 1.1; }
    .hero-sub { color: var(--text-secondary); font-weight: 600; font-size: 1.25rem; margin-bottom: 24px; }
    .tool-wrapper { max-width: 960px; margin: 0 auto; padding-bottom: 100px; }
    .max-w-lg { max-width: 600px; margin-inline: auto; }
    
    .upload-container { background: var(--surface-2); border: 2.5px dashed var(--border); border-radius: 32px; padding: 60px 20px; text-align: center; cursor: pointer; transition: 0.3s; margin-top:16px; min-height: 380px; display: flex; flex-direction: column; align-items: center; justify-content: center; }
    .upload-container:hover, .upload-container.drag-active { border-color: var(--primary); background: var(--success-soft); transform: translateY(-4px); }
    .upload-circle { width: 90px; height: 90px; background:var(--surface-3); border-radius: 50%; box-shadow: 0 10px 25px rgba(0,0,0,0.05); display: flex; align-items: center; justify-content: center; margin: 0 auto 20px; font-size: 3rem; }
    .u-title { font-size: 1.8rem; font-weight:600; color: var(--text-primary); margin-bottom: 8px; }
    .u-sub { font-size: 1.1rem; color: var(--text-secondary); font-weight: 600; margin-bottom: 32px; }

    #action-stage { background:var(--surface-3); padding: 12px; border-radius: 24px; }
    
    .file-list { display: flex; flex-direction: column; gap: 12px; max-height: 280px; overflow-y: auto; padding-right: 8px; }
    .file-list::-webkit-scrollbar { width: 6px; }
    .file-list::-webkit-scrollbar-thumb { background-color: var(--text-muted); border-radius: 10px; }
    
    .file-row { display: flex; align-items: center; justify-content: space-between; padding: 16px; background: var(--surface-2); border: 1.5px solid var(--border); border-radius: 16px; transition: 0.2s; }
    .file-row:hover { border-color: var(--primary-light); background:var(--surface-3); }
    .f-info { display: flex; align-items: center; gap: 16px; overflow: hidden; }
    .f-icon { font-size: 2rem; }
    .f-text { display: flex; flex-direction: column; overflow: hidden; }
    .f-name { font-weight:600; color: var(--text-primary); font-size: 1.1rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 300px; }
    .f-size { color: var(--text-secondary); font-size: 0.85rem; font-weight: 600; margin-top:2px; }
    .remove-btn { background: none; border: none; font-size: 1.2rem; cursor: pointer; opacity: 0.5; transition: 0.2s; padding: 8px; }
    .remove-btn:hover { opacity: 1; transform: scale(1.2); }

    .d-flex { display: flex; }
    .flex-column { flex-direction: column; }
    .align-center { align-items: center; }
    .justify-between { justify-content: space-between; }
    .gap-16 { gap: 16px; }
    .mt-16 { margin-top: 16px; }
    .mt-24 { margin-top: 24px; }
    .mt-32 { margin-top: 32px; }
    .mt-48 { margin-top: 48px; }
    .mb-16 { margin-bottom: 16px; }
    .m-0 { margin: 0; }
    .font-bold { font-weight:600; }
    .text-xl { font-size: 1.35rem; color: var(--text-primary); }

    .wide-btn { padding: 22px 24px; font-weight:600; font-size: 1.25rem; border-radius: 100px; display: block; }
    .small-btn { padding: 10px 18px; border-radius: 100px; font-weight:600; font-size: 0.95rem; }
    .hidden { display: none !important; }

    @media (max-width: 640px) {
        .f-name { max-width: 180px; }
        .upload-container { padding: 40px 16px; min-height: 300px; }
    }
</style>
