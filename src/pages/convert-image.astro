---
import BaseLayout from '../components/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import ToolWrapper from '../components/ToolWrapper.astro';

const PAGE_TITLE = 'FormFix – Convert PNG, JPG to WebP Online';
const PAGE_DESC = 'Instant local image conversion between PNG, JPG, and WebP. Improve website speed by converting to WebP for Google PageSpeed. 100% Secure, No Uploads.';
const PAGE_KEYWORDS = 'convert image to webp, png to jpeg converter, online image format converter, change image type online, webp to jpg conversion';

const customSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      "name": "Convert Image Format - FormFix",
      "operatingSystem": "All Platforms",
      "applicationCategory": "UtilitiesApplication",
      "description": "Instant local image conversion between PNG, JPG, and WebP.",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      }
    }
  ]
};

const faqs = [
  { q: "Does this work in bulk?", a: "This specific tool processes one high-quality image at a time to ensure maximum compression efficiency. For batch processing, stay tuned for our upcoming \"Bulk Converter\" module." },
  { q: "Is transparency preserved?", a: "Yes. If you choose PNG or WebP, transparency (Alpha channel) data is fully preserved. Choosing JPG will automatically replace transparency with a white background." },
];
---

<BaseLayout title={PAGE_TITLE} description={PAGE_DESC} keywords={PAGE_KEYWORDS} customSchema={customSchema} active="tools" canonicalPath="/convert-image" faq={faqs}>
    <script is:inline>
    document.addEventListener('DOMContentLoaded', () => { try {
        const uploadBox = document.getElementById('u-box-container');
        const controls = document.getElementById('controls');
        const fileInput = document.getElementById('convert-input');
        
        const formatBtns = document.querySelectorAll('.setting-pill');
        const qSlider = document.getElementById('q-slider');
        const qValLabel = document.getElementById('q-val');
        const qTextLabel = document.getElementById('quality-label');
        const estLabel = document.getElementById('est-size');
        const applyBtn = document.getElementById('apply-btn');
        const resultStage = document.getElementById('result-stage');

        let originalImg = null;
        let originalFile = null;
        let activeFormat = 'webp';

        fileInput.addEventListener('change', (e) => {
             const file = e.target.files?.[0];
             if (file) handleFile(file);
        });

        uploadBox.addEventListener('dragover', (e) => {
             e.preventDefault();
             uploadBox.querySelector('.upload-box').classList.add('drag-active');
        });
        uploadBox.addEventListener('dragleave', () => {
             uploadBox.querySelector('.upload-box').classList.remove('drag-active');
        });
        uploadBox.addEventListener('drop', (e) => {
             e.preventDefault();
             uploadBox.querySelector('.upload-box').classList.remove('drag-active');
             if (e.dataTransfer?.files.length) {
                 const dt = new DataTransfer();
                 dt.items.add(e.dataTransfer.files[0]);
                 fileInput.files = dt.files;
                 handleFile(e.dataTransfer.files[0]);
             }
        });

        function handleFile(file) {
             originalFile = file;
             const rd = new FileReader();
             rd.onload = (ev) => {
                 const img = new Image();
                 img.onload = () => {
                     originalImg = img;
                     uploadBox.classList.add('hidden');
                     controls.classList.remove('hidden');
                     runEst();
                 };
                 img.src = ev.target?.result;
             };
             rd.readAsDataURL(file);
        }

        formatBtns.forEach(btn => btn.addEventListener('click', () => {
             formatBtns.forEach(b => b.classList.remove('active'));
             btn.classList.add('active');
             activeFormat = btn.dataset.format;
             
             if(activeFormat === 'png') {
                 qSlider.disabled = true;
                 qTextLabel.textContent = 'Lossless';
                 qValLabel.textContent = '-';
             } else {
                 qSlider.disabled = false;
                 updateQText();
             }
             runEst();
        }));

        function updateQText() {
             const v = parseInt(qSlider.value);
             qValLabel.textContent = `${v}%`;
             if (v < 40) qTextLabel.textContent = 'Low Quality';
             else if (v < 75) qTextLabel.textContent = 'Balanced';
             else if (v < 90) qTextLabel.textContent = 'High Quality';
             else qTextLabel.textContent = 'Maximum Quality';
        }

        qSlider.addEventListener('input', () => {
             updateQText();
             runEst();
        });

        const runEst = () => {
             if (!originalFile) return;
             const q = activeFormat === 'png' ? 1 : parseInt(qSlider.value) / 100;
             let e = originalFile.size * (activeFormat === 'webp' ? q * 0.4 : activeFormat === 'jpg' ? q * 0.7 : 1.2);
             estLabel.textContent = `~${(e/1024).toFixed(1)} KB`;
        };

        applyBtn.addEventListener('click', () => {
            if (!originalImg) return;
            applyBtn.textContent = 'Processing...'; applyBtn.disabled = true;
            document.getElementById('convert-overlay-loading')?.classList.add('active');
            
            const q = activeFormat === 'png' ? 1 : parseInt(qSlider.value) / 100;
            const canvas = document.createElement('canvas');
            canvas.width = originalImg.naturalWidth; canvas.height = originalImg.naturalHeight;
            const ctx = canvas.getContext('2d', { alpha: activeFormat !== 'jpg' });
            
            if (activeFormat === 'jpg') {
                ctx.fillStyle = '#FFFFFF';
                ctx.fillRect(0, 0, canvas.width, canvas.height);
            }
            ctx.drawImage(originalImg, 0, 0);
            
            const mime = activeFormat === 'webp' ? 'image/webp' : activeFormat === 'jpg' ? 'image/jpeg' : 'image/png';
            canvas.toBlob(blob => {
                 const url = URL.createObjectURL(blob);
                 document.getElementById('image-preview').src = url;
                 document.getElementById('final-fmt-stat').textContent = activeFormat.toUpperCase();
                 document.getElementById('final-size-stat').textContent = `${(blob.size/1024).toFixed(1)} KB`;
                 document.getElementById('download-btn').href = url;
                 document.getElementById('download-btn').download = `formfix-converted.${activeFormat}`;
                 document.getElementById('download-btn').addEventListener('click', () => {
                     setTimeout(() => URL.revokeObjectURL(url), 100);
                 }, { once: true });
                 
                 controls.classList.add('hidden');
                 resultStage.classList.remove('hidden'); 
                 resultStage.scrollIntoView({ behavior: 'smooth' });
                 
                 if (typeof window.triggerConfetti === 'function') window.triggerConfetti();
                 
                 document.getElementById('convert-overlay-loading')?.classList.remove('active');
                 applyBtn.textContent = '⬇️ Convert & Save Image'; applyBtn.disabled = false;
             }, mime, q);
        });
    } catch(err) { console.error('Convert Image error:', err); if (typeof window.ffNotice === 'function') window.ffNotice('Something went wrong. Please try a different image.', 'error'); }
    });
</script>

    <Breadcrumb items={[{ name: 'Home', path: '/' }, { name: "FormFix – Convert PNG, JPG to WebP Online", path: "/convert-image" }]} />

    <ToolWrapper title="Image Format Converter" subtitle="Optimize for speed. Convert between PNG, JPG, and WebP instantly." currentTool="convert-image">
        
        <div slot="tool-ui">
             <div class="workspace-editor">
                  <!-- 1. Selection Stage -->
                  <div id="u-box-container" class="upload-container">
                       <div class="upload-box shadow-sm" id="drop-zone" onclick="document.getElementById('convert-input').click()">
                            <input type="file" id="convert-input" accept="image/png, image/jpeg, image/webp" class="hidden" />
                            <div class="upload-content">
                                 <div class="upload-icon">🔄</div>
                                 <h3 class="font-850 m-0 mb-8">Select Image to Convert</h3>
                                 <p class="text-muted m-0 mb-24 font-600">Change formats instantly. Works offline in your browser.</p>
                                 <button class="primary-btn px-40">Browse Graphic</button>
                            </div>
                       </div>
                  </div>

                  <!-- 2. Settings Stage -->
                   <div id="controls" class="hidden">
                        <div id="convert-overlay-loading" class="processing-overlay">
                             <div class="processing-spinner"></div>
                             <span class="processing-text">Converting...</span>
                        </div>
                        <div class="settings-grid mb-24 shadow-sm">
                            <div class="section m-0 border-box">
                                 <label class="section-label m-0 mb-12">1. Output Format</label>
                                 <div class="toggle-pill-group flex-wrap">
                                      <button class="setting-pill active" data-format="webp">WebP</button>
                                      <button class="setting-pill" data-format="jpg">JPG</button>
                                      <button class="setting-pill" data-format="png">PNG</button>
                                 </div>
                                 <p class="helper-text text-muted mb-0 font-600 mt-12 small">💡 WebP is typically 30% smaller than JPG.</p>
                            </div>

                            <div class="section flex-col justify-center border-box">
                                 <div class="d-flex justify-between align-center mb-8">
                                      <label class="section-label m-0">2. Quality</label>
                                      <div id="est-size" class="status-pill highlight m-0" style="padding: 4px 12px; border-radius:100px;">~0 KB</div>
                                 </div>
                                 <input type="range" id="q-slider" min="10" max="100" value="85" class="unified-slider mb-12 w-100" />
                                 <div class="d-flex justify-between align-center">
                                      <span id="quality-label" class="text-muted font-600 small">High Quality</span>
                                      <span id="q-val" class="font-850 text-accent" style="font-size:0.95rem;">85%</span>
                                 </div>
                            </div>
                       </div>

                       <div class="action-stack">
                            <button id="apply-btn" class="primary-btn wide-btn pulse-glow mb-12">⬇️ Convert & Save Image</button>
                            <p class="privacy-note text-center m-0 font-600 mt-16 mb-0 text-muted">🔒 Local Processing. No uploads.</p>
                       </div>
                  </div>

                  <!-- 3. Result Stage -->
                  <div id="result-stage" class="result-stage hidden mt-24">
                       <div class="result-card shadow-sm">
                            <div class="success-banner mb-32">
                                 <div class="check-icon">✔</div>
                                 <div class="success-info">
                                      <h4 class="font-850 m-0 mb-8">Conversion Complete</h4>
                                      <p class="text-muted m-0 small font-600">Your image is professionally optimized.</p>
                                 </div>
                            </div>

                            <div class="preview-panel checkerboard shadow-sm mb-32">
                                 <img id="image-preview" src="" alt="Converted result" class="styled-canvas" loading="lazy" decoding="async" />
                            </div>

                            <div class="stats-grid mb-32">
                                 <div class="mini-stat active">
                                      <label>Format</label>
                                      <span id="final-fmt-stat">WEBP</span>
                                 </div>
                                 <div class="mini-stat">
                                      <label>Est. Size</label>
                                      <span id="final-size-stat">0 KB</span>
                                 </div>
                            </div>

                            <div class="d-flex gap-16">
                                 <a id="download-btn" href="#" class="primary-btn flex-2 wide-btn" style="text-decoration:none;">⬇️ Download Formatted Image</a>
                                 <button class="secondary-btn flex-1 wide-btn" onclick="location.reload()">↺ Start New</button>
                            </div>
                       </div>
                  </div>
             </div>
        </div>

        <div slot="tool-info">
             <h2>Local High-Speed Conversion</h2>
             <p>Our <strong>Online Image Converter</strong> processes files entirely within your browser's V8 engine. By using client-side canvas rendering, we offer zero-latency conversion for PNG to WebP or JPG to WebP transformations.</p>
             
             <div class="faq-grid mt-32">
                  <details class="faq-item">
                       <summary>Does this work in bulk?</summary>
                       <p>This specific tool processes one high-quality image at a time to ensure maximum compression efficiency. For batch processing, stay tuned for our upcoming "Bulk Converter" module.</p>
                  </details>
                  <details class="faq-item">
                       <summary>Is transparency preserved?</summary>
                       <p>Yes. If you choose <strong>PNG</strong> or <strong>WebP</strong>, transparency (Alpha channel) data is fully preserved. Choosing JPG will automatically replace transparency with a white background.</p>
                  </details>
             </div>
        </div>
    </ToolWrapper>
</BaseLayout><style>
    .workspace-editor { display: flex; flex-direction: column; width: 100%; max-width: 1000px; margin: 0 auto; }
    
    .upload-container { display: flex; justify-content: center; }
    .upload-box { background: var(--surface-3); border: 2.5px dashed var(--border-subtle); border-radius: 32px; padding: 60px 40px; text-align: center; width: 100%; cursor: pointer; transition: 0.2s; }
    .upload-box:hover, .upload-box.drag-active { border-color: var(--accent-primary); background: var(--surface-2); }
    .upload-icon { font-size: 3.5rem; margin-bottom: 24px; line-height: 1; }

    .settings-grid { display: grid; grid-template-columns: 1.2fr 1fr; gap: 24px; padding: 24px; background: var(--surface-3); border-radius: 24px; border: 1px solid var(--border-subtle); }
    .section-label { font-size: 0.75rem; font-weight:600; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em; display: block; }
    
    .toggle-pill-group { display: flex; background: var(--border-subtle); padding: 6px; border-radius: 12px; gap:4px; }
    .setting-pill { flex: 1; padding: 10px 16px; border-radius: 10px; font-weight:600; font-size: 0.85rem; background: transparent; border: none; cursor: pointer; transition: 0.2s; color: var(--text-muted); text-align: center; }
    .setting-pill:hover { color: var(--text-primary); }
    .setting-pill.active { background:var(--surface-3); color: var(--accent-primary); box-shadow: var(--shadow-sm); }
    .setting-pill:disabled { opacity: 0.5; cursor: not-allowed; }

    .status-pill { font-size: 0.75rem; font-weight:600; color: var(--accent-primary); background:var(--surface-3); padding: 4px 12px; border-radius: 100px; border: 1px solid var(--border-subtle); display: inline-flex; align-items: center; justify-content: center; }
    .status-pill.highlight { border-color: var(--accent-primary); }
    
    .unified-slider { width: 100%; height: 6px; border-radius: 100px; background: var(--border-subtle); appearance: none; outline: none; margin: 0; }
    .unified-slider::-webkit-slider-thumb { appearance: none; width: 24px; height: 24px; background: var(--accent-primary); border-radius: 50%; border:4px solid var(--border-subtle); box-shadow: var(--shadow-sm); cursor: pointer; transition: transform 0.1s; }
    .unified-slider::-webkit-slider-thumb:hover { transform: scale(1.1); }
    .unified-slider:disabled { opacity: 0.5; cursor: not-allowed; }

    .action-stack { display: flex; flex-direction: column; }
    .wide-btn { height: 60px; font-weight:600; font-size: 1rem; border-radius: 16px; width: 100%; box-sizing: border-box; display: flex; justify-content: center; align-items: center; }
    .privacy-note { font-size: 0.8rem; color: var(--text-muted); text-align: center;}

    /* Result Stage */
    .result-card { background:var(--surface-3); border: 1px solid var(--border-subtle); border-radius: 32px; padding: 40px; }
    .success-banner { display: flex; align-items: center; gap: 16px; background: var(--surface-3); border: 1px solid var(--border-subtle); padding: 20px; border-radius: 20px; }
    .check-icon { width: 40px; height: 40px; background: var(--accent-primary); color: #fff; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 1.25rem; font-weight:600; flex-shrink: 0; }
    
    .preview-panel { padding: 32px; border-radius: 24px; border: 1px solid var(--border-subtle); display: flex; align-items: center; justify-content: center; min-height: 250px; background:var(--surface-3); }
    .styled-canvas { max-width: 100%; max-height: 300px; display: block; filter: drop-shadow(0 15px 40px rgba(0,0,0,0.1)); }
    
    .checkerboard { 
        background-color:var(--surface-3);
        background-image: linear-gradient(45deg, var(--surface-2) 25%, transparent 25%, transparent 75%, var(--surface-2) 75%, var(--surface-2)), 
                          linear-gradient(45deg, var(--surface-2) 25%, transparent 25%, transparent 75%, var(--surface-2) 75%, var(--surface-2));
        background-size: 20px 20px; background-position: 0 0, 10px 10px;
    }

    .stats-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
    .mini-stat { background: var(--surface-3); padding: 24px; border-radius: 20px; border: 1px solid var(--border-subtle); text-align: center; }
    .mini-stat.active { border-color: var(--accent-primary); background:var(--surface-3); box-shadow: var(--shadow-sm); }
    .mini-stat label { font-size: 0.72rem; font-weight:600; color: var(--text-muted); text-transform: uppercase; display: block; margin-bottom: 6px; }
    .mini-stat span { font-size: 1.2rem; font-weight:600; color: var(--text-primary); }

    /* FAQ */
    .faq-grid { display: grid; gap: 16px; }
    .faq-item { background:var(--surface-3); border: 1px solid var(--border-subtle); border-radius: var(--radius-sm); overflow: hidden; text-align: left; }
    .faq-item summary { font-weight:600; font-size: 1rem; padding: 16px 20px; cursor: pointer; color: var(--text-primary); list-style-type: none; position: relative; }
    .faq-item summary::after { content: '+'; position: absolute; right: 20px; font-weight:600; font-size: 1.2rem; color: var(--accent-primary); }
    .faq-item[open] summary::after { content: '−'; }
    .faq-item p { padding: 0 20px 20px; margin: 0; font-size: 0.95rem; color: var(--text-muted); line-height: 1.6; }

    .flex-col { display: flex; flex-direction: column; }
    .text-accent { color: var(--accent-primary); }
    .text-green { color: var(--success); }

    @media (max-width: 768px) {
        .settings-grid { grid-template-columns: 1fr; }
        .stats-grid { grid-template-columns: 1fr; }
        .d-flex.gap-16 { flex-direction: column; }
    }
    @media (max-width: 640px) {
        .upload-box { padding: 40px 24px; }
        .result-card { padding: 20px; }
    }
</style>
