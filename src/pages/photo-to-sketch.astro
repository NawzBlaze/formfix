---
import BaseLayout from '../components/BaseLayout.astro';
import RelatedTools from '../components/RelatedTools.astro';

const PAGE_TITLE = 'Photo to Pencil Sketch Online - Free Line Art Maker';
const PAGE_DESC = 'Turn your favorite photos into beautiful pencil sketches and minimalist line art drawings in seconds. 100% free, private sketch effect generator.';
const PAGE_KEYWORDS = 'photo to sketch, picture to line art, turn photo into drawing, online pencil sketch maker, pencil sketch effect filter';

const customSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      "name": "FormFix Pro Sketch Maker",
      "operatingSystem": "All",
      "applicationCategory": "MultimediaApplication",
      "description": "Convert any image into a high-quality pencil sketch or line art drawing instantly.",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      }
    }
  ]
};
---

<BaseLayout title={PAGE_TITLE} description={PAGE_DESC} keywords={PAGE_KEYWORDS} customSchema={customSchema} active="tools" canonicalPath="/photo-to-sketch">
    <div class="tool-wrapper animate-in">
        <header class="tool-intro text-center">
             <div class="brand-badge shadow-sm">✏️ Canvas AI Filter</div>
             <h1 class="main-h1">Photo to <span class="highlight">Pencil Sketch</span></h1>
             <p class="hero-sub">Transform your photography into beautiful, hand-drawn vector-style pencil sketches instantly.</p>
        </header>

        <div class="glass-card tool-content shadow-lg max-w-lg mx-auto">
            
            <div id="upload-stage" class="upload-container shadow-sm">
                 <div class="upload-circle mb-16"><span class="u-icon">🖼️</span></div>
                 <h3 class="u-title">Upload a Photo</h3>
                 <p class="u-sub">JPG, PNG, or WebP. Portraits look fantastic!</p>
                 <button class="primary-btn wide-btn profile-btn pulse-glow" onclick="document.getElementById('image-upload').click()">Browse Photo</button>
                 <input type="file" id="image-upload" class="hidden" accept="image/png, image/jpeg, image/webp" />
            </div>

            <div id="editor-stage" class="hidden">
                 <div class="img-preview mb-24">
                     <canvas id="sketch-canvas" class="styled-canvas"></canvas>
                 </div>
                 
                 <div class="control-panel">
                      <div class="d-flex justify-between mb-12">
                           <span class="font-bold">Sketch Intensity</span>
                      </div>
                      <input type="range" id="intensity-slider" min="1" max="100" value="50" class="modern-slider mb-16" title="Control the thickness and detail of lines" />
                 </div>
                 
                 <div class="d-flex gap-16 mt-24 wrap-mobile">
                      <button id="reset-btn" class="secondary-btn wide-btn-half profile-btn">Start Over</button>
                      <button id="download-btn" class="primary-btn wide-btn profile-btn pulse-glow" style="flex:1;">⬇️ Download Sketch</button>
                 </div>
            </div>

        </div>

        <article class="pro-seo-article container mt-48">
             <h2>Turn Pictures into Hand-Drawn Sketches</h2>
             <p>Our completely free <strong>Online Pencil Sketch Maker</strong> takes your colorful photographs and strips them down to beautiful line art. Whether you're looking to create an elegant portrait drawing for social media, or a minimalist outline for a project, our edge-detection sketching engine produces incredibly clean results. No more paying for expensive apps or designers.</p>
             
             <h3 class="mt-32">How the Sketch Filter Works</h3>
             <ul style="color:var(--slate); line-height:1.8; margin-left:20px; font-size:1.1rem">
                <li><strong>Browser Engine:</strong> We utilize advanced HTML5 edge-detection kernels that run within your device processor. This means the lines are drawn instantly without lag.</li>
                <li><strong>Intensity Slider:</strong> Some photos have too many background patterns. Just lower the Sketch Intensity slider to remove background noise and isolate faces and important outlines.</li>
             </ul>
        </article>

        <RelatedTools currentTool="photo-to-sketch" />
    </div>
</BaseLayout>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const fileInput = document.getElementById('image-upload') as HTMLInputElement;
        const uploadStage = document.getElementById('upload-stage') as HTMLElement;
        const editorStage = document.getElementById('editor-stage') as HTMLElement;
        const downloadBtn = document.getElementById('download-btn') as HTMLButtonElement;
        const resetBtn = document.getElementById('reset-btn') as HTMLButtonElement;
        
        const canvas = document.getElementById('sketch-canvas') as HTMLCanvasElement;
        const ctx = canvas.getContext('2d', { willReadFrequently: true })!;
        
        const intensitySlider = document.getElementById('intensity-slider') as HTMLInputElement;

        let originalImage = new Image();
        let fileName = 'image.png';
        let originalImageData: ImageData;

        fileInput.addEventListener('change', (e: any) => {
            const file = e.target.files[0];
            if(!file) return;
            fileName = file.name;
            
            const reader = new FileReader();
            reader.onload = (event) => {
                originalImage.onload = () => {
                    const MAX_WIDTH = 1200;
                    if(originalImage.width > MAX_WIDTH) {
                        const ratio = MAX_WIDTH / originalImage.width;
                        canvas.width = MAX_WIDTH;
                        canvas.height = originalImage.height * ratio;
                    } else {
                        canvas.width = originalImage.width;
                        canvas.height = originalImage.height;
                    }
                    
                    ctx.drawImage(originalImage, 0, 0, canvas.width, canvas.height);
                    originalImageData = ctx.getImageData(0, 0, canvas.width, canvas.height);
                    
                    uploadStage.classList.add('hidden');
                    editorStage.classList.remove('hidden');
                    
                    applyFilters();
                };
                originalImage.src = event.target?.result as string;
            };
            reader.readAsDataURL(file);
        });

        function applyFilters() {
            if(!originalImage.src) return;
            
            const intensity = parseInt(intensitySlider.value);
            // Translate slider (1-100) to blur radius for shading
            const blurRadius = 2 + (intensity / 100) * 16;

            const w = canvas.width;
            const h = canvas.height;
            
            // 1. Create Grayscale Base
            const baseCanvas = document.createElement('canvas');
            baseCanvas.width = w; baseCanvas.height = h;
            const baseCtx = baseCanvas.getContext('2d')!;
            baseCtx.filter = 'grayscale(100%)';
            baseCtx.drawImage(originalImage, 0, 0, w, h);
            
            // 2. Create Inverted & Blurred Layer
            const blurCanvas = document.createElement('canvas');
            blurCanvas.width = w; blurCanvas.height = h;
            const blurCtx = blurCanvas.getContext('2d')!;
            blurCtx.filter = `grayscale(100%) invert(100%) blur(${blurRadius}px)`;
            blurCtx.drawImage(originalImage, 0, 0, w, h);
            
            // 3. Blend Layers via Color Dodge (Photoshop Sketch Technique)
            ctx.clearRect(0, 0, w, h);
            ctx.globalCompositeOperation = 'source-over';
            ctx.drawImage(baseCanvas, 0, 0, w, h);
            
            ctx.globalCompositeOperation = 'color-dodge';
            ctx.drawImage(blurCanvas, 0, 0, w, h);
            
            // 4. Boost Contrast slightly for cleaner lines
            ctx.globalCompositeOperation = 'multiply';
            ctx.globalAlpha = 0.3;
            ctx.drawImage(baseCanvas, 0, 0, w, h);
            
            ctx.globalCompositeOperation = 'source-over'; // Reset
            ctx.globalAlpha = 1.0;
        }

        intensitySlider.addEventListener('input', applyFilters);

        resetBtn.addEventListener('click', () => {
            originalImage = new Image();
            fileInput.value = '';
            intensitySlider.value = '50';
            uploadStage.classList.remove('hidden');
            editorStage.classList.add('hidden');
        });

        downloadBtn.addEventListener('click', () => {
            const ext = fileName.split('.').pop() || 'jpg';
            const mimeType = ext.toLowerCase() === 'png' ? 'image/png' : 'image/jpeg';
            const finalName = fileName.replace(/\.[^/.]+$/, "") + "_sketch." + ext;
            
            const link = document.createElement('a');
            link.download = finalName;
            link.href = canvas.toDataURL(mimeType, 0.95);
            link.click();
        });
    });
</script>

<style>
    .main-h1 { font-size: 3.5rem; font-weight: 1000; letter-spacing: -0.05em; margin-bottom: 12px; color: var(--dark); line-height: 1.1; }
    .hero-sub { color: var(--slate); font-weight: 600; font-size: 1.25rem; margin-bottom: 24px; }
    .tool-wrapper { max-width: 960px; margin: 0 auto; padding-bottom: 100px; }
    .max-w-lg { max-width: 550px; margin-inline: auto; }
    
    .upload-container { background: #f8fafc; border: 2.5px dashed var(--border); border-radius: 32px; padding: 60px 20px; text-align: center; cursor: pointer; transition: 0.3s; margin-top:16px; min-height: 380px; display: flex; flex-direction: column; align-items: center; justify-content: center; }
    .upload-container:hover { border-color: var(--primary); background: #f0fdf4; transform: translateY(-4px); }
    .upload-circle { width: 90px; height: 90px; background: #fff; border-radius: 50%; box-shadow: 0 10px 25px rgba(0,0,0,0.05); display: flex; align-items: center; justify-content: center; margin: 0 auto 20px; font-size: 3rem; }
    .u-title { font-size: 1.8rem; font-weight: 1000; color: var(--dark); margin-bottom: 8px; }
    .u-sub { font-size: 1.1rem; color: var(--slate); font-weight: 600; margin-bottom: 32px; }

    #editor-stage { background: #fff; padding: 24px; border-radius: 24px; border: 1.5px solid var(--border); }
    .img-preview { width: 100%; max-height: 350px; background: #fafbfc; border-radius: 16px; display: flex; justify-content: center; align-items: center; overflow: hidden; border: 2px dashed #cbd5e1; padding: 8px; }
    .styled-canvas { max-width: 100%; max-height: 100%; object-fit: contain; border-radius: 8px; box-shadow: 0 4px 10px rgba(0,0,0,0.1); background: #fff; }
    
    .control-panel { background: #f8fafc; padding: 20px; border-radius: 16px; border: 1px solid var(--border); }
    .modern-slider { -webkit-appearance: none; width: 100%; height: 8px; border-radius: 5px; background: #e2e8f0; outline: none; margin-top: 8px; }
    .modern-slider::-webkit-slider-thumb { -webkit-appearance: none; appearance: none; width: 24px; height: 24px; border-radius: 50%; background: var(--primary); cursor: pointer; border: 4px solid #fff; box-shadow: 0 2px 6px rgba(0,0,0,0.2); }
    
    .d-flex { display: flex; }
    .justify-between { justify-content: space-between; }
    .font-bold { font-weight: 900; color: var(--dark); }
    .mb-12 { margin-bottom: 12px; }
    .mb-16 { margin-bottom: 16px; }
    .mb-24 { margin-bottom: 24px; }
    .mt-24 { margin-top: 24px; }
    .mt-32 { margin-top: 32px; }
    .mt-48 { margin-top: 48px; }
    .gap-16 { gap: 16px; }
    
    .wide-btn { padding: 22px 24px; font-weight: 1000; font-size: 1.25rem; border-radius: 100px; display: block; }
    .wide-btn-half { padding: 20px 32px; font-weight: 1000; font-size: 1.15rem; border-radius: 100px; min-width: 140px; }
    .hidden { display: none !important; }

    @media (max-width: 640px) {
        .wrap-mobile { flex-direction: column; }
        .wide-btn, .wide-btn-half { width: 100%; }
        .img-preview { max-height: 250px; }
    }
</style>
