    .choice-card { background:var(--surface-3); border: 1px solid var(--border-subtle); border-radius: var(--radius-md); padding: 32px; cursor: pointer; transition: 0.2s; text-align: center; display: flex; flex-direction: column; align-items: center; gap: 16px; width: 100%; }
    .choice-card:hover { border-color: var(--accent-primary); background: var(--surface-50); transform: translateY(-4px); }
    .choice-icon { width: 64px; height: 64px; background: var(--surface-100); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 2rem; transition: 0.2s; }
    .choice-card:hover .choice-icon { background: var(--accent-primary); color: #fff; }
