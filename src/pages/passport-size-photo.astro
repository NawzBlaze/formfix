---
import BaseLayout from '../components/BaseLayout.astro';
import RelatedTools from '../components/RelatedTools.astro';

const PAGE_TITLE = 'Official Passport Size Photo & Signature Maker - FormFix';
const PAGE_DESC = 'Create official 3.5cm x 4.5cm passport photos and clean transparent signatures for SSC, UPSC, and Banking forms. High-quality 1-click processing.';
const PAGE_KEYWORDS = 'passport photo maker online, ssc photo resize, upsc signature maker, official passport size photo, signature background remover, banking form photo';

const customSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      "name": "Passport Photo & Signature Maker",
      "operatingSystem": "All",
      "applicationCategory": "MultimediaApplication",
      "description": "Professional tool for creating official passport size photos and signatures for competitive exam forms.",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      }
    }
  ]
};
---

<BaseLayout title={PAGE_TITLE} description={PAGE_DESC} keywords={PAGE_KEYWORDS} customSchema={customSchema} active="passport-maker" canonicalPath="/passport-size-photo">
    <div class="tool-wrapper animate-in">
        <header class="tool-intro text-center">
             <div class="brand-badge shadow-sm">🪄 Pro Form Toolkit</div>
             <h1 class="main-h1">Passport <span class="highlight">& Signature</span> Maker</h1>
             <p class="hero-sub">Get your photo and signature ready for any official application in 1-Click.</p>
        </header>

        <div class="glass-card tool-content shadow-lg">
            <!-- 1. Selection Step -->
            <div id="selection-panel" class="step-panel text-center">
                <h3 class="step-title">Choose your document type</h3>
                <div class="choice-grid mt-32">
                    <button class="choice-card" onclick="document.getElementById('photo-input').click()">
                        <div class="choice-icon">📸</div>
                        <div class="choice-text">
                            <h4>Passport Photo</h4>
                            <p>Auto-Crop to 3.5cm x 4.5cm</p>
                        </div>
                        <input type="file" id="photo-input" accept="image/*" style="display:none" />
                    </button>

                    <button class="choice-card" onclick="document.getElementById('sign-input').click()">
                        <div class="choice-icon">✍️</div>
                        <div class="choice-text">
                            <h4>Signature Maker</h4>
                            <p>Remove Background & Fix Ink</p>
                        </div>
                        <input type="file" id="sign-input" accept="image/*" style="display:none" />
                    </button>
                </div>
                <p class="u-sub mt-48">100% Private: All processing happens on your device.</p>
            </div>

            <!-- 2. Workspace Panel -->
            <div id="workspace-panel" class="step-panel" style="display: none;">
                <div class="workspace-header mb-24">
                    <div class="flex-between">
                        <h2 id="work-title" class="section-title">Editing Document</h2>
                        <button class="secondary-btn btn-sm" onclick="location.reload()">↺ Change Image</button>
                    </div>
                </div>

                <div class="workspace-layout">
                    <!-- Preview Area -->
                    <div class="preview-wrap">
                        <div class="canvas-container shadow-lg checkerboard" id="pinch-area">
                            <canvas id="active-canvas"></canvas>
                            <!-- Interactive Crop Overlay for Photos -->
                            <div id="crop-overlay" class="crop-frame" style="display:none;"></div>
                        </div>
                        <p class="hint-text text-center mt-12" id="drag-hint">👉 Use mouse to drag and center your photo.</p>
                    </div>

                    <!-- Controls Area -->
                    <div class="controls-area">
                        <!-- Passport Controls -->
                        <div id="photo-controls" style="display: none;">
                            <div class="control-box">
                                <label>Paper Background</label>
                                <div class="toggle-group">
                                    <button class="toggle-btn active" id="bg-orig">Original</button>
                                    <button class="toggle-btn" id="bg-white">Pure White</button>
                                </div>
                            </div>
                            <div class="control-box mt-24">
                                <label>Image Settings</label>
                                <div class="slider-item">
                                    <span>Brightness</span>
                                    <input type="range" id="photo-bright" min="50" max="150" value="100" class="styled-slider" />
                                </div>
                                <div class="slider-item mt-16">
                                    <span>Zoom Image</span>
                                    <input type="range" id="photo-zoom" min="0.5" max="3" step="0.05" value="1" class="styled-slider" />
                                </div>
                            </div>
                            <div class="action-box mt-48">
                                <button id="dl-photo" class="primary-btn full-w pulse-glow shadow-md">Download Passport (JPG)</button>
                                <div class="spec-badge mt-16 text-center">Format: 3.5cm x 4.5cm (Official)</div>
                            </div>
                        </div>

                        <!-- Signature Controls -->
                        <div id="sign-controls" style="display: none;">
                            <div class="control-box">
                                <label>Enhancement</label>
                                <div class="slider-item">
                                    <span>Ink Sensitivity</span>
                                    <input type="range" id="sign-thresh" min="50" max="230" value="180" class="styled-slider" />
                                </div>
                            </div>
                            <div class="control-box mt-24">
                                <label>Ink Color</label>
                                <div class="toggle-group">
                                    <button class="toggle-btn active" id="ink-orig">Original</button>
                                    <button class="toggle-btn" id="ink-black">Pure Black</button>
                                    <button class="toggle-btn" id="ink-blue">Blue Ink</button>
                                </div>
                            </div>
                            <div class="action-box mt-48">
                                <button id="dl-sign" class="primary-btn full-w pulse-glow shadow-md">Download Signature (PNG)</button>
                                <div class="spec-badge mt-16 text-center">Pure Transparent Background</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <RelatedTools currentTool="passport-maker" />
    </div>
</BaseLayout>

<script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
        const pInput = document.getElementById('photo-input');
        const sInput = document.getElementById('sign-input');
        const canvas = document.getElementById('active-canvas');
        const ctx = canvas.getContext('2d', { willReadFrequently: true });
        
        const selectionPanel = document.getElementById('selection-panel');
        const workspacePanel = document.getElementById('workspace-panel');
        const photoControls = document.getElementById('photo-controls');
        const signControls = document.getElementById('sign-controls');
        const cropOverlay = document.getElementById('crop-overlay');
        const dragHint = document.getElementById('drag-hint');

        let originalImg = null;
        let mode = ''; 
        let imgX = 0, imgY = 0, imgScale = 1, baseScale = 1;
        let isDragging = false, lastMouseX = 0, lastMouseY = 0;
        let activeBg = 'orig';
        let activeInk = 'orig';

        pInput.addEventListener('change', (e) => handleUpload(e, 'photo'));
        sInput.addEventListener('change', (e) => handleUpload(e, 'sign'));

        function handleUpload(e, type) {
            const file = e.target.files[0];
            if (!file) return;
            mode = type;
            const reader = new FileReader();
            reader.onload = (ev) => {
                originalImg = new Image();
                originalImg.onload = () => {
                    selectionPanel.style.display = 'none';
                    workspacePanel.style.display = 'block';
                    
                    if (mode === 'photo') {
                        photoControls.style.display = 'block';
                        cropOverlay.style.display = 'block';
                        dragHint.innerText = "👉 Drag to center your face in the box.";
                        initPhoto();
                    } else {
                        signControls.style.display = 'block';
                        dragHint.style.display = 'none';
                        initSign();
                    }
                };
                originalImg.src = ev.target.result;
            };
            reader.readAsDataURL(file);
        }

        // --- PASSPORT PHOTO LOGIC ---
        function initPhoto() {
            canvas.width = 600;
            canvas.height = 800; // 3.5:4.5 roughly 3:4
            document.getElementById('photo-zoom').value = "1";
            baseScale = Math.max(canvas.width / originalImg.width, canvas.height / originalImg.height);
            // Default: fit the screen perfectly
            imgScale = baseScale;
            imgX = (canvas.width - originalImg.width * imgScale) / 2;
            imgY = (canvas.height - originalImg.height * imgScale) / 2;
            render();
        }

        // --- SIGNATURE LOGIC ---
        function initSign() {
            canvas.width = originalImg.width;
            canvas.height = originalImg.height;
            render();
        }

        function render() {
            if (!originalImg) return;
            ctx.clearRect(0, 0, canvas.width, canvas.height);

            if (mode === 'photo') {
                if (activeBg === 'white') { ctx.fillStyle = "#fff"; ctx.fillRect(0,0,canvas.width, canvas.height); }
                ctx.filter = `brightness(${document.getElementById('photo-bright').value}%)`;
                ctx.drawImage(originalImg, imgX, imgY, originalImg.width * imgScale, originalImg.height * imgScale);
            } else {
                ctx.drawImage(originalImg, 0, 0);
                applySignFilter();
            }
        }

        function applySignFilter() {
             const imgData = ctx.getImageData(0, 0, canvas.width, canvas.height);
             const data = imgData.data;
             const thresh = parseInt(document.getElementById('sign-thresh').value);

             for (let i = 0; i < data.length; i += 4) {
                 const b = (data[i] + data[i+1] + data[i+2]) / 3;
                 if (b > thresh) { data[i+3] = 0; }
                 else {
                     if (activeInk === 'black') { data[i]=0; data[i+1]=0; data[i+2]=0; }
                     else if (activeInk === 'blue') { data[i]=0; data[i+1]=50; data[i+2]=180; }
                 }
             }
             ctx.putImageData(imgData, 0, 0);
        }

        // INTERACTION LOGIC
        canvas.addEventListener('pointerdown', (e) => {
            if (mode !== 'photo') return;
            isDragging = true;
            lastMouseX = e.clientX; lastMouseY = e.clientY;
        });

        let isRenderPending = false;
        window.addEventListener('pointermove', (e) => {
            if (!isDragging) return;
            const dx = (e.clientX - lastMouseX);
            const dy = (e.clientY - lastMouseY);
            imgX += dx; imgY += dy;
            lastMouseX = e.clientX; lastMouseY = e.clientY;
            
            if (!isRenderPending) {
                isRenderPending = true;
                requestAnimationFrame(() => {
                    render();
                    isRenderPending = false;
                });
            }
        });

        window.addEventListener('pointerup', () => isDragging = false);

        // CONTROLS LISTENERS
        document.getElementById('photo-bright').addEventListener('input', render);
        
        document.getElementById('photo-zoom').addEventListener('input', (e) => {
            const oldWidth = originalImg.width * imgScale;
            const oldHeight = originalImg.height * imgScale;
            
            imgScale = baseScale * parseFloat(e.target.value);
            
            const newWidth = originalImg.width * imgScale;
            const newHeight = originalImg.height * imgScale;
            
            // Adjust position so it zooms from the center by default
            imgX -= (newWidth - oldWidth) / 2;
            imgY -= (newHeight - oldHeight) / 2;
            
            render();
        });

        document.getElementById('sign-thresh').addEventListener('input', render);
        
        document.getElementById('bg-orig').addEventListener('click', (e) => { activeBg='orig'; toggleActive(e); render(); });
        document.getElementById('bg-white').addEventListener('click', (e) => { activeBg='white'; toggleActive(e); render(); });
        
        document.getElementById('ink-orig').addEventListener('click', (e) => { activeInk='orig'; toggleActive(e); render(); });
        document.getElementById('ink-black').addEventListener('click', (e) => { activeInk='black'; toggleActive(e); render(); });
        document.getElementById('ink-blue').addEventListener('click', (e) => { activeInk='blue'; toggleActive(e); render(); });

        function toggleActive(e) {
            const btns = e.target.parentElement.querySelectorAll('.toggle-btn');
            btns.forEach(b => b.classList.remove('active'));
            e.target.classList.add('active');
        }

        document.getElementById('dl-photo').addEventListener('click', () => {
            const link = document.createElement('a'); link.download = "passport_formfix.jpg";
            link.href = canvas.toDataURL('image/jpeg', 0.9); link.click();
            if (typeof window.triggerConfetti === 'function') window.triggerConfetti();
        });
        document.getElementById('dl-sign').addEventListener('click', () => {
            const link = document.createElement('a'); link.download = "signature_formfix.png";
            link.href = canvas.toDataURL('image/png'); link.click();
            if (typeof window.triggerConfetti === 'function') window.triggerConfetti();
        });
    });
</script>

<style>
    .main-h1 { font-size: 3rem; font-weight: 1000; letter-spacing: -0.05em; margin-bottom: 4px; color: var(--dark); line-height: 1.1; }
    .hero-sub { color: var(--slate); font-weight: 600; font-size: 1.15rem; margin-bottom: 24px; }
    .tool-wrapper { max-width: 1000px; margin: 0 auto; padding-bottom: 100px; }

    .choice-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
    @media (max-width: 700px) { .choice-grid { grid-template-columns: 1fr; } }

    .choice-card { 
        background: #fff; border: 1.5px solid var(--border-light); border-radius: 28px; padding: 40px; 
        text-align: left; cursor: pointer; transition: var(--transition-smooth); display: flex; align-items: center; gap: 24px;
        box-shadow: var(--shadow-sm);
    }
    .choice-card:hover { border-color: var(--primary-mid); background: var(--bg-subtle); transform: translateY(-6px); box-shadow: var(--shadow-lg); }
    .choice-icon { font-size: 2.5rem; background: var(--primary-light); width: 84px; height: 84px; display: flex; align-items: center; justify-content: center; border-radius: 22px; transition: 0.3s; }
    .choice-card:hover .choice-icon { transform: scale(1.1) rotate(5deg); background: var(--primary); color: #fff; }

    .workspace-layout { display: grid; grid-template-columns: 1fr 340px; gap: 40px; }
    @media (max-width: 900px) { .workspace-layout { grid-template-columns: 1fr; } }

    .canvas-container { 
        background: #f4f6f8; border-radius: 24px; min-height: 500px; display: flex; 
        align-items: center; justify-content: center; overflow: hidden; border: 2.5px solid var(--border);
        position: relative; cursor: move;
    }
    #active-canvas { max-width: 100%; max-height: 700px; box-shadow: var(--shadow-lg); transition: filter 0.2s; }
    
    @media (max-width: 768px) {
        .canvas-container { min-height: 380px; }
        #active-canvas { max-height: 450px; }
        .controls-area { padding: 24px; }
        .choice-card { padding: 24px; flex-direction: column; text-align: center; gap: 16px; }
    }

    .crop-frame { 
        position: absolute; top: 10%; left: 15%; right: 15%; bottom: 10%; 
        border: 2.5px dashed var(--primary); pointer-events: none; border-radius: 4px;
        box-shadow: 0 0 0 1000px rgba(0,0,0,0.4);
    }

    .controls-area { background: #fff; border-radius: 28px; padding: 36px; border: 1.5px solid var(--border-light); box-shadow: var(--shadow-soft); }
    .control-box label { display: block; font-size: 0.72rem; font-weight: 1000; color: var(--gray); text-transform: uppercase; margin-bottom: 14px; letter-spacing: 0.08em; }
    
    .slider-item { color: var(--slate); font-weight: 800; font-size: 0.9rem; }
    .slider-item input { margin-top: 10px; }

    .toggle-group { display: flex; gap: 8px; }
    .toggle-btn { flex: 1; padding: 12px; border-radius: 12px; border: 1.5px solid var(--border); background: #fff; font-weight: 800; cursor: pointer; transition: 0.2s; }
    .toggle-btn.active { background: var(--dark); color: #fff; border-color: var(--dark); }

    .spec-badge { background: #f1f5f9; padding: 10px; border-radius: 10px; font-size: 0.8rem; font-weight: 900; color: var(--slate); letter-spacing: 0.05em; border: 1px dashed var(--border); }

    .checkerboard { 
        background-color: #ffffff;
        background-image: linear-gradient(45deg, #f1f5f9 25%, transparent 25%, transparent 75%, #f1f5f9 75%, #f1f5f9), 
                          linear-gradient(45deg, #f1f5f9 25%, transparent 25%, transparent 75%, #f1f5f9 75%, #f1f5f9);
        background-size: 20px 20px;
        background-position: 0 0, 10px 10px;
    }
    .full-w { width: 100%; height: 68px; border-radius: 20px; font-size: 1.15rem; }
</style>
