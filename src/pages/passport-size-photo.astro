---
import BaseLayout from '../components/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import ToolWrapper from '../components/ToolWrapper.astro';

const PAGE_TITLE = 'Passport Size Photo Maker Online (3.5 x 4.5 cm) | FormFix';
const PAGE_DESC = 'Create official 3.5cm x 4.5cm passport photos for SSC, UPSC, and Banking exams. 1-click crop, background fix, and instant download. 100% private & free.';
const PAGE_KEYWORDS = 'passport photo maker online, 3.5x4.5 photo resize, ssc photo compressor, upsc photo maker, banking form photo maker, official passport size photo, create passport photo free';

const customSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      "name": "Passport Photo & Signature Maker",
      "operatingSystem": "All",
      "applicationCategory": "MultimediaApplication",
      "description": "Professional tool for creating official passport size photos and signatures for competitive exam forms.",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      }
    }
  ]
};
---

<BaseLayout title={PAGE_TITLE} description={PAGE_DESC} keywords={PAGE_KEYWORDS} customSchema={customSchema} active="passport-maker" canonicalPath="/passport-size-photo">
    <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
        const selectionPanel = document.getElementById('selection-panel');
        const workspacePanel = document.getElementById('workspace-panel');
        const photoControls = document.getElementById('photo-controls');
        const signControls = document.getElementById('sign-controls');
        const cropOverlay = document.getElementById('crop-overlay');
        const dragHint = document.getElementById('drag-hint');

        const canvas = document.getElementById('active-canvas');
        const ctx = canvas?.getContext('2d');
        const pInput = document.getElementById('photo-input');
        const sInput = document.getElementById('sign-input');

        pInput?.addEventListener('change', (e) => handleUpload(e, 'photo'));
        sInput?.addEventListener('change', (e) => handleUpload(e, 'sign'));

        function handleUpload(e, type) {
            const file = e.target.files[0];
            if (!file) return;
            mode = type;
            const reader = new FileReader();
            reader.onload = (ev) => {
                originalImg = new Image();
                originalImg.onload = () => {
                    selectionPanel.style.display = 'none';
                    workspacePanel.style.display = 'block';
                    
                    if (mode === 'photo') {
                        if (photoControls) photoControls.style.display = 'block';
                        if (cropOverlay) cropOverlay.style.display = 'block';
                        if (dragHint) dragHint.innerText = "👉 Drag to center your face in the box.";
                        initPhoto();
                    } else {
                        if (signControls) signControls.style.display = 'block';
                        if (dragHint) dragHint.style.display = 'none';
                        initSign();
                    }
                };
                originalImg.src = ev.target.result;
            };
            reader.readAsDataURL(file);
        }

        // --- PASSPORT PHOTO LOGIC ---
        function initPhoto() {
            canvas.width = 600;
            canvas.height = 800; // 3.5:4.5 roughly 3:4
            if (document.getElementById('photo-zoom')) document.getElementById('photo-zoom').value = "1";
            baseScale = Math.max(canvas.width / originalImg.width, canvas.height / originalImg.height);
            // Default: fit the screen perfectly
            imgScale = baseScale;
            imgX = (canvas.width - originalImg.width * imgScale) / 2;
            imgY = (canvas.height - originalImg.height * imgScale) / 2;
            render();
        }

        // --- SIGNATURE LOGIC ---
        function initSign() {
            canvas.width = originalImg.width;
            canvas.height = originalImg.height;
            render();
        }

        function render() {
            if (!originalImg || !ctx) return;
            ctx.clearRect(0, 0, canvas.width, canvas.height);

            if (mode === 'photo') {
                if (activeBg === 'white') { ctx.fillStyle = "#fff"; ctx.fillRect(0,0,canvas.width, canvas.height); }
                ctx.filter = `brightness(${document.getElementById('photo-bright')?.value || 100}%)`;
                ctx.drawImage(originalImg, imgX, imgY, originalImg.width * imgScale, originalImg.height * imgScale);
            } else {
                ctx.drawImage(originalImg, 0, 0);
                applySignFilter();
            }
        }

        function applySignFilter() {
             const imgData = ctx.getImageData(0, 0, canvas.width, canvas.height);
             const data = imgData.data;
             const thresh = parseInt(document.getElementById('sign-thresh')?.value || '180');

             for (let i = 0; i < data.length; i += 4) {
                 const b = (data[i] + data[i+1] + data[i+2]) / 3;
                 if (b > thresh) { data[i+3] = 0; }
                 else {
                     if (activeInk === 'black') { data[i]=0; data[i+1]=0; data[i+2]=0; }
                     else if (activeInk === 'blue') { data[i]=0; data[i+1]=50; data[i+2]=180; }
                 }
             }
             ctx.putImageData(imgData, 0, 0);
        }

        let originalImg = null;
        let mode = ''; 
        let imgX = 0, imgY = 0, imgScale = 1, baseScale = 1;
        let isDragging = false, lastMouseX = 0, lastMouseY = 0;
        let activeBg = 'orig';
        let activeInk = 'orig';

        // INTERACTION LOGIC
        canvas?.addEventListener('pointerdown', (e) => {
            if (mode !== 'photo') return;
            isDragging = true;
            lastMouseX = e.clientX; lastMouseY = e.clientY;
            canvas?.setPointerCapture(e.pointerId);
        });

        let isRenderPending = false;
        window.addEventListener('pointermove', (e) => {
            if (!isDragging) return;
            const dx = (e.clientX - lastMouseX);
            const dy = (e.clientY - lastMouseY);
            imgX += dx; imgY += dy;
            lastMouseX = e.clientX; lastMouseY = e.clientY;
            
            if (!isRenderPending) {
                isRenderPending = true;
                requestAnimationFrame(() => {
                    render();
                    isRenderPending = false;
                });
            }
        });

        window.addEventListener('pointerup', (e) => {
            isDragging = false;
            if (e.pointerType === 'touch') {
                evCache = evCache.filter(ev => ev.pointerId !== e.pointerId);
                if (evCache.length < 2) prevDiff = -1;
            }
        });

        // Touch Zoom Support (Pinch)
        let evCache = [];
        let prevDiff = -1;

        canvas?.addEventListener('pointerdown', (e) => {
            if (e.pointerType === 'touch') evCache.push(e);
        });

        canvas?.addEventListener('pointermove', (e) => {
            if (e.pointerType !== 'touch' || evCache.length !== 2) return;
            
            // Find this event in the cache and update its record
            const index = evCache.findIndex(ev => ev.pointerId === e.pointerId);
            if (index > -1) evCache[index] = e;

            // Calculate distance between the two pointers
            const curDiff = Math.hypot(evCache[0].clientX - evCache[1].clientX, evCache[0].clientY - evCache[1].clientY);

            if (prevDiff > 0) {
                if (curDiff > prevDiff) {
                    imgScale *= 1.02;
                } else if (curDiff < prevDiff) {
                    imgScale *= 0.98;
                }
                const zoomInput = document.getElementById('photo-zoom');
                if (zoomInput) zoomInput.value = (imgScale / baseScale).toString();
                render();
            }
            prevDiff = curDiff;
        });

        // CONTROLS LISTENERS
        document.getElementById('photo-bright')?.addEventListener('input', render);
        
        document.getElementById('photo-zoom')?.addEventListener('input', (e) => {
            const oldWidth = originalImg.width * imgScale;
            const oldHeight = originalImg.height * imgScale;
            
            imgScale = baseScale * parseFloat(e.target.value);
            
            const newWidth = originalImg.width * imgScale;
            const newHeight = originalImg.height * imgScale;
            
            // Adjust position so it zooms from the center by default
            imgX -= (newWidth - oldWidth) / 2;
            imgY -= (newHeight - oldHeight) / 2;
            
            render();
        });

        document.getElementById('sign-thresh')?.addEventListener('input', render);
        
        document.getElementById('bg-orig')?.addEventListener('click', (e) => { activeBg='orig'; toggleActive(e); render(); });
        document.getElementById('bg-white')?.addEventListener('click', (e) => { activeBg='white'; toggleActive(e); render(); });
        
        document.getElementById('ink-orig')?.addEventListener('click', (e) => { activeInk='orig'; toggleActive(e); render(); });
        document.getElementById('ink-black')?.addEventListener('click', (e) => { activeInk='black'; toggleActive(e); render(); });
        document.getElementById('ink-blue')?.addEventListener('click', (e) => { activeInk='blue'; toggleActive(e); render(); });

        function toggleActive(e) {
            const btns = e.target.parentElement.querySelectorAll('.toggle-btn');
            btns.forEach(b => b.classList.remove('active'));
            e.target.classList.add('active');
        }

        document.getElementById('dl-photo')?.addEventListener('click', () => {
            const link = document.createElement('a'); link.download = "passport_formfix.jpg";
            link.href = canvas.toDataURL('image/jpeg', 0.9); link.click();
            if (typeof window.triggerConfetti === 'function') window.triggerConfetti();
            var shareTxt = encodeURIComponent("I just created my passport photo using FormFix! 100% private, no uploads. Try it: " + window.__SITE_URL + "/passport-size-photo");
            var existing = document.getElementById('post-passport-share');
            if (!existing) {
                var div = document.createElement('div');
                div.id = 'post-passport-share';
                div.style.cssText = 'margin-top:20px;text-align:center;';
                div.innerHTML = '<p style="font-weight:600;margin-bottom:10px;color:var(--success);">Love FormFix? Share it!</p><div style="display:flex;gap:8px;justify-content:center;"><a href="https://twitter.com/intent/tweet?text=' + shareTxt + '" target="_blank" style="padding:8px 16px;border-radius:8px;background:#000;color:#fff;text-decoration:none;font-weight:600;font-size:0.85rem;">Share on X</a><a href="https://wa.me/?text=' + shareTxt + '" target="_blank" style="padding:8px 16px;border-radius:8px;background:#25D366;color:#fff;text-decoration:none;font-weight:600;font-size:0.85rem;">WhatsApp</a></div>';
                document.getElementById('dl-photo')?.parentElement?.appendChild(div);
            }
        });
        document.getElementById('dl-sign')?.addEventListener('click', () => {
            const link = document.createElement('a'); link.download = "signature_formfix.png";
            link.href = canvas.toDataURL('image/png'); link.click();
            if (typeof window.triggerConfetti === 'function') window.triggerConfetti();
        });
    });
</script>

    <Breadcrumb items={[{ name: 'Home', path: '/' }, { name: "Passport Size Photo Maker Online (3.5 x 4.5 cm)", path: "/passport-size-photo" }]} />

    <ToolWrapper title="Official Form Maker" subtitle="Generate standardized passport photos and digital signatures for competitive exams." currentTool="passport-maker">
        
        <div slot="tool-ui">
             <div class="workspace-editor">
                  <!-- 1. Selection Step -->
                  <div id="selection-panel" class="selection-workspace show">
                       <div class="choice-grid">
                            <button class="choice-card shadow-sm" onclick="document.getElementById('photo-input').click()">
                                 <div class="choice-icon">👤</div>
                                 <div class="choice-text">
                                      <h4>Passport Photo</h4>
                                      <p>Resize to 3.5cm x 4.5cm</p>
                                 </div>
                                 <input type="file" id="photo-input" accept="image/*" class="hidden" />
                            </button>

                            <button class="choice-card shadow-sm" onclick="document.getElementById('sign-input').click()">
                                 <div class="choice-icon">✒️</div>
                                 <div class="choice-text">
                                      <h4>Digital Signature</h4>
                                      <p>Background removal & Ink fix</p>
                                 </div>
                                 <input type="file" id="sign-input" accept="image/*" class="hidden" />
                            </button>
                       </div>
                  </div>

                  <!-- 2. Workspace Panel -->
                  <div id="workspace-panel" class="hidden">
                       <div class="editor-layout">
                            <!-- Preview Area -->
                            <div class="preview-stage shadow-sm">
                                 <div class="preview-header">
                                      <span class="preview-badge" id="mode-badge">Editor</span>
                                 </div>
                                 <div class="canvas-frame checkerboard" id="pinch-area">
                                      <canvas id="active-canvas"></canvas>
                                      <div id="crop-overlay" class="crop-frame" style="display: none;"></div>
                                 </div>
                                 <p class="hint-pill mt-16" id="drag-hint">👉 Drag to center your photo correctly.</p>
                            </div>

                            <!-- Controls Area -->
                            <div class="sidebar-controls">
                                 <div class="settings-card shadow-sm">
                                      <div class="d-flex justify-between align-center mb-24">
                                           <label class="section-label">Tools</label>
                                           <button class="secondary-btn btn-xs" onclick="location.reload()">↺ Start Over</button>
                                      </div>

                                      <!-- Passport Controls -->
                                      <div id="photo-controls" class="hidden">
                                           <div class="setting-item mb-24">
                                                <label class="section-label mb-8">Base Color</label>
                                                <div class="pill-toggle-group">
                                                     <button class="toggle-pill active" id="bg-orig">Native</button>
                                                     <button class="toggle-pill" id="bg-white">Pure White</button>
                                                </div>
                                           </div>
                                           
                                           <div class="setting-item mb-24">
                                                <div class="d-flex justify-between align-center mb-12">
                                                     <label class="section-label">Brightness</label>
                                                     <span id="bright-val" class="status-pill gray">100%</span>
                                                </div>
                                                <input type="range" id="photo-bright" min="50" max="150" value="100" class="unified-slider" />
                                           </div>

                                           <div class="setting-item mb-24">
                                                <div class="d-flex justify-between align-center mb-12">
                                                     <label class="section-label">Manual Zoom</label>
                                                     <span id="zoom-val" class="status-pill gray">1.0x</span>
                                                </div>
                                                <input type="range" id="photo-zoom" min="0.5" max="3" step="0.05" value="1" class="unified-slider" />
                                           </div>

                                           <button id="dl-photo" class="primary-btn wide-btn pulse-glow">Download Photo (JPG)</button>
                                      </div>

                                      <!-- Signature Controls -->
                                      <div id="sign-controls" class="hidden">
                                           <div class="setting-item mb-24">
                                                <div class="d-flex justify-between align-center mb-12">
                                                     <label class="section-label">Ink Sensitivity</label>
                                                     <span id="sign-thresh-val" class="status-pill gray">180</span>
                                                </div>
                                                <input type="range" id="sign-thresh" min="50" max="230" value="180" class="unified-slider" />
                                           </div>
                                           
                                           <div class="setting-item mb-24">
                                                <label class="section-label mb-8">Color Correction</label>
                                                <div class="pill-toggle-group">
                                                     <button class="toggle-pill active" id="ink-orig">Auto</button>
                                                     <button class="toggle-pill" id="ink-black">Black</button>
                                                     <button class="toggle-pill" id="ink-blue">Blue</button>
                                                </div>
                                           </div>
                                           <button id="dl-sign" class="primary-btn wide-btn pulse-glow">Download Signature (PNG)</button>
                                      </div>
                                 </div>
                                 <p class="privacy-note text-center mt-16">🔒 Local Processing Engine</p>
                            </div>
                       </div>
                  </div>
             </div>
        </div>

        <div slot="tool-info">
             <article class="prose">
                 <h2>Professional Passport Photo & Signature Tool</h2>
                 <p>Preparing for an online application (SSC, UPSC, Banking, etc)? This dedicated tool specifically targets the <strong>3.5cm x 4.5cm</strong> requirement used in India and internationally. All edits happen instantly within your browser RAM, ensuring your sensitive ID documents never leave your local device.</p>
                 
                 <h2>Standard Dimensions for Official Forms</h2>
                 <p>Different exam boards have slightly different requirements. Here is a quick reference guide to help you choose the right settings:</p>
                 <ul>
                     <li><strong>SSC (CGL, CHSL, MTS):</strong> 3.5cm x 4.5cm for photo, 4.0cm x 2.0cm for signature.</li>
                     <li><strong>UPSC:</strong> 350px x 350px minimum for both.</li>
                     <li><strong>Banking (IBPS, SBI):</strong> 4.5cm x 3.5cm (Note the orientation swap in some bank forms).</li>
                     <li><strong>NEET:</strong> 3.5cm x 4.5cm (Passport) and 4"x6" (Postcard).</li>
                 </ul>

                 <h2>How to make a Passport Size Photo online</h2>
                 <ol>
                     <li><strong>Upload:</strong> Click the "Passport Photo" card above and choose your image.</li>
                     <li><strong>Crop:</strong> Our editor shows a standard 3.5x4.5cm bounding box. Align your face so it covers about 80% of the box.</li>
                     <li><strong>Enhance:</strong> Adjust brightness if the photo is too dark. Official forms require clear visibility of features.</li>
                     <li><strong>Download:</strong> Click download to get your JPEG. Use our <a href="/compress-image">Compressor</a> if you need to hit a specific KB limit like 20KB or 50KB.</li>
                 </ol>

                 <div class="faq-grid mt-32">
                      <details class="faq-item">
                           <summary>What is the exact dimension for SSC/UPSC? <span class="indicator">+</span></summary>
                           <div class="faq-body">
                               <p>Most Indian examination boards require a <strong>3.5cm width by 4.5cm height</strong> photo. Our tool automatically locks the aspect ratio to this standard so you can simply drag to fit.</p>
                           </div>
                      </details>
                      <details class="faq-item">
                           <summary>How does the Signature Maker work? <span class="indicator">+</span></summary>
                           <div class="faq-body">
                               <p>It uses threshold-based filtering to isolate ink from paper. Once you upload your signed paper, use 'Ink Sensitivity' to clean up shadows and export a transparent PNG ready for uploading.</p>
                           </div>
                      </details>
                      <details class="faq-item">
                           <summary>Is this tool free and private? <span class="indicator">+</span></summary>
                           <div class="faq-body">
                               <p>Yes. FormFix is 100% free and processes everything locally in your browser. We never see or store your photos, making it the safest way to prepare official documents.</p>
                           </div>
                      </details>
                 </div>
             </article>
        </div>
    </ToolWrapper>
</BaseLayout><style>
