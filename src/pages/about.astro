---
import BaseLayout from '../components/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { SITE_URL } from '../seo';

const customSchema = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  "name": "About FormFix",
  "description": "Learn about FormFix, our mission, and the privacy-first browser-based tools we build.",
  "url": `${SITE_URL}/about`,
  "mainEntity": {
    "@type": "Organization",
    "name": "FormFix",
    "url": SITE_URL,
    "logo": `${SITE_URL}/favicon.png`,
    "foundingDate": "2024",
    "description": "FormFix provides free, privacy-first browser-based tools for image and PDF processing."
  }
};
---

<BaseLayout 
    title="About FormFix | Privacy-First Online Image Tools"
    description="FormFix is a 100% free browser-based toolkit for image compression, PDF merging, and photo editing. Privacy-first, zero uploads."
    canonicalPath="/about"
    customSchema={customSchema}
>
    <Breadcrumb items={[{ name: 'Home', path: '/' }, { name: "About", path: "/about" }]} />

    <div class="page">
        <div class="container page-inner">

            <header class="page-header">
                <h1>About FormFix</h1>
                <p>Secure, browser-based tools for your daily digital needs.</p>
            </header>

            <div class="content">
                <h2>Our Mission</h2>
                <p>
                    FormFix was built to provide reliable and secure image and PDF utilities that work entirely in your browser. We noticed a common issue with online tools: many are cluttered with intrusive ads, require paid subscriptions for basic features, or upload your sensitive documents to remote servers without your knowledge.
                </p>

                <h2>Core Values</h2>
                <ul class="values-list">
                    <li>
                        <strong>Local Processing</strong>
                        <span>Everything happens on your device. FormFix processes your files locally using modern web APIs, significantly reducing privacy risks.</span>
                    </li>
                    <li>
                        <strong>No Hidden Costs</strong>
                        <span>We offer tools without hidden paywalls or watermarks for standard usage.</span>
                    </li>
                    <li>
                        <strong>Built for Speed</strong>
                        <span>Since processing is local, you don't have to wait for large file uploads or network processing.</span>
                    </li>
                    <li>
                        <strong>No Installation</strong>
                        <span>Our tools are available instantly through a web browser, no downloads required.</span>
                    </li>
                </ul>

                <h2>Who Can Use These Tools</h2>
                <p>
                    From students formatting assignments to job seekers preparing passport photos, FormFix offers a suite of utilities tailored for anyone who values their data privacy and needs a quick, efficient way to manage digital files.
                </p>

                <h2>Feedback & Support</h2>
                <p>
                    We are dedicated to improving FormFix based on user feedback. If you have any suggestions, bug reports, or feature requests, visit our <a href="/contact">Contact Page</a>.
                </p>

                <div class="cta-box">
                    <h3>Try Our Tools</h3>
                    <p>Explore the full range of secure, private utilities.</p>
                    <a href="/tools" class="btn-primary">Explore All Tools</a>
                </div>
            </div>

        </div>
    </div>
</BaseLayout>

<style>
.page { padding: 32px 0 80px; }
.page-inner { max-width: 760px; }

.page-header {
    margin-bottom: 40px;
}
.page-header h1 {
    font-size: clamp(1.5rem, 4vw, 2.2rem);
    font-weight: 600;
    margin-bottom: 8px;
}
.page-header p {
    font-size: 0.95rem;
    color: var(--text-secondary);
}

.content h2 {
    font-size: 1.2rem;
    font-weight: 600;
    margin-top: 32px;
    margin-bottom: 12px;
}

.content p {
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--text-secondary);
    margin-bottom: 16px;
}

.values-list {
    list-style: none;
    padding: 0;
    margin: 0 0 16px 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
}
.values-list li {
    display: flex;
    flex-direction: column;
    gap: 4px;
}
.values-list strong {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text-primary);
}
.values-list span {
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--text-secondary);
}

.cta-box {
    margin-top: 40px;
    padding: 32px;
    background: var(--surface-2);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    text-align: center;
}
.cta-box h3 {
    font-size: 1.1rem;
    font-weight: 600;
    margin-bottom: 6px;
}
.cta-box p {
    color: var(--text-muted);
    margin-bottom: 20px;
    font-size: 0.9rem;
}
.btn-primary {
    display: inline-block;
    padding: 10px 24px;
    background: var(--accent-primary);
    color: #fff;
    font-weight: 500;
    border-radius: var(--radius-sm);
    text-decoration: none;
    font-size: 0.9rem;
}
.btn-primary:hover {
    background: var(--accent-hover);
    color: #fff;
}
</style>
