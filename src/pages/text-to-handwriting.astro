---
import BaseLayout from '../components/BaseLayout.astro';
import RelatedTools from '../components/RelatedTools.astro';

const PAGE_TITLE = 'Text to Handwriting Converter - Realistic Assignment Maker Online';
const PAGE_DESC = 'Convert typed text into realistic handwriting on notebook paper. Perfect for assignments, letters, and homework. 100% private and free.';
const PAGE_KEYWORDS = 'text to handwriting, handwriting converter online, assignment maker, homework maker, handwritten text generator, ruled paper handwriting';

const customSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      "name": "Handwriting Assignment Studio",
      "operatingSystem": "All",
      "applicationCategory": "EducationalApplication",
      "description": "Transform typed text into realistic handwritten documents on professional ruled paper backgrounds.",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      }
    }
  ]
};
---

<BaseLayout title={PAGE_TITLE} description={PAGE_DESC} keywords={PAGE_KEYWORDS} customSchema={customSchema} active="tools" canonicalPath="/text-to-handwriting">
    <!-- Load Handwriting Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@400;700&family=Indie+Flower&family=Patrick+Hand&family=Handlee&family=Homemade+Apple&family=Kalam:wght@300;400;700&family=Shadows+Into+Light&family=Satisfy&display=swap" rel="stylesheet">

    <div class="tool-wrapper animate-in">
        <header class="tool-intro text-center">
             <div class="brand-badge shadow-sm">🎓 Student assignment Helper</div>
             <h1 class="main-h1">Text to <span class="highlight">Handwriting</span> Studio</h1>
             <p class="hero-sub">Generate realistic handwritten assignments in seconds. Type your text and get a high-quality photo of it.</p>
        </header>

        <div class="handwriting-workspace grid-2x">
            <!-- Left: Inputs -->
            <div class="glass-card editor-pane shadow-lg">
                 <div class="pane-section mb-24">
                      <label class="pane-label">Content to Handwrite</label>
                      <textarea id="text-input" placeholder="Type or paste your assignment here...
Line breaks will be respected.
Try to keep lines short for better results." class="modern-textarea"></textarea>
                 </div>

                 <div class="pane-section mb-24">
                      <div class="grid-2col">
                           <div>
                                <label class="pane-label">Handwriting Style</label>
                                <select id="font-select" class="modern-select">
                                     <option value="'Caveat', cursive">Natural Cursive</option>
                                     <option value="'Patrick Hand', cursive">Patrick Hand</option>
                                     <option value="'Indie Flower', cursive">Indie Flower</option>
                                     <option value="'Kalam', cursive">Kalam Marker</option>
                                     <option value="'Handlee', cursive">Neat Print</option>
                                     <option value="'Shadows Into Light', cursive">Thin Artistic</option>
                                     <option value="'Homemade Apple', cursive">Vintage Cursive</option>
                                     <option value="'Satisfy', cursive">Liquid Ink</option>
                                </select>
                           </div>
                           <div>
                                <label class="pane-label">Paper Type</label>
                                <select id="paper-select" class="modern-select">
                                     <option value="ruled">Blue Ruled Paper</option>
                                     <option value="boxed">Math Graph Paper</option>
                                     <option value="blank">Plain White Paper</option>
                                     <option value="yellow">Yellow Pad (Legal)</option>
                                     <option value="old">Vintage Parchment</option>
                                </select>
                           </div>
                      </div>
                 </div>

                 <div class="pane-section mb-24">
                      <div class="grid-2col">
                           <div>
                                <label class="pane-label">Ink Color</label>
                                <div class="ink-buttons">
                                     <button class="ink-btn active" data-color="#003366" style="background: #003366"></button>
                                     <button class="ink-btn" data-color="#000000" style="background: #000000"></button>
                                     <button class="ink-btn" data-color="#b91c1c" style="background: #b91c1c"></button>
                                </div>
                           </div>
                           <div>
                                <label class="pane-label">Font Size (<span id="font-size-val">1.2</span>)</label>
                                <input type="range" id="font-size" min="0.8" max="2.5" step="0.1" value="1.2" class="modern-slider" />
                           </div>
                      </div>
                 </div>

                 <div class="pane-section mb-24">
                      <div class="grid-2col">
                           <div>
                                <label class="pane-label">Line Space (<span id="line-height-val">1.4</span>)</label>
                                <input type="range" id="line-height" min="1.0" max="2.0" step="0.05" value="1.35" class="modern-slider" />
                           </div>
                           <div>
                                <label class="pane-label">Tilt / Jitter (<span id="tilt-val">High</span>)</label>
                                <input type="range" id="tilt-slider" min="0" max="10" step="1" value="5" class="modern-slider" />
                           </div>
                      </div>
                 </div>

                 <div class="action-wrap mt-32">
                      <button id="download-btn" class="primary-btn wide-btn profile-btn pulse-glow">⬇️ Download High-Res Photo</button>
                      <p class="text-tiny text-center text-slate mt-12">Format: High-Quality JPEG (Looks 100% Real)</p>
                 </div>
            </div>

            <!-- Right: Preview -->
            <div class="preview-pane">
                 <div class="preview-sticky">
                      <div class="preview-container shadow-2xl" id="capture-area">
                           <canvas id="handwriting-canvas"></canvas>
                      </div>
                      <div class="preview-badge mt-16 shadow-lg">HD Real-time Preview</div>
                 </div>
            </div>
        </div>

        <article class="pro-seo-article container mt-60">
             <div class="divider-line mb-48"></div>
             
             <div class="pro-features-grid">
                <div class="feat-card">
                    <span class="feat-icon">✍️</span>
                    <h3>Natural Pen Dynamics</h3>
                    <p>Unlike basic handwriting fonts, our engine simulates natural pen pressure and slight direction changes (jitter) for every single letter, making it look authentically human.</p>
                </div>
                <div class="feat-card">
                    <span class="feat-icon">📄</span>
                    <h3>Official Paper Templates</h3>
                    <p>Choose from standard Blue Ruled paper (Classmate style), Math Grids, or Legal Yellow Pads. The text is perfectly calibrated to sit on the lines.</p>
                </div>
                <div class="feat-card">
                    <span class="feat-icon">🛡️</span>
                    <h3>100% Client-Side</h3>
                    <p>Your sensitive notes and assignments are never uploaded to our servers. All rendering happens instantly in your browser cache.</p>
                </div>
             </div>

             <h2 class="mt-48 text-center">How to Create 100% Realistic Assignments</h2>
             <p class="text-center text-slate max-w-sm mx-auto mb-40">Follow these expert steps to make your digital work indistinguishable from physical handwriting.</p>

             <div class="steps-path">
                <div class="path-step">
                    <div class="step-num">01</div>
                    <div class="step-info">
                        <strong>Choose Natural Fonts:</strong> Select 'Caveat' or 'Homemade Apple' for cursive, and 'Indie Flower' for a neat, youthful print style.
                    </div>
                </div>
                <div class="path-step">
                    <div class="step-num">02</div>
                    <div class="step-info">
                        <strong>Calibrate Ruling:</strong> Use the "Line Space" slider. In India, standard registers use 36px-40px spacing. Match your font size so the base of letters touches the blue lines.
                    </div>
                </div>
                <div class="path-step">
                    <div class="step-num">03</div>
                    <div class="step-info">
                        <strong>Add Organic Jitter:</strong> Set Jitter to "Medium" (value 4-6). This adds slight tilts to lines and micro-shifts in position, simulating a tired human hand.
                    </div>
                </div>
             </div>
        </article>

        <RelatedTools currentTool="text-to-handwriting" />
    </div>
</BaseLayout>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const textInput = document.getElementById('text-input') as HTMLTextAreaElement;
        const fontSelect = document.getElementById('font-select') as HTMLSelectElement;
        const paperSelect = document.getElementById('paper-select') as HTMLSelectElement;
        const fontSizeSlider = document.getElementById('font-size') as HTMLInputElement;
        const lineSlider = document.getElementById('line-height') as HTMLInputElement;
        const tiltSlider = document.getElementById('tilt-slider') as HTMLInputElement;
        const inkBtns = document.querySelectorAll('.ink-btn');
        const downloadBtn = document.getElementById('download-btn') as HTMLButtonElement;
        
        const fontSizeVal = document.getElementById('font-size-val')!;
        const lineHeightVal = document.getElementById('line-height-val')!;
        
        const canvas = document.getElementById('handwriting-canvas') as HTMLCanvasElement;
        const ctx = canvas.getContext('2d')!;

        let activeInk = '#003366';
        
        // Initial setup
        const A4_RATIO = 1.414;
        const CANVAS_WIDTH = 1000;
        const CANVAS_HEIGHT = CANVAS_WIDTH * A4_RATIO;
        canvas.width = CANVAS_WIDTH;
        canvas.height = CANVAS_HEIGHT;

        function render() {
            const paper = paperSelect.value;
            const font = fontSelect.value;
            const text = textInput.value;
            const fontSize = parseFloat(fontSizeSlider.value) * 20;
            const lineHeight = parseFloat(lineSlider.value) * fontSize;
            const jitterAmount = parseInt(tiltSlider.value) / 10;
            
            fontSizeVal.textContent = fontSizeSlider.value;
            lineHeightVal.textContent = lineSlider.value;

            // Clear and draw background
            ctx.fillStyle = "#ffffff";
            ctx.fillRect(0, 0, CANVAS_WIDTH, CANVAS_HEIGHT);

            drawPaper(paper);

            // Draw Text
            ctx.fillStyle = activeInk;
            ctx.font = `${fontSize}px ${font}`;
            ctx.textBaseline = "alphabetic"; // Better for sitting ON lines

            const marginX = 120; // Corrected left margin
            const rightMargin = 60;
            const maxWidth = CANVAS_WIDTH - marginX - rightMargin;
            const startY = 112; // Adjusted to sit on typical notebook lines

            // Split into manual paragraphs first
            const paragraphs = text.split('\n');
            let currentLineY = startY;

            paragraphs.forEach((para) => {
                const words = para.split(' ');
                let currentLine = '';

                for (let n = 0; n < words.length; n++) {
                    const testLine = currentLine + words[n] + ' ';
                    const metrics = ctx.measureText(testLine);
                    const testWidth = metrics.width;

                    if (testWidth > maxWidth && n > 0) {
                        drawHandwrittenLine(currentLine, marginX, currentLineY, jitterAmount);
                        currentLine = words[n] + ' ';
                        currentLineY += lineHeight;
                    } else {
                        currentLine = testLine;
                    }
                }
                drawHandwrittenLine(currentLine, marginX, currentLineY, jitterAmount);
                currentLineY += lineHeight; // Small gap between paragraphs
            });
        }

        function drawHandwrittenLine(text: string, x: number, y: number, jitter: number) {
            if (y > CANVAS_HEIGHT - 40) return;
            
            ctx.save();
            // Natural jitter
            if (jitter > 0) {
                const tilt = (Math.random() - 0.5) * jitter * 0.03;
                const shiftX = (Math.random() - 0.5) * jitter * 5;
                const shiftY = (Math.random() - 0.5) * jitter * 3;
                ctx.translate(x + shiftX, y + shiftY);
                ctx.rotate(tilt);
            } else {
                ctx.translate(x, y);
            }

            // Ink simulation
            ctx.shadowBlur = jitter * 0.3;
            ctx.shadowColor = activeInk;
            ctx.globalAlpha = 0.9 + (Math.random() * 0.1); // Variable ink density
            
            ctx.fillText(text.trim(), 0, 0);
            ctx.restore();
        }

        function drawPaper(type: string) {
            if (type === 'ruled') {
                // Vertical Red Margin
                ctx.strokeStyle = "rgba(255, 0, 0, 0.25)";
                ctx.lineWidth = 2;
                ctx.beginPath();
                ctx.moveTo(90, 0); ctx.lineTo(90, CANVAS_HEIGHT);
                ctx.stroke();

                // Blue horizontal lines
                ctx.strokeStyle = "#cfe3ff";
                ctx.lineWidth = 1;
                for (let y = 116; y < CANVAS_HEIGHT; y += 36) { // 36px matches typical ruling
                    ctx.beginPath();
                    ctx.moveTo(0, y); ctx.lineTo(CANVAS_WIDTH, y);
                    ctx.stroke();
                }
            } else if (type === 'boxed') {
                ctx.strokeStyle = "#f1f5f9";
                for (let x = 0; x < CANVAS_WIDTH; x += 30) {
                    ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x, CANVAS_HEIGHT); ctx.stroke();
                }
                for (let y = 0; y < CANVAS_HEIGHT; y += 30) {
                    ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(CANVAS_WIDTH, y); ctx.stroke();
                }
            } else if (type === 'yellow') {
                ctx.fillStyle = "#fffde7";
                ctx.fillRect(0, 0, CANVAS_WIDTH, CANVAS_HEIGHT);
                ctx.strokeStyle = "rgba(255,0,0,0.2)"; // Legal pad margin
                ctx.lineWidth = 2;
                ctx.beginPath(); ctx.moveTo(100, 0); ctx.lineTo(100, CANVAS_HEIGHT); ctx.stroke();
                
                ctx.strokeStyle = "#ffe082";
                for (let y = 120; y < CANVAS_HEIGHT; y += 32) {
                    ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(CANVAS_WIDTH, y); ctx.stroke();
                }
            } else if (type === 'old') {
                ctx.fillStyle = "#f3e5ab";
                ctx.fillRect(0, 0, CANVAS_WIDTH, CANVAS_HEIGHT);
                for(let i=0; i<1000; i++) {
                    ctx.fillStyle = `rgba(0,0,0,${Math.random() * 0.03})`;
                    ctx.fillRect(Math.random() * CANVAS_WIDTH, Math.random() * CANVAS_HEIGHT, 1, 1);
                }
            }
        }

        // Live input listeners
        textInput.addEventListener('input', render);
        fontSelect.addEventListener('change', render);
        paperSelect.addEventListener('change', render);
        fontSizeSlider.addEventListener('input', render);
        lineSlider.addEventListener('input', render);
        tiltSlider.addEventListener('input', render);

        inkBtns.forEach(btn => {
            btn.addEventListener('click', (e: any) => {
                inkBtns.forEach(b => b.classList.remove('active'));
                btn.classList.add('active');
                activeInk = btn.getAttribute('data-color')!;
                render();
            });
        });

        downloadBtn.addEventListener('click', () => {
            const link = document.createElement('a');
            link.download = "handwritten_assignment.jpg";
            link.href = canvas.toDataURL('image/jpeg', 0.95);
            link.click();
        });

        // Initial render
        setTimeout(render, 500); // Wait for fonts
    });
</script>

<style>
    .main-h1 { font-size: 3rem; font-weight: 1000; letter-spacing: -0.05em; margin-bottom: 8px; color: var(--dark); line-height: 1.1; }
    .hero-sub { color: var(--slate); font-weight: 600; font-size: 1.25rem; margin-bottom: 32px; }
    .tool-wrapper { max-width: 1200px; margin: 0 auto; padding-bottom: 100px; }

    .handwriting-workspace { display: grid; grid-template-columns: 450px 1fr; gap: 32px; align-items: start; }
    @media (max-width: 1000px) { .handwriting-workspace { grid-template-columns: 1fr; } }
    
    .editor-pane { background: #fff; padding: 32px; border-radius: 24px; border: 1.5px solid var(--border); }
    .pane-label { display: block; font-size: 0.75rem; font-weight: 1000; color: var(--slate); text-transform: uppercase; margin-bottom: 12px; letter-spacing: 0.05em; }
    
    .modern-textarea { width: 100%; height: 220px; border-radius: 16px; border: 1.5px solid var(--border); padding: 16px; font-size: 1rem; color: var(--dark); background: #f8fafc; outline: none; transition: 0.3s; resize: none; font-family: inherit; }
    .modern-textarea:focus { border-color: var(--primary); background: #fff; box-shadow: 0 0 0 4px var(--primary-light); }
    
    .grid-2col { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
    .modern-select { width: 100%; padding: 12px; border-radius: 12px; border: 1.5px solid var(--border); background: #fff; font-weight: 700; color: var(--dark); outline: none; }
    
    .ink-buttons { display: flex; gap: 12px; }
    .ink-btn { width: 32px; height: 32px; border-radius: 50%; border: 3px solid #fff; box-shadow: 0 0 0 2px var(--border); transition: 0.2s; cursor: pointer; }
    .ink-btn.active { box-shadow: 0 0 0 2px var(--primary); transform: scale(1.1); }

    .preview-pane { position: relative; }
    .preview-sticky { position: sticky; top: 20px; }
    .preview-container { border-radius: 12px; overflow: hidden; border: 1.5px solid var(--border); background: #f1f5f9; cursor: crosshair; }
    #handwriting-canvas { width: 100%; height: auto; display: block; image-rendering: -webkit-optimize-contrast; }
    
    .preview-badge { display: inline-block; background: var(--dark); color: #fff; padding: 10px 20px; border-radius: 100px; font-weight: 1000; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.05em; }

    .modern-slider { -webkit-appearance: none; width: 100%; height: 6px; border-radius: 5px; background: #cbd5e1; outline: none; margin-top: 8px; }
    .modern-slider::-webkit-slider-thumb { -webkit-appearance: none; appearance: none; width: 22px; height: 22px; border-radius: 50%; background: var(--primary); cursor: pointer; border: 4px solid #fff; box-shadow: 0 4px 8px rgba(0,0,0,0.15); transition: 0.2s; }
    
    .pro-features-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; margin-bottom: 60px; }
    .feat-card { background: #fff; border: 1.5px solid var(--border-light); border-radius: 20px; padding: 32px; transition: 0.3s; }
    .feat-icon { font-size: 2.2rem; margin-bottom: 16px; display: block; }
    .feat-card h3 { font-size: 1.15rem; font-weight: 1000; margin-bottom: 8px; color: var(--dark); }
    .feat-card p { font-size: 0.95rem; color: var(--slate); line-height: 1.6; font-weight: 500; }

    .steps-path { display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px; }
    .path-step { display: flex; gap: 20px; }
    .step-num { font-size: 2rem; font-weight: 1000; color: var(--primary-light); opacity: 0.8; line-height: 1; }
    .step-info strong { display: block; margin-bottom: 6px; color: var(--dark); }
    .step-info { font-size: 0.92rem; color: var(--slate); line-height: 1.6; font-weight: 500; }

    .divider-line { width: 100%; height: 1.5px; background: #eee; border-radius: 10px; }
    .mt-60 { margin-top: 60px; }
    .max-w-sm { max-width: 500px; }
    .text-slate { color: var(--slate); }

    .wide-btn { padding: 22px 32px; font-weight: 1000; font-size: 1.2rem; border-radius: 100px; width: 100%; box-shadow: 0 10px 30px rgba(0,0,0,0.1); border: none; cursor: pointer; transition: 0.3s; }
    .wide-btn:hover { transform: translateY(-3px); filter: brightness(1.1); box-shadow: var(--shadow-xl); }

    @media (max-width: 900px) {
        .pro-features-grid, .steps-path { grid-template-columns: 1fr; }
        .handwriting-workspace { grid-template-columns: 1fr; }
        .main-h1 { font-size: 2.4rem; }
    }
</style>
