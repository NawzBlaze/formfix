---
import BaseLayout from '../components/BaseLayout.astro';
import ToolWrapper from '../components/ToolWrapper.astro';

const PAGE_TITLE = 'Text to Handwriting Converter - Realistic Assignment Maker | FormFix';
const PAGE_DESC = 'Convert typed text into realistic handwriting on notebook paper. Perfect for assignments, letters, and homework. 100% private and free.';
const PAGE_KEYWORDS = 'text to handwriting, handwriting converter online, assignment maker, homework maker, handwritten text generator, ruled paper handwriting';

const customSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      "name": "Text to Handwriting Converter",
      "operatingSystem": "All",
      "applicationCategory": "EducationalApplication",
      "description": "Transform typed text into realistic handwritten documents on professional ruled paper backgrounds.",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      }
    }
  ]
};
---

<BaseLayout title={PAGE_TITLE} description={PAGE_DESC} keywords={PAGE_KEYWORDS} customSchema={customSchema} active="tools" canonicalPath="/text-to-handwriting">
    <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@400;700&family=Indie+Flower&family=Patrick+Hand&family=Handlee&family=Homemade+Apple&family=Kalam:wght@300;400;700&family=Shadows+Into+Light&family=Satisfy&display=swap" rel="stylesheet">

    <ToolWrapper title="Text to Handwriting" subtitle="Transform any text into realistic handwriting on ruled paper instantly." currentTool="text-to-handwriting">
        
        <div slot="tool-ui">
             <div class="workspace-editor">
                  <div class="studio-grid">
                       <!-- 1. Controls Sidebar -->
                       <div class="controls-sidebar">
                            <div class="settings-card glass-card mb-24">
                                 <label class="section-label mb-12">1. Input Text</label>
                                 <textarea id="text-input" placeholder="Paste your assignment text here..." class="modern-textarea mb-24">Hi, this is a realistic handwriting sample. You can change colors, paper types, and hand styles using the controls below!</textarea>

                                 <div class="settings-grid mb-24">
                                      <div class="setting-item">
                                           <label class="section-label mb-8">Hand Style</label>
                                           <select id="font-select" class="modern-select">
                                                <option value="'Caveat', cursive">Natural Cursive</option>
                                                <option value="'Patrick Hand', cursive">Patrick Hand</option>
                                                <option value="'Indie Flower', cursive">Indie Flower</option>
                                                <option value="'Kalam', cursive">Kalam Marker</option>
                                                <option value="'Handlee', cursive">Neat Print</option>
                                                <option value="'Shadows Into Light', cursive">Thin Artistic</option>
                                                <option value="'Homemade Apple', cursive">Vintage Cursive</option>
                                                <option value="'Satisfy', cursive">Liquid Ink</option>
                                           </select>
                                      </div>
                                      <div class="setting-item">
                                           <label class="section-label mb-8">Paper Base</label>
                                           <select id="paper-select" class="modern-select">
                                                <option value="ruled">Blue Ruled</option>
                                                <option value="boxed">Math Graph</option>
                                                <option value="blank">Plain White</option>
                                                <option value="yellow">Yellow Pad</option>
                                                <option value="old">Vintage</option>
                                           </select>
                                      </div>
                                 </div>

                                 <div class="setting-item mb-24">
                                      <div class="d-flex justify-between align-center mb-12">
                                           <label class="section-label m-0">Ink Color</label>
                                           <div class="ink-selector" id="ink-group">
                                                <button class="ink-dot active" data-color="#003366" style="background: #003366" title="Dark Blue"></button>
                                                <button class="ink-dot" data-color="#111827" style="background: #111827" title="Black"></button>
                                                <button class="ink-dot" data-color="#065f46" style="background: #065f46" title="Dark Green"></button>
                                                <button class="ink-dot" data-color="#b91c1c" style="background: #b91c1c" title="Red"></button>
                                           </div>
                                      </div>
                                 </div>

                                 <div class="settings-grid mb-32">
                                      <div class="setting-item">
                                           <div class="d-flex justify-between mb-8">
                                                <label class="section-label m-0">Scale</label>
                                                <span id="font-size-val" class="status-pill">1.2</span>
                                           </div>
                                           <input type="range" id="font-size" min="0.8" max="2.5" step="0.1" value="1.2" class="premium-slider" />
                                      </div>
                                      <div class="setting-item">
                                           <div class="d-flex justify-between mb-8">
                                                <label class="section-label m-0">Jitter</label>
                                                <span id="tilt-val" class="status-pill">Low</span>
                                           </div>
                                           <input type="range" id="tilt-slider" min="0" max="10" step="1" value="3" class="premium-slider" />
                                      </div>
                                 </div>

                                 <button id="download-btn" class="primary-btn btn-glow lg-btn">Download High-Res JPG</button>
                                 <p class="privacy-tiny">🔒 Secure local rendering. No images ever leave your device.</p>
                            </div>
                       </div>

                       <!-- 2. Preview Stage -->
                       <div class="preview-stage">
                            <div class="preview-header mb-16">
                                 <span class="preview-badge">Document Preview</span>
                            </div>
                            <div class="assignment-preview glass-card">
                                 <div class="canvas-wrap scroll-container">
                                      <canvas id="handwriting-canvas"></canvas>
                                 </div>
                            </div>
                       </div>
                  </div>
             </div>
        </div>

        <div slot="tool-info">
             <div class="pro-article">
                 <h2>Text to Handwriting Converter</h2>
                 <p>Our <strong>Text to Handwriting Converter</strong> helps you generate high-quality images of handwritten notes instantly. Perfect for making digital assignments look realistic on professional ruled paper backgrounds.</p>
                 
                 <div class="feature-grid">
                      <div class="f-item">
                           <span class="f-icon">✨</span>
                           <h3>Human Jitter</h3>
                           <p>Our algorithm mimics human imperfection by adding subtle tilt and position shifts to every word.</p>
                      </div>
                      <div class="f-item">
                           <span class="f-icon">📏</span>
                           <h3>A4 Standards</h3>
                           <p>Output is perfectly scaled for A4 paper printing at 300 DPI for professional results.</p>
                      </div>
                 </div>

                 <div class="faq-accordion mt-32">
                      <details class="faq-item">
                           <summary>How do I make it look real?</summary>
                           <div class="ans">Use a 'Low' or 'Med' jitter setting. Adjust the font scale so your text sits naturally on the ruled lines. Real handwriting is rarely perfectly centered, so those small 'irregularities' are key.</div>
                      </details>
                      <details class="faq-item">
                           <summary>Can I print the output?</summary>
                           <div class="ans">Yes. The download is a high-resolution JPG optimized for 300 DPI printing. It will look like a scanned photo of a real piece of paper when printed.</div>
                      </details>
                 </div>
             </div>
        </div>
    </ToolWrapper>
</BaseLayout>

<script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
        const textInput = document.getElementById('text-input');
        const fontSelect = document.getElementById('font-select');
        const paperSelect = document.getElementById('paper-select');
        const fontSizeSlider = document.getElementById('font-size');
        const tiltSlider = document.getElementById('tilt-slider');
        const inkGroup = document.getElementById('ink-group');
        const downloadBtn = document.getElementById('download-btn');
        
        const fontSizeVal = document.getElementById('font-size-val');
        const tiltVal = document.getElementById('tilt-val');
        
        const canvas = document.getElementById('handwriting-canvas');
        if (!canvas) return;
        const ctx = canvas.getContext('2d');

        let activeInk = '#003366';
        
        const A4_RATIO = 1.414;
        const CANVAS_WIDTH = 1240; // 300 DPI for A4 width
        const CANVAS_HEIGHT = CANVAS_WIDTH * A4_RATIO;
        canvas.width = CANVAS_WIDTH;
        canvas.height = CANVAS_HEIGHT;

        function render() {
            const paper = paperSelect.value;
            const font = fontSelect.value;
            const text = textInput.value;
            const baseFontSize = parseFloat(fontSizeSlider.value) * 22;
            const lineHeight = baseFontSize * 1.6;
            const jitterAmount = parseInt(tiltSlider.value) / 10;
            
            fontSizeVal.textContent = fontSizeSlider.value;
            const jitLabels = ['Off','Min', 'Low', 'Low+', 'Med-', 'Med', 'Med+', 'High-', 'High', 'Max', 'Ultra'];
            tiltVal.textContent = jitLabels[parseInt(tiltSlider.value)];

            // Background
            ctx.fillStyle = "#ffffff";
            ctx.fillRect(0, 0, CANVAS_WIDTH, CANVAS_HEIGHT);

            drawPaper(paper);

            // Font setup
            ctx.fillStyle = activeInk;
            ctx.font = `${baseFontSize}px ${font}`;
            ctx.textBaseline = "alphabetic";

            const marginX = 140;
            const rightMargin = 80;
            const maxWidth = CANVAS_WIDTH - marginX - rightMargin;
            const startY = 160;

            const paragraphs = text.split('\n');
            let currentLineY = startY;

            paragraphs.forEach((para) => {
                if (!para.trim()) {
                    currentLineY += lineHeight;
                    return;
                }
                const words = para.split(' ');
                let currentLine = '';

                for (let n = 0; n < words.length; n++) {
                    const testLine = currentLine + words[n] + ' ';
                    const metrics = ctx.measureText(testLine);
                    const testWidth = metrics.width;

                    if (testWidth > maxWidth && n > 0) {
                        drawHandwrittenLine(currentLine, marginX, currentLineY, jitterAmount);
                        currentLine = words[n] + ' ';
                        currentLineY += lineHeight;
                        if (currentLineY > CANVAS_HEIGHT - 60) break;
                    } else {
                        currentLine = testLine;
                    }
                }
                drawHandwrittenLine(currentLine, marginX, currentLineY, jitterAmount);
                currentLineY += lineHeight;
                if (currentLineY > CANVAS_HEIGHT - 60) return;
            });
        }

        function drawHandwrittenLine(text, x, y, jitter) {
            if (y > CANVAS_HEIGHT - 40) return;
            
            ctx.save();
            if (jitter > 0) {
                const tilt = (Math.random() - 0.5) * jitter * 0.04;
                const shiftX = (Math.random() - 0.5) * jitter * 6;
                const shiftY = (Math.random() - 0.5) * jitter * 4;
                ctx.translate(x + shiftX, y + shiftY);
                ctx.rotate(tilt);
            } else {
                ctx.translate(x, y);
            }

            ctx.shadowBlur = jitter * 0.2;
            ctx.shadowColor = activeInk;
            ctx.globalAlpha = 0.85 + (Math.random() * 0.15);
            
            ctx.fillText(text.trim(), 0, 0);
            ctx.restore();
        }

        function drawPaper(type) {
            if (type === 'ruled') {
                // Vertical Red Margin
                ctx.strokeStyle = "rgba(255, 0, 0, 0.25)";
                ctx.lineWidth = 2;
                ctx.beginPath();
                ctx.moveTo(110, 0); ctx.lineTo(110, CANVAS_HEIGHT);
                ctx.stroke();

                // Blue horizontal lines
                ctx.strokeStyle = "#e2e8f0";
                ctx.lineWidth = 1.5;
                for (let y = 168; y < CANVAS_HEIGHT; y += 42) {
                    ctx.beginPath();
                    ctx.moveTo(0, y); ctx.lineTo(CANVAS_WIDTH, y);
                    ctx.stroke();
                }
            } else if (type === 'boxed') {
                ctx.strokeStyle = "#f1f5f9";
                ctx.lineWidth = 1;
                for (let x = 0; x < CANVAS_WIDTH; x += 35) {
                    ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x, CANVAS_HEIGHT); ctx.stroke();
                }
                for (let y = 0; y < CANVAS_HEIGHT; y += 35) {
                    ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(CANVAS_WIDTH, y); ctx.stroke();
                }
            } else if (type === 'yellow') {
                ctx.fillStyle = "#fffde7";
                ctx.fillRect(0, 0, CANVAS_WIDTH, CANVAS_HEIGHT);
                ctx.strokeStyle = "rgba(255,0,0,0.15)";
                ctx.lineWidth = 2;
                ctx.beginPath(); ctx.moveTo(110, 0); ctx.lineTo(110, CANVAS_HEIGHT); ctx.stroke();
                ctx.strokeStyle = "#ffe082";
                for (let y = 168; y < CANVAS_HEIGHT; y += 40) {
                    ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(CANVAS_WIDTH, y); ctx.stroke();
                }
            } else if (type === 'old') {
                ctx.fillStyle = "#faf3e0";
                ctx.fillRect(0, 0, CANVAS_WIDTH, CANVAS_HEIGHT);
                for(let i=0; i<800; i++) {
                    ctx.fillStyle = `rgba(139, 69, 19, ${Math.random() * 0.05})`;
                    ctx.fillRect(Math.random() * CANVAS_WIDTH, Math.random() * CANVAS_HEIGHT, 1.5, 1.5);
                }
            }
        }

        [textInput, fontSelect, paperSelect, fontSizeSlider, tiltSlider].forEach(el => {
            el.addEventListener('input', render);
        });

        if (inkGroup) {
            inkGroup.addEventListener('click', (e) => {
                const btn = e.target.closest('.ink-dot');
                if(!btn) return;
                document.querySelectorAll('.ink-dot').forEach(b => b.classList.remove('active'));
                btn.classList.add('active');
                activeInk = btn.getAttribute('data-color');
                render();
            });
        }

        if (downloadBtn) {
            downloadBtn.onclick = () => {
                const link = document.createElement('a');
                link.download = "assignment_formfix.jpg";
                link.href = canvas.toDataURL('image/jpeg', 0.95);
                link.click();
            };
        }

        // Wait for fonts to load before first render
        document.fonts.ready.then(() => {
            render();
        });
    });
</script>

<style>
    .workspace-editor { width: 100%; max-width: 1200px; margin: 0 auto; }
    .studio-grid { display: grid; grid-template-columns: 420px 1fr; gap: 40px; }

    .controls-sidebar { position: sticky; top: 20px; }
    .settings-card { padding: 32px; background: #fff; }
    .section-label { font-size: 0.75rem; font-weight: 800; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em; display: block; }

    .modern-textarea { width: 100%; height: 200px; padding: 16px; border-radius: 12px; border: 1.5px solid var(--border-subtle); background: var(--surface-50); font-weight: 600; font-size: 1rem; outline: none; transition: 0.2s; resize: none; line-height: 1.5; }
    .modern-textarea:focus { border-color: var(--accent); background: #fff; box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.1); }

    .settings-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
    .modern-select { width: 100%; padding: 12px; border-radius: 12px; border: 1.5px solid var(--border-subtle); background: #fff; font-weight: 800; font-size: 0.9rem; outline: none; transition: 0.2s; cursor: pointer; }
    .modern-select:hover { border-color: var(--accent); }

    .ink-selector { display: flex; gap: 12px; }
    .ink-dot { width: 34px; height: 34px; border-radius: 50%; border: 3px solid #fff; box-shadow: 0 0 0 2px var(--border-subtle); cursor: pointer; transition: 0.2s; }
    .ink-dot.active { transform: scale(1.15); box-shadow: 0 0 0 2px var(--accent); }

    .status-pill { font-size: 0.75rem; font-weight: 900; color: var(--accent); background: #f0f7ff; padding: 2px 10px; border-radius: 20px; }
    .premium-slider { width: 100%; height: 6px; border-radius: 100px; background: var(--surface-200); appearance: none; outline: none; }
    .premium-slider::-webkit-slider-thumb { appearance: none; width: 20px; height: 20px; background: var(--accent); border: 4px solid #fff; border-radius: 50%; box-shadow: var(--shadow-sm); cursor: pointer; transition: 0.2s; }
    .premium-slider::-webkit-slider-thumb:hover { transform: scale(1.15); }

    .lg-btn { width: 100%; height: 64px; font-size: 1.1rem; border-radius: 18px; margin-top: 12px; }
    .privacy-tiny { font-size: 0.75rem; color: var(--text-muted); font-weight: 600; text-align: center; margin-top: 16px; }

    /* Preview UI */
    .preview-stage { min-width: 0; }
    .preview-badge { display: inline-block; background: var(--text-main); color: #fff; padding: 6px 16px; border-radius: 100px; font-size: 0.75rem; font-weight: 800; text-transform: uppercase; }
    .assignment-preview { padding: 40px; background: #eaeff5; display: flex; justify-content: center; overflow: hidden; }
    .canvas-wrap { max-width: 100%; box-shadow: 0 20px 50px rgba(0,0,0,0.15); border-radius: 4px; overflow: auto; background: #fff; }
    #handwriting-canvas { display: block; height: auto; width: 100%; max-width: 800px; }

    /* Info */
    .pro-article h2 { font-size: 1.75rem; font-weight: 850; margin-bottom: 24px; }
    .feature-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin: 32px 0; }
    .f-item { padding: 24px; background: var(--surface-50); border-radius: 20px; border: 1px solid var(--border-subtle); }
    .f-icon { font-size: 2rem; display: block; margin-bottom: 12px; }
    .ans { padding: 12px 0; color: var(--text-muted); font-size: 0.95rem; }

    .d-flex { display: flex; }
    .justify-between { justify-content: space-between; }
    .align-center { align-items: center; }

    @media (max-width: 1100px) {
        .studio-grid { grid-template-columns: 1fr; }
        .controls-sidebar { position: static; }
        .assignment-preview { padding: 20px; }
    }
</style>
