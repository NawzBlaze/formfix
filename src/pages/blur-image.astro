---
import BaseLayout from '../components/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import ToolWrapper from '../components/ToolWrapper.astro';

const PAGE_TITLE = 'Blur Image Online - Pixelate & Censor Faces for Free | FormFix';
const PAGE_DESC = 'Free online image blur tool to redact sensitive information, censor faces or pixelate areas of a photo securely within your browser. 100% private and fast.';
const PAGE_KEYWORDS = 'blur image online, pixelate image, censor face photo, redact image sensitive info, private online image blur, face pixelator';

const customSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      "name": "Image Blur & Censor Tool",
      "operatingSystem": "All Platforms",
      "applicationCategory": "UtilitiesApplication",
      "description": "Premium redaction tool to blur or pixelate sensitive parts of images locally.",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      }
    }
  ]
};

const faqs = [
  { q: "Does this actually delete the pixels?", a: "Yes. Unlike \"black bar\" overlays which can sometimes be removed, our tool performs a destructive pixelation or gaussian blur on the actual image data before you download the final file." },
  { q: "Is my original photo stored?", a: "Never. FormFix uses a \"Zero-Vault\" architecture. All processing is transient and happens in your browser's RAM. Once you close the tab, everything is gone." },
];
---

<BaseLayout title={PAGE_TITLE} description={PAGE_DESC} keywords={PAGE_KEYWORDS} customSchema={customSchema} active="tools" canonicalPath="/blur-image" faq={faqs}>
    <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
        try {
        const uploadBox = document.getElementById('u-box-container');
        const controls = document.getElementById('controls');
        const fileInput = document.getElementById('blur-input');
        
        const baseCanvas = document.getElementById('base-canvas');
        const fxCanvas = document.getElementById('fx-canvas');
        const drawCanvas = document.getElementById('draw-canvas');
        
        const bCtx = baseCanvas.getContext('2d');
        const fCtx = fxCanvas.getContext('2d', { willReadFrequently: true });
        const dCtx = drawCanvas.getContext('2d', { willReadFrequently: true });
        
        const typeBtns = document.querySelectorAll('.setting-pill');
        const brushSlider = document.getElementById('brush-size');
        const brushVal = document.getElementById('brush-val');
        const strSlider = document.getElementById('strength');
        const strVal = document.getElementById('str-val');
        
        const clearBtn = document.getElementById('clear-btn');
        const downloadBtn = document.getElementById('download-btn');

        let originalImg = null;
        let originalFileType = 'image/jpeg';
        let originalFileName = 'formfix-censored';
        let exifOrientation = 1;
        let drawScale = 1;
        let isDrawing = false;
        let currentMode = 'blur';
        let lastVisualEffect = 'blur';
        let currentShape = 'free';
        let undoStack = [];
        let redoStack = [];
        let strokeStartPos = null;
        let snapshotBeforeStroke = null;

        fileInput.addEventListener('change', (e) => {
             const file = e.target.files?.[0];
             if (file) handleFile(file);
        });

        uploadBox.addEventListener('dragover', (e) => {
             e.preventDefault();
             uploadBox.querySelector('.upload-box').classList.add('drag-active');
        });
        uploadBox.addEventListener('dragleave', () => {
             uploadBox.querySelector('.upload-box').classList.remove('drag-active');
        });
        uploadBox.addEventListener('drop', (e) => {
             e.preventDefault();
             uploadBox.querySelector('.upload-box').classList.remove('drag-active');
             if (e.dataTransfer?.files.length) {
                 fileInput.files = e.dataTransfer.files;
                 handleFile(e.dataTransfer.files[0]);
             }
        });

        function handleFile(file) {
             if (!file.type.startsWith('image/')) {
                 if (typeof window.ffNotice === 'function') window.ffNotice('Please upload an image file.', 'error');
                 return;
             }
             originalFileType = file.type === 'image/png' ? 'image/png' : file.type === 'image/webp' ? 'image/webp' : 'image/jpeg';
             originalFileName = file.name ? file.name.replace(/\.[^/.]+$/, '') : 'formfix-censored';
             const reader = new FileReader();
             reader.onload = (ev) => {
                 originalImg = new Image();
                 originalImg.onload = () => {
                     uploadBox.classList.add('hidden');
                     controls.classList.remove('hidden');
                     initCanvas();
                 };
                 originalImg.src = ev.target?.result;
             };
             reader.readAsDataURL(file);
             const exifReader = new FileReader();
             exifReader.onload = (exifEv) => {
                 exifOrientation = (window.FormFix && window.FormFix.readExifOrientation) ? window.FormFix.readExifOrientation(exifEv.target.result) : 1;
             };
             exifReader.readAsArrayBuffer(file);
        }

        typeBtns.forEach(btn => btn.addEventListener('click', () => {
             typeBtns.forEach(b => b.classList.remove('active'));
             btn.classList.add('active');
             currentMode = btn.dataset.fx || 'blur';
             
             if (currentMode === 'blur' || currentMode === 'pixel') {
                 lastVisualEffect = currentMode;
                 generateEffect();
             }
             renderFinal();
        }));

        brushSlider.addEventListener('input', () => brushVal.textContent = brushSlider.value);
        strSlider.addEventListener('input', () => {
             strVal.textContent = strSlider.value;
             generateEffect();
             renderFinal();
        });

        clearBtn.addEventListener('click', () => {
             saveUndoState();
             dCtx.clearRect(0, 0, drawCanvas.width, drawCanvas.height);
             renderFinal();
        });

        const undoBtn = document.getElementById('undo-btn');
        const redoBtn = document.getElementById('redo-btn');
        if (undoBtn) undoBtn.addEventListener('click', undo);
        if (redoBtn) redoBtn.addEventListener('click', redo);

        function saveUndoState() {
             undoStack.push(dCtx.getImageData(0, 0, drawCanvas.width, drawCanvas.height));
             if (undoStack.length > 30) undoStack.shift();
             redoStack = [];
        }
        function undo() {
             if (undoStack.length === 0) return;
             redoStack.push(dCtx.getImageData(0, 0, drawCanvas.width, drawCanvas.height));
             dCtx.putImageData(undoStack.pop(), 0, 0);
             renderFinal();
        }
        function redo() {
             if (redoStack.length === 0) return;
             undoStack.push(dCtx.getImageData(0, 0, drawCanvas.width, drawCanvas.height));
             dCtx.putImageData(redoStack.pop(), 0, 0);
             renderFinal();
        }

        const shapeBtns = document.querySelectorAll('.shape-btn');
        shapeBtns.forEach(btn => btn.addEventListener('click', () => {
             shapeBtns.forEach(b => b.classList.remove('active'));
             btn.classList.add('active');
             currentShape = btn.dataset.shape || 'free';
        }));

        window.addEventListener('keydown', (e) => {
             if ((e.ctrlKey || e.metaKey) && e.key === 'z') { e.preventDefault(); undo(); }
             if ((e.ctrlKey || e.metaKey) && e.key === 'y') { e.preventDefault(); redo(); }
        });

        function initCanvas() {
             if (!originalImg) return;
             
             const maxD = 1200;
             let s = 1;
             if (originalImg.width > maxD || originalImg.height > maxD) {
                 s = maxD / Math.max(originalImg.width, originalImg.height);
             }

             const cw = originalImg.width * s;
             const ch = originalImg.height * s;
             
             baseCanvas.width = cw; baseCanvas.height = ch;
             fxCanvas.width = cw; fxCanvas.height = ch;
             drawCanvas.width = cw; drawCanvas.height = ch;

             if (window.FormFix && window.FormFix.applyExifOrientation && exifOrientation > 1) {
                 window.FormFix.applyExifOrientation(bCtx, originalImg, exifOrientation, 0, 0, cw, ch);
             } else {
                 bCtx.drawImage(originalImg, 0, 0, cw, ch);
             }
             
             generateEffect();
             renderFinal();

             resizeCanvas();
             window.addEventListener('resize', resizeCanvas);
        }

        function resizeCanvas() {
             const container = baseCanvas.parentElement;
             if (!container) return;
             
             drawScale = Math.min(container.clientWidth / baseCanvas.width, (window.innerHeight * 0.6) / baseCanvas.height, 1);
             const fw = `${baseCanvas.width * drawScale}px`;
             const fh = `${baseCanvas.height * drawScale}px`;

             baseCanvas.style.width = fw; baseCanvas.style.height = fh;
             fxCanvas.style.width = fw; fxCanvas.style.height = fh;
             drawCanvas.style.width = fw; drawCanvas.style.height = fh;
        }

        function generateEffect() {
             if (!originalImg) return;
             fCtx.clearRect(0, 0, fxCanvas.width, fxCanvas.height);
             
             const str = parseInt(strSlider.value);
             
             if (lastVisualEffect === 'blur') {
                 fCtx.filter = `blur(${str}px)`;
                 fCtx.drawImage(baseCanvas, 0, 0);
                 fCtx.filter = 'none';
             } else {
                 const s = Math.max(0.01, 1 - (str * 0.02)); 
                 const pw = Math.max(1, fxCanvas.width * s);
                 const ph = Math.max(1, fxCanvas.height * s);
                 
                 fCtx.imageSmoothingEnabled = false;
                 fCtx.drawImage(baseCanvas, 0, 0, pw, ph);
                 fCtx.drawImage(fxCanvas, 0, 0, pw, ph, 0, 0, fxCanvas.width, fxCanvas.height);
                 fCtx.imageSmoothingEnabled = true;
             }
        }

        function getMousePos(e) {
             const rect = drawCanvas.getBoundingClientRect();
             let clientX, clientY;
             if (e.touches && e.touches.length > 0) {
                 clientX = e.touches[0].clientX; clientY = e.touches[0].clientY;
             } else {
                 clientX = e.clientX; clientY = e.clientY;
             }
             
             return {
                 x: (clientX - rect.left) / drawScale,
                 y: (clientY - rect.top) / drawScale
             };
        }

        function strokeMask(x, y) {
             const brush = parseInt(brushSlider.value);
             dCtx.beginPath();
             dCtx.arc(x, y, brush, 0, Math.PI * 2);
             if (currentMode === 'erase') {
                 dCtx.globalCompositeOperation = 'destination-out';
                 dCtx.fillStyle = 'black';
                 dCtx.fill();
                 dCtx.globalCompositeOperation = 'source-over';
             } else {
                 dCtx.fillStyle = 'black';
                 dCtx.fill();
             }
        }

        function renderFinal() {
             if (window.FormFix && window.FormFix.applyExifOrientation && exifOrientation > 1) {
                 window.FormFix.applyExifOrientation(bCtx, originalImg, exifOrientation, 0, 0, baseCanvas.width, baseCanvas.height);
             } else {
                 bCtx.drawImage(originalImg, 0, 0, baseCanvas.width, baseCanvas.height);
             }
             
             const tmp = document.createElement('canvas');
             tmp.width = baseCanvas.width; tmp.height = baseCanvas.height;
             const tCtx = tmp.getContext('2d');
             
             tCtx.drawImage(drawCanvas, 0, 0);
             tCtx.globalCompositeOperation = 'source-in';
             tCtx.drawImage(fxCanvas, 0, 0);
             
             bCtx.drawImage(tmp, 0, 0);
        }

        const startDraw = (e) => {
             isDrawing = true;
             const {x, y} = getMousePos(e);
             strokeStartPos = { x, y };
             snapshotBeforeStroke = dCtx.getImageData(0, 0, drawCanvas.width, drawCanvas.height);
             if (currentShape === 'free') {
                  strokeMask(x, y);
                  renderFinal();
             }
        };

        const draw = (e) => {
             if (!isDrawing) return;
             e.preventDefault();
             const {x, y} = getMousePos(e);
             if (currentShape === 'free') {
                  strokeMask(x, y);
                  renderFinal();
             } else {
                  dCtx.putImageData(snapshotBeforeStroke, 0, 0);
                  dCtx.fillStyle = 'black';
                  if (currentShape === 'rect') {
                       const rx = Math.min(strokeStartPos.x, x);
                       const ry = Math.min(strokeStartPos.y, y);
                       const rw = Math.abs(x - strokeStartPos.x);
                       const rh = Math.abs(y - strokeStartPos.y);
                       dCtx.fillRect(rx, ry, rw, rh);
                  } else if (currentShape === 'circle') {
                       const dx = x - strokeStartPos.x;
                       const dy = y - strokeStartPos.y;
                       const radius = Math.sqrt(dx * dx + dy * dy);
                       dCtx.beginPath();
                       dCtx.arc(strokeStartPos.x, strokeStartPos.y, radius, 0, Math.PI * 2);
                       dCtx.fill();
                  }
                  renderFinal();
             }
        };

        const stopDraw = () => {
             if (isDrawing && snapshotBeforeStroke) {
                  if (currentShape !== 'free') {
                       saveUndoState();
                  } else {
                       const prev = snapshotBeforeStroke;
                       const now = dCtx.getImageData(0, 0, drawCanvas.width, drawCanvas.height);
                       let changed = false;
                       for (let i = 0; i < prev.data.length; i += 4) {
                            if (prev.data[i] !== now.data[i] || prev.data[i+1] !== now.data[i+1] || prev.data[i+2] !== now.data[i+2] || prev.data[i+3] !== now.data[i+3]) { changed = true; break; }
                       }
                       if (changed) undoStack.push(prev);
                  }
             }
             isDrawing = false;
             strokeStartPos = null;
             snapshotBeforeStroke = null;
        };

        drawCanvas.addEventListener('mousedown', startDraw);
        drawCanvas.addEventListener('mousemove', draw);
        window.addEventListener('mouseup', stopDraw);

        drawCanvas.addEventListener('touchstart', (e) => { e.preventDefault(); startDraw(e); }, {passive: false});
        drawCanvas.addEventListener('touchmove', draw, {passive: false});
        window.addEventListener('touchend', stopDraw);

        downloadBtn.addEventListener('click', () => {
             const ext = originalFileType === 'image/png' ? 'png' : originalFileType === 'image/webp' ? 'webp' : 'jpg';
             baseCanvas.toBlob(blob => {
                 if (!blob) { if (typeof window.ffNotice === 'function') window.ffNotice('Failed to generate image. Try a different format.', 'error'); return; }
                 const url = URL.createObjectURL(blob);
                 const a = document.createElement('a');
                 a.href = url;
                 a.download = `${originalFileName}-censored.${ext}`;
                 a.click();
                 URL.revokeObjectURL(url);
             }, originalFileType, 0.95);
        });
        } catch(err) { console.error('Blur tool error:', err); if (typeof window.ffNotice === 'function') window.ffNotice('Something went wrong. Please try a different image.', 'error'); }
    });
</script>

    <Breadcrumb items={[{ name: 'Home', path: '/' }, { name: "Blur Image Online - Pixelate & Censor Faces for Free", path: "/blur-image" }]} />

    <ToolWrapper title="Blur & Censor" subtitle="Redact sensitive data, faces, and documents with brush-based blurring." currentTool="blur-image">
        
        <div slot="tool-ui">
             <div class="workspace-editor">
                  <!-- 1. Selection Stage -->
                  <div id="u-box-container" class="upload-container">
                       <div class="upload-box shadow-sm" id="drop-zone" onclick="document.getElementById('blur-input').click()">
                            <input type="file" id="blur-input" class="hidden" accept="image/*" />
                            <div class="upload-content">
                                 <div class="upload-icon">🕵️‍♂️</div>
                                 <h3 class="font-850 m-0 mb-8">Select Image to Censor</h3>
                                 <p class="text-muted m-0 mb-24 font-600">Redact sensitive faces or information securely.</p>
                                 <button class="primary-btn px-40">Browse Photo</button>
                            </div>
                       </div>
                  </div>

                  <!-- 2. Editor Stage -->
                   <div id="controls" class="hidden">
                        <div class="crop-grid">
                            <div class="preview-panel shadow-sm">
                                 <div class="preview-header mb-16 d-flex justify-between align-center">
                                      <span class="preview-badge">Live Redaction Canvas</span>
                                      <span class="text-muted font-600 select-none">🎨 Draw to censor</span>
                                 </div>
                                 <div class="canvas-viewport checkerboard scroll-container">
                                      <canvas id="base-canvas"></canvas>
                                      <canvas id="fx-canvas"></canvas>
                                      <canvas id="draw-canvas"></canvas>
                                 </div>
                            </div>

                            <div class="controls-sidebar">
                                 <div class="settings-card shadow-sm mb-24">
                                       <div class="section mb-24">
                                            <label class="section-label m-0 mb-12">Effect Style</label>
                                            <div class="toggle-pill-group">
                                                 <button class="setting-pill active" data-fx="blur">Soft Blur</button>
                                                 <button class="setting-pill" data-fx="pixel">Pixelate</button>
                                                 <button class="setting-pill" data-fx="erase">Erase 🧽</button>
                                            </div>
                                       </div>

                                       <div class="section mb-24">
                                            <label class="section-label m-0 mb-12">Brush Shape</label>
                                            <div class="toggle-pill-group">
                                                 <button class="setting-pill active shape-btn" data-shape="free">✏️ Free</button>
                                                 <button class="setting-pill shape-btn" data-shape="rect">▭ Rect</button>
                                                 <button class="setting-pill shape-btn" data-shape="circle">○ Circle</button>
                                            </div>
                                       </div>
                                      
                                      <div class="section mb-24">
                                           <div class="d-flex justify-between align-center mb-16">
                                                <label class="section-label m-0">Brush Size</label>
                                                <span id="brush-val" class="status-pill highlight m-0" style="padding: 4px 12px;">40</span>
                                           </div>
                                           <input type="range" id="brush-size" min="10" max="150" value="40" class="unified-slider w-100" />
                                      </div>

                                      <div class="section">
                                           <div class="d-flex justify-between align-center mb-16">
                                                <label class="section-label m-0">Strength</label>
                                                <span id="str-val" class="status-pill highlight m-0" style="padding: 4px 12px;">10</span>
                                           </div>
                                           <input type="range" id="strength" min="2" max="50" value="10" class="unified-slider w-100" />
                                      </div>
                                 </div>

                                  <div class="action-stack">
                                       <button id="download-btn" class="primary-btn wide-btn pulse-glow mb-12">⬇️ Download Redacted</button>
                                       <div class="d-flex gap-12 mb-12">
                                            <button id="undo-btn" class="secondary-btn wide-btn flex-1" title="Ctrl+Z">↩ Undo</button>
                                            <button id="redo-btn" class="secondary-btn wide-btn flex-1" title="Ctrl+Y">↪ Redo</button>
                                       </div>
                                       <div class="d-flex gap-12">
                                            <button id="clear-btn" class="secondary-btn wide-btn flex-1">🗑️ Clear</button>
                                            <button class="secondary-btn wide-btn flex-1" onclick="location.reload()">↺ New</button>
                                       </div>
                                  </div>
                                 <p class="privacy-note text-center mt-16 mb-0 font-600 text-muted">🔒 Processed entirely in browser RAM.</p>
                            </div>
                       </div>
                  </div>
             </div>
        </div>

        <div slot="tool-info">
             <h2>Secure Document Redaction</h2>
             <p>Our <strong>Online Redaction Tool</strong> ensures your classified information never leaves your device. By processing everything strictly inside your local browser memory, we offer the most private way to censor faces, license plates, and sensitive documents.</p>
             
             <div class="faq-grid mt-32">
                  <details class="faq-item">
                       <summary>Does this actually delete the pixels?</summary>
                       <p>Yes. Unlike "black bar" overlays which can sometimes be removed, our tool performs a destructive pixelation or gaussian blur on the actual image data before you download the final file.</p>
                  </details>
                  <details class="faq-item">
                       <summary>Is my original photo stored?</summary>
                       <p>Never. FormFix uses a "Zero-Vault" architecture. All processing is transient and happens in your browser's RAM. Once you close the tab, everything is gone.</p>
                  </details>
             </div>
        </div>
    </ToolWrapper>
</BaseLayout><style>
    @media (max-width: 900px) {
        .crop-grid { grid-template-columns: 1fr; }
        .preview-panel { min-height: 350px; padding: 16px; }
    }
    @media (max-width: 640px) {
        .upload-box { padding: 40px 24px; }
    }
</style>
