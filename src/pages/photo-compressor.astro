---
import BaseLayout from '../components/BaseLayout.astro';
import ToolWrapper from '../components/ToolWrapper.astro';
import CompressTool from '../components/tools/CompressTool.astro';

const PAGE_TITLE = 'Photo Compressor Online - Reduce JPEG/PNG Size | FormFix';
const PAGE_DESC = 'Professional photo compressor used by millions to reduce image file size without losing quality. Optimized for 20KB, 50KB, and 100KB targets.';
const PAGE_KEYWORDS = 'photo compressor, reduce photo size online, jpeg compressor, image size reducer';
---

<BaseLayout title={PAGE_TITLE} description={PAGE_DESC} keywords={PAGE_KEYWORDS} active="compress" canonicalPath="/compress-image">
    <ToolWrapper title="Photo Compressor" subtitle="Reduce image size while maintaining crystal clear quality." currentTool="compress">
        <div slot="tool-ui">
             <CompressTool />
        </div>
        <div slot="tool-info">
             <h2>Why use FormFix Photo Compressor?</h2>
             <p>Our tool uses advanced browser-side compression, allowing you to hit exact file size requirements (like 20KB or 50KB) needed for official form submissions.</p>
        </div>
    </ToolWrapper>
</BaseLayout>
