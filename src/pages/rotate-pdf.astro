---
import BaseLayout from '../components/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import ToolWrapper from '../components/ToolWrapper.astro';

const PAGE_TITLE = 'Rotate PDF Pages Online - Free & Secure Editor | FormFix';
const PAGE_DESC = 'Rotate upside-down PDF pages instantly in your browser with live preview. 100% free, no uploads, and perfectly secure. Rotate left or right and download.';
const PAGE_KEYWORDS = 'rotate pdf online, rotate pdf pages, preview pdf rotation, flip pdf, secure pdf editor, free rotate pdf tool';

const customSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      "name": "FormFix Pro PDF Rotator",
      "operatingSystem": "All",
      "applicationCategory": "UtilitiesApplication",
      "description": "Preview and rotate all pages in a PDF document 90, 180, or 270 degrees locally.",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      }
    }
  ]
};

const faqs = [
  { q: "Will this reduce my PDF quality?", a: "Absolutely not. Fixing the rotation does not blur images or alter text. We strictly modify the internal bounding box matrices locally, meaning your document retains its original crisp 100% quality." },
  { q: "How many pages can I rotate?", a: "Our tool rotates all pages in the PDF simultaneously. There is no hard limit on the number of pages, as long as your browser has enough memory to handle the file size." },
];
---

<BaseLayout title={PAGE_TITLE} description={PAGE_DESC} keywords={PAGE_KEYWORDS} customSchema={customSchema} active="pdf" canonicalPath="/rotate-pdf" faq={faqs}>
    <script type="module">
    import * as pdfjsLib from 'pdfjs-dist';
    import { PDFDocument, degrees } from 'pdf-lib';
    pdfjsLib.GlobalWorkerOptions.workerSrc = new URL('pdfjs-dist/build/pdf.worker.min.mjs', import.meta.url).href;
    window.pdfjsLib = pdfjsLib;
    window.PDFLib = { PDFDocument, degrees };
    </script>

    <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
        const fileInput = document.getElementById('pdf-upload');
        const uploadStage = document.getElementById('upload-stage');
        const editorStage = document.getElementById('editor-stage');
        const downloadBtn = document.getElementById('download-btn');
        const resetBtn = document.getElementById('reset-btn');
        
        const docName = document.getElementById('doc-name');
        const docPages = document.getElementById('doc-pages');
        const previewCanvas = document.getElementById('pdf-preview');
        const ctx = previewCanvas?.getContext('2d');

        let pdfBytesOriginal = null;
        let fileName = 'document.pdf';
        
        let totalRotation = 0;

        async function renderPreview(arrayBuffer) {
             const typedarray = new Uint8Array(arrayBuffer.slice(0));
             const pdf = await pdfjsLib.getDocument({ data: typedarray }).promise;
             const page = await pdf.getPage(1);
             
             const viewport = page.getViewport({ scale: 1.0 });
             const scale = Math.min(600 / viewport.width, 1.5);
             const scaledViewport = page.getViewport({ scale });
             
             previewCanvas.width = scaledViewport.width;
             previewCanvas.height = scaledViewport.height;
             
             if (ctx) await page.render({ canvasContext: ctx, viewport: scaledViewport }).promise;
        }

        function updatePreviewTransform() {
             if (previewCanvas) previewCanvas.style.transform = `rotate(${totalRotation}deg)`;
        }

        function bindUploadHandler() {
            const inp = document.getElementById('pdf-upload');
            if (!inp) return;
            inp.addEventListener('change', async function handler(e) {
                const file = e.target.files[0];
                if(!file) return;
                fileName = file.name;
                
                if (docName) docName.textContent = fileName;
                uploadStage.innerHTML = `<div class="upload-circle"><span class="u-icon pulse-glow">⏳</span></div><h3 class="u-title">Loading PDF...</h3>`;
                
                const reader = new FileReader();
                reader.onload = async (event) => {
                    pdfBytesOriginal = event.target.result;
                    
                    try {
                        const { PDFDocument } = window.PDFLib;
                        const pdfDoc = await PDFDocument.load(pdfBytesOriginal.slice(0));
                        const pages = pdfDoc.getPages();
                        if (docPages) docPages.textContent = `${pages.length} Pages loaded`;
                        
                        await renderPreview(pdfBytesOriginal);
                        
                        uploadStage?.classList.add('hidden');
                        editorStage?.classList.remove('hidden');
                        
                        totalRotation = 0;
                        updatePreviewTransform();

                    } catch(err) {
                        console.error(err);
                        window.ffNotice("Could not load PDF. It might be encrypted or corrupted.", "error");
                        uploadStage.innerHTML = `<div class="upload-circle mb-16"><span class="u-icon">📄</span></div><h3 class="u-title">Select a PDF</h3><p class="u-sub">Works with any PDF document or scan.</p><button class="primary-btn wide-btn profile-btn pulse-glow" onclick="document.getElementById('pdf-upload').click()">Browse PDF</button><input type="file" id="pdf-upload" class="hidden" accept="application/pdf" />`;
        if (uploadStage) {
            uploadStage.addEventListener('dragover', (e) => { e.preventDefault(); uploadStage.classList.add('drag-active'); });
            uploadStage.addEventListener('dragleave', () => uploadStage.classList.remove('drag-active'));
            uploadStage.addEventListener('drop', (e) => {
                e.preventDefault();
                uploadStage.classList.remove('drag-active');
                if (e.dataTransfer?.files.length) {
                    const fileInput = document.getElementById('pdf-upload');
                    if (fileInput) {
                        fileInput.files = e.dataTransfer.files;
                        fileInput.dispatchEvent(new Event('change'));
                    }
                }
            });
        }

        bindUploadHandler();
                    }
                };
                reader.readAsArrayBuffer(file);
            });
        }

        bindUploadHandler();

        document.getElementById('rotate-left-btn')?.addEventListener('click', () => {
             totalRotation -= 90;
             updatePreviewTransform();
        });

        document.getElementById('rotate-right-btn')?.addEventListener('click', () => {
             totalRotation += 90;
             updatePreviewTransform();
        });

        if (resetBtn) {
            resetBtn.addEventListener('click', () => {
                pdfBytesOriginal = null;
                totalRotation = 0;
                updatePreviewTransform();
                uploadStage.innerHTML = `<div class="upload-icon-circle">🔄</div><h3 class="zone-title">Rotate PDF Pages</h3><p class="zone-sub">Upload PDF to fix page orientation</p><button class="primary-btn px-32" onclick="document.getElementById('pdf-upload').click()">Select PDF File</button><input type="file" id="pdf-upload" class="hidden" accept="application/pdf" />`;
                uploadStage?.classList.remove('hidden');
                editorStage?.classList.add('hidden');
                bindUploadHandler();
            });
        }

        downloadBtn?.addEventListener('click', async () => {
            if (!pdfBytesOriginal) return;

            if (!window.PDFLib || !window.PDFLib.PDFDocument) {
                if (typeof window.ffNotice === 'function') window.ffNotice('PDF library is still loading. Please wait a moment and try again.', 'error');
                return;
            }

            try {
                if (totalRotation % 360 === 0) {
                     const proceed = confirm("You haven't rotated the document visually. Save anyway?");
                     if (!proceed) return;
                }

                downloadBtn.textContent = '⏳ Processing...';
                downloadBtn.style.pointerEvents = 'none';

                const { PDFDocument, degrees } = window.PDFLib;
                const pdfDoc = await PDFDocument.load(pdfBytesOriginal.slice(0));
                const pages = pdfDoc.getPages();

                pages.forEach((page) => {
                    const rotObj = page.getRotation();
                    const currentAngle = rotObj ? (rotObj.angle || 0) : 0;
                    page.setRotation(degrees(currentAngle + totalRotation));
                });

                const modifiedPdfBytes = await pdfDoc.save();
                const blob = new Blob([modifiedPdfBytes], { type: 'application/pdf' });
                const url = URL.createObjectURL(blob);
                
                const link = document.createElement('a');
                link.download = fileName.replace('.pdf', '') + '_fixed.pdf';
                link.href = url;
                link.click();
                if (window.triggerConfetti) window.triggerConfetti();
                var shareTxt = encodeURIComponent("I just rotated my PDF using FormFix! 100% private, no uploads. Try it: " + window.__SITE_URL + "/rotate-pdf");
                var existing = document.getElementById('post-rotate-share');
                if (!existing) {
                    var div = document.createElement('div');
                    div.id = 'post-rotate-share';
                    div.style.cssText = 'margin-top:20px;text-align:center;';
                    div.innerHTML = '<p style="font-weight:600;margin-bottom:10px;color:var(--success);">Love FormFix? Share it!</p><div style="display:flex;gap:8px;justify-content:center;"><a href="https://x.com/intent/tweet?text=' + shareTxt + '" target="_blank" style="padding:8px 16px;border-radius:8px;background:#000;color:#fff;text-decoration:none;font-weight:600;font-size:0.85rem;">Share on X</a><a href="https://wa.me/?text=' + shareTxt + '" target="_blank" style="padding:8px 16px;border-radius:8px;background:#25D366;color:#fff;text-decoration:none;font-weight:600;font-size:0.85rem;">WhatsApp</a></div>';
                    downloadBtn?.parentElement?.appendChild(div);
                }
            } catch (err) {
                 console.error(err);
                  window.ffNotice('Error saving the rotated document.', 'error');
            } finally {
                 if (downloadBtn) downloadBtn.textContent = '⬇️ Apply & Save PDF';
                 if (downloadBtn) downloadBtn.style.pointerEvents = 'all';
                 totalRotation = 0;
                 updatePreviewTransform();
            }
        });
    });
</script>

    <Breadcrumb items={[{ name: 'Home', path: '/' }, { name: "Rotate PDF Pages Online - Free & Secure Editor", path: "/rotate-pdf" }]} />

    <ToolWrapper title="Rotate PDF Files" subtitle="Fix upside-down scanned PDFs securely with a live visual preview." currentTool="rotate-pdf">
        
        <div slot="tool-ui">
             <div class="workspace-editor">
                  <!-- 1. Selection Step -->
                  <div id="upload-stage" class="upload-zone show">
                       <div class="upload-icon-circle">🔄</div>
                       <h3 class="zone-title">Rotate PDF Pages</h3>
                       <p class="zone-sub">Upload PDF to fix page orientation</p>
                       <button class="primary-btn px-32" onclick="document.getElementById('pdf-upload').click()">Select PDF File</button>
                       <input type="file" id="pdf-upload" class="hidden" accept="application/pdf" />
                  </div>

                  <!-- 2. Workspace Step -->
                  <div id="editor-stage" class="hidden">
                       <div class="editor-layout">
                            <div class="preview-stage shadow-sm">
                                 <div class="preview-header">
                                      <span class="preview-badge">Live PDF Preview</span>
                                 </div>
                                 <div class="canvas-frame checkerboard">
                                      <canvas id="pdf-preview"></canvas>
                                 </div>
                                 <div class="info-pill mt-16 shadow-xs">
                                      <span id="doc-name" class="name">document.pdf</span>
                                      <span class="sep">|</span>
                                      <span id="doc-pages" class="count">Detecting pages...</span>
                                 </div>
                            </div>
                            
                            <div class="sidebar-controls">
                                 <div class="settings-card shadow-sm mb-24">
                                      <label class="section-label mb-16">Rotation Controls</label>
                                      <div class="rotation-grid">
                                           <button id="rotate-left-btn" class="secondary-btn flex-1 py-16">
                                                <span class="d-block mb-4">↺</span>
                                                <span class="text-xs">Left 90°</span>
                                           </button>
                                           <button id="rotate-right-btn" class="secondary-btn flex-1 py-16">
                                                <span class="d-block mb-4">↻</span>
                                                <span class="text-xs">Right 90°</span>
                                           </button>
                                      </div>
                                 </div>

                                 <div class="action-footer vertical">
                                       <button id="download-btn" class="primary-btn wide-btn pulse-glow">⬇️ Apply & Save PDF</button>
                                       <button id="reset-btn" class="secondary-btn wide-btn">↺ Change File</button>
                                 </div>
                                 <p class="privacy-note text-center mt-16 font-600">🔒 Local PDF processing.</p>
                            </div>
                       </div>
                  </div>
             </div>
        </div>

        <div slot="tool-info">
             <h2>The Fastest Way to Rotate Upside-Down PDFs</h2>
             <p>Scanners and phone cameras often save documents in the incorrect orientation. Our <strong>Free PDF Rotator</strong> provides a beautiful live preview, allowing you to visually confirm the correct orientation of your document instantly before saving. Unlike other websites that require you to upload your sensitive tax documents or IDs to their server, our system alters the standard PDF rotation metadata directly inside your computer's RAM.</p>
             
             <div class="faq-grid mt-32">
                  <details class="faq-item">
                       <summary>Will this reduce my PDF quality?</summary>
                       <p>Absolutely not. Fixing the rotation does not blur images or alter text. We strictly modify the internal bounding box matrices locally, meaning your document retains its original crisp 100% quality.</p>
                  </details>
                  <details class="faq-item">
                       <summary>How many pages can I rotate?</summary>
                       <p>Our tool rotates all pages in the PDF simultaneously. There is no hard limit on the number of pages, as long as your browser has enough memory to handle the file size.</p>
                  </details>
             </div>
        </div>
    </ToolWrapper>
</BaseLayout><style>
    .main-h1 { font-size: 3.5rem; font-weight:600; letter-spacing: -0.05em; margin-bottom: 12px; color: var(--text-primary); line-height: 1.1; }
    .hero-sub { color: var(--text-secondary); font-weight: 600; font-size: 1.25rem; margin-bottom: 24px; }
    .tool-wrapper { max-width: 960px; margin: 0 auto; padding-bottom: 100px; }
    .max-w-lg { max-width: 550px; margin-inline: auto; }
    
    .upload-container { background: var(--surface-2); border: 2.5px dashed var(--border); border-radius: 32px; padding: 60px 20px; text-align: center; cursor: pointer; transition: 0.3s; margin-top:16px; min-height: 380px; display: flex; flex-direction: column; align-items: center; justify-content: center; }
    .upload-container:hover { border-color: var(--accent-primary); background: var(--success-soft); transform: translateY(-4px); }
    .upload-circle { width: 90px; height: 90px; background:var(--surface-3); border-radius: 50%; box-shadow: 0 10px 25px rgba(0,0,0,0.05); display: flex; align-items: center; justify-content: center; margin: 0 auto 20px; font-size: 3rem; }
    .u-title { font-size: 1.8rem; font-weight:600; color: var(--text-primary); margin-bottom: 8px; }
    .u-sub { font-size: 1.1rem; color: var(--text-secondary); font-weight: 600; margin-bottom: 32px; }

    #editor-stage { background:var(--surface-3); padding: 24px; border-radius: 24px; border: 1.5px solid var(--border); }
    
    .editor-layout { display: grid; grid-template-columns: 1fr 280px; gap: 24px; align-items: start; }
    .sidebar-controls { display: flex; flex-direction: column; gap: 16px; }
    
    .preview-stage { position: relative; width: 100%; height: 350px; background: var(--surface-2); border-radius: 16px; display: flex; justify-content: center; align-items: center; overflow: hidden; border: 2px dashed var(--text-muted); padding: 20px; }
    .preview-badge { position: absolute; top: 12px; left: 16px; background: rgba(0,0,0,0.75); color: #fff; padding: 4px 12px; border-radius: 100px; font-size: 0.85rem; font-weight:600; }
    
    .canvas-wrapper { width: 100%; height: 100%; display: flex; justify-content: center; align-items: center; }
    .pdf-canvas { max-width: 100%; max-height: 100%; box-shadow: 0 5px 20px rgba(0,0,0,0.15); transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275); transform-origin: center center; border-radius: 2px;}

    .info-banner { display: flex; align-items: center; gap: 16px; padding: 20px; background:var(--surface-3); border: 1.5px solid var(--border); border-radius: 16px; }
    .f-icon { font-size: 2.5rem; }
    .f-text { display: flex; flex-direction: column; overflow: hidden; }
    .f-name { font-weight:600; color: var(--text-primary); font-size: 1.25rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 300px; }
    .f-size { color: var(--accent-primary); font-size: 1rem; font-weight:600; margin-top:4px; }

    .text-xl { font-size: 1.3rem; }
    .text-lg { font-size: 1.1rem; }
    
    .hover-scale { transition: 0.2s; }
    .hover-scale:hover { transform: scale(1.05); border-color: var(--accent-primary); color: var(--accent-primary); background: var(--accent-soft); }

    .wide-btn { padding: 22px 24px; font-weight:600; font-size: 1.25rem; border-radius: 100px; display: block; }
    .wide-btn-half { padding: 18px 24px; font-weight:600; border-radius: 100px; flex: 1; border: 2px solid var(--border); background:var(--surface-3); }

    @media (max-width: 640px) {
        .editor-layout { grid-template-columns: 1fr; gap: 16px; }
        .wrap-mobile { flex-direction: column; }
        .wide-btn, .wide-btn-half { width: 100%; }
        .f-name { max-width: 200px; }
        .preview-stage { height: 280px; }
    }
</style>
