---
import BaseLayout from '../components/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import ToolWrapper from '../components/ToolWrapper.astro';

const PAGE_TITLE = 'Resize Image Pixels Online - Free Dimension Changer | FormFix';
const PAGE_DESC = 'Resize image dimensions in pixels for Instagram, YouTube, and official forms. Pro aspect ratio lock and high-quality interpolation.';
const PAGE_KEYWORDS = 'resize image pixels online, online image resizer, change photo dimensions free, resize image for instagram, photo resolution changer';

const customSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      "name": "Resize Image Online - FormFix",
      "operatingSystem": "All Platforms",
      "applicationCategory": "DesignApplication",
      "description": "Easily resize image dimensions in pixels for Instagram, YouTube, and official forms. Pro aspect ratio lock and high-quality interpolation.",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      }
    }
  ]
};
---

<BaseLayout title={PAGE_TITLE} description={PAGE_DESC} keywords={PAGE_KEYWORDS} customSchema={customSchema} active="tools" canonicalPath="/resize-image">
    <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
        const uploadBox = document.getElementById('u-box-container');
        const controls = document.getElementById('controls');
        const fileInput = document.getElementById('file-input');
        const source = document.getElementById('source');

        const lockIcon = document.getElementById('lock-icon');
        const aspectLock = document.getElementById('aspect-lock');
        const presetBtns = document.querySelectorAll('.preset-btn');
        const applyBtn = document.getElementById('apply-btn');
        const resultStage = document.getElementById('result-stage');
        
        const origResTxt = document.getElementById('orig-res-txt');
        const targetResTxt = document.getElementById('target-res-txt');
        
        const widthInput = document.getElementById('width-px');
        const heightInput = document.getElementById('height-px');

        let originalImg = null;
        let originalRatio = 1;

        fileInput.addEventListener('change', (e) => {
            const file = e.target.files?.[0];
            if (file) handleFile(file);
        });

        uploadBox.addEventListener('dragover', (e) => {
             e.preventDefault();
             uploadBox.querySelector('.upload-box').classList.add('drag-active');
        });
        uploadBox.addEventListener('dragleave', () => {
             uploadBox.querySelector('.upload-box').classList.remove('drag-active');
        });
        uploadBox.addEventListener('drop', (e) => {
             e.preventDefault();
             uploadBox.querySelector('.upload-box').classList.remove('drag-active');
             if (e.dataTransfer?.files.length) {
                 fileInput.files = e.dataTransfer.files;
                 handleFile(e.dataTransfer.files[0]);
             }
        });

        function handleFile(file) {
            if (!file || !['image/png','image/jpeg','image/webp'].includes(file.type)) {
                if (typeof window.ffNotice === 'function') window.ffNotice('Please select a PNG, JPG, or WebP image.', 'error');
                return;
            }
            const rd = new FileReader();
            rd.onload = (ev) => {
                const img = new Image();
                img.onload = () => {
                    originalImg = img;
                    source.src = img.src;
                    
                    originalRatio = img.naturalWidth / img.naturalHeight;
                    widthInput.value = img.naturalWidth.toString();
                    heightInput.value = img.naturalHeight.toString();
                    origResTxt.textContent = `${img.naturalWidth} x ${img.naturalHeight}`;
                    updateFlow();
                    
                    uploadBox.classList.add('hidden');
                    controls.classList.remove('hidden');
                };
                img.src = ev.target.result;
            };
            rd.readAsDataURL(file);
        }

        const updateFlow = () => {
             if (!originalImg) return;
             targetResTxt.textContent = `${widthInput.value || 0} x ${heightInput.value || 0}`;
             // update preview size visually
             let displayW = parseInt(widthInput.value) || originalImg.naturalWidth;
             let displayH = parseInt(heightInput.value) || originalImg.naturalHeight;
             source.style.width = displayW + 'px';
             source.style.height = displayH + 'px';
        };

        aspectLock.addEventListener('change', () => {
             if (aspectLock.checked) {
                 lockIcon.classList.add('locked');
                 heightInput.value = Math.round(parseInt(widthInput.value || 0) / originalRatio).toString();
                 updateFlow();
             } else {
                 lockIcon.classList.remove('locked');
             }
        });

        widthInput.addEventListener('input', () => {
            if (aspectLock.checked) heightInput.value = Math.round(parseInt(widthInput.value || 0) / originalRatio).toString();
            updateFlow();
        });
        heightInput.addEventListener('input', () => {
            if (aspectLock.checked) widthInput.value = Math.round(parseInt(heightInput.value || 0) * originalRatio).toString();
            updateFlow();
        });

        presetBtns.forEach(btn => btn.addEventListener('click', () => {
             widthInput.value = btn.dataset.w;
             heightInput.value = btn.dataset.h;
             aspectLock.checked = false;
             lockIcon.classList.remove('locked');
             updateFlow();
        }));

        applyBtn.addEventListener('click', () => {
            if (!originalImg) return;

            const rawW = parseInt(widthInput.value) || originalImg.naturalWidth;
            const rawH = parseInt(heightInput.value) || originalImg.naturalHeight;
            const w = Math.max(1, Math.min(10000, rawW));
            const h = Math.max(1, Math.min(10000, rawH));

            if (rawW !== w || rawH !== h) {
                widthInput.value = w;
                heightInput.value = h;
                if (typeof window.ffNotice === 'function') window.ffNotice('Dimensions clamped to ' + w + 'x' + h + 'px.', 'warning');
            }

            applyBtn.textContent = 'Processing...'; applyBtn.disabled = true;
            
            const canvas = document.createElement('canvas');
            canvas.width = w; canvas.height = h;
            const ctx = canvas.getContext('2d');
            ctx.imageSmoothingEnabled = true; ctx.imageSmoothingQuality = 'high';
            ctx.drawImage(originalImg, 0, 0, w, h);
            
            canvas.toBlob(blob => {
                 const url = URL.createObjectURL(blob);
                 document.getElementById('image-preview').src = url;
                 document.getElementById('final-res-stat').textContent = `${w} x ${h}`;
                 document.getElementById('download-btn').href = url;
                 document.getElementById('download-btn').download = `formfix-resized-${w}x${h}.jpg`;
                 
                 controls.classList.add('hidden');
                 resultStage.classList.remove('hidden'); 
                 resultStage.scrollIntoView({ behavior: 'smooth' });

                 applyBtn.textContent = '⬇️ Execute Resize & Save'; applyBtn.disabled = false;
                 if (typeof window.triggerConfetti === 'function') window.triggerConfetti();
                 var shareTxt = encodeURIComponent("I just resized my image using FormFix! 100% private. Try it: " + window.__SITE_URL + "/resize-image");
                 var existing = document.getElementById('post-resize-share');
                 if (!existing) {
                     var div = document.createElement('div');
                     div.id = 'post-resize-share';
                     div.style.cssText = 'margin-top:20px;text-align:center;';
                     div.innerHTML = '<p style="font-weight:600;margin-bottom:10px;color:var(--success);">Love FormFix? Share it!</p><div style="display:flex;gap:8px;justify-content:center;"><a href="https://twitter.com/intent/tweet?text=' + shareTxt + '" target="_blank" style="padding:8px 16px;border-radius:8px;background:#000;color:#fff;text-decoration:none;font-weight:600;font-size:0.85rem;">Share on X</a><a href="https://wa.me/?text=' + shareTxt + '" target="_blank" style="padding:8px 16px;border-radius:8px;background:#25D366;color:#fff;text-decoration:none;font-weight:600;font-size:0.85rem;">WhatsApp</a></div>';
                     resultStage.appendChild(div);
                 }
            }, 'image/jpeg', 0.95);
        });
    });
</script>

    <Breadcrumb items={[{ name: 'Home', path: '/' }, { name: "Resize Image Pixels Online - Free Dimension Changer", path: "/resize-image" }]} />

    <ToolWrapper title="Image Dimension Resizer" subtitle="Perfect for social media creators, web developers, and job applicants." currentTool="resize-image">
        
        <div slot="tool-ui">
             <div class="workspace-editor">
                  <!-- 1. Selection Stage -->
                  <div id="u-box-container" class="upload-container">
                       <div class="upload-box shadow-sm" id="drop-zone" onclick="document.getElementById('file-input').click()">
                            <input type="file" id="file-input" class="hidden" accept="image/png, image/jpeg, image/webp" />
                            <div class="upload-content">
                                 <div class="upload-icon">📏</div>
                                 <h3 class="font-850 m-0 mb-8">Select Image to Resize</h3>
                                 <p class="text-muted m-0 mb-24 font-600">Change height and width locally in your browser.</p>
                                 <button class="primary-btn px-40">Browse Photo</button>
                            </div>
                       </div>
                  </div>

                  <!-- 2. Editor Stage -->
                  <div id="controls" class="hidden">
                       <div class="crop-grid">
                            <div class="preview-panel shadow-sm p-0 overflow-hidden">
                                <div class="resolution-badge mb-24">
                                      <div class="res-item">
                                           <span class="label text-muted font-600 small">Original</span>
                                           <br />
                                           <span id="orig-res-txt" class="val font-850 text-main">---</span>
                                      </div>
                                      <div class="res-arrow text-muted font-850 mx-16">→</div>
                                      <div class="res-item">
                                           <span class="label text-muted font-600 small">Target</span>
                                           <br />
                                           <span id="target-res-txt" class="val font-850 text-accent">---</span>
                                      </div>
                                </div>
                                 <div id="viewport" class="crop-viewport d-flex align-center justify-center p-24 box-border checkerboard w-100 h-100">
                                      <img id="source" draggable="false" alt="Original image for resizing" class="image-preview-target" loading="lazy" decoding="async" />
                                 </div>
                            </div>

                            <div class="controls-sidebar">
                                 <div class="settings-card shadow-sm mb-24">
                                      <div class="section mb-24">
                                           <label class="section-label m-0 mb-12">Manual Dimensions (PX)</label>
                                           <div class="dim-inputs">
                                                <div class="input-group">
                                                     <span>Width</span>
                                                     <input type="number" id="width-px" placeholder="W" />
                                                </div>
                                                <div id="lock-icon" class="lock-indicator locked" title="Aspect Ratio Locked">
                                                     <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                                                </div>
                                                <div class="input-group">
                                                     <span>Height</span>
                                                     <input type="number" id="height-px" placeholder="H" />
                                                </div>
                                           </div>
                                           <div class="lock-toggle mt-16 text-center">
                                                <label class="toggle-container">
                                                     <input type="checkbox" id="aspect-lock" checked />
                                                     Maintain Aspect Ratio
                                                </label>
                                           </div>
                                      </div>
                                      
                                      <div class="section">
                                           <label class="section-label m-0 mb-12">Quick Presets</label>
                                           <div class="pill-row">
                                                <button class="preset-pill preset-btn" data-w="1080" data-h="1080">Instagram</button>
                                                <button class="preset-pill preset-btn" data-w="1280" data-h="720">YouTube HD</button>
                                                <button class="preset-pill preset-btn" data-w="600" data-h="600">Passport</button>
                                                <button class="preset-pill preset-btn" data-w="1920" data-h="1080">Desktop HD</button>
                                           </div>
                                      </div>
                                 </div>

                                 <div class="action-stack">
                                      <button id="apply-btn" class="primary-btn wide-btn pulse-glow mb-12">⬇️ Execute Resize & Save</button>
                                      <button class="secondary-btn wide-btn" onclick="location.reload()">↺ Change Photo</button>
                                 </div>
                                 <p class="privacy-note text-center mt-16 mb-0 font-600">🔒 Local Processing. No uploads.</p>
                            </div>
                       </div>
                  </div>

                  <!-- 3. Result Stage -->
                  <div id="result-stage" class="result-stage hidden">
                       <div class="result-card shadow-sm">
                            <div class="success-banner mb-32">
                                 <div class="check-icon">✔</div>
                                 <div class="success-info">
                                      <h4 class="font-850 m-0 mb-8">Image Resize Complete</h4>
                                      <p class="text-muted m-0 small font-600">Perfectly resized to your specifications.</p>
                                 </div>
                            </div>

                            <div class="preview-panel checkerboard shadow-sm mb-32 d-flex justify-center" style="height: auto; min-height: 250px;">
                                 <img id="image-preview" src="" alt="Resized image output preview" class="styled-canvas m-24" loading="lazy" decoding="async" />
                            </div>

                            <div class="stats-grid mb-32">
                                 <div class="mini-stat active">
                                      <label>Final Resolution</label>
                                      <span id="final-res-stat">1920 x 1080</span>
                                 </div>
                                 <div class="mini-stat">
                                      <label>Protection</label>
                                      <span>100% Secure</span>
                                 </div>
                            </div>

                            <div class="d-flex gap-16">
                                 <a id="download-btn" href="#" class="primary-btn flex-2 wide-btn" style="text-decoration:none;">⬇️ Download Resized Image</a>
                                 <button class="secondary-btn flex-1 wide-btn" onclick="location.reload()">↺ New Resize</button>
                            </div>
                       </div>
                  </div>
             </div>
        </div>

        <div slot="tool-info">
             <h2>Resize Image Online for Social Media & Job Portals</h2>
             <p>FormFix provides the most accurate <strong>online image resizer</strong> to hit exact pixel requirements for Instagram (1080x1080) or YouTube thumbnails. Our local engine ensures that your photos are never uploaded to any server, making it the safest way to <strong>resize image pixels</strong> for identity documents or sensitive projects.</p>
             
             <div class="faq-grid mt-32">
                  <details class="faq-item">
                       <summary>How to resize image pixels for Instagram?</summary>
                       <p>Upload your photo and select the "Instagram" preset (1080x1080). Our tool handles the aspect ratio automatically, or you can supply manual dimensions.</p>
                  </details>
                  <details class="faq-item">
                       <summary>Does resizing reduce image quality?</summary>
                       <p>Our resizing algorithm uses high-quality bicubic interpolation which preserves as much detail as possible. While shrinking images looks perfectly sharp, enlarging very small images may cause slight softness.</p>
                  </details>
                  <details class="faq-item">
                       <summary>Can I resize for Passport photos?</summary>
                       <p>Yes, we have a specific 600x600 preset often required for online visa applications (like the US Visa portal or Indian Passport services).</p>
                  </details>
             </div>
        </div>
    </ToolWrapper>
</BaseLayout><style>
    .workspace-editor { display: flex; flex-direction: column; width: 100%; max-width: 1000px; margin: 0 auto; }
    
    .upload-container { display: flex; justify-content: center; }
    .upload-box { background: var(--surface-50); border: 2.5px dashed var(--border-subtle); border-radius: 32px; padding: 60px 40px; text-align: center; width: 100%; cursor: pointer; transition: 0.2s; }
    .upload-box:hover, .upload-box.drag-active { border-color: var(--accent-primary); background: var(--surface-100); }
    .upload-icon { font-size: 3.5rem; margin-bottom: 24px; line-height: 1; }

    .crop-grid { display: grid; grid-template-columns: 1fr 340px; gap: 32px; }
    
    .preview-panel { background:var(--surface-3); border: 1px solid var(--border-subtle); border-radius: 24px; position: relative; height: 500px; display: flex; flex-direction: column; overflow: hidden; }
    
    .resolution-badge { display: flex; background: var(--surface-50); border-bottom: 1px solid var(--border-subtle); padding: 12px 24px; justify-content: center; align-items: center; }
    .res-item { text-align: center; }
    .mx-16 { margin-left: 16px; margin-right: 16px; }

    .checkerboard { 
        background:var(--surface-3);
        background-image: linear-gradient(45deg, var(--surface-2) 25%, transparent 25%, transparent 75%, var(--surface-2) 75%, var(--surface-2)), 
                          linear-gradient(45deg, var(--surface-2) 25%, transparent 25%, transparent 75%, var(--surface-2) 75%, var(--surface-2));
        background-size: 20px 20px; background-position: 0 0, 10px 10px;
    }
    
    .image-preview-target { max-width: 90%; max-height: 90%; display: block; filter: drop-shadow(0 10px 30px rgba(0,0,0,0.1)); border: 1px solid var(--border-subtle); background:var(--surface-3); transform-origin: center; transition: all 0.2s ease; }

    .controls-sidebar { display: flex; flex-direction: column; }
    .settings-card { background: var(--surface-50); padding: 24px; border-radius: 24px; border: 1px solid var(--border-subtle); }
    
    .section-label { font-size: 0.75rem; font-weight:600; color: var(--surface-500); text-transform: uppercase; letter-spacing: 0.05em; display: block; }

    .dim-inputs { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-top: 12px; }
    .input-group { display: flex; flex-direction: column; gap: 8px; flex: 1; }
    .input-group span { font-size: 0.75rem; font-weight:600; color: var(--surface-500); text-transform: uppercase; letter-spacing: 0.05em; }
    .input-group input { width: 100%; padding: 12px; border: 1px solid var(--border-subtle); border-radius: 12px; text-align: center; font-weight:600; font-size: 1.1rem; outline: none; transition: 0.2s; box-sizing: border-box; }
    .input-group input:focus { border-color: var(--accent-primary); box-shadow: 0 0 0 3px rgba(var(--accent-rgb), 0.1); }
    
    .lock-indicator { display: flex; align-items: center; justify-content: center; color: var(--surface-300); margin-top: 24px; } 
    .lock-indicator.locked { color: var(--accent-primary); }
    
    .lock-toggle { display: flex; align-items: center; justify-content: center; gap: 8px; font-weight:600; color: var(--text-muted); font-size: 0.9rem; }
    .toggle-container { display: flex; align-items: center; gap: 8px; cursor: pointer; user-select: none; }
    .toggle-container input { width: 18px; height: 18px; accent-color: var(--accent-primary); cursor: pointer; }

    .pill-row { display: flex; gap: 8px; flex-wrap: wrap; }
    .preset-pill { flex: 1; background:var(--surface-3); border: 1px solid var(--border-subtle); padding: 10px 16px; border-radius: 12px; font-weight:600; font-size: 0.85rem; cursor: pointer; transition: 0.2s; color: var(--text-muted); text-align: center; white-space: nowrap; }
    .preset-pill:hover { border-color: var(--accent-primary); color: var(--text-main); }
    
    .action-stack { display: flex; flex-direction: column; }
    .wide-btn { height: 60px; font-weight:600; font-size: 1rem; border-radius: 16px; width: 100%; box-sizing: border-box; display: flex; justify-content: center; align-items: center; }
    .privacy-note { font-size: 0.8rem; color: var(--text-muted); }

    /* Result Stage */
    .result-card { background:var(--surface-3); border: 1px solid var(--border-subtle); border-radius: 32px; padding: 40px; }
    .success-banner { display: flex; align-items: center; gap: 16px; background: var(--surface-50); border: 1px solid var(--border-subtle); padding: 20px; border-radius: 20px; }
    .check-icon { width: 40px; height: 40px; background: var(--accent-primary); color: #fff; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 1.25rem; font-weight:600; flex-shrink: 0; }
    
    .styled-canvas { max-width: 100%; max-height: 350px; display: block; filter: drop-shadow(0 15px 40px rgba(0,0,0,0.15)); border-radius: 4px; }

    .stats-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
    .mini-stat { background: var(--surface-50); padding: 24px; border-radius: 20px; border: 1px solid var(--border-subtle); text-align: center; }
    .mini-stat.active { border-color: var(--accent-primary); background:var(--surface-3); box-shadow: var(--shadow-sm); }
    .mini-stat label { font-size: 0.72rem; font-weight:600; color: var(--text-muted); text-transform: uppercase; display: block; margin-bottom: 6px; }
    .mini-stat span { font-size: 1.2rem; font-weight:600; color: var(--text-main); }

    /* FAQ */
    .faq-grid { display: grid; gap: 16px; }
    .faq-item { background:var(--surface-3); border: 1px solid var(--border-subtle); border-radius: var(--radius-sm); overflow: hidden; text-align: left; }
    .faq-item summary { font-weight:600; font-size: 1rem; padding: 16px 20px; cursor: pointer; color: var(--text-main); list-style-type: none; position: relative; }
    .faq-item summary::after { content: '+'; position: absolute; right: 20px; font-weight:600; font-size: 1.2rem; color: var(--accent-primary); }
    .faq-item[open] summary::after { content: '−'; }
    .faq-item p { padding: 0 20px 20px; margin: 0; font-size: 0.95rem; color: var(--text-muted); line-height: 1.6; }

    .w-100 { width: 100%; }
    .h-100 { height: 100%; }
    .box-border { box-sizing: border-box; }
    .text-center { text-align: center; }
    .text-accent { color: var(--accent-primary); }

    .mb-8 { margin-bottom: 8px; }
    .mb-12 { margin-bottom: 12px; }
    .mb-24 { margin-bottom: 24px; }
    .mb-32 { margin-bottom: 32px; }
    .mb-0 { margin-bottom: 0px; }
    .m-24 { margin: 24px; }
    .mt-12 { margin-top: 12px; }
    .mt-16 { margin-top: 16px; }
    .mt-32 { margin-top: 32px; }
    .p-24 { padding: 24px; }
    .gap-16 { gap: 16px; }
    .font-800 { font-weight:600; }
    .font-850 { font-weight:600; }
    .font-600 { font-weight: 600; }
    .small { font-size: 0.85rem; }
    .px-40 { padding-left: 40px; padding-right: 40px; }
    .m-0 { margin: 0; }
    .p-0 { padding: 0; }
    .flex-1 { flex: 1; }
    .flex-2 { flex: 2; }
    .flex-wrap { flex-wrap: wrap; }
    .d-flex { display: flex; }
    .justify-between { justify-content: space-between; }
    .justify-center { justify-content: center; }
    .align-center { align-items: center; }
    .overflow-hidden { overflow: hidden; }
    .hidden { display: none !important; }

    @media (max-width: 900px) {
        .crop-grid { grid-template-columns: 1fr; }
        .preview-panel { height: 300px; }
        .stats-grid { grid-template-columns: 1fr; }
        .d-flex.gap-16 { flex-direction: column; }
        .upload-box { padding: 40px 20px; }
    }
</style>
