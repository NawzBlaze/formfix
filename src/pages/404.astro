---
import BaseLayout from '../components/BaseLayout.astro';

const PAGE_TITLE = '404 | Well... this is awkward | FormFix';
const PAGE_DESC = 'The page you are looking for doesn’t exist, got lost, or never existed in the first place.';
---

<BaseLayout title={PAGE_TITLE} description={PAGE_DESC} noindex={true}>

    <div class="void-404">
        <!-- Floating Particles (0s and 4s) -->
        <div class="particle-system">
            <span class="particle p1">0</span>
            <span class="particle p2">4</span>
            <span class="particle p3">0</span>
            <span class="particle p4">4</span>
            <span class="particle p5">0</span>
            <span class="particle p6">4</span>
        </div>

        <div class="content-stage animate-in">
            <!-- Animated Robot Mascot (SVG) -->
            <div class="robot-wrap">
                <svg width="200" height="200" viewBox="0 0 200 200" class="confused-robot">
                    <!-- Head -->
                    <rect x="50" y="40" width="100" height="80" rx="15" class="robot-head" fill="#1e1b4b" stroke="#4f46e5" stroke-width="3" />
                    <!-- Eyes -->
                    <circle cx="80" cy="80" r="8" fill="#a855f7" class="eye left-eye">
                        <animate attributeName="opacity" values="1;0.2;1" dur="3s" repeatCount="indefinite" />
                    </circle>
                    <circle cx="120" cy="80" r="8" fill="#a855f7" class="eye right-eye">
                        <animate attributeName="opacity" values="1;0.2;1" dur="3s" repeatCount="indefinite" />
                    </circle>
                    <!-- Mouth/Panel -->
                    <rect x="75" y="100" width="50" height="4" rx="2" fill="#4f46e5" />
                    <!-- Antenna -->
                    <line x1="100" y1="40" x2="100" y2="20" stroke="#4f46e5" stroke-width="3" />
                    <circle cx="100" cy="20" r="5" fill="#a855f7" class="antenna-light" />
                    <!-- Neck -->
                    <rect x="90" y="120" width="20" height="10" fill="#312e81" />
                    <!-- Body (partial) -->
                    <path d="M60 130 Q100 130 140 130 L150 180 L50 180 Z" fill="#1e1b4b" stroke="#4f46e5" stroke-width="3" />
                </svg>
            </div>

            <div class="text-cluster">
                <h1 class="big-404">404</h1>
                <h2 class="awkward-heading">Well… this is awkward.</h2>
                
                <div class="search-animation" id="search-box">
                    <div class="search-bar">
                        <div class="search-progress"></div>
                    </div>
                    <p class="search-status">Searching for your page...</p>
                </div>

                <p class="joke-text" id="joke-placeholder">Even our AI couldn’t fix this one 🤖</p>
            </div>

            <div class="btn-group">
                <a href="/" class="btn-neon-blue">Go Home</a>
                <button onclick="history.back()" class="btn-outline-neon">Go Back</button>
            </div>
        </div>
    </div>

    <script is:inline>
        // Randomized Jokes
        const jokes = [
            "Even our AI couldn’t fix this one 🤖",
            "We checked everywhere. Even under the couch.",
            "This page ghosted you harder than your last chat.",
            "Oops! Our intern probably deleted this page.",
            "404: Brain not found. (Just kidding, it's the page).",
            "You've wandered into a digital void. Be careful.",
            "We tried to optimize this into a single pixel. It vanished."
        ];

        const jokePlaceholder = document.getElementById('joke-placeholder');
        const randomJoke = jokes[Math.floor(Math.random() * jokes.length)];
        jokePlaceholder.innerText = randomJoke;

        // Fake Search Animation Logic
        const statusText = document.querySelector('.search-status');
        const statuses = [
            "Scanning cache...",
            "Checking the database...",
            "Asking the server nicely...",
            "Accepting the inevitable...",
            "Status: Gone. Forever."
        ];

        let sIndex = 0;
        const sInterval = setInterval(() => {
            if (sIndex < statuses.length) {
                statusText.innerText = statuses[sIndex];
                sIndex++;
            } else {
                clearInterval(sInterval);
            }
        }, 800);
    </script>

</BaseLayout>

<style>
    .void-404 {
        min-height: 90vh;
        background: radial-gradient(circle at 50% 50%, #0f172a 0%, #020617 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        overflow: hidden;
        color: #fff;
        font-family: 'Outfit', sans-serif;
    }

    /* Floating Particles */
    .particle-system {
        position: absolute;
        width: 100%;
        height: 100%;
        pointer-events: none;
    }

    .particle {
        position: absolute;
        font-size: 1.5rem;
        font-weight: 800;
        opacity: 0.05;
        color: #4f46e5;
        animation: drift 10s infinite linear;
    }
    .p1 { top: 10%; left: 10%; animation-delay: 0s; }
    .p2 { top: 20%; right: 20%; animation-delay: 2s; }
    .p3 { bottom: 30%; left: 25%; animation-delay: 4s; }
    .p4 { bottom: 10%; right: 15%; animation-delay: 6s; }
    .p5 { top: 50%; left: 5%; animation-delay: 1s; }
    .p6 { top: 40%; right: 5%; animation-delay: 3s; }

    @keyframes drift {
        0% { transform: translate(0, 0) rotate(0deg); }
        100% { transform: translate(40px, -40px) rotate(360deg); }
    }

    .content-stage {
        position: relative;
        z-index: 10;
        text-align: center;
        max-width: 500px;
        padding: 20px;
    }

    .confused-robot {
        filter: drop-shadow(0 0 20px rgba(79, 70, 229, 0.3));
        animation: hover 3s infinite ease-in-out;
    }

    @keyframes hover {
        0%, 100% { transform: translateY(0) rotate(0deg); }
        50% { transform: translateY(-15px) rotate(2deg); }
    }

    .big-404 {
        font-size: 8rem;
        font-weight: 900;
        margin: 0;
        line-height: 1;
        background: linear-gradient(135deg, #4f46e5, #a855f7);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        letter-spacing: -0.05em;
    }

    .awkward-heading {
        font-size: 2.25rem;
        font-weight: 800;
        margin-top: 10px;
        letter-spacing: -0.02em;
    }

    .joke-text {
        font-size: 1.1rem;
        color: #94a3b8;
        margin: 24px 0 40px;
        font-style: italic;
    }

    /* Search Bar Animation */
    .search-animation {
        margin: 32px auto 0;
        max-width: 300px;
    }

    .search-bar {
        width: 100%;
        height: 6px;
        background: rgba(255, 255, 255, 0.05);
        border-radius: 10px;
        overflow: hidden;
        margin-bottom: 12px;
    }

    .search-progress {
        width: 0%;
        height: 100%;
        background: #4f46e5;
        box-shadow: 0 0 10px #4f46e5;
        animation: searchFill 4s forwards cubic-bezier(0.65, 0, 0.35, 1);
    }

    @keyframes searchFill {
        0% { width: 0%; }
        20% { width: 30%; }
        50% { width: 70%; }
        100% { width: 100%; }
    }

    .search-status {
        font-size: 0.85rem;
        color: #475569;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.1em;
    }

    /* Buttons */
    .btn-group {
        display: flex;
        gap: 16px;
        justify-content: center;
    }

    .btn-neon-blue {
        background: #4f46e5;
        color: #fff;
        padding: 14px 32px;
        border-radius: 12px;
        font-weight: 700;
        text-decoration: none;
        transition: all 0.3s;
        box-shadow: 0 0 15px rgba(79, 70, 229, 0.4);
    }

    .btn-neon-blue:hover {
        transform: translateY(-3px);
        box-shadow: 0 0 25px rgba(79, 70, 229, 0.6);
    }

    .btn-outline-neon {
        background: transparent;
        border: 2px solid #334155;
        color: #94a3b8;
        padding: 14px 32px;
        border-radius: 12px;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.3s;
    }

    .btn-outline-neon:hover {
        border-color: #a855f7;
        color: #fff;
        box-shadow: 0 0 15px rgba(168, 85, 247, 0.3);
    }

    /* Animations */
    .animate-in {
        animation: slideUp 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    }

    @keyframes slideUp {
        from { opacity: 0; transform: translateY(30px); }
        to { opacity: 1; transform: translateY(0); }
    }

    @media (max-width: 640px) {
        .big-404 { font-size: 6rem; }
        .awkward-heading { font-size: 1.75rem; }
        .btn-group { flex-direction: column; }
    }
</style>
