---
import BaseLayout from '../components/BaseLayout.astro';

const PAGE_TITLE = 'Page Not Found | FormFix Digital Tool Hub';
const PAGE_DESC = 'Oops! The page you are looking for does not exist on FormFix digital toolkit.';
---

<BaseLayout title={PAGE_TITLE} description={PAGE_DESC} noindex={true}>

    <div class="prism-404">
        <div class="error-visual animate-fade-up">
            <h1 class="prism-text">404</h1>
        </div>
        <div class="error-content animate-fade-up delay-100">
            <h2 class="h-prism">Lost in Orbit?</h2>
            <p>The workspace you're looking for doesn't exist or has been moved to a new system.</p>
            <div class="cta-row">
                <a href="/" class="primary-btn prism-glow">Return to Dashboard</a>
            </div>
        </div>
    </div>
</BaseLayout>

<style>
    .prism-404 {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-height: 70vh;
        text-align: center;
        padding: 40px;
    }
    .prism-text {
        font-size: clamp(6rem, 15vw, 10rem);
        font-weight: 900;
        background: var(--grad-prism);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        letter-spacing: -0.05em;
        line-height: 1;
        margin-bottom: 20px;
    }
    p {
        font-size: 1.25rem;
        color: var(--surface-500);
        margin: 20px 0 40px;
        max-width: 480px;
    }
    .cta-row { display: flex; justify-content: center; }
</style>
