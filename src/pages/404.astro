---
import BaseLayout from '../components/BaseLayout.astro';

const PAGE_TITLE = '404 | Well... this is awkward | FormFix';
const PAGE_DESC = 'The page you are looking for doesn’t exist, got lost, or never existed in the first place.';
---

<BaseLayout title={PAGE_TITLE} description={PAGE_DESC} noindex={true}>

    <div class="void-404">
        <!-- SIMPLIFIED BACKGROUND (No Particles for zero lag) -->
        <div class="glow-bg"></div>

        <div class="content-stage">
            <!-- Animated Robot Mascot (Simplified for performance) -->
            <div class="robot-wrap">
                <svg width="180" height="180" viewBox="0 0 200 200" class="confused-robot">
                    <rect x="50" y="40" width="100" height="80" rx="15" fill="#1e1b4b" stroke="#4f46e5" stroke-width="4" />
                    <circle cx="80" cy="80" r="8" fill="#a855f7" />
                    <circle cx="120" cy="80" r="8" fill="#a855f7" />
                    <rect x="75" y="100" width="50" height="4" rx="2" fill="#4f46e5" />
                    <line x1="100" y1="40" x2="100" y2="20" stroke="#4f46e5" stroke-width="3" />
                    <circle cx="100" cy="20" r="5" fill="#a855f7" />
                    <path d="M60 130 Q100 130 140 130 L150 180 L50 180 Z" fill="#1e1b4b" stroke="#4f46e5" stroke-width="4" />
                </svg>
            </div>

            <div class="text-cluster">
                <h1 class="big-404">404</h1>
                <h2 class="awkward-heading">Well… this is awkward.</h2>
                
                <p class="joke-text" id="joke-placeholder">Even our AI couldn’t fix this one 🤖</p>
                
                <p class="search-msg">The page you’re looking for doesn’t exist, got lost, or never existed in the first place.</p>
            </div>

            <div class="btn-group">
                <a href="/" class="btn-neon-blue">Go Home</a>
                <button onclick="history.back()" class="btn-outline-neon">Go Back</button>
            </div>
        </div>
    </div>

    <script is:inline>
        const jokes = [
            "Even our AI couldn’t fix this one 🤖",
            "We checked everywhere. Even under the couch.",
            "This page ghosted you harder than your last chat.",
            "Oops! Our intern probably deleted this page.",
            "404: Brain not found. (Just kidding, it's the page).",
            "You've wandered into a digital void.",
            "We tried to optimize this into a single pixel. It vanished."
        ];
        const jokePlaceholder = document.getElementById('joke-placeholder');
        if(jokePlaceholder) {
            jokePlaceholder.innerText = jokes[Math.floor(Math.random() * jokes.length)];
        }
    </script>

</BaseLayout>

<style>
    .void-404 {
        min-height: 80vh;
        background: #020617; /* Solid dark background to prevent lag */
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        overflow: hidden;
        color: #fff;
        padding: 40px 20px;
        z-index: 1;
    }

    .glow-bg {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 600px;
        height: 600px;
        background: radial-gradient(circle, rgba(79, 70, 229, 0.15) 0%, transparent 70%);
        z-index: 2;
        pointer-events: none;
    }

    .content-stage {
        position: relative;
        z-index: 10; /* Ensure content is ALWAYS on top */
        text-align: center;
        max-width: 500px;
        width: 100%;
    }

    .robot-wrap {
        margin-bottom: 24px;
    }

    .confused-robot {
        animation: simpleHover 3s infinite ease-in-out;
    }

    @keyframes simpleHover {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(-10px); }
    }

    .big-404 {
        font-size: clamp(5rem, 15vw, 8rem);
        font-weight: 900;
        margin: 0;
        line-height: 1;
        background: linear-gradient(135deg, #6366f1, #a855f7);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        letter-spacing: -0.05em;
    }

    .awkward-heading {
        font-size: clamp(1.5rem, 5vw, 2.25rem);
        font-weight: 800;
        margin-top: 10px;
        color: #f8fafc;
    }

    .joke-text {
        font-size: 1.1rem;
        color: #94a3b8;
        margin: 16px 0 8px;
        font-style: italic;
    }

    .search-msg {
        color: #64748b;
        font-size: 1rem;
        margin-bottom: 40px;
        line-height: 1.5;
    }

    .btn-group {
        display: flex;
        gap: 16px;
        justify-content: center;
    }

    .btn-neon-blue {
        background: #4f46e5;
        color: #fff;
        padding: 14px 32px;
        border-radius: 12px;
        font-weight: 700;
        text-decoration: none;
        transition: transform 0.2s;
    }

    .btn-neon-blue:hover {
        transform: translateY(-2px);
    }

    .btn-outline-neon {
        background: transparent;
        border: 2px solid #334155;
        color: #94a3b8;
        padding: 14px 32px;
        border-radius: 12px;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.2s;
    }

    .btn-outline-neon:hover {
        border-color: #6366f1;
        color: #fff;
    }

    @media (max-width: 480px) {
        .btn-group { flex-direction: column; }
    }
</style>
