---
import BaseLayout from '../components/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';

const PAGE_TITLE = '404 - Page Not Found | FormFix';
const PAGE_DESC = 'The page you are looking for does not exist. Try searching or browse our popular tools below.';
---

<BaseLayout title={PAGE_TITLE} description={PAGE_DESC} noindex={true}>
    <Breadcrumb items={[{ name: 'Home', path: '/' }, { name: "404", path: "/" }]} />

    <div class="page-404">
        <div class="container page-inner">

            <h1 class="big-404">404</h1>
            <p class="joke-text" id="joke-placeholder">This page doesn't exist.</p>

            <form class="search-404" action="/tools" method="GET">
                <input type="text" name="q" placeholder="Search tools..." aria-label="Search tools" />
                <button type="submit">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
                </button>
            </form>

            <p class="pop-label">Popular Tools</p>
            <div class="pop-grid">
                <a href="/compress-image" class="pop-card">Compress Image</a>
                <a href="/passport-size-photo" class="pop-card">Passport Photo</a>
                <a href="/merge-pdf" class="pop-card">Merge PDF</a>
                <a href="/signature-maker" class="pop-card">Signature Maker</a>
                <a href="/qr-code-generator" class="pop-card">QR Code</a>
                <a href="/resume-builder" class="pop-card">Resume Builder</a>
            </div>

            <div class="btn-group">
                <a href="/" class="btn-primary">Go Home</a>
                <button onclick="history.back()" class="btn-secondary">Go Back</button>
            </div>

        </div>
    </div>

    <script is:inline>
        const jokes = [
            "This page doesn't exist.",
            "This page went to grab coffee and never came back.",
            "We looked everywhere. Checked under the digital couch too.",
            "This link is as broken as a screen protector after a phone drop."
        ];
        const el = document.getElementById('joke-placeholder');
        if (el) el.innerText = jokes[Math.floor(Math.random() * jokes.length)];
    </script>
</BaseLayout>

<style>
.page-404 {
    min-height: 70vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 40px 20px;
}
.page-inner {
    text-align: center;
    max-width: 500px;
}
.big-404 {
    font-size: clamp(3rem, 10vw, 5rem);
    font-weight: 600;
    margin-bottom: 8px;
    color: var(--text-primary);
}
.joke-text {
    font-size: 0.95rem;
    color: var(--text-muted);
    margin-bottom: 28px;
}

.search-404 {
    display: flex;
    max-width: 380px;
    margin: 0 auto 28px;
    border-radius: var(--radius-sm);
    overflow: hidden;
    border: 1px solid var(--border-subtle);
    background: var(--surface-2);
}
.search-404 input {
    flex: 1;
    padding: 10px 14px;
    background: transparent;
    border: none;
    color: var(--text-primary);
    font-size: 0.85rem;
    outline: none;
    font-family: inherit;
}
.search-404 input::placeholder { color: var(--text-muted); }
.search-404 button {
    padding: 10px 14px;
    background: var(--accent-primary);
    border: none;
    color: #fff;
    cursor: pointer;
    display: flex;
    align-items: center;
}
.search-404 button:hover { background: var(--accent-hover); }

.pop-label {
    font-size: 0.7rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 10px;
}
.pop-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
    max-width: 380px;
    margin: 0 auto 28px;
}
.pop-card {
    padding: 12px 8px;
    background: var(--surface-2);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    text-decoration: none;
    color: var(--text-primary);
    font-size: 0.8rem;
    font-weight: 500;
    text-align: center;
}
.pop-card:hover {
    border-color: var(--border-strong);
}

.btn-group {
    display: flex;
    gap: 10px;
    justify-content: center;
}
.btn-primary {
    padding: 10px 24px;
    background: var(--accent-primary);
    color: #fff;
    border-radius: var(--radius-sm);
    font-weight: 500;
    font-size: 0.85rem;
    text-decoration: none;
    border: none;
    cursor: pointer;
    font-family: inherit;
}
.btn-primary:hover { background: var(--accent-hover); color: #fff; }
.btn-secondary {
    padding: 10px 24px;
    background: transparent;
    border: 1px solid var(--border-subtle);
    color: var(--text-secondary);
    border-radius: var(--radius-sm);
    font-weight: 500;
    font-size: 0.85rem;
    cursor: pointer;
    font-family: inherit;
}
.btn-secondary:hover { border-color: var(--border-strong); }

@media (max-width: 480px) {
    .pop-grid { grid-template-columns: repeat(2, 1fr); }
    .btn-group { flex-direction: column; }
}
</style>
