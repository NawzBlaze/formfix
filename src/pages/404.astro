---
import BaseLayout from '../components/BaseLayout.astro';

const PAGE_TITLE = '404 - We Compressed This Page Too Hard! | FormFix';
const PAGE_DESC = 'Our AI got a bit too excited and compressed this page into a single pixel. We are trying to recover it!';
---

<BaseLayout title={PAGE_TITLE} description={PAGE_DESC} noindex={true}>

    <div class="ultra-404">
        <div class="background-elements">
            <div class="floating-emoji e1">📁</div>
            <div class="floating-emoji e2">📉</div>
            <div class="floating-emoji e3">🤖</div>
            <div class="floating-emoji e4">🔎</div>
        </div>

        <div class="error-stage animate-pop-in">
            <div class="pixel-box">
                <div class="the-pixel"></div>
            </div>
            
            <h1 class="glitch-text" data-text="404">404</h1>
            <h2 class="funny-title">Oops! Too Much Compression... 🤏</h2>
            
            <p class="funny-msg">
                Our AI optimizer got a bit too aggressive and compressed this entire page into that **single tiny pixel** above. We're trying to inflate it back, but it's not looking good.
            </p>

            <div class="interactive-row">
                <a href="/" class="primary-btn glow-btn">🚀 Emergency Warp Home</a>
                <a href="/tools" class="secondary-btn">🧰 Visit the Tool Shed</a>
            </div>

            <div class="rescue-mission">
                <p>While we rescue this page, check out these 100% visible tools:</p>
                <div class="mini-grid">
                    <a href="/compress-image" class="mini-tool">Compressor</a>
                    <a href="/merge-pdf" class="mini-tool">PDF Merger</a>
                    <a href="/signature-maker" class="mini-tool">Sign Maker</a>
                    <a href="/official-passport-photo-maker" class="mini-tool">Passport Studio</a>
                </div>
            </div>
        </div>
    </div>

</BaseLayout>

<style>
    .ultra-404 {
        position: relative;
        min-height: 90vh;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        background: #fff;
        padding: 20px;
    }

    .background-elements {
        position: absolute;
        width: 100%;
        height: 100%;
        pointer-events: none;
    }

    .floating-emoji {
        position: absolute;
        font-size: 3rem;
        opacity: 0.1;
        animation: float 6s infinite ease-in-out;
    }
    .e1 { top: 20%; left: 10%; animation-delay: 0s; }
    .e2 { top: 70%; left: 15%; animation-delay: 2s; }
    .e3 { top: 30%; right: 10%; animation-delay: 4s; }
    .e4 { top: 75%; right: 20%; animation-delay: 1s; }

    @keyframes float {
        0%, 100% { transform: translateY(0) rotate(0deg); }
        50% { transform: translateY(-30px) rotate(10deg); }
    }

    .error-stage {
        position: relative;
        z-index: 10;
        max-width: 600px;
        text-align: center;
        background: rgba(255, 255, 255, 0.9);
        backdrop-filter: blur(10px);
        padding: 60px 40px;
        border-radius: 40px;
        border: 1px solid rgba(0,0,0,0.05);
        box-shadow: 0 40px 100px -20px rgba(0,0,0,0.1);
    }

    .pixel-box {
        display: flex;
        justify-content: center;
        margin-bottom: 20px;
    }
    .the-pixel {
        width: 4px;
        height: 4px;
        background: #4f46e5;
        box-shadow: 0 0 20px 5px rgba(79, 70, 229, 0.4);
        animation: pulse 1.5s infinite;
    }

    @keyframes pulse {
        0% { transform: scale(1); opacity: 1; }
        50% { transform: scale(3); opacity: 0.5; }
        100% { transform: scale(1); opacity: 1; }
    }

    .glitch-text {
        font-size: 8rem;
        font-weight: 950;
        margin: 0;
        line-height: 1;
        background: linear-gradient(135deg, #4f46e5 0%, #9333ea 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        letter-spacing: -0.05em;
    }

    .funny-title {
        font-size: 2rem;
        font-weight: 800;
        color: #111;
        margin: 20px 0 10px;
        letter-spacing: -0.02em;
    }

    .funny-msg {
        font-size: 1.15rem;
        color: #666;
        line-height: 1.6;
        margin-bottom: 40px;
    }

    .interactive-row {
        display: flex;
        gap: 16px;
        justify-content: center;
        margin-bottom: 50px;
    }

    .glow-btn {
        box-shadow: 0 10px 20px -5px rgba(79, 70, 229, 0.4);
    }

    .rescue-mission {
        border-top: 1px dashed #eee;
        padding-top: 40px;
    }
    .rescue-mission p {
        font-size: 0.85rem;
        font-weight: 700;
        text-transform: uppercase;
        color: #aaa;
        letter-spacing: 0.1em;
        margin-bottom: 20px;
    }

    .mini-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 12px;
    }

    .mini-tool {
        background: #f8fafc;
        border: 1px solid #f1f5f9;
        padding: 12px;
        border-radius: 16px;
        font-weight: 600;
        color: #334155;
        text-decoration: none;
        font-size: 0.9rem;
        transition: all 0.2s;
    }

    .mini-tool:hover {
        background: #4f46e5;
        color: #fff;
        transform: translateY(-3px);
    }

    .animate-pop-in {
        animation: popIn 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }

    @keyframes popIn {
        from { opacity: 0; transform: scale(0.8) translateY(40px); }
        to { opacity: 1; transform: scale(1) translateY(0); }
    }

    @media (max-width: 480px) {
        .error-stage { padding: 40px 20px; }
        .interactive-row { flex-direction: column; }
        .mini-grid { grid-template-columns: 1fr; }
        .glitch-text { font-size: 6rem; }
    }
</style>
