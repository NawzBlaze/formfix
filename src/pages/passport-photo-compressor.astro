---
import BaseLayout from '../components/BaseLayout.astro';
import ToolWrapper from '../components/ToolWrapper.astro';

const PAGE_TITLE = 'Passport Photo Compressor Online (Standard 3.5x4.5cm) | FormFix';
const PAGE_DESC = 'Compress passport photos to 20KB, 50KB or 100KB for online forms. Official dimensions for SSC, UPSC, and Banking exams included.';
const PAGE_KEYWORDS = 'passport photo compressor, compress passport photo to 20kb, resize passport photo online, official photo resizer';
---

<BaseLayout title={PAGE_TITLE} description={PAGE_DESC} keywords={PAGE_KEYWORDS} active="tools" canonicalPath="/passport-size-photo">
    <ToolWrapper title="Passport Photo Compressor" subtitle="Hit exact KB targets for your official passport photos." currentTool="passport-maker">
        <div slot="tool-ui">
             <div class="cta-box text-center">
                 <p class="mb-24">Use our specialized maker to crop and compress your passport photo in one go.</p>
                 <a href="/passport-size-photo" class="primary-btn lg-btn">Start Passport Photo Maker →</a>
             </div>
        </div>
        <div slot="tool-info">
             <h2>Expert Passport Photo Compression Tips</h2>
             <p>Most portals like SSC or UPSC require photos between 20KB and 50KB. Our <a href="/passport-size-photo">Passport Photo Maker</a> is designed to help you crop to 3.5x4.5cm and then compress with 100% accuracy.</p>
        </div>
    </ToolWrapper>
</BaseLayout>

<style>
    .cta-box { padding: 40px; background: var(--surface-50); border-radius: 20px; border: 1.5px dashed var(--border-subtle); }
    .text-center { text-align: center; }
    .mb-24 { margin-bottom: 24px; }
    .lg-btn { font-size: 1.1rem; padding: 16px 32px; }
</style>
