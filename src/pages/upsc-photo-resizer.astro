---
import BaseLayout from '../components/BaseLayout.astro';
import ToolWrapper from '../components/ToolWrapper.astro';

const PAGE_TITLE = 'UPSC Photo Resizer & Signature Maker (350x350) | FormFix';
const PAGE_DESC = 'Official UPSC photo resizer. Convert your photo to exactly 350x350 pixels and signature to 1000x1000 pixels as per UPSC guidelines. Free, private, and secure.';
const PAGE_KEYWORDS = 'upsc photo resizer, upsc signature maker, upsc cse photo size, 350x350 photo for upsc, convert photo for upsc online, upsc form photo maker';

const customSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "UPSC Photo Optimizer",
  "description": "Tailored tool for UPSC Civil Services and other Union Public Service Commission exams.",
  "applicationCategory": "MultimediaApplication",
  "operatingSystem": "All"
};
---

<BaseLayout title={PAGE_TITLE} description={PAGE_DESC} keywords={PAGE_KEYWORDS} customSchema={customSchema} active="tools" canonicalPath="/upsc-photo-resizer">
    <ToolWrapper 
        title="UPSC Exam Optimizer" 
        subtitle="Meet UPSC's strict pixel and KB requirements in one click. 100% compliant."
        currentTool="upsc-optimizer"
    >
        <div slot="tool-ui">
             <div class="upsc-workspace">
                 <div class="upsc-alert">
                     <strong>UPSC Requirement:</strong> Both Photo & Signature must be between 20KB and 300KB. Dimensions should be 350px x 350px (minimum).
                 </div>
                 <div class="tool-actions-centered">
                     <a href="/passport-size-photo" class="primary-btn pulse-glow">Open UPSC Photo Maker →</a>
                     <a href="/resize-image" class="secondary-btn">Resize to 350px</a>
                 </div>
             </div>
        </div>

        <div slot="tool-info">
             <article class="prose">
                 <h2>UPSC IAS/CSE Photo & Signature Specifications</h2>
                 <p>The Union Public Service Commission (UPSC) requires specific pixel dimensions and file sizes for the Civil Services Examination and other recruitment tests. Using the wrong dimensions is a leading cause of form rejection.</p>
                 
                 <div class="guideline-card">
                     <h3>Official UPSC Photo & Signature Specs:</h3>
                     <ul>
                         <li><strong>Aspect Ratio:</strong> Must be Square (1:1).</li>
                         <li><strong>Pixel Dimensions:</strong> Minimum 350px x 350px. Maximum 1000px x 1000px.</li>
                         <li><strong>File Size:</strong> 20 KB to 300 KB.</li>
                         <li><strong>File Format:</strong> .JPG or .JPEG only.</li>
                         <li><strong>Background:</strong> Light color background, preferably white.</li>
                     </ul>
                 </div>

                 <h2>How to Resize Photos for UPSC Form Online</h2>
                 <ol>
                     <li><strong>Open the Maker:</strong> Click on "Open UPSC Photo Maker" above.</li>
                     <li><strong>Upload your Image:</strong> Select your passport-style photo.</li>
                     <li><strong>Square Crop:</strong> Our tool locks the aspect ratio to 1:1, ensuring it meets the UPSC "Square" requirement.</li>
                     <li><strong>Set Pixels:</strong> Ensure the download settings are set to at least 350 pixels.</li>
                     <li><strong>Target KB:</strong> Use our compressor to stay between 20KB and 300KB.</li>
                 </ol>

                 <div class="tips-card mt-24">
                     <h3>Important UPSC Compliance Note:</h3>
                     <p>UPSC's portal validates that the Width and Height in pixels are <strong>exactly equal</strong>. Even a 1-pixel difference (e.g., 350x351) will cause an upload failure. FormFix handles this pixel-perfect matching automatically.</p>
                 </div>

                 <div class="faq-section mt-48">
                     <h3>UPSC Photo Resizer FAQ</h3>
                     <details class="minimal-faq">
                         <summary>What is the best resolution for UPSC photos? <span class="indicator">+</span></summary>
                         <div class="faq-body">
                             <p>While 350x350 is the minimum, we recommend 500x500 pixels for a sharper image that still stays well under the 300KB limit.</p>
                         </div>
                     </details>
                     <details class="minimal-faq">
                         <summary>Does UPSC accept PDF for photos? <span class="indicator">+</span></summary>
                         <div class="faq-body">
                             <p>No. UPSC strictly requires JPG or JPEG format for both photographs and signatures.</p>
                         </div>
                     </details>
                     <details class="minimal-faq">
                         <summary>How do I make my UPSC signature 350x350? <span class="indicator">+</span></summary>
                         <div class="faq-body">
                             <p>Upload your signature scan to our tool, select the "Square" crop, and it will automatically format it to the required 350x350 pixel minimum.</p>
                         </div>
                     </details>
                 </div>
             </article>
        </div>
    </ToolWrapper>
</BaseLayout>

<style>
    .upsc-workspace { text-align: center; padding: 20px 0; }
    .upsc-alert { background: #e0f2fe; border-left: 4px solid #0ea5e9; padding: 16px; border-radius: 8px; margin-bottom: 32px; color: #0369a1; font-size: 0.95rem; }
    .tool-actions-centered { display: flex; gap: 16px; justify-content: center; align-items: center; }
    .guideline-card { background: var(--surface-50); border: 1px solid var(--border-subtle); padding: 24px; border-radius: 16px; }
    .guideline-card h3 { margin-bottom: 12px; font-size: 1.1rem; }
    .guideline-card ul { padding-left: 20px; color: var(--text-muted); }
    .guideline-card li { margin-bottom: 8px; }
    .tips-card { background: #fdf2f8; border: 1px solid #fbcfe8; padding: 20px; border-radius: 16px; color: #9d174d; }
</style>
