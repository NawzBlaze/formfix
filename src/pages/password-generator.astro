---
import BaseLayout from '../components/BaseLayout.astro';
import RelatedTools from '../components/RelatedTools.astro';

const PAGE_TITLE = 'Secure Password Generator Online - Strong & Random Passwords';
const PAGE_DESC = 'Generate highly secure, random passwords instantly. Client-side, 100% private, customizable length and character types. Protect your online accounts for free.';
const PAGE_KEYWORDS = 'password generator, random string generator, secure password maker, strong password online, private password generator';

const customSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      "name": "FormFix Pro Password Generator",
      "operatingSystem": "All",
      "applicationCategory": "SecurityApplication",
      "description": "Generate cryptographically secure random passwords instantly in your browser.",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      }
    }
  ]
};
---

<BaseLayout title={PAGE_TITLE} description={PAGE_DESC} keywords={PAGE_KEYWORDS} customSchema={customSchema} active="tools" canonicalPath="/password-generator">
    <div class="tool-wrapper animate-in">
        <header class="tool-intro text-center">
             <div class="brand-badge shadow-sm">🔐 Crypto Secure Engine</div>
             <h1 class="main-h1">Secure Password <span class="highlight">Generator</span></h1>
             <p class="hero-sub">Generate military-grade strong passwords instantly. 100% offline and secure.</p>
        </header>

        <div class="glass-card tool-content shadow-lg max-w-lg mx-auto py-32 px-24" style="border-radius:24px;">
            
            <div class="pw-display shadow-sm mb-24">
                <input type="text" id="pw-output" class="pw-output pulse-glow-text" readonly value="Loading..." />
                <button id="copy-btn" class="copy-btn hover-scale" title="Copy to Clipboard">
                    <span id="copy-icon">📋</span>
                </button>
            </div>
            
            <div class="pw-strength-bar mb-32">
                 <div class="strength-fill" id="strength-fill"></div>
                 <div class="strength-text" id="strength-text">Strong Password</div>
            </div>

            <div class="pw-controls">
                
                <div class="length-slider-box mb-24">
                     <label class="d-flex justify-between font-bold mb-12"><span>Password Length</span> <span id="len-val" class="text-primary">16</span></label>
                     <input type="range" id="pw-length" min="6" max="64" value="16" class="modern-slider" />
                </div>

                <div class="options-grid mb-32">
                     <label class="custom-checkbox">
                         <input type="checkbox" id="opt-uppercase" checked />
                         <span class="checkmark"></span>
                         Uppercase (A-Z)
                     </label>
                     <label class="custom-checkbox">
                         <input type="checkbox" id="opt-lowercase" checked />
                         <span class="checkmark"></span>
                         Lowercase (a-z)
                     </label>
                     <label class="custom-checkbox">
                         <input type="checkbox" id="opt-numbers" checked />
                         <span class="checkmark"></span>
                         Numbers (0-9)
                     </label>
                     <label class="custom-checkbox">
                         <input type="checkbox" id="opt-symbols" checked />
                         <span class="checkmark"></span>
                         Symbols (!@#$%)
                     </label>
                </div>
                
                <button id="regenerate-btn" class="primary-btn wide-btn profile-btn pulse-glow">🔄 Generate New Password</button>
            </div>

        </div>

        <article class="pro-seo-article container mt-48">
             <h2>Why Use a Strong Password Generator?</h2>
             <p>Our <strong>Secure Password Generator</strong> helps you easily create cryptographically secure, random passwords. Human-created passwords are often predictable and easily hacked using dictionary attacks. By employing our tool, you generate complex strings using standard `crypto.getRandomValues()` directly within your browser window, ensuring maximum entropy and absolute privacy.</p>
             
             <h3 class="mt-32">100% Private & Offline</h3>
             <ul style="color:var(--slate); line-height:1.8; margin-left:20px; font-size:1.1rem">
                <li><strong>Zero Data Tracking:</strong> Passwords are never stored, logged, or sent over the internet. Generation happens entirely locally on your device processor.</li>
                <li><strong>Instantly Copied:</strong> Use the one-click copy button to securely paste the password directly into your vault or account creation form.</li>
             </ul>
        </article>

        <RelatedTools currentTool="password-generator" />
    </div>
</BaseLayout>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const pwOutput = document.getElementById('pw-output') as HTMLInputElement;
        const copyBtn = document.getElementById('copy-btn') as HTMLButtonElement;
        const copyIcon = document.getElementById('copy-icon') as HTMLElement;
        const lenSlider = document.getElementById('pw-length') as HTMLInputElement;
        const lenVal = document.getElementById('len-val') as HTMLElement;
        
        const optUpper = document.getElementById('opt-uppercase') as HTMLInputElement;
        const optLower = document.getElementById('opt-lowercase') as HTMLInputElement;
        const optNum = document.getElementById('opt-numbers') as HTMLInputElement;
        const optSym = document.getElementById('opt-symbols') as HTMLInputElement;
        
        const regenerateBtn = document.getElementById('regenerate-btn') as HTMLButtonElement;
        const strengthFill = document.getElementById('strength-fill') as HTMLElement;
        const strengthText = document.getElementById('strength-text') as HTMLElement;

        const charSets = {
            upper: "ABCDEFGHIJKLMNOPQRSTUVWXYZ",
            lower: "abcdefghijklmnopqrstuvwxyz",
            numbers: "0123456789",
            symbols: "!@#$%^&*()_+~`|}{[]:;?><,./-="
        };

        function generatePassword() {
            let charset = "";
            if (optUpper.checked) charset += charSets.upper;
            if (optLower.checked) charset += charSets.lower;
            if (optNum.checked) charset += charSets.numbers;
            if (optSym.checked) charset += charSets.symbols;

            if (charset === "") {
                optLower.checked = true;
                charset += charSets.lower;
            }

            const length = parseInt(lenSlider.value);
            let password = "";
            const array = new Uint32Array(length);
            window.crypto.getRandomValues(array);

            for (let i = 0; i < length; i++) {
                password += charset[array[i] % charset.length];
            }

            pwOutput.value = password;
            lenVal.textContent = length.toString();
            updateStrength(password);
            
            // Reset copy button
            copyIcon.textContent = "📋";
            copyBtn.style.background = "#f1f5f9";
            copyBtn.style.color = "var(--dark)";
        }

        function updateStrength(pwd: string) {
            let score = 0;
            if (pwd.length > 8) score += 1;
            if (pwd.length > 12) score += 1;
            if (pwd.length >= 16) score += 1;
            if (optUpper.checked) score += 1;
            if (optNum.checked) score += 1;
            if (optSym.checked) score += 1;

            strengthFill.className = "strength-fill";
            if (score <= 2) {
                strengthFill.style.width = "30%";
                strengthFill.style.background = "#ef4444";
                strengthText.textContent = "Weak Password";
            } else if (score <= 4) {
                strengthFill.style.width = "60%";
                strengthFill.style.background = "#eab308";
                strengthText.textContent = "Good Password";
            } else {
                strengthFill.style.width = "100%";
                strengthFill.style.background = "#22c55e";
                strengthText.textContent = "Strong Password";
            }
        }

        async function copyToClipboard() {
            try {
                await navigator.clipboard.writeText(pwOutput.value);
                copyIcon.textContent = "✔";
                copyBtn.style.background = "#22c55e";
                copyBtn.style.color = "white";
                setTimeout(() => {
                     if (copyIcon.textContent === "✔") {
                         copyIcon.textContent = "📋";
                         copyBtn.style.background = "#f1f5f9";
                         copyBtn.style.color = "var(--dark)";
                     }
                }, 2000);
            } catch (err) {
                alert("Failed to copy password.");
            }
        }

        [lenSlider, optUpper, optLower, optNum, optSym].forEach(el => {
            el.addEventListener('input', generatePassword);
        });

        regenerateBtn.addEventListener('click', generatePassword);
        copyBtn.addEventListener('click', copyToClipboard);

        // Init
        generatePassword();
    });
</script>

<style>
    .main-h1 { font-size: 3.5rem; font-weight: 1000; letter-spacing: -0.05em; margin-bottom: 12px; color: var(--dark); line-height: 1.1; }
    .hero-sub { color: var(--slate); font-weight: 600; font-size: 1.25rem; margin-bottom: 24px; }
    .tool-wrapper { max-width: 960px; margin: 0 auto; padding-bottom: 100px; }
    .max-w-lg { max-width: 600px; margin-inline: auto; background:#fff; border: 1.5px solid var(--border); }
    
    .px-24 { padding-left: 24px; padding-right: 24px; }
    .py-32 { padding-top: 32px; padding-bottom: 32px; }

    .pw-display { position: relative; display: flex; align-items: center; background: #f8fafc; border-radius: 16px; border: 2px dashed #cbd5e1; overflow: hidden; }
    .pw-output { width: 100%; border: none; background: transparent; padding: 24px 80px 24px 24px; font-size: 2rem; font-weight: 900; font-family: monospace; color: var(--primary); text-align: center; letter-spacing: 2px; outline: none; transition: 0.2s; }
    .pw-output::selection { background: var(--primary); color: white; }
    
    .copy-btn { position: absolute; right: 12px; top: 12px; bottom: 12px; border: none; background: #f1f5f9; border-radius: 10px; font-size: 1.5rem; cursor: pointer; transition: 0.2s; width: 60px; display: flex; align-items: center; justify-content: center; box-shadow: 0 4px 10px rgba(0,0,0,0.05); }
    .copy-btn:hover { background: var(--primary-light); transform: scale(1.05); }

    .pw-strength-bar { width: 100%; height: 8px; background: #e2e8f0; border-radius: 100px; position: relative; margin-top: 24px;}
    .strength-fill { height: 100%; border-radius: 100px; transition: 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275); }
    .strength-text { text-align: center; margin-top: 12px; font-weight: 800; font-size: 0.95rem; color: var(--slate); }

    .font-bold { font-weight: 900; color: var(--dark); font-size: 1.15rem; }
    .text-primary { color: var(--primary); }
    
    .modern-slider { -webkit-appearance: none; width: 100%; height: 8px; border-radius: 5px; background: #e2e8f0; outline: none; margin-top: 8px; }
    .modern-slider::-webkit-slider-thumb { -webkit-appearance: none; appearance: none; width: 24px; height: 24px; border-radius: 50%; background: var(--primary); cursor: pointer; border: 4px solid #fff; box-shadow: 0 2px 6px rgba(0,0,0,0.2); }
    
    .options-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
    
    .custom-checkbox { display: flex; align-items: center; position: relative; padding-left: 36px; cursor: pointer; font-size: 1.05rem; font-weight: 700; color: var(--slate); user-select: none; }
    .custom-checkbox input { position: absolute; opacity: 0; cursor: pointer; height: 0; width: 0; }
    .checkmark { position: absolute; top: 0; left: 0; height: 24px; width: 24px; background-color: #f1f5f9; border-radius: 6px; border: 2px solid var(--border); transition: 0.2s; }
    .custom-checkbox:hover input ~ .checkmark { background-color: var(--primary-light); }
    .custom-checkbox input:checked ~ .checkmark { background-color: var(--primary); border-color: var(--primary); }
    .checkmark:after { content: ""; position: absolute; display: none; }
    .custom-checkbox input:checked ~ .checkmark:after { display: block; }
    .custom-checkbox .checkmark:after { left: 7px; top: 3px; width: 6px; height: 12px; border: solid white; border-width: 0 2.5px 2.5px 0; transform: rotate(45deg); }

    .d-flex { display: flex; }
    .justify-between { justify-content: space-between; }
    
    .mb-12 { margin-bottom: 12px; }
    .mb-24 { margin-bottom: 24px; }
    .mb-32 { margin-bottom: 32px; }
    .mt-32 { margin-top: 32px; }
    .mt-48 { margin-top: 48px; }
    
    .wide-btn { padding: 22px 24px; font-weight: 1000; font-size: 1.25rem; border-radius: 100px; display: block; border:none; color:white; background:var(--primary); transition: 0.2s; width: 100%;}
    
    @media (max-width: 640px) {
        .options-grid { grid-template-columns: 1fr; }
        .pw-output { font-size: 1.5rem; padding-right: 64px; }
        .px-24 { padding-left: 16px; padding-right: 16px; }
    }
</style>
