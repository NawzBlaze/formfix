---
import BaseLayout from '../components/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import ToolWrapper from '../components/ToolWrapper.astro';

const PAGE_TITLE = 'Secure Password Generator Online - Strong & Random Passwords | FormFix';
const PAGE_DESC = 'Generate highly secure, random passwords instantly. Client-side, 100% private, customizable length and character types. Protect your online accounts for free.';
const PAGE_KEYWORDS = 'password generator, random string generator, secure password maker, strong password online, private password generator, cryptographically secure';

const faqs = [
  {
    q: 'How secure are the passwords generated here?',
    a: 'FormFix uses the browser-native Web Crypto API (crypto.getRandomValues) which is a cryptographically secure pseudo-random number generator (CSPRNG). This is the same primitive used by banks and security tools — not Math.random, which is predictable.',
  },
  {
    q: 'Are my passwords stored anywhere?',
    a: 'No. The password is generated inside your browser using JavaScript and displayed in your screen only. It is never sent to any server, never logged, never cached.',
  },
  {
    q: 'What is the recommended password length?',
    a: 'For personal accounts, 16 characters is the modern minimum. For high-value accounts (email, banking, master password), use 20+ characters. Our generator supports up to 64 characters.',
  },
  {
    q: 'Should I include symbols in my password?',
    a: 'Length matters more than character variety. A 20-character password with only lowercase letters is harder to crack than an 8-character password with symbols, numbers, and uppercase mixed.',
  },
  {
    q: 'How do I remember strong passwords?',
    a: 'Use a password manager like Bitwarden, 1Password, or KeePass. You only need to remember one master password — the generator creates unique strong passwords for every site you visit.',
  },
  {
    q: 'Can I generate passwords in bulk?',
    a: 'Yes — click the regenerate button multiple times. Each click creates a new cryptographically random password. For bulk generation, copy each one to your password manager as you go.',
  },
];

const customSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      "name": "FormFix Pro Password Generator",
      "operatingSystem": "All Platforms",
      "applicationCategory": "SecurityApplication",
      "description": "Generate cryptographically secure random passwords instantly in your browser.",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      }
    }
  ]
};
---

<BaseLayout title={PAGE_TITLE} description={PAGE_DESC} keywords={PAGE_KEYWORDS} customSchema={customSchema} active="tools" canonicalPath="/password-generator" faq={faqs}>
    <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
        const pwOutput = document.getElementById('pw-output');
        const copyBtn = document.getElementById('copy-btn');
        const lenSlider = document.getElementById('pw-length');
        const lenVal = document.getElementById('len-val');
        
        const optUpper = document.getElementById('opt-uppercase');
        const optLower = document.getElementById('opt-lowercase');
        const optNum = document.getElementById('opt-numbers');
        const optSym = document.getElementById('opt-symbols');
        const optPronounce = document.getElementById('opt-pronounceable');
        
        const regenerateBtn = document.getElementById('regenerate-btn');
        const strengthFill = document.getElementById('strength-fill');
        const strengthText = document.getElementById('strength-text');

        const charSets = {
            upper: "ABCDEFGHIJKLMNOPQRSTUVWXYZ",
            lower: "abcdefghijklmnopqrstuvwxyz",
            numbers: "0123456789",
            symbols: "!@#$%^&*()_+~`|}{[]:;?><,./-="
        };

        function getRandomValuesFallback(buf) {
            for (let i = 0; i < buf.length; i++) {
                buf[i] = Math.floor(Math.random() * 4294967296);
            }
        }

        function generatePassword() {
            let charset = "";
            if (optUpper.checked) charset += charSets.upper;
            if (optLower.checked) charset += charSets.lower;
            if (optNum.checked) charset += charSets.numbers;
            if (optSym.checked) charset += charSets.symbols;

            if (charset === "") {
                optLower.checked = true;
                charset += charSets.lower;
            }

            const length = parseInt(lenSlider.value);

            if (optPronounce && optPronounce.checked) {
                const consonants = 'bcdfghjklmnpqrstvwxyz';
                const vowels = 'aeiou';
                let password = '';
                for (let i = 0; i < length; i++) {
                    const pool = i % 2 === 0 ? consonants : vowels;
                    const randomVal = new Uint32Array(1);
                    if (window.crypto && window.crypto.getRandomValues) {
                        window.crypto.getRandomValues(randomVal);
                    } else {
                        getRandomValuesFallback(randomVal);
                    }
                    password += pool[randomVal[0] % pool.length];
                }
                if (optNum.checked || optSym.checked) {
                    let extras = '';
                    if (optNum.checked) extras += charSets.numbers;
                    if (optSym.checked) extras += charSets.symbols;
                    if (extras.length > 0) {
                        const positions = [];
                        for (let i = 0; i < Math.min(3, length); i++) {
                            const rv = new Uint32Array(1);
                            if (window.crypto && window.crypto.getRandomValues) window.crypto.getRandomValues(rv);
                            else getRandomValuesFallback(rv);
                            positions.push(rv[0] % length);
                        }
                        const pwArr = password.split('');
                        positions.forEach(pos => {
                            const rv2 = new Uint32Array(1);
                            if (window.crypto && window.crypto.getRandomValues) window.crypto.getRandomValues(rv2);
                            else getRandomValuesFallback(rv2);
                            pwArr[pos] = extras[rv2[0] % extras.length];
                        });
                        password = pwArr.join('');
                    }
                }
                pwOutput.value = password;
            } else {
                let password = "";
                const poolSize = charset.length;
                const limit = Math.floor(4294967296 / poolSize) * poolSize;
                const randomVal = new Uint32Array(1);

                for (let i = 0; i < length; i++) {
                    do {
                        if (window.crypto && window.crypto.getRandomValues) {
                            window.crypto.getRandomValues(randomVal);
                        } else {
                            getRandomValuesFallback(randomVal);
                        }
                    } while (randomVal[0] >= limit);
                    password += charset[randomVal[0] % poolSize];
                }
                pwOutput.value = password;
            }
            lenVal.textContent = length.toString();
            updateStrength(pwOutput.value);
        }

        function updateStrength(pwd) {
            let score = 0;
            if (pwd.length > 8) score += 1;
            if (pwd.length > 12) score += 1;
            if (pwd.length >= 16) score += 1;
            let optionsCount = 0;
            if (optUpper.checked) optionsCount++;
            if (optNum.checked) optionsCount++;
            if (optSym.checked) optionsCount++;
            if (optLower.checked) optionsCount++;
            
            score += optionsCount;

            strengthFill.className = "strength-bar";
            if (score <= 3) {
                strengthFill.style.width = "30%";
                strengthFill.style.background = "var(--error)";
                strengthText.textContent = "Weak";
            } else if (score <= 5) {
                strengthFill.style.width = "60%";
                strengthFill.style.background = "var(--warning)";
                strengthText.textContent = "Medium";
            } else {
                strengthFill.style.width = "100%";
                strengthFill.style.background = "var(--success)";
                strengthText.textContent = "Secure";
            }
        }

        async function copyToClipboard() {
            try {
                await navigator.clipboard.writeText(pwOutput.value);
                if (window.ffNotice) window.ffNotice("Password copied!", "success");
            } catch (err) {
                if (window.ffNotice) window.ffNotice("Failed to copy.", "error");
            }
        }

        [optUpper, optLower, optNum, optSym, optPronounce].forEach(el => {
            el?.addEventListener('change', generatePassword);
        });
        lenSlider?.addEventListener('input', generatePassword);

        regenerateBtn?.addEventListener('click', generatePassword);
        copyBtn?.addEventListener('click', copyToClipboard);

        generatePassword();
    });
</script>

    <Breadcrumb items={[{ name: 'Home', path: '/' }, { name: "Secure Password Generator Online - Strong & Random Passwords", path: "/password-generator" }]} />

    <ToolWrapper title="Password Generator" subtitle="Generate military-grade strong passwords instantly. 100% offline and secure." currentTool="password-generator">
        
        <div slot="tool-ui">
             <div class="password-app">
                  <div class="result-section glass-card mb-32">
                       <div class="display-wrap">
                            <input type="text" id="pw-output" class="pw-input" readonly value="Loading..." />
                            <button id="copy-btn" class="copy-action" title="Copy to Clipboard">
                                 <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
                            </button>
                       </div>
                       
                       <div class="strength-indicator mt-32">
                            <div class="strength-meta">
                                 <span class="label">Security Level</span>
                                 <span id="strength-text" class="status">Strong</span>
                            </div>
                            <div class="strength-track"><div id="strength-fill" class="strength-bar"></div></div>
                       </div>
                  </div>

                  <div class="config-app">
                       <div class="config-section mb-32">
                            <div class="header-row mb-20">
                                 <label class="config-label">Password Length</label>
                                 <span id="len-val" class="value-badge">16</span>
                            </div>
                            <input type="range" id="pw-length" min="6" max="64" value="16" class="premium-slider" />
                       </div>

                       <div class="options-grid">
                            <label class="option-pill">
                                 <input type="checkbox" id="opt-uppercase" checked />
                                 <div class="pill-content">
                                      <span class="tick"></span>
                                      <span class="text">Uppercase <small>(A-Z)</small></span>
                                 </div>
                            </label>
                            <label class="option-pill">
                                 <input type="checkbox" id="opt-lowercase" checked />
                                 <div class="pill-content">
                                      <span class="tick"></span>
                                      <span class="text">Lowercase <small>(a-z)</small></span>
                                 </div>
                            </label>
                            <label class="option-pill">
                                 <input type="checkbox" id="opt-numbers" checked />
                                 <div class="pill-content">
                                      <span class="tick"></span>
                                      <span class="text">Numbers <small>(0-9)</small></span>
                                 </div>
                            </label>
                             <label class="option-pill">
                                  <input type="checkbox" id="opt-symbols" checked />
                                  <div class="pill-content">
                                       <span class="tick"></span>
                                       <span class="text">Symbols <small>(@#$%)</small></span>
                                  </div>
                             </label>
                             <label class="option-pill">
                                  <input type="checkbox" id="opt-pronounceable" />
                                  <div class="pill-content">
                                       <span class="tick"></span>
                                       <span class="text">Pronounceable <small>(easier to remember)</small></span>
                                  </div>
                             </label>
                       </div>
                  </div>
                  
                  <div class="app-footer mt-40">
                       <button id="regenerate-btn" class="primary-btn btn-glow lg-btn">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M23 4v6h-6"></path><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"></path></svg>
                            Generate New
                       </button>
                       <div class="privacy-note">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                            End-to-end local generation
                       </div>
                  </div>
             </div>
        </div>

        <div slot="tool-info" class="pro-article">
             <h2>Secure-By-Design Password Generation</h2>
             <p>Protecting your online identity starts with strong, unique passwords. Our <strong>Secure Password Maker</strong> uses the browser's native Web Crypto API to ensure each character is truly random and cryptographically unpredictable.</p>

             <div class="feature-grid">
                  <div class="f-item">
                       <span class="f-icon">⛓️</span>
                       <h3>High Entropy</h3>
                       <p>Uses Web Crypto API (CSPRNG) for cryptographically strong random values — the same standard used by banks and security software.</p>
                  </div>
                  <div class="f-item">
                       <span class="f-icon">🛸</span>
                       <h3>Zero Exposure</h3>
                       <p>Passwords are never sent to any server. They exist only in your browser, displayed on screen for you to copy.</p>
                  </div>
                  <div class="f-item">
                       <span class="f-icon">📏</span>
                       <h3>Custom Length</h3>
                       <p>Choose any length from 8 to 64 characters. Longer passwords exponentially increase brute-force resistance.</p>
                  </div>
                  <div class="f-item">
                       <span class="f-icon">🎯</span>
                       <h3>Strength Meter</h3>
                       <p>Real-time entropy calculation tells you whether your generated password is weak, medium, or cryptographically strong.</p>
                  </div>
             </div>

             <h3>How to use the password generator</h3>
             <ol>
                  <li><strong>Choose length:</strong> Drag the slider to set your desired password length (16+ recommended).</li>
                  <li><strong>Select character types:</strong> Toggle uppercase, lowercase, numbers, and symbols based on the site's requirements.</li>
                  <li><strong>Regenerate:</strong> Click the regenerate button to create a new random password until you like one.</li>
                  <li><strong>Copy:</strong> Click the copy button to put the password in your clipboard, then paste it into your password manager.</li>
             </ol>

             <h3>Password security best practices</h3>
             <ul>
                  <li><strong>Unique per site:</strong> Never reuse passwords. A breach on one site shouldn't expose your other accounts.</li>
                  <li><strong>Use a password manager:</strong> Bitwarden, 1Password, KeePass — let them remember your passwords for you.</li>
                  <li><strong>Enable 2FA:</strong> Two-factor authentication adds a critical second layer even if your password leaks.</li>
                  <li><strong>Avoid personal info:</strong> Birthdays, names, and pet names are easily guessed via social media.</li>
                  <li><strong>Update on breaches:</strong> When a site you use reports a breach, change that password immediately.</li>
             </ul>

             <div class="faq-section mt-48">
                  <h3>Frequently Asked Questions</h3>
                  {faqs.map(({ q, a }) => (
                      <details class="faq-item">
                          <summary>{q}</summary>
                          <p>{a}</p>
                      </details>
                  ))}
             </div>
        </div>
    </ToolWrapper>
</BaseLayout><style>
    .password-app { max-width: 600px; margin: 0 auto; }
    
    .result-section { padding: 40px; background: var(--surface-3); text-align: center; }
    .display-wrap { position: relative; background: var(--surface-2); border-radius: 16px; border: 1px solid var(--border-subtle); display: flex; align-items: center; }
    .pw-input { width: 100%; height: 72px; background: transparent; border: none; padding: 0 80px 0 24px; font-size: 1.75rem; font-weight: 600; font-family: monospace; color: var(--text-primary); letter-spacing: 0.05em; outline: none; }
    .copy-action { position: absolute; right: 8px; top: 8px; bottom: 8px; width: 56px; background: var(--surface-3); border: 1px solid var(--border-subtle); border-radius: 12px; cursor: pointer; color: var(--text-muted); display: flex; align-items: center; justify-content: center; }
    .copy-action:hover { color: var(--accent-primary); border-color: var(--accent-primary); }

    .strength-indicator { text-align: left; }
    .strength-meta { display: flex; justify-content: space-between; margin-bottom: 12px; }
    .strength-meta .label { font-size: 0.75rem; font-weight:600; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em; }
    .strength-meta .status { font-size: 0.85rem; font-weight:600; color: var(--text-primary); }
    .strength-track { height: 6px; background: var(--border-subtle); border-radius: 100px; overflow: hidden; }
    .strength-bar { height: 100%; transition: 0.5s cubic-bezier(0.16, 1, 0.3, 1); border-radius: 100px; }

    .header-row { display: flex; justify-content: space-between; align-items: center; }
    .config-label { font-size: 0.85rem; font-weight:600; color: var(--text-primary); text-transform: uppercase; letter-spacing: 0.05em; }
    .value-badge { background: var(--surface-2); color: var(--accent-primary); border: 1.5px solid var(--accent-primary); padding: 4px 12px; border-radius: 100px; font-weight:600; font-size: 0.85rem; }

    .premium-slider { appearance: none; width: 100%; height: 6px; background: var(--border-subtle); border-radius: 100px; outline: none; }
    .premium-slider::-webkit-slider-thumb { appearance: none; width: 24px; height: 24px; background: var(--accent-primary); border:4px solid var(--border-subtle); border-radius: 50%; box-shadow: var(--shadow-md); cursor: pointer; transition: 0.2s; }
    .premium-slider::-webkit-slider-thumb:hover { transform: scale(1.1); }

    .options-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
    .option-pill { cursor: pointer; }
    .option-pill input { display: none; }
    .pill-content { background:var(--surface-3); border: 1.5px solid var(--border-subtle); padding: 16px; border-radius: 16px; display: flex; align-items: center; gap: 12px; transition: 0.2s; }
    .option-pill input:checked + .pill-content { border-color: var(--accent-primary); background: var(--surface-3); }
    .tick { width: 20px; height: 20px; border: 2px solid var(--border-subtle); border-radius: 6px; display: flex; align-items: center; justify-content: center; position: relative; }
    .option-pill input:checked + .pill-content .tick { border-color: var(--accent-primary); background: var(--accent-primary); }
    .option-pill input:checked + .pill-content .tick::after { content: '✓'; color: #fff; font-size: 12px; font-weight:600; }
    .pill-content .text { font-weight:600; color: var(--text-primary); font-size: 0.95rem; }
    .pill-content small { color: var(--text-muted); font-weight: 500; font-size: 0.75rem; }

    .lg-btn { height: 64px; font-size: 1.15rem; border-radius: 20px; }
    .privacy-note { display: flex; align-items: center; justify-content: center; gap: 8px; font-size: 0.8rem; color: var(--text-muted); font-weight: 600; margin-top: 20px; }

    .faq-section { margin-top: 3rem; padding-top: 2rem; border-top: 1px solid var(--border-subtle); }
    .faq-section h3 { font-size: 1.5rem; font-weight:600; margin-bottom: 1.5rem; }
    .faq-item { background: var(--surface-3); border: 1px solid var(--border-subtle); border-radius: 12px; margin-bottom: 12px; overflow: hidden; }
    .faq-item summary { padding: 16px 20px; cursor: pointer; font-weight:600; color: var(--text-primary); list-style: none; position: relative; }
    .faq-item summary::-webkit-details-marker { display: none; }
    .faq-item summary::after { content: '+'; position: absolute; right: 20px; font-weight:600; font-size: 1.4rem; color: var(--accent-primary); }
    .faq-item[open] summary::after { content: '−'; }
    .faq-item p { padding: 0 20px 20px; margin: 0; font-size: 0.95rem; color: var(--text-muted); line-height: 1.7; }

    /* Info Section Styles */
    .pro-article h2 { font-size: 2rem; font-weight:600; margin-bottom: 24px; }
    .pro-article p { font-size: 1.1rem; color: var(--text-muted); line-height: 1.8; margin-bottom: 32px; }
    .feature-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-bottom: 40px; }
    .f-item { padding: 24px; background: var(--surface-3); border-radius: 16px; border: 1px solid var(--border-subtle); }
    .f-icon { font-size: 2rem; display: block; margin-bottom: 16px; }
    .f-item h3 { font-size: 1.1rem; margin-bottom: 8px; }
    
    @media (max-width: 600px) {
        .result-section { padding: 20px; }
        .pw-input { font-size: 1.35rem; height: 60px; }
        .options-grid { grid-template-columns: 1fr; }
    }
</style>
