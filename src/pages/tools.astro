---
import BaseLayout from '../components/BaseLayout.astro';

const PAGE_TITLE = 'Tool Dashboard | FormFix';
const PAGE_DESC = 'Access your complete suite of 30+ free tools for images, PDFs, and more.';
const PAGE_KEYWORDS = 'formfix dashboard, free online tools, image compressor, pdf tools';

// Primary Featured Tool
const featuredTool = {
    id: 'compress-image',
    title: 'Image Compressor Studio',
    icon: '🎯',
    href: '/compress-image',
    desc: 'The ultimate tool to accurately reduce your photo file size to specific targets like 20KB or 50KB without noticeable quality loss.',
    cta: 'Compress Now'
};

// All Categories
const categories = [
    {
        id: 'image',
        title: 'Image Tools',
        icon: '🖼️',
        tools: [
            { id: 'compress-image', title: 'Compress Image to Exact KB', href: '/compress-image', desc: 'Hit exact file size targets like 20KB, 50KB or any custom limit.', cta: 'Compress Now' },
            { id: 'compress-image-20kb', title: 'Compress to 20KB', href: '/compress-image-to-20kb', desc: 'One-click compress to exactly 20KB for govt portals.', cta: 'Open Tool' },
            { id: 'compress-image-50kb', title: 'Compress to 50KB', href: '/compress-image-to-50kb', desc: 'Reduce image to exactly 50KB instantly.', cta: 'Open Tool' },
            { id: 'passport-size-photo', title: 'Passport Photo Maker', href: '/passport-size-photo', desc: 'Official 3.5×4.5cm passport photos for all online forms.', cta: 'Create Photo' },
            { id: 'crop-image', title: 'Crop Image Online', href: '/crop-image', desc: 'Precise cropping with ratio presets (1:1, 4:3, 16:9).', cta: 'Crop Now' },
            { id: 'circle-crop', title: 'Circle Profile Maker', href: '/circle-crop', desc: 'Perfect circular avatars for CV, LinkedIn & social.', cta: 'Create Avatar' },
            { id: 'resize-image', title: 'Resize Image Pixels', href: '/resize-image', desc: 'Change width/height proportionally in any resolution.', cta: 'Resize' },
            { id: 'background-remover', title: 'Background Remover', href: '/background-remover', desc: 'Remove white or solid backgrounds from signatures & photos.', cta: 'Remove BG' },
            { id: 'black-and-white', title: 'Black & White Filter', href: '/black-and-white', desc: 'Convert photos to elegant grayscale B&W.', cta: 'Apply Filter' },
            { id: 'photo-to-sketch', title: 'Pencil Sketch Maker', href: '/photo-to-sketch', desc: 'Turn any photo into a beautiful pencil drawing instantly.', cta: 'Make Sketch' },
            { id: 'text-to-handwriting', title: 'Assignment Studio', href: '/text-to-handwriting', desc: 'Convert typed text into realistic handwriting on notebook paper.', cta: 'Write Now' },
            { id: 'image-to-text', title: 'Image to Text (OCR)', href: '/image-to-text', desc: 'Extract editable text from any image or document instantly.', cta: 'Scan Now' },
            { id: 'resume-builder', title: 'Pro Resume Builder', href: '/resume-builder', desc: 'Create a professional modern resume in less than 60 seconds.', cta: 'Build CV' },
            { id: 'convert-image', title: 'Format Converter', href: '/convert-image', desc: 'Convert between JPG, PNG & fast-loading WebP.', cta: 'Convert' },
            { id: 'signature-maker', title: 'Digital Signature Maker', href: '/signature-maker', desc: 'Draw or type signatures in 60+ cursive fonts. Transparent PNG.', cta: 'Make Signature' },
            { id: 'blur-image', title: 'Blur & Censor Image', href: '/blur-image', desc: 'Redact sensitive info, pixelate faces securely.', cta: 'Blur Now' },
            { id: 'watermark-image', title: 'Watermark Engine', href: '/watermark-image', desc: 'Add text watermarks to protect your photography.', cta: 'Add Watermark' }
        ]
    },
    {
        id: 'pdf',
        title: 'PDF Tools',
        icon: '📄',
        tools: [
            { id: 'merge-pdf', title: 'Merge PDF Files', href: '/merge-pdf', desc: 'Combine multiple PDF documents into one file 100% offline.', cta: 'Merge PDFs' },
            { id: 'rotate-pdf', title: 'Rotate PDF Pages', href: '/rotate-pdf', desc: 'Fix upside-down scanned PDFs without uploading.', cta: 'Rotate PDF' },
            { id: 'image-to-pdf', title: 'Images to PDF', href: '/image-to-pdf', desc: 'Merge multiple JPG/PNG images into a single PDF.', cta: 'Create PDF' },
            { id: 'pdf-to-image', title: 'PDF to Images', href: '/pdf-to-image', desc: 'Extract every page from a PDF as a high-quality image.', cta: 'Extract' },
            { id: 'split-pdf', title: 'Split & Extract PDF', href: '/split-pdf', desc: 'Separate specific pages from any PDF instantly.', cta: 'Split PDF' },
        ]
    },
    {
        id: 'utilities',
        title: 'Utilities',
        icon: '🔐',
        tools: [
            { id: 'qr-code-generator', title: 'QR Code Generator', href: '/qr-code-generator', desc: 'Create branded, permanent QR codes for URLs, WiFi & more.', cta: 'Make QR Code' },
            { id: 'password-generator', title: 'Password Generator', href: '/password-generator', desc: 'Generate military-grade secure passwords locally.', cta: 'Generate' },
            { id: 'file-size-converter', title: 'File Size Converter', href: '/file-size-converter', desc: 'Instant calculator for Bytes ⇄ KB ⇄ MB ⇄ GB.', cta: 'Calculate' },
            { id: 'percentage-calculator', title: 'Percentage Calculator', href: '/percentage-calculator', desc: 'Quickly find % of numbers without page reload.', cta: 'Calculate %' },
            { id: 'age-calculator', title: 'Age Calculator', href: '/age-calculator', desc: 'Calculate exact age in years, months, and days.', cta: 'Check Age' },
        ]
    }
];

// Flatten for quick lookup in client JS
const allToolsFlat = categories.flatMap(c => c.tools);
---

<BaseLayout title={PAGE_TITLE} description={PAGE_DESC} keywords={PAGE_KEYWORDS} active="tools" canonicalPath="/tools">

<!-- DASHBOARD HEADER -->
<div class="dashboard-shell animate-fade-up">
    <div class="container">
        
        <header class="dashboard-header">
            <div class="header-titles">
                <h1>Workspace</h1>
                <p class="greeting-line">Welcome back — pick up right where you left off.</p>
            </div>
            
            <div class="search-filter-wrap">
                <div class="search-box">
                    <span class="search-icon">🔍</span>
                    <input type="search" id="tool-search" placeholder="Search perfectly optimized tools..." aria-label="Search tools" />
                </div>
            </div>
        </header>

        <!-- DASHBOARD TOP GRID (Hierarchy & Recents) -->
        <section class="top-dashboard-section" id="top-dashboard-area">
            <div class="quick-actions-row">
                <!-- 1. Featured Tool (Prominent) -->
                <div class="featured-column">
                    <h3 class="section-lbl">Primary Tool</h3>
                    <a href={featuredTool.href} class="dashboard-card featured-card tracker-tool" data-id={featuredTool.id} data-title={featuredTool.title} data-icon={featuredTool.icon} data-href={featuredTool.href} data-cta={featuredTool.cta}>
                        <div class="feat-content">
                            <span class="tool-icon colossal">{featuredTool.icon}</span>
                            <div class="feat-text">
                                <h2>{featuredTool.title}</h2>
                                <p>{featuredTool.desc}</p>
                            </div>
                        </div>
                        <button class="action-btn primary">{featuredTool.cta}</button>
                    </a>
                </div>

                <!-- 2. Recent Tools (Dynamic) -->
                <div class="recent-column">
                    <div class="recent-header">
                        <h3 class="section-lbl">Recent Tools</h3>
                        <button id="clear-recents" class="clear-btn hidden">Clear</button>
                    </div>
                    <div class="recent-grid empty" id="recent-tools-container">
                        <div class="empty-state">
                            <p>No tools used recently.</p>
                            <span>Your history will appear here.</span>
                        </div>
                        <!-- JS WILL POPULATE THIS -->
                    </div>
                </div>
            </div>
        </section>

        <!-- FILTER TABS -->
        <div class="filter-tabs" id="filter-tabs">
            <button class="filter-tab active" data-filter="all">All Tools</button>
            <button class="filter-tab" data-filter="image">Image Tools</button>
            <button class="filter-tab" data-filter="pdf">PDF Tools</button>
            <button class="filter-tab" data-filter="utilities">Utilities</button>
        </div>

        <!-- COLLAPSIBLE GROUPINGS -->
        <div class="tool-groups-container" id="groups-container">
            {categories.map(cat => (
                <details class="tool-group" data-category={cat.id} open>
                    <summary class="group-summary">
                        <div class="summary-left">
                            <span class="group-icon">{cat.icon}</span>
                            <h2>{cat.title} <span class="count-badge">{cat.tools.length}</span></h2>
                        </div>
                        <span class="toggle-arrow">▼</span>
                    </summary>
                    
                    <div class="group-grid">
                        {cat.tools.map(tool => (
                            <a href={tool.href} class="dashboard-card standard-card tracker-tool search-item" data-id={tool.id} data-title={tool.title} data-icon={cat.icon} data-href={tool.href} data-cta={tool.cta}>
                                <div class="card-top">
                                    <span class="tool-icon">{cat.icon}</span>
                                    <div class="card-titles">
                                        <h3>{tool.title}</h3>
                                        <p>{tool.desc}</p>
                                    </div>
                                </div>
                                <div class="card-bottom">
                                    <button class="action-btn secondary">{tool.cta}</button>
                                </div>
                            </a>
                        ))}
                    </div>
                </details>
            ))}
            
            <div id="no-results" class="hidden no-results-state">
                <span class="sad-icon">🔍</span>
                <h3>No tools found</h3>
                <p>Try searching with different keywords.</p>
            </div>
        </div>

    </div>
</div>

</BaseLayout>

<style>
/* ───── GLOBALS & TYPE ───── */
.dashboard-shell {
    background: #fafafa;
    min-height: 100vh;
    padding: 60px 0 120px 0;
}
.section-lbl {
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--surface-500);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 16px;
}

/* ───── HEADER & SEARCH ───── */
.dashboard-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 48px;
    gap: 32px;
    flex-wrap: wrap;
}
.header-titles h1 {
    font-size: 2.5rem;
    font-weight: 800;
    color: #000;
    letter-spacing: -0.03em;
    margin-bottom: 8px;
}
.greeting-line {
    font-size: 1.1rem;
    color: var(--surface-600);
    font-weight: 500;
}
.search-filter-wrap { flex-grow: 1; max-width: 400px; width: 100%; }
.search-box {
    position: relative;
    width: 100%;
}
.search-icon {
    position: absolute;
    left: 16px; top: 50%;
    transform: translateY(-50%);
    color: var(--surface-400);
    font-size: 1.1rem;
}
#tool-search {
    width: 100%;
    padding: 16px 16px 16px 48px;
    border-radius: 12px;
    border: 1px solid var(--border-subtle);
    background: #fff;
    font-size: 1rem;
    font-weight: 500;
    transition: all 0.2s;
    box-shadow: 0 4px 12px -4px rgba(0,0,0,0.03);
}
#tool-search:focus {
    outline: none;
    border-color: #000;
    box-shadow: 0 4px 20px -4px rgba(0,0,0,0.1);
}

/* ───── TOP GRID (HIERARCHY) ───── */
.quick-actions-row {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 32px;
    margin-bottom: 48px;
}

/* Cards Base */
.dashboard-card {
    background: #fff;
    border: 1px solid var(--border-subtle);
    border-radius: 16px;
    text-decoration: none;
    display: flex;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 0 4px 12px -4px rgba(0,0,0,0.02);
}
.dashboard-card:hover {
    border-color: var(--surface-300);
    box-shadow: 0 20px 40px -15px rgba(0,0,0,0.08);
    transform: translateY(-4px);
}
.action-btn {
    border: none; border-radius: 8px; font-weight: 600; font-size: 0.95rem; padding: 10px 24px; cursor: pointer; transition: 0.2s;
}
.dashboard-card:hover .action-btn.primary { background: #222; transform: translateY(-1px); }
.dashboard-card:hover .action-btn.secondary { background: #000; color: #fff; transform: translateY(-1px); }

/* Featured Card */
.featured-card {
    flex-direction: column;
    justify-content: space-between;
    padding: 40px;
    height: 100%;
    min-height: 280px;
    border: 1px solid var(--surface-300);
}
.feat-content { display: flex; gap: 24px; align-items: flex-start; margin-bottom: 32px; }
.tool-icon.colossal { font-size: 3.5rem; background: var(--surface-100); padding: 16px; border-radius: 16px; }
.feat-text h2 { font-size: 1.8rem; font-weight: 800; color: #000; margin-bottom: 12px; }
.feat-text p { font-size: 1.1rem; color: var(--surface-600); line-height: 1.6; }
.action-btn.primary { background: #000; color: #fff; width: fit-content; padding: 14px 32px; }

/* Recents */
.recent-column { display: flex; flex-direction: column; }
.recent-header { display: flex; justify-content: space-between; align-items: center; }
.clear-btn { background: none; border: none; color: var(--surface-400); font-size: 0.85rem; font-weight: 600; cursor: pointer; transition: 0.2s; margin-bottom: 16px; }
.clear-btn:hover { color: #000; text-decoration: underline; }
.recent-grid {
    display: flex;
    flex-direction: column;
    gap: 16px;
    flex-grow: 1;
}
.recent-grid.empty { justify-content: center; align-items: center; background: transparent; border: 2px dashed var(--surface-300); border-radius: 16px; }
.empty-state { text-align: center; color: var(--surface-500); }
.empty-state p { font-weight: 600; color: var(--surface-600); margin-bottom: 4px; }
.empty-state span { font-size: 0.9rem; }

/* Mini Card for Recents */
.mini-card {
    padding: 16px 20px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
}
.mini-left { display: flex; align-items: center; gap: 16px; }
.mini-icon { font-size: 1.5rem; }
.mini-title { font-weight: 700; color: #000; font-size: 1rem; }
.mini-btn { font-size: 0.85rem; font-weight: 600; color: var(--surface-600); background: var(--surface-100); padding: 6px 16px; border-radius: 6px; transition: 0.2s; }
.mini-card:hover .mini-btn { background: #000; color: #fff; }

/* ───── FILTERS ───── */
.filter-tabs {
    display: flex;
    gap: 12px;
    margin-bottom: 32px;
    border-bottom: 1px solid var(--border-subtle);
    padding-bottom: 16px;
    overflow-x: auto;
}
.filter-tab {
    background: transparent;
    border: none;
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--surface-500);
    padding: 8px 16px;
    border-radius: 100px;
    cursor: pointer;
    transition: 0.2s;
    white-space: nowrap;
}
.filter-tab:hover { color: #000; background: var(--surface-200); }
.filter-tab.active { background: #000; color: #fff; }

/* ───── COLLAPSIBLE GROUPS ───── */
.tool-groups-container { display: flex; flex-direction: column; gap: 24px; }
.tool-group {
    background: transparent;
}
.group-summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 24px 0;
    cursor: pointer;
    list-style: none; /* remove default triangle */
    outline: none;
    border-bottom: 2px solid transparent;
}
.group-summary::-webkit-details-marker { display: none; }
.summary-left { display: flex; align-items: center; gap: 16px; }
.group-icon { font-size: 1.8rem; }
.summary-left h2 { font-size: 1.5rem; font-weight: 800; color: #000; display: flex; align-items: center; gap: 12px; }
.count-badge { font-size: 0.8rem; background: var(--surface-200); color: var(--surface-600); padding: 4px 10px; border-radius: 100px; }
.toggle-arrow { font-size: 1rem; color: var(--surface-400); transition: transform 0.3s; }
.tool-group[open] .toggle-arrow { transform: rotate(180deg); }

/* Group Grid */
.group-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 20px;
    padding: 16px 0 48px 0;
    animation: fadeIn 0.4s ease;
}
@keyframes fadeIn { from { opacity: 0; transform: translateY(-10px); } to { opacity: 1; transform: translateY(0); } }

/* Standard Cards */
.standard-card {
    flex-direction: column;
    padding: 24px;
    gap: 20px;
    justify-content: space-between;
    height: 100%;
}
.card-top { display: flex; gap: 16px; align-items: flex-start; }
.tool-icon { font-size: 1.8rem; }
.card-titles h3 { font-size: 1.15rem; font-weight: 800; color: #000; margin-bottom: 6px; line-height: 1.3;}
.card-titles p { font-size: 0.95rem; color: var(--surface-500); line-height: 1.5; }
.action-btn.secondary { background: var(--surface-100); color: var(--surface-600); width: 100%; padding: 12px; }

/* No Results State */
.no-results-state {
    text-align: center;
    padding: 80px 0;
}
.sad-icon { font-size: 3rem; margin-bottom: 16px; display: block; opacity: 0.5; }
.no-results-state h3 { font-size: 1.5rem; font-weight: 700; color: #000; margin-bottom: 8px; }
.no-results-state p { color: var(--surface-500); }
.hidden { display: none !important; }

/* ───── RESPONSIVE CONSTRAINTS ───── */
@media (max-width: 1024px) {
    .quick-actions-row { grid-template-columns: 1fr; }
    .featured-card { min-height: auto; }
}

@media (max-width: 768px) {
    .dashboard-header { flex-direction: column; align-items: flex-start; gap: 24px; }
    .search-filter-wrap { max-width: 100%; }
    .feat-content { flex-direction: column; gap: 16px; }
    .tool-icon.colossal { font-size: 2.5rem; padding: 12px; }
    .group-grid { grid-template-columns: 1fr; }
}
</style>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        // --- 1. RECENT TOOLS SYSTEM (LOCALSTORAGE) ---
        const RECENT_KEY = 'formfix_recent_tools';
        const recentContainer = document.getElementById('recent-tools-container');
        const clearBtn = document.getElementById('clear-recents');
        
        function renderRecents() {
            if (!recentContainer) return;
            const data = localStorage.getItem(RECENT_KEY);
            let recents = data ? JSON.parse(data) : [];
            
            if (recents.length === 0) {
                recentContainer.innerHTML = `
                    <div class="empty-state">
                        <p>No tools used recently.</p>
                        <span>Your history will appear here.</span>
                    </div>`;
                recentContainer.classList.add('empty');
                if(clearBtn) clearBtn.classList.add('hidden');
                return;
            }

            recentContainer.classList.remove('empty');
            if(clearBtn) clearBtn.classList.remove('hidden');
            
            recentContainer.innerHTML = recents.map(t => `
                <a href="${t.href}" class="dashboard-card mini-card box-shadow-subtle hover-lift">
                    <div class="mini-left">
                        <span class="mini-icon">${t.icon}</span>
                        <span class="mini-title">${t.title}</span>
                    </div>
                    <span class="mini-btn">${t.cta}</span>
                </a>
            `).join('');
        }

        function trackToolClick(e) {
            const card = e.currentTarget;
            const toolData = {
                id: card.dataset.id,
                title: card.dataset.title,
                icon: card.dataset.icon,
                href: card.dataset.href,
                cta: card.dataset.cta
            };

            const data = localStorage.getItem(RECENT_KEY);
            let recents = data ? JSON.parse(data) : [];
            
            // Remove if exists
            recents = recents.filter(t => t.id !== toolData.id);
            // Add to front
            recents.unshift(toolData);
            // Keep only top 3
            if (recents.length > 3) recents = recents.slice(0, 3);
            
            localStorage.setItem(RECENT_KEY, JSON.stringify(recents));
        }

        // Init tracker on all tool cards
        document.querySelectorAll('.tracker-tool').forEach(el => {
            el.addEventListener('click', trackToolClick);
        });

        if (clearBtn) {
            clearBtn.addEventListener('click', () => {
                localStorage.removeItem(RECENT_KEY);
                renderRecents();
            });
        }

        renderRecents();

        // --- 2. SEARCH AND FILTER LOGIC ---
        const searchInput = document.getElementById('tool-search');
        const filterBtns = document.querySelectorAll('.filter-tab');
        const groups = document.querySelectorAll('.tool-group');
        const topArea = document.getElementById('top-dashboard-area');
        const noResults = document.getElementById('no-results');

        let currentFilter = 'all';
        let currentSearch = '';

        function runFilters() {
            let totalVisible = 0;

            groups.forEach(group => {
                const cat = group.dataset.category;
                const items = group.querySelectorAll('.search-item');
                let groupHasVisibleItems = false;
                
                // Check if this entire group is filtered out by tabs
                const matchesTab = (currentFilter === 'all' || currentFilter === cat);

                items.forEach(item => {
                    const title = item.dataset.title.toLowerCase();
                    const desc = item.querySelector('.card-titles p').innerText.toLowerCase();
                    const matchesSearch = title.includes(currentSearch) || desc.includes(currentSearch);
                    
                    if (matchesTab && matchesSearch) {
                        item.classList.remove('hidden');
                        groupHasVisibleItems = true;
                        totalVisible++;
                    } else {
                        item.classList.add('hidden');
                    }
                });

                // Hide/show the entire group HTML
                if (groupHasVisibleItems) {
                    group.classList.remove('hidden');
                    // Force open if searching actively
                    if (currentSearch.length > 0) {
                        group.setAttribute('open', '');
                    }
                } else {
                    group.classList.add('hidden');
                }
            });

            // Handle Top Area
            if (topArea) {
                if (currentSearch.length > 0 || currentFilter !== 'all') {
                    topArea.classList.add('hidden'); // hide top actions when deeply searching
                } else {
                    topArea.classList.remove('hidden');
                }
            }

            // Handle No Results
            if (totalVisible === 0) {
                noResults.classList.remove('hidden');
            } else {
                noResults.classList.add('hidden');
            }
        }

        if (searchInput) {
            searchInput.addEventListener('input', (e) => {
                currentSearch = e.target.value.toLowerCase();
                runFilters();
            });
        }

        filterBtns.forEach(btn => {
            btn.addEventListener('click', (e) => {
                filterBtns.forEach(b => b.classList.remove('active'));
                btn.classList.add('active');
                currentFilter = btn.dataset.filter;
                runFilters();
            });
        });

    });
</script>
