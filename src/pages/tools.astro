---
import BaseLayout from '../components/BaseLayout.astro';
import CompressTool from '../components/tools/CompressTool.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { SITE_URL } from '../seo';

const PAGE_TITLE = 'All Free Online Tools — Image Compressor, PDF Merger, Passport Photo & More | FormFix';
const PAGE_DESC = 'Browse 30+ free browser-based tools: image compressor, PDF merger, passport photo maker, signature maker, QR code generator, and more. No sign-up, no uploads.';
const PAGE_KEYWORDS = 'free online tools, image compressor online, pdf merger free, passport photo maker, signature maker online, qr code generator free, browser tools, no upload tools';

const categories = [
    {
        id: 'image',
        title: 'Image Tools',
        desc: 'Professional image processing, resizing, and manipulation.',
        tools: [
            { id: 'compress-image', title: 'Image Compressor', href: '/compress-image', desc: 'Hit exact file size targets like 20KB, 50KB or any custom limit.' },
            { id: 'compress-image-to-20kb', title: 'Compress to 20KB', href: '/compress-image-to-20kb', desc: 'Precisely hit the 20KB file size limit for government forms.' },
            { id: 'compress-image-to-50kb', title: 'Compress to 50KB', href: '/compress-image-to-50kb', desc: 'Optimize images for SSC, UPSC, and banking form uploads.' },
            { id: 'passport-photo-compressor', title: 'Passport Photo Compressor', href: '/passport-photo-compressor', desc: 'Compress passport photos to required size limits.' },
            { id: 'passport-size-photo', title: 'Passport Photo Maker', href: '/passport-size-photo', desc: 'Official 3.5x4.5cm passport photos.' },
            { id: 'official-passport-photo-maker', title: 'Global Passport Photo', href: '/official-passport-photo-maker', desc: 'Generate photos for any country with correct dimensions.' },
            { id: 'crop-image', title: 'Crop Image', href: '/crop-image', desc: 'Precise cropping with ratio presets.' },
            { id: 'circle-crop', title: 'Circle Profile Maker', href: '/circle-crop', desc: 'Perfect circular avatars for profiles.' },
            { id: 'resize-image', title: 'Resize Image', href: '/resize-image', desc: 'Change width/height proportionally.' },
            { id: 'resize-image-for-platform', title: 'Resize for Social', href: '/resize-image-for-instagram', desc: 'One-click resize for Instagram, Twitter, LinkedIn.' },
            { id: 'background-remover', title: 'Background Remover', href: '/background-remover', desc: 'Remove white or solid backgrounds.' },
            { id: 'black-and-white', title: 'Black & White Filter', href: '/black-and-white', desc: 'Convert photos to elegant grayscale.' },
            { id: 'photo-to-sketch', title: 'Pencil Sketch Maker', href: '/photo-to-sketch', desc: 'Turn any photo into a pencil drawing.' },
            { id: 'convert-image', title: 'Format Converter', href: '/convert-image', desc: 'Convert between JPG, PNG & WebP.' },
            { id: 'blur-image', title: 'Blur & Censor', href: '/blur-image', desc: 'Redact sensitive info securely.' },
            { id: 'watermark-image', title: 'Watermark Engine', href: '/watermark-image', desc: 'Add text watermarks to your photos.' }
        ]
    },
    {
        id: 'pdf',
        title: 'Document & PDF Tools',
        desc: 'Merge, split, and extract documents completely offline.',
        tools: [
            { id: 'merge-pdf', title: 'Merge PDF', href: '/merge-pdf', desc: 'Combine multiple PDFs into one file.' },
            { id: 'rotate-pdf', title: 'Rotate PDF', href: '/rotate-pdf', desc: 'Fix upside-down scanned PDFs.' },
            { id: 'image-to-pdf', title: 'Images to PDF', href: '/image-to-pdf', desc: 'Merge JPG/PNG images into a single PDF.' },
            { id: 'pdf-to-image', title: 'PDF to Images', href: '/pdf-to-image', desc: 'Extract every page as a high-quality image.' },
            { id: 'split-pdf', title: 'Split & Extract', href: '/split-pdf', desc: 'Separate specific pages from any PDF.' },
            { id: 'resume-builder', title: 'Resume Builder', href: '/resume-builder', desc: 'Create a modern resume in 60 seconds.' },
            { id: 'text-to-handwriting', title: 'Assignment Studio', href: '/text-to-handwriting', desc: 'Convert text into realistic handwriting.' },
            { id: 'signature-maker', title: 'Signature Maker', href: '/signature-maker', desc: 'Draw or type digital signatures.' }
        ]
    },
    {
        id: 'utilities',
        title: 'Utilities & Calculators',
        desc: 'Quick tools for everyday tasks and calculations.',
        tools: [
            { id: 'qr-code-generator', title: 'QR Code Generator', href: '/qr-code-generator', desc: 'Create permanent QR codes.' },
            { id: 'password-generator', title: 'Password Generator', href: '/password-generator', desc: 'Generate secure passwords.' },
            { id: 'file-size-converter', title: 'File Size Converter', href: '/file-size-converter', desc: 'Instant calculator for Bytes to KB to MB.' },
            { id: 'percentage-calculator', title: 'Percentage Calculator', href: '/percentage-calculator', desc: 'Quickly find percent of numbers.' },
            { id: 'age-calculator', title: 'Age Calculator', href: '/age-calculator', desc: 'Calculate exact age in years, months, days.' },
            { id: 'image-to-text', title: 'Image to Text (OCR)', href: '/image-to-text', desc: 'Extract text from any image using OCR.' }
        ]
    }
];

const customSchema = {
    '@context': 'https://schema.org',
    '@graph': [
        {
            '@type': 'CollectionPage',
            name: 'FormFix Tools',
            description: PAGE_DESC,
            url: `${SITE_URL}/tools`,
            hasPart: categories.flatMap(c => c.tools).map(t => ({
                '@type': 'SoftwareApplication',
                name: t.title,
                url: SITE_URL + t.href,
                applicationCategory: 'UtilitiesApplication',
                offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
            })),
        }
    ]
};
---

<BaseLayout title={PAGE_TITLE} description={PAGE_DESC} keywords={PAGE_KEYWORDS} active="tools" canonicalPath="/tools" customSchema={customSchema}>

<Breadcrumb items={[{ name: 'Home', path: '/' }, { name: 'All Tools', path: '/tools' }]} />

<div class="tools-page">
    <div class="container">

        <header class="page-header">
            <h1>All Tools</h1>
            <p>Browse 30+ free tools. 100% private, runs in your browser.</p>
        </header>

        <section class="featured-section">
            <div class="featured-card">
                <div class="featured-header">
                    <span class="featured-tag">Featured</span>
                    <h2>Image Compressor</h2>
                    <p>Hit exact 20KB or 50KB targets with precision. Runs locally.</p>
                </div>
                <div class="featured-body">
                    <CompressTool initialTarget="20" />
                </div>
            </div>
        </section>

        <div class="controls">
            <div class="search-wrap">
                <svg class="search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
                <label for="tool-search" class="sr-only">Search tools</label>
                <input type="search" id="tool-search" placeholder="Search tools..." aria-label="Search tools" />
            </div>
            <div class="filter-tabs" role="tablist" aria-label="Filter by category">
                <button class="filter-tab active" data-filter="all" role="tab" aria-selected="true">All</button>
                <button class="filter-tab" data-filter="image" role="tab" aria-selected="false">Image</button>
                <button class="filter-tab" data-filter="pdf" role="tab" aria-selected="false">PDF</button>
                <button class="filter-tab" data-filter="utilities" role="tab" aria-selected="false">Utilities</button>
            </div>
        </div>

        <div class="activity-bar hidden" id="activity-area">
            <div class="activity-header">
                <h2>Recent</h2>
                <button id="clear-recents" class="clear-btn" type="button">Clear</button>
            </div>
            <div id="recent-tools-container" class="recent-grid"></div>
        </div>

        <div class="tools-library" id="groups-container">
            {categories.map(cat => (
                <section class="tool-section" data-category={cat.id} aria-labelledby={`cat-${cat.id}`}>
                    <header class="section-header">
                        <h2 id={`cat-${cat.id}`}>{cat.title}</h2>
                        <p>{cat.desc}</p>
                    </header>

                    <div class="tools-grid">
                        {cat.tools.map(tool => (
                            <a href={tool.href} class="tool-card search-item tracker-tool" data-id={tool.id} data-title={tool.title} data-desc={tool.desc} data-href={tool.href} aria-label={`Open ${tool.title}`}>
                                <h3>{tool.title}</h3>
                                <p>{tool.desc}</p>
                            </a>
                        ))}
                    </div>
                </section>
            ))}

            <div id="no-results" class="hidden no-results" role="status">
                <h3>No tools found</h3>
                <p>Try a different search term.</p>
            </div>
        </div>

    </div>
</div>

</BaseLayout>

<style>
.tools-page {
    padding: 32px 0 120px;
}

.page-header {
    margin-bottom: 40px;
}
.page-header h1 {
    font-size: clamp(1.5rem, 4vw, 2.2rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    margin-bottom: 8px;
}
.page-header p {
    font-size: 0.95rem;
    color: var(--text-secondary);
}

/* Featured */
.featured-section {
    margin-bottom: 48px;
}
.featured-card {
    background: var(--surface-2);
    border: 1px solid var(--card-border);
    border-radius: var(--radius-lg);
    padding: 32px;
}
.featured-header {
    margin-bottom: 28px;
}
.featured-tag {
    display: inline-block;
    padding: 4px 10px;
    background: var(--accent-soft);
    color: var(--accent-primary);
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border-radius: var(--radius-sm);
    margin-bottom: 12px;
}
.featured-header h2 {
    font-size: 1.3rem;
    font-weight: 600;
    margin-bottom: 4px;
}
.featured-header p {
    font-size: 0.85rem;
    color: var(--text-secondary);
}

/* Controls */
.controls {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
    margin-bottom: 40px;
}
.search-wrap {
    position: relative;
    flex: 1;
    min-width: 240px;
}
.search-icon {
    position: absolute;
    left: 12px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--text-muted);
    pointer-events: none;
}
#tool-search {
    width: 100%;
    padding: 10px 12px 10px 40px;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    background: var(--surface-2);
    color: var(--text-primary);
    font-size: 0.85rem;
    font-family: inherit;
    outline: none;
}
#tool-search:focus {
    border-color: var(--accent-primary);
}

.filter-tabs {
    display: flex;
    gap: 4px;
}
.filter-tab {
    padding: 8px 14px;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    background: transparent;
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--text-secondary);
    cursor: pointer;
    font-family: inherit;
}
.filter-tab:hover {
    border-color: var(--border-strong);
    color: var(--text-primary);
}
.filter-tab.active {
    background: var(--text-primary);
    color: var(--surface-1);
    border-color: var(--text-primary);
}

/* Activity */
.activity-bar {
    margin-bottom: 48px;
}
.activity-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--border-subtle);
}
.activity-header h2 {
    font-size: 0.9rem;
    font-weight: 600;
}
.clear-btn {
    background: none;
    border: none;
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--text-muted);
    cursor: pointer;
    font-family: inherit;
}
.clear-btn:hover {
    color: var(--error);
}
.recent-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 12px;
}
.recent-card {
    background: var(--surface-2);
    padding: 16px;
    border-radius: var(--radius-md);
    border: 1px solid var(--border-subtle);
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
}
.recent-card:hover {
    border-color: var(--border-strong);
}
.recent-title {
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--text-primary);
}

/* Tool Sections */
.tools-library {
    opacity: 0.95;
}

.tool-section {
    margin-bottom: 56px;
}

.section-header {
    margin-bottom: 20px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--border-subtle);
}
.section-header h2 {
    font-size: 1.1rem;
    font-weight: 600;
    margin-bottom: 4px;
}
.section-header p {
    font-size: 0.85rem;
    color: var(--text-muted);
}

.tools-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
}

.tool-card {
    background: var(--surface-2);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 20px;
    text-decoration: none;
    display: flex;
    flex-direction: column;
}
.tool-card:hover {
    border-color: var(--border-strong);
}
.tool-card h3 {
    font-size: 0.9rem;
    font-weight: 600;
    margin-bottom: 4px;
    color: var(--text-primary);
}
.tool-card p {
    font-size: 0.8rem;
    color: var(--text-muted);
    line-height: 1.5;
    margin: 0;
}

.no-results {
    text-align: center;
    padding: 80px 0;
}
.no-results h3 {
    font-size: 1.1rem;
    font-weight: 600;
    margin-bottom: 8px;
}
.no-results p {
    color: var(--text-secondary);
    font-size: 0.9rem;
}

@media (max-width: 1024px) {
    .tools-grid { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 640px) {
    .tools-grid { grid-template-columns: 1fr; }
    .controls { flex-direction: column; }
    .search-wrap { min-width: 100%; }
}
</style>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const RECENT_KEY = 'formfix_recent_tools';
        const recentContainer = document.getElementById('recent-tools-container');
        const activityArea = document.getElementById('activity-area');
        const clearBtn = document.getElementById('clear-recents');

        function renderRecents() {
            if (!recentContainer) return;
            const data = localStorage.getItem(RECENT_KEY);
            let recents = data ? JSON.parse(data) : [];

            if (recents.length === 0) {
                if(activityArea) activityArea.classList.add('hidden');
                return;
            }

            if(activityArea) activityArea.classList.remove('hidden');

            const safeTitle = (typeof window.FormFix !== 'undefined' && window.FormFix.escapeHtml)
                ? window.FormFix.escapeHtml
                : (s) => s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
            recentContainer.innerHTML = recents.map(t => `
                <a href="${safeTitle(t.href)}" class="recent-card" aria-label="Recently used ${safeTitle(t.title)}">
                    <span class="recent-title">${safeTitle(t.title)}</span>
                </a>
            `).join('');
        }

        function trackToolClick(e) {
            const card = e.currentTarget;
            const toolData = {
                id: card.dataset.id,
                title: card.dataset.title,
                href: card.dataset.href
            };

            const data = localStorage.getItem(RECENT_KEY);
            let recents = data ? JSON.parse(data) : [];

            recents = recents.filter(t => t.id !== toolData.id);
            recents.unshift(toolData);
            if (recents.length > 4) recents = recents.slice(0, 4);

            localStorage.setItem(RECENT_KEY, JSON.stringify(recents));
        }

        document.querySelectorAll('.tracker-tool').forEach(el => el.addEventListener('click', trackToolClick));

        if (clearBtn) {
            clearBtn.addEventListener('click', () => {
                localStorage.removeItem(RECENT_KEY);
                renderRecents();
            });
        }
        renderRecents();

        const searchInput = document.getElementById('tool-search');
        const filterBtns = document.querySelectorAll('.filter-tab');
        const sections = document.querySelectorAll('.tool-section');
        const topArea = document.querySelector('.featured-section');
        const noResults = document.getElementById('no-results');

        let currentFilter = 'all';
        let currentSearch = '';

        function runFilters() {
            let totalVisible = 0;

            sections.forEach(section => {
                const cat = section.dataset.category;
                const items = section.querySelectorAll('.search-item');
                let groupHasVisibleItems = false;

                const matchesTab = (currentFilter === 'all' || currentFilter === cat);

                items.forEach(item => {
                    const title = item.dataset.title.toLowerCase();
                    const desc = (item.dataset.desc || '').toLowerCase();
                    const matchesSearch = title.includes(currentSearch) || desc.includes(currentSearch);

                    if (matchesTab && (currentSearch === '' || matchesSearch)) {
                        item.style.display = 'flex';
                        groupHasVisibleItems = true;
                        totalVisible++;
                    } else {
                        item.style.display = 'none';
                    }
                });

                section.style.display = groupHasVisibleItems ? 'block' : 'none';
            });

            const isSearching = currentSearch.length > 0 || currentFilter !== 'all';
            if (topArea) topArea.style.display = isSearching ? 'none' : 'block';
            if (activityArea && !activityArea.classList.contains('hidden')) {
                activityArea.style.display = isSearching ? 'none' : 'block';
            }

            if (totalVisible === 0) {
                noResults?.classList.remove('hidden');
            } else {
                noResults?.classList.add('hidden');
            }
        }

        if (searchInput) {
            searchInput.addEventListener('input', (e) => {
                currentSearch = e.target.value.toLowerCase();
                runFilters();
            });
        }

        filterBtns.forEach(btn => {
            btn.addEventListener('click', () => {
                filterBtns.forEach(b => { b.classList.remove('active'); b.setAttribute('aria-selected', 'false'); });
                btn.classList.add('active');
                btn.setAttribute('aria-selected', 'true');
                currentFilter = btn.dataset.filter;
                runFilters();
            });
        });
    });
</script>
