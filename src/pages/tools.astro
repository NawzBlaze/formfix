---
import BaseLayout from '../components/BaseLayout.astro';

const PAGE_TITLE = 'All Free Online Tools – FormFix Tool Hub';
const PAGE_DESC = 'Access all 30+ FormFix tools in one place: image compressor, passport photo maker, PDF merger, QR code generator, signature maker, and more. Free, private, browser-based.';
const PAGE_KEYWORDS = 'image tools online free, pdf tools browser, qr code generator, password generator, online calculators, formfix tool hub';

const categories = [
    {
        id: 'image-suite',
        title: 'Image Suite',
        icon: '🖼️',
        color: 'indigo',
        tools: [
            { title: 'Compress Image to Exact KB', href: '/compress-image', desc: 'Hit exact file size targets like 20KB, 50KB or any custom limit.', badge: 'Most Popular', cta: 'Compress Now' },
            { title: 'Compress to 20KB', href: '/compress-image-20kb', desc: 'One-click compress to exactly 20KB for govt portals.', badge: 'Hot', cta: 'Start' },
            { title: 'Compress to 50KB', href: '/compress-image-50kb', desc: 'Reduce image to exactly 50KB instantly.', badge: null, cta: 'Start' },
            { title: 'Compress to 100KB', href: '/compress-image-100kb', desc: 'Reduce image to 100KB for uploads.', badge: null, cta: 'Start' },
            { title: 'Passport Photo Maker', href: '/passport-size-photo', desc: 'Official 3.5×4.5cm passport photos for all online forms.', badge: 'Official', cta: 'Create Photo' },
            { title: 'Crop Image Online', href: '/crop-image', desc: 'Precise cropping with ratio presets (1:1, 4:3, 16:9).', badge: null, cta: 'Crop Now' },
            { title: 'Circle Profile Maker', href: '/circle-crop', desc: 'Perfect circular avatars for CV, LinkedIn & social.', badge: null, cta: 'Create Avatar' },
            { title: 'Resize Image Pixels', href: '/resize-image', desc: 'Change width/height proportionally in any resolution.', badge: null, cta: 'Resize' },
            { title: 'Background Remover', href: '/background-remover', desc: 'Remove white or solid backgrounds from signatures & photos.', badge: 'AI', cta: 'Remove BG' },
            { title: 'Black & White Filter', href: '/black-and-white', desc: 'Convert photos to elegant grayscale B&W.', badge: 'Hot', cta: 'Apply Filter' },
            { title: 'Pencil Sketch Maker', href: '/photo-to-sketch', desc: 'Turn any photo into a beautiful pencil drawing instantly.', badge: 'Viral', cta: 'Make Sketch' },
            { title: 'Assignment Studio', href: '/text-to-handwriting', desc: 'Convert typed text into realistic handwriting on notebook paper.', badge: 'Hot', cta: 'Write Now' },
            { title: 'Image to Text (OCR)', href: '/image-to-text', desc: 'Extract editable text from any image or document instantly.', badge: 'AI', cta: 'Scan Now' },
            { title: 'Pro Resume Builder', href: '/resume-builder', desc: 'Create a professional modern resume in less than 60 seconds.', badge: 'Careers', cta: 'Build CV' },
            { title: 'Format Converter', href: '/convert-image', desc: 'Convert between JPG, PNG & fast-loading WebP.', badge: 'Fast', cta: 'Convert' },
            { title: 'Digital Signature Maker', href: '/signature-maker', desc: 'Draw or type signatures in 60+ cursive fonts. Transparent PNG.', badge: 'Trending', cta: 'Make Signature' },
            { title: 'Blur & Censor Image', href: '/blur-image', desc: 'Redact sensitive info, pixelate faces securely.', badge: null, cta: 'Blur Now' },
            { title: 'Watermark Engine', href: '/watermark-image', desc: 'Add text watermarks to protect your photography.', badge: null, cta: 'Add Watermark' },
        ]
    },
    {
        id: 'pdf-suite',
        title: 'PDF Utilities',
        icon: '📄',
        color: 'rose',
        tools: [
            { title: 'Merge PDF Files', href: '/merge-pdf', desc: 'Combine multiple PDF documents into one file 100% offline.', badge: 'Hot', cta: 'Merge PDFs' },
            { title: 'Rotate PDF Pages', href: '/rotate-pdf', desc: 'Fix upside-down scanned PDFs without uploading.', badge: 'Quick', cta: 'Rotate PDF' },
            { title: 'Images to PDF', href: '/image-to-pdf', desc: 'Merge multiple JPG/PNG images into a single PDF.', badge: 'New', cta: 'Create PDF' },
            { title: 'PDF to Images', href: '/pdf-to-image', desc: 'Extract every page from a PDF as a high-quality image.', badge: 'New', cta: 'Extract' },
            { title: 'Split & Extract PDF', href: '/split-pdf', desc: 'Separate specific pages from any PDF instantly.', badge: 'New', cta: 'Split PDF' },
        ]
    },
    {
        id: 'utilities',
        title: 'Security & Utilities',
        icon: '🔐',
        color: 'emerald',
        tools: [
            { title: 'QR Code Generator', href: '/qr-code-generator', desc: 'Create branded, permanent QR codes for URLs, WiFi & more.', badge: 'Brand New', cta: 'Make QR Code' },
            { title: 'Password Generator', href: '/password-generator', desc: 'Generate military-grade secure passwords locally.', badge: 'Secure', cta: 'Generate' },
            { title: 'File Size Converter', href: '/file-size-converter', desc: 'Instant calculator for Bytes ⇄ KB ⇄ MB ⇄ GB.', badge: null, cta: 'Calculate' },
            { title: 'Percentage Calculator', href: '/percentage-calculator', desc: 'Quickly find % of numbers without page reload.', badge: null, cta: 'Calculate %' },
            { title: 'Age Calculator', href: '/age-calculator', desc: 'Calculate exact age in years, months, and days.', badge: null, cta: 'Check Age' },
        ]
    },
    {
        id: 'compressors',
        title: 'Photo Compressors',
        icon: '🗜️',
        color: 'amber',
        tools: [
            { title: 'Photo Compressor', href: '/photo-compressor', desc: 'Smart compressor for any photo format.', badge: null, cta: 'Compress' },
            { title: 'Passport Photo Compressor', href: '/passport-photo-compressor', desc: 'Compress passport photos without losing quality.', badge: null, cta: 'Compress' },
        ]
    }
];

const colorMap: Record<string, { bg: string; border: string; badge: string; icon: string }> = {
    indigo: { bg: '#eef2ff', border: '#c7d2fe', badge: '#4f46e5', icon: '#eef2ff' },
    rose:   { bg: '#fff1f2', border: '#fecdd3', badge: '#e11d48', icon: '#fff1f2' },
    emerald:{ bg: '#ecfdf5', border: '#a7f3d0', badge: '#059669', icon: '#ecfdf5' },
    amber:  { bg: '#fffbeb', border: '#fde68a', badge: '#d97706', icon: '#fffbeb' },
};
---

<BaseLayout title={PAGE_TITLE} description={PAGE_DESC} keywords={PAGE_KEYWORDS} active="tools" canonicalPath="/tools">

<!-- Hero -->
<section class="hub-hero container animate-fade-up">
    <div class="hub-hero-content">
        <span class="section-label">🛠️ Complete Toolkit</span>
        <h1>FormFix <span class="highlight">Tool Hub</span></h1>
        <p class="hub-sub">30+ free, browser-based tools. No uploads. No sign-up. Instant results on any device.</p>
        <div class="hub-stats">
            <div class="hub-stat"><strong>30+</strong> <span>Free Tools</span></div>
            <div class="hub-stat-div"></div>
            <div class="hub-stat"><strong>0</strong> <span>Server Uploads</span></div>
            <div class="hub-stat-div"></div>
            <div class="hub-stat"><strong>100%</strong> <span>Private</span></div>
        </div>
    </div>
</section>


<button id="back-to-top" class="back-to-top hidden" aria-label="Back to top">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M18 15l-6-6-6 6"/></svg>
</button>

<!-- Categories -->
<div class="categories-wrapper container animate-fade-up">
    {categories.map(cat => {
        const colors = colorMap[cat.color];
        return (
            <section id={cat.id} class="category-section">
                <div class="cat-header" style={`background: ${colors.bg}; border-color: ${colors.border};`}>
                    <div class="cat-icon-wrap" style={`background: ${colors.badge};`}>
                        {cat.icon}
                    </div>
                    <div>
                        <h2 class="cat-title">{cat.title}</h2>
                        <p class="cat-count">{cat.tools.length} tools available</p>
                    </div>
                </div>

                <div class="tool-grid">
                    {cat.tools.map(tool => (
                        <a href={tool.href} class="hub-card">
                            <div class="hub-card-top">
                                <h3>{tool.title}</h3>
                                {tool.badge && (
                                    <span class="hub-badge" style={`background: ${colors.badge};`}>{tool.badge}</span>
                                )}
                            </div>
                            <p>{tool.desc}</p>
                            <span class="hub-cta">{tool.cta} →</span>
                        </a>
                    ))}
                </div>
            </section>
        );
    })}
</div>

<!-- Bottom CTA -->
<section class="hub-cta-section container animate-fade-up">
    <div class="hub-cta-card">
        <div class="hub-cta-content">
            <h2>🚀 Need a specific tool?</h2>
            <p>Can't find what you need? Our most popular tool is the image compressor — hit any exact KB target with one click.</p>
        </div>
        <div class="hub-cta-actions">
            <a href="/compress-image" class="primary-btn" id="hub-compress-btn">Compress Image →</a>
            <a href="/passport-size-photo" class="secondary-btn" id="hub-passport-btn">Passport Photo →</a>
        </div>
    </div>
</section>

</BaseLayout>

<style>
/* ─ Hero ─ */
.hub-hero {
    padding: 72px 0 48px;
    text-align: center;
}
.hub-hero-content { max-width: 680px; margin: 0 auto; }
.hub-hero h1 { font-size: clamp(2.2rem, 5vw, 3.5rem); font-weight: 900; letter-spacing: -0.05em; margin: 12px 0 20px; }
.hub-sub { font-size: 1.15rem; color: var(--slate); font-weight: 500; line-height: 1.6; margin-bottom: 36px; }

.hub-stats {
    display: inline-flex;
    align-items: center;
    gap: 24px;
    background: var(--bg-subtle);
    border: 1.5px solid var(--border-light);
    border-radius: 100px;
    padding: 16px 36px;
}
.hub-stat { display: flex; flex-direction: column; align-items: center; gap: 2px; }
.hub-stat strong { font-size: 1.4rem; font-weight: 900; color: var(--primary); line-height: 1; }
.hub-stat span { font-size: 0.72rem; font-weight: 700; color: var(--gray); text-transform: uppercase; letter-spacing: 0.08em; }
.hub-stat-div { width: 1px; height: 36px; background: var(--border); }

/* ─ Categories ─ */
.categories-wrapper { padding-bottom: 80px; }
.category-section { margin-bottom: 72px; scroll-margin-top: 100px; }

/* Back to Top */
.back-to-top {
    position: fixed;
    bottom: 32px; right: 32px;
    width: 56px; height: 56px;
    background: var(--dark);
    color: white;
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    cursor: pointer;
    z-index: 100;
    box-shadow: var(--shadow-xl);
    transition: var(--transition-bounce);
}
.back-to-top:hover { transform: translateY(-6px) scale(1.1); background: var(--primary); }
.back-to-top.hidden { opacity: 0; pointer-events: none; transform: translateY(20px); }

.cat-header {
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 24px 28px;
    border-radius: 20px;
    border: 1.5px solid;
    margin-bottom: 24px;
}
.cat-icon-wrap {
    width: 52px; height: 52px;
    border-radius: 14px;
    display: flex; align-items: center; justify-content: center;
    font-size: 1.6rem;
    flex-shrink: 0;
}
.cat-title { font-size: 1.4rem; font-weight: 900; color: var(--dark); letter-spacing: -0.03em; margin-bottom: 2px; }
.cat-count { font-size: 0.82rem; font-weight: 700; color: var(--gray); text-transform: uppercase; letter-spacing: 0.06em; }

/* ─ Tool Grid ─ */
.tool-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));
    gap: 14px;
}
.hub-card {
    background: white;
    border: 1.5px solid var(--border-light);
    border-radius: 20px;
    padding: 24px;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
    transition: var(--transition-smooth);
    position: relative;
    overflow: hidden;
}
.hub-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 2px;
    background: var(--gradient-primary);
    transform: scaleX(0);
    transition: transform 0.35s ease;
    transform-origin: left;
}
.hub-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-md); border-color: var(--primary-mid); }
.hub-card:hover::before { transform: scaleX(1); }
.hub-card:hover .hub-cta { color: var(--primary); transform: translateX(4px); }

.hub-card-top { display: flex; justify-content: space-between; align-items: flex-start; gap: 10px; }
.hub-card-top h3 { font-size: 1rem; font-weight: 800; color: var(--dark); line-height: 1.3; }
.hub-badge {
    color: white;
    padding: 3px 10px;
    border-radius: 100px;
    font-size: 0.62rem;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    white-space: nowrap;
    flex-shrink: 0;
    margin-top: 2px;
}
.hub-card p { font-size: 0.88rem; color: var(--slate); font-weight: 500; line-height: 1.55; flex-grow: 1; }
.hub-cta { font-size: 0.82rem; font-weight: 800; color: var(--gray); text-transform: uppercase; letter-spacing: 0.06em; transition: var(--transition-base); margin-top: auto; }

/* ─ Bottom CTA ─ */
.hub-cta-section { padding-bottom: 100px; }
.hub-cta-card {
    background: var(--dark);
    border-radius: 28px;
    padding: 48px 60px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 40px;
    position: relative;
    overflow: hidden;
}
.hub-cta-card::before {
    content: '';
    position: absolute;
    top: -60px; right: -60px;
    width: 260px; height: 260px;
    background: radial-gradient(circle, rgba(79,70,229,0.3) 0%, transparent 70%);
    pointer-events: none;
}
.hub-cta-content { position: relative; }
.hub-cta-content h2 { font-size: 1.8rem; color: white; margin-bottom: 8px; font-weight: 900; }
.hub-cta-content p { font-size: 1rem; color: rgba(255,255,255,0.6); line-height: 1.6; font-weight: 500; }
.hub-cta-actions { display: flex; gap: 14px; flex-shrink: 0; position: relative; }

@media (max-width: 768px) {
    .hub-hero { padding: 48px 0 32px; }
    .hub-stats { flex-wrap: wrap; gap: 16px; padding: 16px 24px; border-radius: 20px; }
    .hub-stat-div { display: none; }
    .tool-grid { grid-template-columns: 1fr; gap: 10px; }
    .hub-card { padding: 20px; border-radius: 16px; }
    .hub-cta-card { flex-direction: column; padding: 32px 28px; text-align: center; }
    .hub-cta-content h2 { font-size: 1.4rem; }
    .hub-cta-actions { flex-direction: column; width: 100%; }
    .hub-cta-actions a { width: 100%; }
    .cat-header { padding: 18px 20px; }
}
</style>
<script>
    const btt = document.getElementById('back-to-top');

    window.addEventListener('scroll', () => {
        if (window.scrollY > 400) {
            btt?.classList.remove('hidden');
        } else {
            btt?.classList.add('hidden');
        }
    });

    btt?.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: 'smooth' });
    });
</script>
