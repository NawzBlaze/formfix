---
import BaseLayout from '../components/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import ToolWrapper from '../components/ToolWrapper.astro';

const PAGE_TITLE = 'Background Color Remover - Free & Private | FormFix';
const PAGE_DESC = 'Remove white, black, or any solid color background from signatures, logos and photos instantly. 100% private, browser-based processing.';
const PAGE_KEYWORDS = 'remove background from image, background remover online, transparent background maker, signature background reducer, white background removal';

const customSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      "name": "FormFix Background Remover",
      "applicationCategory": "MultimediaApplication",
      "operatingSystem": "All Platforms",
      "description": PAGE_DESC,
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      }
    }
  ]
};

const faqs = [
  { q: "Does this work for complex backgrounds?", a: "This tool is specialized for Solid Color Removal. It works best on signatures, clear logos, or images shot against a green/white screen. For complex landscape or portrait backgrounds, use a professional AI segmentation tool." },
  { q: "Will the final file stay transparent?", a: "Yes. We export the result as a 32-bit PNG which preserves full alpha transparency. This ensures the background remains invisible when you place the image on other documents, resumes, or websites." },
];
---

<BaseLayout title={PAGE_TITLE} description={PAGE_DESC} keywords={PAGE_KEYWORDS} customSchema={customSchema} active="tools" canonicalPath="/background-remover" faqs={faqs}>
    <script is:inline>
    document.addEventListener('DOMContentLoaded', () => { try {
        const input = document.getElementById('img-input'), canvas = document.getElementById('main-canvas'), ctx = canvas.getContext('2d', { willReadFrequently: true });
        const tolInput = document.getElementById('tolerance'), smoothInput = document.getElementById('smoothing');
        let originalImg = null, originalData = null, selectedColor = null;

        const dropZone = document.getElementById('drop-zone');
        if (dropZone) {
            dropZone.addEventListener('dragover', (e) => { e.preventDefault(); e.stopPropagation(); dropZone.style.borderColor = 'var(--accent-primary)'; dropZone.style.background = 'var(--surface-2)'; });
            dropZone.addEventListener('dragleave', (e) => { e.preventDefault(); e.stopPropagation(); dropZone.style.borderColor = ''; dropZone.style.background = ''; });
            dropZone.addEventListener('drop', (e) => {
                e.preventDefault(); e.stopPropagation();
                dropZone.style.borderColor = ''; dropZone.style.background = '';
                const file = e.dataTransfer.files[0];
                if (file && file.type.startsWith('image/')) {
                    input.files = e.dataTransfer.files;
                    input.dispatchEvent(new Event('change'));
                } else {
                    if (typeof window.ffNotice === 'function') window.ffNotice('Please drop a PNG, JPG, or WebP image.', 'error');
                }
            });
        }

        input.onchange = (e) => {
            const file = e.target.files[0]; if (!file) return;
            if (!['image/png','image/jpeg','image/webp'].includes(file.type)) {
                if (typeof window.ffNotice === 'function') window.ffNotice('Please select a PNG, JPG, or WebP image.', 'error');
                return;
            }
            const reader = new FileReader();
            reader.onload = (ev) => {
                originalImg = new Image();
                originalImg.onload = () => {
                   const max = 800; let w = originalImg.width, h = originalImg.height;
                   if (w > max) { h = (max / w) * h; w = max; } if (h > max) { w = (max / h) * w; h = max; }
                   canvas.width = w; canvas.height = h; ctx.drawImage(originalImg, 0, 0, w, h);
                   originalData = ctx.getImageData(0, 0, w, h).data;
                   document.getElementById('selection-stage').classList.add('hidden');
                   document.getElementById('editor-stage').classList.remove('hidden'); render();
                };
                originalImg.src = ev.target.result;
            };
            reader.readAsDataURL(file);
        };

        function render() {
            if (!originalImg) return;
            const imgData = ctx.getImageData(0, 0, canvas.width, canvas.height), data = imgData.data;
            const tol = parseInt(tolInput.value), smooth = parseInt(smoothInput.value) * 10;
            if (selectedColor) {
                for (let i = 0; i < data.length; i += 4) {
                    const r = originalData[i], g = originalData[i+1], b = originalData[i+2];
                    const diff = Math.sqrt(Math.pow(r-selectedColor.r,2)+Math.pow(g-selectedColor.g,2)+Math.pow(b-selectedColor.b,2));
                    if (diff < tol) data[i+3] = 0;
                    else if (diff < tol + smooth) data[i+3] = Math.min(data[i+3], ((diff - tol) / smooth) * 255);
                    else { data[i]=originalData[i]; data[i+1]=originalData[i+1]; data[i+2]=originalData[i+2]; data[i+3]=originalData[i+3]; }
                }
            } else { for (let i = 0; i < data.length; i++) data[i] = originalData[i]; }
            ctx.putImageData(imgData, 0, 0);
        }

        canvas.onclick = (e) => {
            const rect = canvas.getBoundingClientRect(), x = Math.floor((e.clientX - rect.left) * (canvas.width / rect.width)), y = Math.floor((e.clientY - rect.top) * (canvas.height / rect.height));
            if (x < 0 || x >= canvas.width || y < 0 || y >= canvas.height) return;
            const idx = (y * canvas.width + x) * 4;
            selectedColor = { r: originalData[idx], g: originalData[idx+1], b: originalData[idx+2] };
            render();
        };

        document.getElementById('remove-white').onclick = () => { selectedColor = {r:255,g:255,b:255}; tolInput.value = 30; document.getElementById('tol-val').innerText = 30; render(); };
        document.getElementById('remove-black').onclick = () => { selectedColor = {r:0,g:0,b:0}; tolInput.value = 30; document.getElementById('tol-val').innerText = 30; render(); };
        tolInput.oninput = () => { document.getElementById('tol-val').innerText = tolInput.value; render(); };
        smoothInput.oninput = () => { document.getElementById('smooth-val').innerText = smoothInput.value; render(); };
        document.getElementById('dl-btn').onclick = () => {
            const a = document.createElement('a'); a.download = "no-bg.png"; a.href = canvas.toDataURL('image/png'); a.click();
            if (typeof window.triggerConfetti === 'function') window.triggerConfetti();
            var shareTxt = encodeURIComponent("I just removed the background from my image using FormFix! 100% private. Try it: " + window.__SITE_URL + "/background-remover");
            var existing = document.getElementById('post-bg-share');
            if (!existing) {
                var div = document.createElement('div');
                div.id = 'post-bg-share';
                div.style.cssText = 'margin-top:20px;text-align:center;';
                div.innerHTML = '<p style="font-weight:600;margin-bottom:10px;color:var(--success);">Love FormFix? Share it!</p><div style="display:flex;gap:8px;justify-content:center;"><a href="https://x.com/intent/tweet?text=' + shareTxt + '" target="_blank" style="padding:8px 16px;border-radius:8px;background:#000;color:#fff;text-decoration:none;font-weight:600;font-size:0.85rem;">Share on X</a><a href="https://wa.me/?text=' + shareTxt + '" target="_blank" style="padding:8px 16px;border-radius:8px;background:#25D366;color:#fff;text-decoration:none;font-weight:600;font-size:0.85rem;">WhatsApp</a></div>';
                document.querySelector('.action-stack')?.appendChild(div);
            }
        };
    } catch(err) { console.error('Background Remover error:', err); if (typeof window.ffNotice === 'function') window.ffNotice('Something went wrong. Please try a different image.', 'error'); }
    });
</script>

    <Breadcrumb items={[{ name: 'Home', path: '/' }, { name: "Background Color Remover - Free & Private", path: "/background-remover" }]} />

    <ToolWrapper title="Background Remover" subtitle="Remove solid backgrounds from signatures and logos with chroma-key precision." currentTool="background-remover">
        
        <div slot="tool-ui">
             <div class="workspace-editor">
                  <!-- 1. Selection Stage -->
                  <div id="selection-stage" class="upload-container">
                       <div class="upload-box shadow-sm" id="drop-zone" onclick="document.getElementById('img-input').click()">
                            <input type="file" id="img-input" accept="image/*" class="hidden" />
                            <div class="upload-content">
                                 <div class="upload-icon">🎨</div>
                                 <h3 class="font-850 m-0 mb-8">Select Image to Fix</h3>
                                 <p class="text-muted m-0 mb-24 font-600">Clear white backgrounds from signatures & logos instantly.</p>
                                 <button class="primary-btn px-40">Upload Photo</button>
                            </div>
                       </div>
                  </div>

                  <!-- 2. Editor Stage -->
                  <div id="editor-stage" class="hidden">
                       <div class="chroma-grid">
                            <div class="preview-panel shadow-sm scroll-container">
                                 <div class="canvas-viewport checkerboard" id="pick-area">
                                      <canvas id="main-canvas"></canvas>
                                 </div>
                                 <div class="hint-badge mt-16 font-600">
                                      <span>👉 Click target color on image to remove it</span>
                                 </div>
                            </div>

                            <div class="controls-sidebar">
                                 <div class="settings-card shadow-sm mb-24">
                                      <div class="section mb-24">
                                           <label class="section-label m-0 mb-12">Preset Removal</label>
                                           <div class="d-flex gap-12">
                                                <button class="preset-btn flex-1" id="remove-white">White</button>
                                                <button class="preset-btn flex-1" id="remove-black">Black</button>
                                           </div>
                                      </div>

                                      <div class="section mb-24">
                                           <div class="d-flex justify-between align-center mb-16">
                                                <label class="section-label m-0">Tolerance</label>
                                                <span id="tol-val" class="status-pill highlight m-0" style="padding: 4px 12px;">20</span>
                                           </div>
                                           <input type="range" id="tolerance" min="1" max="100" value="20" class="unified-slider w-100" />
                                      </div>

                                      <div class="section">
                                           <div class="d-flex justify-between align-center mb-16">
                                                <label class="section-label m-0">Edge Softness</label>
                                                <span id="smooth-val" class="status-pill highlight m-0" style="padding: 4px 12px;">1</span>
                                           </div>
                                           <input type="range" id="smoothing" min="0" max="10" value="1" class="unified-slider w-100" />
                                      </div>
                                 </div>

                                 <div class="action-stack">
                                      <button id="dl-btn" class="primary-btn wide-btn pulse-glow mb-12">⬇️ Download Transparent PNG</button>
                                      <button class="secondary-btn wide-btn" onclick="location.reload()">↺ Start New</button>
                                 </div>
                                 <p class="privacy-note text-center mt-16 mb-0 font-600 text-muted">🔒 Local processing, files stay on your device.</p>
                            </div>
                       </div>
                  </div>
             </div>
        </div>

        <div slot="tool-info">
             <h2>Signature & Logo Background Removal</h2>
             <p>Our <strong>Online Color Remover</strong> uses a professional chroma-key algorithm to identify and strip away solid color backgrounds. Whether you need to <strong>remove white from a signature</strong> or isolate a logo from its canvas, FormFix provides pixel-perfect transparency without uploading your data to any server. This ensures your sensitive documents and branding assets remain private and secure.</p>
             
             <div class="how-it-works mt-32">
                  <h3>How It Works</h3>
                  <ol class="steps">
                       <li><strong>Step 1:</strong> Upload your photo</li>
                       <li><strong>Step 2:</strong> Wait for processing</li>
                       <li><strong>Step 3:</strong> Download transparent PNG</li>
                  </ol>
             </div>

             <div class="faq-grid mt-32">
                  <details class="faq-item">
                       <summary>Does this work for complex backgrounds?</summary>
                       <p>This tool is specialized for <strong>Solid Color Removal</strong>. It works best on signatures, clear logos, or images shot against a green/white screen. For complex landscape or portrait backgrounds, use a professional AI segmentation tool.</p>
                  </details>
                  <details class="faq-item">
                       <summary>Will the final file stay transparent?</summary>
                       <p>Yes. We export the result as a <strong>32-bit PNG</strong> which preserves full alpha transparency. This ensures the background remains invisible when you place the image on other documents, resumes, or websites.</p>
                  </details>
             </div>
        </div>
    </ToolWrapper>
</BaseLayout><style>
    .workspace-editor { display: flex; flex-direction: column; width: 100%; max-width: 1000px; margin: 0 auto; }
    
    .upload-container { display: flex; justify-content: center; }
    .upload-box { background: var(--surface-3); border: 2.5px dashed var(--border-subtle); border-radius: 32px; padding: 60px 40px; text-align: center; width: 100%; cursor: pointer; transition: 0.2s; }
    .upload-box:hover { border-color: var(--accent-primary); background: var(--surface-2); }
    .upload-icon { font-size: 3.5rem; margin-bottom: 24px; }

    .chroma-grid { display: grid; grid-template-columns: 1fr 340px; gap: 32px; }
    .preview-panel { background:var(--surface-3); border: 1px solid var(--border-subtle); border-radius: 24px; padding: 32px; display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 500px; }
    
    .checkerboard { 
        background-color:var(--surface-3);
        background-image: linear-gradient(45deg, var(--surface-2) 25%, transparent 25%, transparent 75%, var(--surface-2) 75%, var(--surface-2)), 
                          linear-gradient(45deg, var(--surface-2) 25%, transparent 25%, transparent 75%, var(--surface-2) 75%, var(--surface-2));
        background-size: 20px 20px; background-position: 0 0, 10px 10px;
        border-radius: 12px; overflow: hidden; border: 1px solid var(--border-subtle); box-shadow: var(--shadow-sm);
    }
    #main-canvas { max-width: 100%; height: auto; display: block; filter: drop-shadow(0 15px 40px rgba(0,0,0,0.1)); cursor: crosshair; }
    
    .hint-badge { display: inline-block; font-size: 0.85rem; color: var(--text-muted); background: var(--surface-2); padding: 8px 20px; border-radius: 100px; border: 1px solid var(--border-subtle); }

    .controls-sidebar { display: flex; flex-direction: column; gap: 24px; }
    .settings-card { background: var(--surface-3); padding: 24px; border-radius: 24px; border: 1px solid var(--border-subtle); }
    
    .preset-btn { padding: 12px; border-radius: 12px; border: 1px solid var(--border-subtle); background:var(--surface-3); font-weight:600; color: var(--text-primary); cursor: pointer; transition: 0.2s; font-size: 0.95rem; }
    .preset-btn:hover { border-color: var(--accent-primary); color: var(--accent-primary); box-shadow: var(--shadow-sm); }
    
    .section-label { font-size: 0.75rem; font-weight:600; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em; display: block; }
    
    .status-pill { font-size: 0.75rem; font-weight:600; color: var(--accent-primary); background:var(--surface-3); padding: 4px 12px; border-radius: 100px; border: 1px solid var(--border-subtle); display: inline-flex; align-items: center; justify-content: center; }
    .status-pill.highlight { border-color: var(--accent-primary); }

    .unified-slider { width: 100%; height: 6px; border-radius: 100px; background: var(--border-subtle); appearance: none; outline: none; margin: 0; }
    .unified-slider::-webkit-slider-thumb { appearance: none; width: 24px; height: 24px; background: var(--accent-primary); border-radius: 50%; border:4px solid var(--border-subtle); box-shadow: var(--shadow-sm); cursor: pointer; transition: transform 0.1s; }
    .unified-slider::-webkit-slider-thumb:hover { transform: scale(1.1); }

    .action-stack { display: flex; flex-direction: column; }
    .wide-btn { width: 100%; height: 60px; font-weight:600; font-size: 1rem; border-radius: 16px; box-sizing: border-box; display: flex; justify-content: center; align-items: center; }
    .privacy-note { font-size: 0.8rem; color: var(--text-muted); }

    /* FAQ */
    .faq-grid { display: grid; gap: 16px; }
    .faq-item { background:var(--surface-3); border: 1px solid var(--border-subtle); border-radius: var(--radius-sm); overflow: hidden; text-align: left; }
    .faq-item summary { font-weight:600; font-size: 1rem; padding: 16px 20px; cursor: pointer; color: var(--text-primary); list-style-type: none; position: relative; }
    .faq-item summary::after { content: '+'; position: absolute; right: 20px; font-weight:600; font-size: 1.2rem; color: var(--accent-primary); }
    .faq-item[open] summary::after { content: '−'; }
    .faq-item p { padding: 0 20px 20px; margin: 0; font-size: 0.95rem; color: var(--text-muted); line-height: 1.6; }

    .how-it-works h3 { font-size: 1.1rem; font-weight: 600; margin-bottom: 12px; color: var(--text-primary); }
    .steps { padding-left: 20px; margin: 0; }
    .steps li { font-size: 0.95rem; line-height: 1.7; color: var(--text-secondary); margin-bottom: 8px; }
    .steps li strong { color: var(--text-primary); }

    @media (max-width: 900px) {
        .chroma-grid { grid-template-columns: 1fr; }
        .preview-panel { min-height: 350px; padding: 16px; }
    }
    @media (max-width: 640px) {
        .upload-box { padding: 40px 24px; }
    }
</style>
