<script>
// Consolidation of Homepage Interactivity
document.addEventListener('DOMContentLoaded', () => {
    // 1. Smooth scroll for hero button
    document.querySelector('[href="#tools"]')?.addEventListener('click', (e: Event) => {
        e.preventDefault();
        const target = document.getElementById('tools');
        if (target) target.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });

    // 2. Numerical Counter Animation for Stats
    const statsObserver = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                const el = entry.target as HTMLElement;
                const valueStr = el.getAttribute('data-count') || '0';
                
                // Handle non-numeric values like 30+, 100%, ∞
                if (valueStr.includes('+')) {
                    animateValue(el, 0, parseInt(valueStr), 1500, '+');
                } else if (valueStr.includes('%')) {
                    animateValue(el, 0, parseInt(valueStr), 1500, '%');
                } else if (valueStr === '∞') {
                    // Just fade in for infinity
                    el.style.opacity = '1';
                } else {
                    animateValue(el, 0, parseInt(valueStr), 1500, '');
                }
                statsObserver.unobserve(el);
            }
        });
    }, { threshold: 0.5 });

    document.querySelectorAll('.stat-value').forEach(el => statsObserver.observe(el));

    function animateValue(obj: HTMLElement, start: number, end: number, duration: number, suffix: string) {
        let startTimestamp: number | null = null;
        const step = (timestamp: number) => {
            if (!startTimestamp) startTimestamp = timestamp;
            const progress = Math.min((timestamp - startTimestamp) / duration, 1);
            const current = Math.floor(progress * (end - start) + start);
            obj.innerHTML = current + suffix;
            if (progress < 1) {
                window.requestAnimationFrame(step);
            }
        };
        window.requestAnimationFrame(step);
    }

    // 3. Staggered Entrance Animations
    const animObserver = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                const el = entry.target as HTMLElement;
                el.style.animationPlayState = 'running';
                el.style.opacity = '1';
                animObserver.unobserve(el);
            }
        });
    }, { threshold: 0.1 });

    document.querySelectorAll<HTMLElement>('.animate-fade-up, .animate-in').forEach(el => {
        el.style.animationPlayState = 'paused';
        el.style.opacity = '0'; // Initial state for clean fade
        animObserver.observe(el);
    });
});
</script>
