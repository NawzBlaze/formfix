---
import BaseLayout from '../components/BaseLayout.astro';

const PAGE_TITLE = 'FormFix - 100% Private Image Compressor, Passport Photo Maker & PDF Tools';
const PAGE_DESC = 'The safest way to prepare official documents. 100% private image compressor, global passport photo maker, signature resizer, and PDF tools. No server uploads.';
---

<BaseLayout title={PAGE_TITLE} description={PAGE_DESC}>
    
    <!-- 🚀 SIGNATURE PRODUCT HERO -->
    <section class="product-hero">
        <div class="hero-light-beam"></div>
        <div class="hero-ambient-blob"></div>
        
        <div class="container hero-content-grid">
            <div class="hero-text-wrap">
                <div class="brand-eyebrow">
                    <span class="eyebrow-dot"></span>
                    Local Browser Architecture
                </div>
                
                <h1 class="hero-display">
                    Process files with <br />
                    <span class="word-dominant">Precision.</span>
                </h1>
                
                <p class="hero-lead">
                    The highest standard of document preparation. Compress, convert, and sign without your data ever touching a server.
                </p>

                <div class="hero-actions">
                    <a href="/tools" class="btn-dominant">
                        <span class="btn-text">Open Workspace</span>
                        <div class="btn-glow-intense"></div>
                    </a>
                    <a href="#popular-tools" class="btn-subtle">
                        Explore Suite
                    </a>
                </div>
            </div>

            <div class="hero-visual">
                <div class="hero-glass-panel">
                    <div class="panel-edge-highlight"></div>
                    <div class="panel-content">
                        <div class="status-ring">
                            <div class="core-pulse"></div>
                        </div>
                        <h3 class="panel-title">End-to-End Privacy</h3>
                        <p class="panel-desc">All computations happen locally on your device.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ⚡ TENSION BENTO GRID -->
    <section class="bento-product-section section-spacer-xxl" id="popular-tools">
        <div class="container">
            <div class="section-intro">
                <h2 class="section-heading">The Core <span class="text-accent">Suite.</span></h2>
                <p class="section-subheading">A meticulously crafted collection of essential utilities.</p>
            </div>
            
            <div class="tension-grid stagger-container">
                <!-- CARD 1: FEATURED (Larger, Spans 2 Cols) -->
                <a href="/compress-image" class="tension-card featured-card stagger-item">
                    <div class="card-edge-highlight"></div>
                    <div class="card-inner">
                        <div class="card-icon blue-gradient">📸</div>
                        <div class="card-text">
                            <h3>Image Compressor Pro</h3>
                            <p>Hit exact 20KB or 50KB targets effortlessly. The most powerful local compression engine on the web.</p>
                        </div>
                        <span class="card-arrow">→</span>
                    </div>
                    <div class="card-ambient-glow"></div>
                </a>

                <!-- CARD 2: TINTED (Slight gradient background) -->
                <a href="/official-passport-photo-maker" class="tension-card tinted-card stagger-item">
                    <div class="card-edge-highlight"></div>
                    <div class="card-inner">
                        <div class="card-icon purple-gradient">🛂</div>
                        <h3>Passport Studio</h3>
                        <p>Generate perfect Visa and Passport photos aligned to global standards.</p>
                        <span class="card-arrow">→</span>
                    </div>
                </a>

                <!-- CARD 3: GLOWING (Stronger hover glow) -->
                <a href="/merge-pdf" class="tension-card glowing-card stagger-item">
                    <div class="card-edge-highlight"></div>
                    <div class="card-inner">
                        <div class="card-icon orange-gradient">📄</div>
                        <h3>PDF Master</h3>
                        <p>Merge, split, and rotate confidential PDF documents securely.</p>
                        <span class="card-arrow">→</span>
                    </div>
                </a>

                <!-- CARD 4: STANDARD -->
                <a href="/signature-maker" class="tension-card standard-card stagger-item">
                    <div class="card-edge-highlight"></div>
                    <div class="card-inner">
                        <div class="card-icon green-gradient">✍️</div>
                        <h3>E-Signatures</h3>
                        <p>Draw transparent, high-resolution digital signatures for legal use.</p>
                        <span class="card-arrow">→</span>
                    </div>
                </a>
            </div>
        </div>
    </section>

    <script is:inline>
        // Staggered Entrance
        const observerOptions = { threshold: 0.1, rootMargin: '0px 0px -50px 0px' };
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('visible');
                    observer.unobserve(entry.target);
                }
            });
        }, observerOptions);

        document.querySelectorAll('.stagger-item').forEach(el => observer.observe(el));
    </script>

</BaseLayout>

<style>
/* ───── PRODUCT HERO ───── */
.product-hero {
    position: relative;
    padding: 200px 0 160px;
    background: transparent;
    overflow: hidden;
    min-height: 95vh;
    display: flex;
    align-items: center;
}

.hero-light-beam {
    position: absolute;
    top: -20%; left: 10%;
    width: 60vw; height: 100vh;
    background: radial-gradient(ellipse at 50% 0%, var(--accent-glow) 0%, transparent 70%);
    transform: rotate(-15deg);
    pointer-events: none;
    z-index: 0;
    opacity: 0.8;
}

.hero-ambient-blob {
    position: absolute;
    bottom: -10%; right: -10%;
    width: 800px; height: 800px;
    background: var(--accent-soft);
    border-radius: 50%;
    filter: blur(120px);
    animation: blobBreathe 15s ease-in-out infinite alternate;
    z-index: 0;
    pointer-events: none;
}
@keyframes blobBreathe { 0% { transform: scale(1) translate(0, 0); } 100% { transform: scale(1.1) translate(-50px, -50px); } }

.hero-content-grid {
    display: grid; grid-template-columns: 1.2fr 0.8fr; gap: 60px;
    align-items: center; position: relative; z-index: 10;
}

.brand-eyebrow {
    display: inline-flex; align-items: center; gap: 12px;
    font-size: 0.85rem; font-weight: 800; text-transform: uppercase;
    letter-spacing: 0.15em; color: var(--text-secondary);
    margin-bottom: 24px;
}
.eyebrow-dot { width: 6px; height: 6px; background: var(--accent-primary); border-radius: 50%; box-shadow: 0 0 10px var(--accent-primary); }

.hero-display {
    font-size: clamp(3rem, 7vw, 5rem);
    font-weight: 800; line-height: 1; letter-spacing: -0.04em;
    margin-bottom: 32px; color: var(--text-primary);
}

.word-dominant {
    display: block;
    font-size: clamp(4rem, 10vw, 7.5rem);
    font-weight: 900;
    letter-spacing: -0.06em;
    background: var(--accent-gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    filter: drop-shadow(0 0 30px var(--accent-glow));
    line-height: 1;
    margin-top: 8px;
}

.hero-lead {
    font-size: 1.4rem; line-height: 1.6; color: var(--text-secondary);
    max-width: 540px; margin-bottom: 48px; font-weight: 500;
}

/* ───── HERO ACTIONS ───── */
.hero-actions { display: flex; gap: 20px; align-items: center; }

.btn-dominant {
    position: relative;
    padding: 22px 56px;
    background: var(--accent-gradient);
    color: #ffffff !important;
    border-radius: 12px;
    font-weight: 800; font-size: 1.2rem;
    overflow: visible; z-index: 1;
    border: 1px solid rgba(255,255,255,0.2);
    transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
}
.btn-dominant:hover { transform: scale(1.05); }
.btn-dominant:active { transform: scale(0.98); }

.btn-glow-intense {
    position: absolute; inset: -4px;
    background: var(--accent-gradient); filter: blur(20px);
    opacity: 0.6; z-index: -1; border-radius: inherit;
    animation: intenseGlow 3s infinite;
}
@keyframes intenseGlow { 0%, 100% { opacity: 0.5; transform: scale(1); } 50% { opacity: 0.8; transform: scale(1.05); } }

.btn-subtle {
    padding: 20px 48px; background: transparent; border: 1px solid var(--border-strong);
    color: var(--text-primary); border-radius: 12px; font-weight: 700; font-size: 1.1rem;
    transition: 0.3s;
}
.btn-subtle:hover { background: var(--surface-2); border-color: var(--text-secondary); }

/* ───── HERO VISUAL ───── */
.hero-glass-panel {
    background: var(--surface-gradient); border: 1px solid var(--card-border);
    border-radius: 24px; padding: 60px 40px; position: relative;
    box-shadow: var(--shadow-lift); overflow: hidden;
    transform: perspective(1000px) rotateY(-5deg) rotateX(5deg);
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
}
.hero-glass-panel:hover { transform: perspective(1000px) rotateY(0deg) rotateX(0deg) translateY(-10px); }

.panel-edge-highlight {
    position: absolute; top: 0; left: 0; right: 0; height: 1px;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.3), transparent);
}
.dark .panel-edge-highlight { background: linear-gradient(90deg, transparent, rgba(255,255,255,0.15), transparent); }

.status-ring { width: 80px; height: 80px; margin: 0 auto 32px; border-radius: 50%; border: 2px solid var(--border-strong); display: flex; align-items: center; justify-content: center; position: relative; }
.core-pulse { width: 30px; height: 30px; background: var(--accent-primary); border-radius: 50%; box-shadow: 0 0 20px var(--accent-primary); animation: corePulse 2s infinite; }
@keyframes corePulse { 0%, 100% { transform: scale(1); opacity: 1; } 50% { transform: scale(1.4); opacity: 0.4; } }

.panel-title { font-size: 1.8rem; font-weight: 800; margin-bottom: 12px; text-align: center; }
.panel-desc { font-size: 1.1rem; color: var(--text-secondary); text-align: center; }

/* ───── TENSION GRID (BREAKING MONOTONY) ───── */
.section-spacer-xxl { padding: 140px 0; }
.section-intro { margin-bottom: 80px; max-width: 600px; }
.section-heading { font-size: clamp(2.5rem, 5vw, 3.5rem); font-weight: 900; letter-spacing: -0.04em; margin-bottom: 16px; line-height: 1.1; }
.text-accent { color: var(--accent-primary); filter: drop-shadow(0 0 10px var(--accent-soft)); }
.section-subheading { font-size: 1.25rem; color: var(--text-secondary); }

.tension-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-auto-rows: minmax(300px, auto);
    gap: 32px;
}

/* Base Card */
.tension-card {
    position: relative; background: var(--surface-3); border-radius: 20px;
    text-decoration: none; display: flex; flex-direction: column; overflow: hidden;
    box-shadow: var(--shadow-medium); transition: 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    z-index: 1; border: 1px solid var(--card-border);
}

.card-edge-highlight { position: absolute; top: 0; left: 0; right: 0; height: 1px; background: linear-gradient(90deg, transparent, rgba(255,255,255,0.4), transparent); opacity: 0.5; z-index: 5; }
.dark .card-edge-highlight { background: linear-gradient(90deg, transparent, rgba(255,255,255,0.1), transparent); }

.card-inner { padding: 40px; position: relative; z-index: 2; height: 100%; display: flex; flex-direction: column; }
.card-icon { width: 64px; height: 64px; border-radius: 16px; display: flex; align-items: center; justify-content: center; font-size: 1.8rem; margin-bottom: 32px; border: 1px solid rgba(255,255,255,0.1); box-shadow: var(--shadow-soft); }

.blue-gradient { background: linear-gradient(135deg, #3b82f6, #2563eb); color: white; }
.purple-gradient { background: linear-gradient(135deg, #a855f7, #7e22ce); color: white; }
.orange-gradient { background: linear-gradient(135deg, #f97316, #ea580c); color: white; }
.green-gradient { background: linear-gradient(135deg, #10b981, #059669); color: white; }

.tension-card h3 { font-size: 1.6rem; margin-bottom: 12px; font-weight: 800; }
.tension-card p { font-size: 1.05rem; color: var(--text-secondary); line-height: 1.6; flex-grow: 1; }
.card-arrow { align-self: flex-end; font-size: 1.5rem; color: var(--text-muted); transition: 0.3s; transform: translateX(-10px); opacity: 0; }

.tension-card:hover { transform: translateY(-8px); box-shadow: var(--shadow-lift); }
.tension-card:hover .card-arrow { color: var(--accent-primary); transform: translateX(0); opacity: 1; }

/* VARIATIONS */
.featured-card {
    grid-column: span 2;
    background: linear-gradient(135deg, var(--surface-3) 0%, var(--surface-2) 100%);
    border-color: var(--border-strong);
}
.featured-card .card-inner { flex-direction: row; align-items: center; gap: 40px; }
.featured-card .card-icon { width: 80px; height: 80px; font-size: 2.5rem; margin-bottom: 0; flex-shrink: 0; }
.featured-card h3 { font-size: 2.2rem; }
.featured-card p { font-size: 1.2rem; }
.card-ambient-glow { position: absolute; inset: 0; background: radial-gradient(circle at 100% 100%, var(--accent-soft), transparent 60%); z-index: 1; pointer-events: none; opacity: 0; transition: 0.5s; }
.featured-card:hover .card-ambient-glow { opacity: 1; }

.tinted-card { background: linear-gradient(to bottom right, var(--surface-3), rgba(168, 85, 247, 0.03)); }

.glowing-card { position: relative; }
.glowing-card::after { content: ''; position: absolute; inset: -2px; background: var(--accent-gradient); border-radius: 22px; z-index: -1; opacity: 0; filter: blur(15px); transition: 0.4s; }
.glowing-card:hover::after { opacity: 0.6; }

@media (max-width: 1024px) {
    .tension-grid { grid-template-columns: 1fr 1fr; }
    .featured-card { grid-column: span 2; }
}

@media (max-width: 768px) {
    .hero-content-grid { grid-template-columns: 1fr; text-align: center; gap: 60px; }
    .hero-actions { flex-direction: column; justify-content: center; }
    .hero-display { font-size: 3.5rem; }
    .word-dominant { font-size: 4.5rem; margin-top: 0; }
    .hero-lead { margin-inline: auto; }
    .brand-eyebrow { justify-content: center; }
    
    .tension-grid { grid-template-columns: 1fr; }
    .featured-card { grid-column: span 1; }
    .featured-card .card-inner { flex-direction: column; align-items: flex-start; gap: 20px; }
    .card-arrow { align-self: flex-start; }
}

/* Stagger Animation */
.stagger-item { opacity: 0; transform: translateY(30px) scale(0.98); transition: all 0.6s cubic-bezier(0.22, 1, 0.36, 1); }
.stagger-item.visible { opacity: 1; transform: translateY(0) scale(1); }
</style>
