---
import BaseLayout from '../components/BaseLayout.astro';
import { SITE_URL } from '../seo';

const PAGE_TITLE = 'FormFix — Free Online Image Compressor, PDF Merger, Passport Photo Maker & 30+ Tools';
const PAGE_DESC = 'Compress images to 20KB, make passport photos, merge PDFs, create signatures, and use 30+ free browser tools. No uploads, no sign-up, 100% private.';
const PAGE_KEYWORDS = 'free online image compressor, compress image to 20kb, passport photo maker online free, pdf merger free, signature maker online, qr code generator, free browser tools, no upload tools, photo compressor online, image resizer, formfix';

const faqs = [
  {
    q: 'Is FormFix really 100% private?',
    a: 'Yes. Every tool runs entirely in your browser using JavaScript and WebAssembly. Your files never leave your device — no uploads to any server.',
  },
  {
    q: 'Do I need to create an account?',
    a: 'No. FormFix requires no registration, no email, and no login. Just open the tool and use it instantly.',
  },
  {
    q: 'Are FormFix tools really free?',
    a: 'Yes, all 30+ tools are completely free with no hidden paywalls, watermarks, or premium tiers.',
  },
  {
    q: 'Which image formats are supported?',
    a: 'JPG, PNG, and WebP are supported for compression, conversion, resizing, and editing.',
  },
  {
    q: 'Can I compress an image to exactly 20KB?',
    a: 'Yes. Our smart compressor uses a binary-search algorithm to hit exact file size targets like 20KB, 50KB, or 100KB.',
  },
];

const customSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      name: 'FormFix — Free Online Image, PDF & Document Tools',
      description: PAGE_DESC,
      url: SITE_URL,
      applicationCategory: 'MultimediaApplication',
      operatingSystem: 'All',
      browserRequirements: 'Requires JavaScript. Requires HTML5.',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      featureList: [
        'Image Compression',
        'Passport Photo Maker',
        'PDF Merge & Split',
        'Digital Signature Maker',
        'QR Code Generator',
        'Background Remover',
        'Photo to Sketch',
        'Resume Builder',
      ],
    },
  ],
};
---

<BaseLayout
    title={PAGE_TITLE}
    description={PAGE_DESC}
    keywords={PAGE_KEYWORDS}
    customSchema={customSchema}
    active="home"
    canonicalPath="/"
    faq={faqs}
>

    <section class="hero" aria-labelledby="hero-title">
        <div class="container">
            <h1 class="hero-title" id="hero-title">
                Compress, crop, merge &mdash; right in your browser.
            </h1>
            <p class="hero-desc">
                FormFix runs entirely on your device. Your files never get uploaded anywhere.
                No account. No watermark. No catch.
            </p>
            <div class="hero-actions">
                <a href="/tools" class="btn-primary">Browse All Tools</a>
            </div>
        </div>
    </section>

    <section class="tools-section" id="tools" aria-labelledby="tools-title">
        <div class="container">
            <h2 class="section-title" id="tools-title">What people actually use</h2>

            <div class="tools-grid">
                <a href="/compress-image" class="tool-card">
                    <div class="tool-card-icon">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
                    </div>
                    <h3>Image Compressor</h3>
                    <p>Hit exact 20KB or 50KB targets. Used for government form uploads.</p>
                </a>

                <a href="/passport-size-photo" class="tool-card">
                    <div class="tool-card-icon">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
                    </div>
                    <h3>Passport Photo</h3>
                    <p>3.5x4.5cm photos with white background. Meets SSC, UPSC specs.</p>
                </a>

                <a href="/merge-pdf" class="tool-card">
                    <div class="tool-card-icon">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="12" y1="18" x2="12" y2="12"/><line x1="9" y1="15" x2="15" y2="15"/></svg>
                    </div>
                    <h3>Merge PDF</h3>
                    <p>Combine multiple PDFs into one. Drag to reorder. Stays on your machine.</p>
                </a>

                <a href="/signature-maker" class="tool-card">
                    <div class="tool-card-icon">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z"/></svg>
                    </div>
                    <h3>Signature Maker</h3>
                    <p>Draw or type a signature. Export transparent PNG for documents.</p>
                </a>

                <a href="/crop-image" class="tool-card">
                    <div class="tool-card-icon">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6.13 1L6 16a2 2 0 0 0 2 2h15"/><path d="M1 6.13L16 6a2 2 0 0 1 2 2v15"/></svg>
                    </div>
                    <h3>Crop Image</h3>
                    <p>Precise cropping with ratio presets. Free aspect ratio.</p>
                </a>

                <a href="/background-remover" class="tool-card">
                    <div class="tool-card-icon">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
                    </div>
                    <h3>Background Remover</h3>
                    <p>Remove solid backgrounds from photos. Runs locally.</p>
                </a>

                <a href="/qr-code-generator" class="tool-card">
                    <div class="tool-card-icon">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="8" height="8" rx="1"/><rect x="14" y="2" width="8" height="8" rx="1"/><rect x="2" y="14" width="8" height="8" rx="1"/><rect x="14" y="14" width="4" height="4" rx="1"/><line x1="22" y1="18" x2="22" y2="22"/><line x1="18" y1="22" x2="22" y2="22"/></svg>
                    </div>
                    <h3>QR Code Generator</h3>
                    <p>Create permanent QR codes. No expiration, works offline.</p>
                </a>

                <a href="/image-to-text" class="tool-card">
                    <div class="tool-card-icon">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="4 7 4 4 20 4 20 7"/><line x1="9" y1="20" x2="15" y2="20"/><line x1="12" y1="4" x2="12" y2="20"/></svg>
                    </div>
                    <h3>Image to Text (OCR)</h3>
                    <p>Extract text from images using on-device OCR.</p>
                </a>
            </div>

            <div class="tools-more">
                <a href="/tools" class="link-arrow">See all 30+ tools &rarr;</a>
            </div>
        </div>
    </section>

    <section class="faq-section" aria-labelledby="faq-title">
        <div class="container">
            <h2 class="section-title" id="faq-title">Common questions</h2>
            <div class="faq-list">
                {faqs.map(({ q, a }) => (
                    <details class="faq-item">
                        <summary>{q}</summary>
                        <p>{a}</p>
                    </details>
                ))}
            </div>
        </div>
    </section>

    <section class="guides-section" aria-labelledby="guides-title">
        <div class="container">
            <h2 class="section-title" id="guides-title">Read the guides</h2>
            <div class="guides-grid">
                <a href="/guides/how-to-compress-image-to-20kb" class="guide-card">
                    <h3>How to compress to 20KB</h3>
                    <p>For UPSC, SSC, and bank form uploads.</p>
                </a>
                <a href="/guides/passport-photo-specifications" class="guide-card">
                    <h3>Passport photo specs</h3>
                    <p>Dimensions and requirements for government forms.</p>
                </a>
                <a href="/guides/make-signature-transparent" class="guide-card">
                    <h3>Transparent signatures</h3>
                    <p>How to make your signature background transparent.</p>
                </a>
                <a href="/guides/secure-pdf-merging-offline" class="guide-card">
                    <h3>Why merge PDFs offline</h3>
                    <p>Browser-based tools vs cloud alternatives.</p>
                </a>
            </div>
        </div>
    </section>

</BaseLayout>

<style>
.hero {
    padding: 100px 0 72px;
    text-align: center;
}
.hero-title {
    font-size: clamp(1.8rem, 5vw, 3rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.15;
    max-width: 640px;
    margin: 0 auto 16px;
}
.hero-desc {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--text-secondary);
    max-width: 480px;
    margin: 0 auto 28px;
}
.hero-actions {
    display: flex;
    justify-content: center;
    gap: 10px;
}
.btn-primary {
    display: inline-flex;
    align-items: center;
    padding: 10px 24px;
    background: var(--accent-primary);
    color: #fff;
    border-radius: var(--radius-sm);
    font-weight: 500;
    font-size: 0.9rem;
    text-decoration: none;
}
.btn-primary:hover {
    background: var(--accent-hover);
    color: #fff;
}

.tools-section { padding: 48px 0 72px; }
.section-title {
    font-size: 1.1rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    margin-bottom: 24px;
    color: var(--text-primary);
}
.tools-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
}
.tool-card {
    background: var(--surface-2);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 20px;
    text-decoration: none;
}
.tool-card:hover {
    border-color: var(--border-strong);
}
.tool-card-icon {
    width: 36px;
    height: 36px;
    background: var(--accent-soft);
    color: var(--accent-primary);
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 12px;
}
.tool-card h3 {
    font-size: 0.9rem;
    font-weight: 600;
    margin-bottom: 4px;
    color: var(--text-primary);
}
.tool-card p {
    font-size: 0.78rem;
    line-height: 1.5;
    color: var(--text-muted);
    margin: 0;
}
.tools-more {
    margin-top: 20px;
    text-align: center;
}
.link-arrow {
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--accent-primary);
    text-decoration: none;
}
.link-arrow:hover { text-decoration: underline; }

.faq-section { padding: 48px 0 72px; }
.faq-list { display: flex; flex-direction: column; gap: 6px; max-width: 640px; }
.faq-item {
    background: var(--surface-2);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    padding: 0;
}
.faq-item summary {
    padding: 14px 16px;
    font-weight: 500;
    font-size: 0.9rem;
    cursor: pointer;
    color: var(--text-primary);
    list-style: none;
}
.faq-item summary::before {
    content: '+';
    margin-right: 10px;
    color: var(--text-muted);
    font-weight: 400;
}
.faq-item[open] summary::before { content: '\2212'; }
.faq-item p {
    padding: 0 16px 14px;
    font-size: 0.85rem;
    line-height: 1.6;
    color: var(--text-secondary);
}

.guides-section { padding: 48px 0 80px; }
.guides-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
}
.guide-card {
    background: var(--surface-2);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 20px;
    text-decoration: none;
}
.guide-card:hover {
    border-color: var(--border-strong);
}
.guide-card h3 {
    font-size: 0.9rem;
    font-weight: 600;
    margin-bottom: 4px;
    color: var(--text-primary);
}
.guide-card p {
    font-size: 0.78rem;
    color: var(--text-muted);
    margin: 0;
    line-height: 1.5;
}

@media (max-width: 960px) {
    .tools-grid { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 640px) {
    .hero { padding: 72px 0 56px; }
    .tools-grid { grid-template-columns: 1fr; }
    .guides-grid { grid-template-columns: 1fr; }
}
</style>
