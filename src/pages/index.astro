---
import BaseLayout from '../components/BaseLayout.astro';

const PAGE_TITLE = 'FormFix - 100% Private Image Compressor, Passport Photo Maker & PDF Tools';
const PAGE_DESC = 'The safest way to prepare official documents. 100% private image compressor, global passport photo maker, signature resizer, and PDF tools. No server uploads.';
const PAGE_KEYWORDS = 'image compressor to 20kb, professional photo resizer, global passport maker, signature maker online, merge pdf online free, formfix private tools';

const customSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "name": "FormFix - Free Online Tool Hub",
      "url": "https://formfix.pages.dev/",
      "applicationCategory": "MultimediaApplication",
      "operatingSystem": "Any",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      },
      "description": "FormFix is a free, private digital toolkit for images, PDFs, and utilities. 100% privacy with zero server uploads. Features high-quality photo resizer, PDF tools, and 30+ other free utilities.",
      "featureList": [
        "Compress image to exact KB size (20KB, 50KB, 100KB)",
        "100% Private local browser processing",
        "Complete PDF Suite (Merge, Split, Rotate)",
        "QR Code & Digital Signature Maker",
        "AI-powered Background Remover & OCR"
      ]
    },
    {
      "@type": "Organization",
      "url": "https://formfix.pages.dev/",
      "logo": "https://formfix.pages.dev/favicon.png?v=5",
      "name": "FormFix",
      "contactPoint": {
        "@type": "ContactPoint",
        "email": "formfix.support@gmail.com",
        "contactType": "customer support"
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is the best and most private free image compressor?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "FormFix is widely considered the best multi-tool because it processes images 100% completely offline in your browser. Unlike other online tools, FormFix never uploads your sensitive data to cloud servers. This guarantees ultimate privacy while compressing photos to exact targets like 20KB or 50KB."
          }
        },
        {
          "@type": "Question",
          "name": "How can I resize a photo to 2x2 inches for a US visa?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Our Global Passport Studio supports US 2x2 inch standards perfectly. Simply upload your photo, select the US Passport preset, and our tool will handle the DPI and dimension conversion locally in your browser."
          }
        },
        {
          "@type": "Question",
          "name": "Is it safe to merge PDF files online?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "With FormFix, it is 100% safe. We use client-side PDF libraries, meaning the merging happens on your computer, not our server. Your private documents are never seen by us or stored anywhere."
          }
        }
      ]
    }
  ]
};

const faqs = customSchema["@graph"][2].mainEntity.map(q => ({ q: q.name, a: q.acceptedAnswer.text }));
---

<BaseLayout title={PAGE_TITLE} description={PAGE_DESC} keywords={PAGE_KEYWORDS} customSchema={customSchema}>
    
    <!-- 🚀 GLOBAL HERO -->
    <section class="saas-hero">
        <div class="container hero-content-grid">
            <div class="hero-text-wrap animate-in">
                <div class="badge-row">
                    <span class="premium-badge"><span class="icon">✨</span> 100% Private & Browser-Based</span>
                </div>
                <h1>
                    Professional Digital Toolkit <br />
                    <span class="text-gradient">For Every Requirement.</span>
                </h1>
                
                <p class="hero-subtitle">
                    A professional-grade toolkit that processes your files securely in your browser. Global Standard Sizes for web portals.
                </p>

                <div class="hero-cta-box mt-32 animate-in delay-100">
                    <a href="/tools" class="primary-btn hero-btn btn-elevate">
                        Open Digital Workspace <span class="btn-arrow">→</span>
                    </a>
                    <div class="hero-trust-marquee mt-24">
                        <span class="trust-label">Optimized for:</span>
                        <div class="trust-tags">
                            <a href="/compress-image-to-20kb" class="t-tag">20KB/50KB</a>
                            <a href="/resize-image-for-linkedin" class="t-tag">LinkedIn</a>
                            <a href="/resize-image-for-instagram" class="t-tag">Instagram</a>
                            <a href="/official-passport-photo-maker" class="t-tag">Global Passports</a>
                            <a href="/signature-maker" class="t-tag">E-Signatures</a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="hero-visual animate-in delay-200">
                <div class="product-preview-card box-depth signature-card" id="demo-card">
                    <div class="preview-header">
                        <div class="window-dots">
                            <span class="dot-red"></span>
                            <span class="dot-yellow"></span>
                            <span class="dot-green"></span>
                        </div>
                    </div>
                    
                    <!-- DEFAULT STATE -->
                    <div class="preview-body" id="demo-default">
                        <div class="preview-upload-zone" id="demo-drop">
                            <div class="upload-icon-circle">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
                            </div>
                            <h3>Drag document here</h3>
                            <p>or click to select file</p>
                            <span class="tiny-text">Max size 25MB • Secure Local Processing</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ⚡ CORE FEATURES GRID -->
    <section class="tools-grid-section section-spacer" id="popular-tools">
        <div class="container">
            <div class="section-title-wrap center">
                <div class="sub-label">Instant Access</div>
                <h2>The Essentials</h2>
            </div>
            
            <div class="bento-grid">
                <a href="/compress-image" class="bento-card tool-card animate-in">
                    <div class="card-icon blue">📸</div>
                    <h3>Image Compressor</h3>
                    <p>Reduce file size without losing sharpness. Target 20KB, 50KB, or custom targets.</p>
                </a>
                <a href="/official-passport-photo-maker" class="bento-card tool-card animate-in delay-50">
                    <div class="card-icon purple">🛂</div>
                    <h3>Passport Studio</h3>
                    <p>US, UK, EU, and Global ID photo maker with precise alignment guides.</p>
                </a>
                <a href="/merge-pdf" class="bento-card tool-card animate-in delay-100">
                    <div class="card-icon orange">📄</div>
                    <h3>PDF Toolkit</h3>
                    <p>Merge, Split, and Rotate PDFs 100% locally on your computer.</p>
                </a>
                <a href="/signature-maker" class="bento-card tool-card animate-in delay-150">
                    <div class="card-icon green">✍️</div>
                    <h3>Signature Maker</h3>
                    <p>Draw or type your digital signature with professional transparency.</p>
                </a>
            </div>
        </div>
    </section>

    <!-- 🌍 GLOBAL SEO DISCOVERY FOOTER -->
    <section class="niche-tools-section">
        <div class="container">
            <div class="discovery-grid">
                <div class="discovery-col">
                    <h4>Global Essentials</h4>
                    <div class="discovery-links">
                        <a href="/compress-image" class="text-link">Smart Compressor</a>
                        <a href="/resize-image-for-linkedin" class="text-link">LinkedIn Profile</a>
                        <a href="/resize-image-for-instagram" class="text-link">Instagram Square</a>
                        <a href="/resize-image-for-us-passport" class="text-link">US Passport (2x2")</a>
                    </div>
                </div>

                <div class="discovery-col">
                    <h4>Standardized Sizes</h4>
                    <div class="discovery-links">
                        <a href="/official-passport-photo-maker" class="text-link">Global Passport Studio</a>
                        <a href="/compress-image-to-20kb" class="text-link">Compress to 20KB</a>
                        <a href="/signature-maker" class="text-link">E-Signature Tool</a>
                        <a href="/qr-code-generator" class="text-link">QR Code Generator</a>
                    </div>
                </div>

                <div class="discovery-col">
                    <h4>Technical Guides</h4>
                    <div class="discovery-links">
                        <a href="/blog/how-to-compress-image-to-20kb" class="text-link">How to hit 20KB exactly</a>
                        <a href="/blog/best-image-size-for-online-forms" class="text-link">Portal Dimension Guide</a>
                        <a href="/blog/reduce-image-size-without-losing-quality" class="text-link">Compression Secrets</a>
                        <a href="/guides/make-signature-transparent" class="text-link">Clear Signature Guide</a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- 📣 SPREAD THE WORD -->
    <section class="share-section section-spacer bg-app">
        <div class="container text-center">
            <div class="share-card box-depth p-48 br-24">
                <h2 class="mb-16">Love FormFix? Help others find us!</h2>
                <p class="text-muted mb-32 max-600 mx-auto">We spend $0 on marketing to keep this tool free and private. If you found it useful, please share it with your friends or colleagues.</p>
                <div class="share-buttons">
                    <a href="https://twitter.com/intent/tweet?text=Check%20out%20FormFix%20%E2%80%94%20the%20most%20private%20way%20to%20compress%20images%2C%20merge%20PDFs%2C%20and%20more.%20100%25%20browser-based.%20%23Privacy%20%23TechTools&url=https%3A%2F%2Fformfix.pages.dev" target="_blank" class="share-btn twitter">Share on X</a>
                    <a href="https://www.reddit.com/submit?url=https://formfix.pages.dev&title=A%20100%25%20private%2C%20zero-upload%20digital%20toolkit%20for%20everyone." target="_blank" class="share-btn reddit">Share on Reddit</a>
                    <a href="https://wa.me/?text=I%20found%20this%20amazing%20private%20tool%20to%20compress%20images%20and%20edit%20PDFs%20without%20uploading%20anything.%20Check%20it%20out:%20https://formfix.pages.dev" target="_blank" class="share-btn whatsapp">Share on WhatsApp</a>
                </div>
            </div>
        </div>
    </section>

    <!-- ❓ FAQS -->
    <section class="faq-section section-spacer" id="faq">
        <div class="container">
            <div class="section-title-wrap center">
                <h2>Frequently Asked Questions</h2>
            </div>
            <div class="faq-list">
                {faqs.map(item => (
                    <details class="minimal-faq">
                        <summary>{item.q} <span class="indicator">+</span></summary>
                        <div class="faq-body">
                            <p>{item.a}</p>
                        </div>
                    </details>
                ))}
            </div>
        </div>
    </section>

</BaseLayout>

<style>
/* ───── CORE LAYOUT OVERRIDES ───── */
.section-spacer { padding: 80px 0; }
.section-spacer-sm { padding: 80px 0; }
.mt-48 { margin-top: 48px; }

.section-title-wrap { margin-bottom: 48px; }
.section-title-wrap.center { text-align: center; }
.section-title-wrap h2 { font-size: 2.25rem; font-weight: 800; letter-spacing: -0.04em; margin-bottom: 12px; }

.btn-arrow { margin-left: 8px; font-weight: 400; transition: margin 0.2s; }
.hero-btn:hover .btn-arrow { margin-left: 12px; }

/* ───── CORE LAYOUT OVERRIDES ───── */
.saas-hero {
    position: relative;
    padding: 120px 0 100px;
    background: #fff;
    overflow: hidden;
}

.hero-content-grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 64px;
    align-items: center;
}

.hero-text-wrap h1 {
    font-size: clamp(2.5rem, 6vw, 4rem);
    font-weight: 900;
    line-height: 1.05;
    letter-spacing: -0.05em;
    margin-bottom: 24px;
    color: #111;
}

.hero-subtitle {
    font-size: 1.25rem;
    color: #555;
    line-height: 1.6;
    max-width: 540px;
    margin-bottom: 32px;
}

/* Tool Cards */
.bento-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 24px;
}

.bento-card {
    background: #fff;
    border: 1px solid rgba(0,0,0,0.06);
    padding: 32px;
    border-radius: 24px;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    text-decoration: none;
    color: inherit;
}

.bento-card:hover {
    transform: translateY(-8px);
    border-color: #4f46e5;
    box-shadow: 0 20px 40px -15px rgba(0,0,0,0.1);
}

.card-icon {
    font-size: 2.5rem;
    margin-bottom: 20px;
}

/* Niche Discovery Grid */
.niche-tools-section {
    background: #fafafa;
    border-top: 1px solid #f0f0f0;
    padding: 80px 0;
}

.discovery-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 48px;
}

.discovery-col h4 {
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #999;
    margin-bottom: 24px;
}

.discovery-links {
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.text-link {
    color: #333;
    text-decoration: none;
    font-weight: 600;
    font-size: 1.05rem;
    transition: color 0.2s;
}

.text-link:hover {
    color: #4f46e5;
}

@media (max-width: 968px) {
    .hero-content-grid { grid-template-columns: 1fr; text-align: center; gap: 48px; }
    .hero-text-wrap h1 { margin-inline: auto; }
    .hero-subtitle { margin-inline: auto; }
    .discovery-grid { grid-template-columns: 1fr; gap: 32px; }
}
</style>
