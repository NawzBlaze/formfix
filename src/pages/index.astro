---
import BaseLayout from '../components/BaseLayout.astro';

const PAGE_TITLE = 'FormFix - 100% Private Image Compressor, Passport Photo Maker & PDF Tools';
const PAGE_DESC = 'The safest way to prepare official documents. 100% private image compressor, global passport photo maker, signature resizer, and PDF tools. No server uploads.';
---

<BaseLayout title={PAGE_TITLE} description={PAGE_DESC}>
    
    <!-- 🚀 IMPACT-TIER HERO -->
    <section class="impact-hero">
        <!-- Breathing Atmosphere -->
        <div class="hero-atmosphere"></div>
        <div class="hero-focal-glow"></div>
        
        <div class="container hero-content-grid">
            <div class="hero-text-wrap">
                <div class="status-indicator-pill">
                    <span class="pulse-dot"></span> 
                    Local Processing Active
                </div>
                
                <h1 class="impact-title">
                    Digital Utility <br />
                    <span class="animated-gradient-text">Mastered.</span>
                </h1>
                
                <p class="hero-subtitle-impact">
                    Experience a fast, intelligent workspace designed for privacy. Your files never leave your device.
                </p>

                <div class="hero-cta-group-impact">
                    <a href="/tools" class="impact-btn-primary pulse-loop">
                        <span>Get Started Free</span>
                    </a>
                    <a href="#popular-tools" class="impact-btn-secondary">
                        View Tool Suite
                    </a>
                </div>
            </div>

            <div class="hero-visual-impact">
                <div class="glass-orb-container">
                    <div class="orb orb-1"></div>
                    <div class="orb orb-2"></div>
                    <div class="visual-card box-depth">
                        <div class="card-lighting"></div>
                        <div class="icon-pulse">
                            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                        </div>
                        <h3>End-to-End Privacy</h3>
                        <p>Browser-level Encryption</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ⚡ STAGGERED BENTO GRID -->
    <section class="bento-impact-section section-spacer-xl" id="popular-tools">
        <div class="container">
            <div class="section-intro center">
                <span class="tag-label">The Professional Suite</span>
                <h2 class="impact-section-title">Built for Performance.</h2>
            </div>
            
            <div class="impact-grid stagger-container">
                <a href="/compress-image" class="impact-card stagger-item">
                    <div class="card-rim"></div>
                    <div class="impact-card-body">
                        <div class="tool-icon-circle blue">📸</div>
                        <h3>Image Compressor</h3>
                        <p>Hit exact 20KB/50KB targets with instant local processing.</p>
                        <span class="learn-more">Open Workspace →</span>
                    </div>
                </a>

                <a href="/official-passport-photo-maker" class="impact-card stagger-item">
                    <div class="card-rim"></div>
                    <div class="impact-card-body">
                        <div class="tool-icon-circle purple">🛂</div>
                        <h3>Passport Studio</h3>
                        <p>AI-guided alignment for Global ID and Visa requirements.</p>
                        <span class="learn-more">Open Workspace →</span>
                    </div>
                </a>

                <a href="/merge-pdf" class="impact-card stagger-item">
                    <div class="card-rim"></div>
                    <div class="impact-card-body">
                        <div class="tool-icon-circle orange">📄</div>
                        <h3>PDF Master</h3>
                        <p>Merge, Split, and Rotate PDF files 100% securely.</p>
                        <span class="learn-more">Open Workspace →</span>
                    </div>
                </a>

                <a href="/signature-maker" class="impact-card stagger-item">
                    <div class="card-rim"></div>
                    <div class="impact-card-body">
                        <div class="tool-icon-circle green">✍️</div>
                        <h3>E-Signatures</h3>
                        <p>Draw or type high-fidelity digital signatures instantly.</p>
                        <span class="learn-more">Open Workspace →</span>
                    </div>
                </a>
            </div>
        </div>
    </section>

    <script is:inline>
        // Staggered Entrance Observer
        const observerOptions = { threshold: 0.1 };
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('visible');
                }
            });
        }, observerOptions);

        document.querySelectorAll('.stagger-item').forEach(el => observer.observe(el));
    </script>

</BaseLayout>

<style>
/* ───── IMPACT HERO ───── */
.impact-hero {
    position: relative;
    padding: 180px 0 160px;
    background: var(--surface-1);
    overflow: hidden;
}

.hero-atmosphere {
    position: absolute; inset: 0;
    background: linear-gradient(-45deg, var(--surface-1), var(--accent-soft), var(--surface-1));
    background-size: 400% 400%;
    animation: atmosphereShift 15s ease infinite;
    z-index: 0; opacity: 0.6;
}
@keyframes atmosphereShift { 0% { background-position: 0% 50%; } 50% { background-position: 100% 50%; } 100% { background-position: 0% 50%; } }

.hero-focal-glow {
    position: absolute; top: 0%; left: 50%; transform: translateX(-50%);
    width: 100%; height: 100%;
    background: radial-gradient(circle at 50% 30%, var(--accent-glow) 0%, transparent 60%);
    z-index: 1; pointer-events: none; opacity: 0.5;
}

.hero-content-grid {
    display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 80px;
    align-items: center; position: relative; z-index: 10;
}

.status-indicator-pill {
    display: inline-flex; align-items: center; gap: 10px;
    padding: 10px 20px; background: var(--surface-2); border: 1px solid var(--border-subtle);
    border-radius: var(--radius-full); font-size: 0.8rem; font-weight: 800; color: var(--text-primary);
    text-transform: uppercase; letter-spacing: 0.15em; margin-bottom: 32px;
}
.pulse-dot { width: 8px; height: 8px; background: #10b981; border-radius: 50%; box-shadow: 0 0 12px #10b981; animation: glow-pulse 2s infinite; }
@keyframes glow-pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.4; } }

.impact-title {
    font-size: clamp(3rem, 9vw, 5.5rem); font-weight: 900; line-height: 0.9;
    letter-spacing: -0.06em; margin-bottom: 24px;
}

.animated-gradient-text {
    background: linear-gradient(135deg, #4f46e5, #a855f7, #4f46e5);
    background-size: 200% auto;
    -webkit-background-clip: text; -webkit-text-fill-color: transparent;
    animation: gradientFlow 5s linear infinite;
}
@keyframes gradientFlow { 0% { background-position: 0% center; } 100% { background-position: 200% center; } }

.hero-subtitle-impact {
    font-size: 1.4rem; line-height: 1.6; color: var(--text-secondary);
    max-width: 580px; margin-bottom: 48px; font-weight: 500;
}

/* ───── IMPACT BUTTONS ───── */
.hero-cta-group-impact { display: flex; gap: 24px; }

.impact-btn-primary {
    padding: 20px 48px; background: var(--accent-gradient); color: #fff;
    border-radius: var(--radius-md); font-weight: 800; font-size: 1.15rem;
    transition: 0.4s; box-shadow: var(--shadow-medium);
}
.impact-btn-primary:hover { transform: translateY(-4px) scale(1.02); box-shadow: var(--shadow-lift); }

.pulse-loop { animation: pulseLoop 3s infinite; }
@keyframes pulseLoop { 0%, 100% { box-shadow: 0 0 0 0 var(--accent-glow); } 50% { box-shadow: 0 0 30px 10px var(--accent-glow); } }

.impact-btn-secondary {
    padding: 20px 48px; background: transparent; border: 2px solid var(--border-strong);
    color: var(--text-primary); border-radius: var(--radius-md); font-weight: 800;
    transition: 0.3s;
}
.impact-btn-secondary:hover { background: var(--surface-2); border-color: var(--accent-primary); color: var(--accent-primary); }

/* ───── IMPACT GRID ───── */
.section-intro { margin-bottom: 80px; }
.tag-label { font-weight: 800; text-transform: uppercase; color: var(--accent-primary); letter-spacing: 0.2em; font-size: 0.85rem; margin-bottom: 12px; display: block; }
.impact-section-title { font-size: 3.5rem; font-weight: 900; letter-spacing: -0.05em; }

.impact-grid {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 32px;
}

.impact-card {
    background: var(--surface-3); border-radius: var(--radius-lg); overflow: hidden;
    position: relative; transition: 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: var(--shadow-medium); text-decoration: none;
}

.impact-card:hover { transform: translateY(-12px) scale(1.02); box-shadow: var(--shadow-lift); }

.card-rim {
    position: absolute; inset: 0; border: 1px solid transparent; border-radius: var(--radius-lg);
    background: linear-gradient(135deg, var(--accent-primary), transparent) border-box;
    -webkit-mask: linear-gradient(#fff 0 0) padding-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor; mask-composite: exclude; opacity: 0.05; transition: 0.3s;
}
.impact-card:hover .card-rim { opacity: 0.8; }

.impact-card-body { padding: 48px; position: relative; z-index: 10; }
.tool-icon-circle {
    width: 64px; height: 64px; background: var(--surface-2); border-radius: 20px;
    display: flex; align-items: center; justify-content: center; font-size: 2rem; margin-bottom: 32px;
    transition: 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}
.impact-card:hover .tool-icon-circle { transform: scale(1.2) rotate(5deg); background: var(--accent-soft); }

.impact-card h3 { font-size: 1.8rem; font-weight: 850; margin-bottom: 16px; color: var(--text-primary); }
.impact-card p { font-size: 1.1rem; line-height: 1.6; color: var(--text-secondary); margin-bottom: 32px; }

.learn-more { font-weight: 800; color: var(--accent-primary); font-size: 1rem; opacity: 0; transform: translateX(-10px); transition: 0.3s; display: block; }
.impact-card:hover .learn-more { opacity: 1; transform: translateX(0); }

@media (max-width: 968px) {
    .hero-content-grid { grid-template-columns: 1fr; text-align: center; gap: 48px; }
    .hero-cta-group-impact { flex-direction: column; }
    .hero-subtitle-impact { margin-inline: auto; }
}
</style>
