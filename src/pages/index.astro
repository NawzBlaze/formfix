---
import BaseLayout from '../components/BaseLayout.astro';

const PAGE_TITLE = 'FormFix - 100% Private Image Compressor, Passport Photo Maker & PDF Tools';
const PAGE_DESC = 'The safest way to prepare official documents. 100% private image compressor, global passport photo maker, signature resizer, and PDF tools. No server uploads.';
---

<BaseLayout title={PAGE_TITLE} description={PAGE_DESC}>
    
    <!-- 🚀 CINEMATIC HERO -->
    <section class="cinematic-hero">
        <div class="hero-radial-glow"></div>
        <div class="hero-floating-shapes">
            <div class="shape shape-primary"></div>
            <div class="shape shape-secondary"></div>
        </div>
        
        <div class="container hero-content-grid">
            <div class="hero-text-wrap">
                <div class="hero-badge">
                    <span class="badge-glow"></span>
                    <span>100% Local Browser Processing</span>
                </div>
                
                <h1 class="cinematic-title">
                    Digital Tools <br />
                    <span class="gradient-text-animated">Perfected.</span>
                </h1>
                
                <p class="hero-subtitle-cinematic">
                    A visually rich, highly intelligent workspace for your documents. 
                    Zero server uploads. Absolute privacy.
                </p>

                <div class="hero-cta-group-cinematic">
                    <a href="/tools" class="btn-primary-cinematic">
                        <span class="btn-text">Open Workspace</span>
                        <div class="btn-ambient-glow"></div>
                    </a>
                    <a href="#popular-tools" class="btn-secondary-cinematic">
                        Explore Tools
                    </a>
                </div>
            </div>

            <div class="hero-visual-cinematic">
                <div class="cinematic-glass-card hover-lift">
                    <div class="card-inner-glow"></div>
                    <div class="icon-ring">
                        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-accent-primary"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                    </div>
                    <h3>Secure By Design</h3>
                    <p>Every pixel is processed directly on your device. We never see your data.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- ⚡ ELEGANT BENTO GRID -->
    <section class="cinematic-bento-section section-spacer-xxl" id="popular-tools">
        <div class="container">
            <div class="section-intro center">
                <span class="section-kicker">Professional Suite</span>
                <h2 class="cinematic-section-title">One Platform. <br/><span class="gradient-text-animated">Zero Compromise.</span></h2>
            </div>
            
            <div class="cinematic-grid stagger-container">
                <a href="/compress-image" class="cinematic-card stagger-item">
                    <div class="card-glow-border"></div>
                    <div class="cinematic-card-inner">
                        <div class="card-icon-wrap bg-blue-glow">📸</div>
                        <h3>Image Compressor</h3>
                        <p>Hit exact 20KB or 50KB targets effortlessly with smart resizing algorithms.</p>
                        <span class="card-action-link">Open Tool <span class="arrow">→</span></span>
                    </div>
                </a>

                <a href="/official-passport-photo-maker" class="cinematic-card stagger-item">
                    <div class="card-glow-border"></div>
                    <div class="cinematic-card-inner">
                        <div class="card-icon-wrap bg-purple-glow">🛂</div>
                        <h3>Passport Studio</h3>
                        <p>Generate perfect Visa and Passport photos aligned to global standards.</p>
                        <span class="card-action-link">Open Tool <span class="arrow">→</span></span>
                    </div>
                </a>

                <a href="/merge-pdf" class="cinematic-card stagger-item">
                    <div class="card-glow-border"></div>
                    <div class="cinematic-card-inner">
                        <div class="card-icon-wrap bg-orange-glow">📄</div>
                        <h3>PDF Toolkit</h3>
                        <p>Merge, split, and rotate confidential PDF documents securely offline.</p>
                        <span class="card-action-link">Open Tool <span class="arrow">→</span></span>
                    </div>
                </a>

                <a href="/signature-maker" class="cinematic-card stagger-item">
                    <div class="card-glow-border"></div>
                    <div class="cinematic-card-inner">
                        <div class="card-icon-wrap bg-green-glow">✍️</div>
                        <h3>E-Signatures</h3>
                        <p>Draw transparent, high-resolution digital signatures for legal use.</p>
                        <span class="card-action-link">Open Tool <span class="arrow">→</span></span>
                    </div>
                </a>
            </div>
        </div>
    </section>

    <script is:inline>
        // Staggered Entrance Observer
        const observerOptions = { threshold: 0.15, rootMargin: '0px 0px -50px 0px' };
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('visible');
                    observer.unobserve(entry.target);
                }
            });
        }, observerOptions);

        document.querySelectorAll('.stagger-item').forEach(el => observer.observe(el));
    </script>

</BaseLayout>

<style>
/* ───── CINEMATIC HERO ───── */
.cinematic-hero {
    position: relative;
    padding: 180px 0 160px;
    background: transparent;
    overflow: hidden;
    min-height: 90vh;
    display: flex;
    align-items: center;
}

.hero-radial-glow {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 80vw;
    height: 80vw;
    max-width: 1000px;
    max-height: 1000px;
    background: radial-gradient(circle, var(--accent-soft) 0%, transparent 60%);
    z-index: 0;
    pointer-events: none;
    opacity: 0.6;
}

.dark .hero-radial-glow { opacity: 0.3; }

.hero-floating-shapes {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
}

.shape {
    position: absolute;
    border-radius: 50%;
    filter: blur(100px);
    opacity: 0.4;
    animation: float 20s infinite alternate ease-in-out;
}
.shape-primary { width: 400px; height: 400px; background: var(--accent-primary); top: -10%; right: -5%; }
.shape-secondary { width: 300px; height: 300px; background: #c084fc; bottom: -10%; left: 10%; animation-delay: -10s; }
.dark .shape { opacity: 0.15; }

@keyframes float {
    from { transform: translate(0, 0) scale(1); }
    to { transform: translate(60px, 40px) scale(1.1); }
}

.hero-content-grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 80px;
    align-items: center;
    position: relative;
    z-index: 10;
}

.hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 10px 24px;
    background: var(--surface-2);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-full);
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--text-primary);
    text-transform: uppercase;
    letter-spacing: 0.15em;
    margin-bottom: 32px;
    box-shadow: var(--shadow-soft);
}

.badge-glow {
    width: 8px;
    height: 8px;
    background: var(--accent-primary);
    border-radius: 50%;
    box-shadow: 0 0 15px var(--accent-primary);
    animation: badge-pulse 2s infinite;
}
@keyframes badge-pulse { 0%, 100% { opacity: 1; transform: scale(1); } 50% { opacity: 0.5; transform: scale(1.2); } }

.cinematic-title {
    font-size: clamp(3.5rem, 8vw, 6rem);
    font-weight: 900;
    line-height: 1.05;
    letter-spacing: -0.05em;
    margin-bottom: 24px;
    position: relative;
}

.gradient-text-animated {
    background: var(--accent-gradient);
    background-size: 200% auto;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: textShine 5s linear infinite;
    filter: drop-shadow(0 4px 12px var(--accent-glow));
}
@keyframes textShine { 0% { background-position: 0% center; } 100% { background-position: 200% center; } }

.hero-subtitle-cinematic {
    font-size: 1.35rem;
    line-height: 1.7;
    color: var(--text-secondary);
    max-width: 580px;
    margin-bottom: 48px;
    font-weight: 500;
}

/* ───── BUTTONS ───── */
.hero-cta-group-cinematic { display: flex; gap: 20px; align-items: center; }

.btn-primary-cinematic {
    position: relative;
    padding: 20px 48px;
    background: var(--accent-gradient);
    color: #ffffff !important;
    border-radius: var(--radius-md);
    font-weight: 800;
    font-size: 1.15rem;
    box-shadow: 0 10px 30px var(--accent-glow);
    overflow: visible;
    z-index: 1;
}

.btn-ambient-glow {
    position: absolute;
    inset: -2px;
    background: var(--accent-gradient);
    filter: blur(15px);
    opacity: 0.5;
    z-index: -1;
    border-radius: inherit;
    transition: 0.4s;
    animation: ambientPulse 3s infinite;
}

@keyframes ambientPulse { 0%, 100% { opacity: 0.5; transform: scale(1); } 50% { opacity: 0.8; transform: scale(1.05); } }

.btn-primary-cinematic:hover { transform: scale(1.03) translateY(-2px); }
.btn-primary-cinematic:hover .btn-ambient-glow { opacity: 1; filter: blur(20px); }
.btn-primary-cinematic:active { transform: scale(0.97); }

.btn-secondary-cinematic {
    padding: 18px 44px;
    background: var(--glass-bg);
    border: 1px solid var(--border-strong);
    color: var(--text-primary);
    border-radius: var(--radius-md);
    font-weight: 800;
    font-size: 1.15rem;
    backdrop-filter: blur(12px);
    box-shadow: var(--shadow-soft);
}
.btn-secondary-cinematic:hover { background: var(--surface-3); border-color: var(--accent-primary); transform: translateY(-2px); }

/* ───── VISUAL CARD ───── */
.cinematic-glass-card {
    background: var(--surface-gradient);
    border: 1px solid var(--card-border);
    border-radius: var(--radius-lg);
    padding: 60px 40px;
    text-align: center;
    position: relative;
    box-shadow: var(--shadow-lift);
    overflow: hidden;
}

.hover-lift { transition: transform 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275); }
.hover-lift:hover { transform: translateY(-15px) scale(1.02); }

.card-inner-glow {
    position: absolute; top: 0; left: 0; right: 0; height: 1px;
    background: linear-gradient(90deg, transparent, var(--glass-border), transparent);
    opacity: 0.5;
}

.icon-ring {
    width: 90px; height: 90px; margin: 0 auto 32px;
    background: var(--surface-2); border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    border: 1px solid var(--border-strong);
    box-shadow: inset 0 0 20px var(--accent-soft);
}

.cinematic-glass-card h3 { font-size: 2rem; margin-bottom: 16px; }
.cinematic-glass-card p { font-size: 1.15rem; color: var(--text-secondary); }


/* ───── CINEMATIC BENTO GRID ───── */
.section-spacer-xxl { padding: 160px 0; }
.section-intro { margin-bottom: 80px; }
.section-kicker { font-weight: 800; text-transform: uppercase; color: var(--accent-primary); letter-spacing: 0.25em; font-size: 0.85rem; margin-bottom: 16px; display: block; }
.cinematic-section-title { font-size: clamp(2.5rem, 6vw, 4rem); font-weight: 900; letter-spacing: -0.04em; line-height: 1.1; }

.cinematic-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 40px; }

.cinematic-card {
    position: relative;
    background: var(--surface-3);
    border-radius: var(--radius-lg);
    text-decoration: none;
    box-shadow: var(--shadow-medium);
    display: block;
    z-index: 1;
}

.cinematic-card-inner {
    position: relative;
    background: var(--surface-gradient);
    border-radius: var(--radius-lg);
    padding: 48px;
    border: 1px solid var(--card-border);
    height: 100%;
    z-index: 2;
}

/* Hover Effects */
.cinematic-card:hover { transform: translateY(-12px); box-shadow: var(--shadow-lift); }
.cinematic-card:hover .cinematic-card-inner { border-color: var(--border-strong); }

.card-glow-border {
    position: absolute;
    inset: -2px;
    border-radius: calc(var(--radius-lg) + 2px);
    background: var(--accent-gradient);
    opacity: 0;
    transition: opacity 0.4s ease;
    z-index: 0;
    filter: blur(8px);
}
.cinematic-card:hover .card-glow-border { opacity: 0.5; }
.dark .cinematic-card:hover .card-glow-border { opacity: 1; filter: blur(12px); }

.card-icon-wrap {
    width: 64px; height: 64px; border-radius: 16px;
    display: flex; align-items: center; justify-content: center;
    font-size: 2rem; margin-bottom: 32px;
    background: var(--surface-2);
    border: 1px solid var(--border-subtle);
    transition: transform 0.4s;
}

.cinematic-card:hover .card-icon-wrap { transform: scale(1.15) rotate(5deg); }

.bg-blue-glow { box-shadow: inset 0 0 20px rgba(59, 130, 246, 0.1); }
.bg-purple-glow { box-shadow: inset 0 0 20px rgba(168, 85, 247, 0.1); }
.bg-orange-glow { box-shadow: inset 0 0 20px rgba(249, 115, 22, 0.1); }
.bg-green-glow { box-shadow: inset 0 0 20px rgba(34, 197, 94, 0.1); }

.cinematic-card h3 { font-size: 1.8rem; margin-bottom: 16px; }
.cinematic-card p { font-size: 1.1rem; color: var(--text-secondary); margin-bottom: 32px; line-height: 1.6; }

.card-action-link {
    font-weight: 700; color: var(--text-primary); font-size: 1.05rem; display: flex; align-items: center; gap: 8px; transition: color 0.3s;
}
.cinematic-card:hover .card-action-link { color: var(--accent-primary); }
.arrow { transform: translateX(0); transition: transform 0.3s; }
.cinematic-card:hover .arrow { transform: translateX(6px); }

/* Stagger Animation */
.stagger-item { opacity: 0; transform: translateY(30px) scale(0.95); transition: all 0.8s cubic-bezier(0.22, 1, 0.36, 1); }
.stagger-item.visible { opacity: 1; transform: translateY(0) scale(1); }

@media (max-width: 968px) {
    .hero-content-grid { grid-template-columns: 1fr; text-align: center; gap: 60px; }
    .hero-cta-group-cinematic { flex-direction: column; align-items: stretch; }
    .hero-subtitle-cinematic { margin-inline: auto; }
}
</style>
