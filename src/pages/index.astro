---
import BaseLayout from '../components/BaseLayout.astro';

const PAGE_TITLE = 'FormFix – Online Image Compressor and PDF Toolkit';
const PAGE_DESC = 'FormFix provides browser-based tools to compress images, merge PDFs, generate QR codes, and create passport photos. High privacy with no file uploads.';
const PAGE_KEYWORDS = 'image compressor, pdf merger, digital tools, signature maker, passport photo maker, formfix';

const customSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "name": "FormFix - Free Online Tool Hub",
      "url": "https://formfix.pages.dev/",
      "applicationCategory": "MultimediaApplication",
      "operatingSystem": "Any",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      },
      "description": "FormFix is a free, private digital toolkit for images, PDFs, and utilities. 100% privacy with zero server uploads. Features QR generator, PDF tools, and 30+ utilities.",
      "featureList": [
        "Compress image to exact KB size (20KB, 50KB)",
        "100% Private local browser processing",
        "Complete PDF Suite (Merge, Split, Rotate)",
        "QR Code & Digital Signature Maker",
        "AI-powered Background Remover & OCR"
      ]
    },
    {
      "@type": "Organization",
      "url": "https://formfix.pages.dev/",
      "logo": "https://formfix.pages.dev/favicon.png?v=5",
      "name": "FormFix",
      "contactPoint": {
        "@type": "ContactPoint",
        "email": "formfix.support@gmail.com",
        "contactType": "customer support"
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is the best and most private free image compressor?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "FormFix is widely considered the best multi-tool because it processes images 100% completely offline in your browser. Unlike other online tools, FormFix never uploads your sensitive data to cloud servers. This guarantees ultimate privacy while compressing photos to exact targets like 20KB or 50KB."
          }
        },
        {
          "@type": "Question",
          "name": "Which tool provides the best passport size photo maker for government exams?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "FormFix provides the most accurate passport photo maker. It automatically sets the official 3.5cm x 4.5cm dimensions and allows you to compress the image precisely to 20KB or 50KB, which is required by UPSC, SSC, and Banking portals."
          }
        },
        {
          "@type": "Question",
          "name": "Is there an alternative to standard online PDF mergers that is actually private?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, FormFix acts as the most secure alternative. Because it utilizes WebAssembly and JavaScript, it merges PDF files directly using your device's memory. Your PDFs are never exposed to the internet."
          }
        }
      ]
    }
  ]
};

const heroFeatures = [
    { text: 'No Uploads', icon: '🔒' },
    { text: '100% Private', icon: '🛡️' },
    { text: 'Works Offline', icon: '📶' },
    { text: 'Instant Results', icon: '⚡' },
    { text: 'Always Free', icon: '✅' },
];

const featuredTools = [
    {
        id: 'compress',
        title: 'Compress Image to KB',
        icon: '🎯',
        href: '/compress-image',
        desc: 'Hit exact file size targets like 20KB or 50KB with mathematical precision. Perfect for Sarkari & Bank forms.',
        badge: 'Popular',
        badgeColor: 'hot',
        cta: 'Compress Now',
        featured: true,
    },
    {
        id: 'merge-pdf',
        title: 'Merge PDF Online',
        icon: '🔗',
        href: '/merge-pdf',
        desc: 'Combine multiple PDF files into one document 100% securely and completely offline in your browser.',
        badge: 'Pro Suite',
        badgeColor: 'orange',
        cta: 'Merge PDFs',
        featured: false,
    },
    {
        id: 'resume-builder',
        title: 'Resume Builder',
        icon: '👔',
        href: '/resume-builder',
        desc: 'Create a professional, modern resume in less than 60 seconds. Download as PDF instantly.',
        badge: 'New',
        badgeColor: 'purple',
        cta: 'Build CV',
        featured: false,
    },
    {
        id: 'qr-generator',
        title: 'QR Code Generator',
        icon: '📱',
        href: '/qr-code-generator',
        desc: 'Create permanent QR codes for URLs, WiFi, or business cards. Branding support included.',
        badge: 'Essential',
        badgeColor: 'blue',
        cta: 'Make QR Code',
        featured: false,
    },
    {
        id: 'bg-remover',
        title: 'Background Remover',
        icon: '🪄',
        href: '/background-remover',
        desc: 'Remove white or solid backgrounds from signatures and photos with AI-powered precision.',
        badge: 'AI Powered',
        badgeColor: 'green',
        cta: 'Remove BG',
        featured: false,
    },
    {
        id: 'image-to-text',
        title: 'Image to Text (OCR)',
        icon: '🔍',
        href: '/image-to-text',
        desc: 'Extract editable text from any image or scanned document instantly using on-device AI.',
        badge: 'AI Scan',
        badgeColor: 'pink',
        cta: 'Extract Text',
        featured: false,
    },
    {
        id: 'passport-maker',
        title: 'Passport Photo Maker',
        icon: '📸',
        href: '/passport-size-photo',
        desc: 'Official 3.5×4.5cm photos for online forms. Automatic background and resolution settings.',
        badge: 'Official',
        badgeColor: 'blue',
        cta: 'Create Photo',
        featured: false,
    },
    {
        id: 'signature',
        title: 'Signature Maker',
        icon: '✍️',
        href: '/signature-maker',
        desc: 'Draw or type professional signatures. Download as transparent PNG for documents.',
        badge: 'Trending',
        badgeColor: 'purple',
        cta: 'Make Signature',
        featured: false,
    },
    {
        id: 'text-to-handwriting',
        title: 'Text to Handwriting',
        icon: '✍️',
        href: '/text-to-handwriting',
        desc: 'Convert typed text into realistic handwriting on notebook paper for assignments.',
        badge: 'Students',
        badgeColor: 'pink',
        cta: 'Write Now',
        featured: false,
    },
];

const moreTools = [
    { icon: '✂️', title: 'Crop Image', href: '/crop-image' },
    { icon: '📐', title: 'Resize Image', href: '/resize-image' },
    { icon: '🔄', title: 'Rotate PDF', href: '/rotate-pdf' },
    { icon: '💧', title: 'Blur & Censor', href: '/blur-image' },
    { icon: '⚖️', title: 'Watermark', href: '/watermark-image' },
    { icon: '⭕', title: 'Circle Crop', href: '/circle-crop' },
    { icon: '🗜️', title: 'Split PDF', href: '/split-pdf' },
    { icon: '🖼️', title: 'PDF to JPG', href: '/pdf-to-image' },
    { icon: '📄', title: 'Image to PDF', href: '/image-to-pdf' },
    { icon: '🔀', title: 'Convert Format', href: '/convert-image' },
    { icon: '🔐', title: 'Password Gen', href: '/password-generator' },
    { icon: '📊', title: '% Calculator', href: '/percentage-calculator' },
    { icon: '🎂', title: 'Age Calculator', href: '/age-calculator' },
    { icon: '💾', title: 'MB to KB', href: '/file-size-converter' },
    { icon: '⚫', title: 'Photo to B&W', href: '/black-and-white' },
];

const stats = [
    { value: '30+', label: 'Free Tools', icon: '🛠️' },
    { value: '0', label: 'Uploads to Server', icon: '☁️' },
    { value: '100%', label: 'Browser-Based', icon: '🔒' },
    { value: '∞', label: 'Files Processed', icon: '⚡' },
];

const howItWorks = [
    { step: '01', title: 'Upload Your File', desc: 'Drag & drop or click to select your image or PDF. It stays in your browser memory only.', icon: '📂' },
    { step: '02', title: 'Choose Your Settings', desc: 'Pick a target KB, output format, dimensions, or any tool-specific options in seconds.', icon: '⚙️' },
    { step: '03', title: 'Download Instantly', desc: 'Your file is processed locally and ready to download immediately. No waiting, no ads.', icon: '⬇️' },
];

const useCases = [
    {
        icon: '🎓',
        title: 'Students & Exam Filers',
        desc: 'Compress photos to 20KB for UPSC, SSC, NEET & other entrance exam portals that enforce strict file size limits.',
        color: 'blue',
    },
    {
        icon: '💼',
        title: 'Job Seekers',
        desc: 'Resize and format profile photos for LinkedIn, Naukri.com, and government job application portals.',
        color: 'purple',
    },
    {
        icon: '🎬',
        title: 'Content Creators',
        desc: 'Optimize thumbnail images for YouTube, create Instagram-ready square crops, and convert formats to WebP.',
        color: 'green',
    },
    {
        icon: '💻',
        title: 'Developers',
        desc: 'Batch convert PNGs to WebP, compress assets, generate QR codes and merge PDFs for production workflows.',
        color: 'orange',
    },
];

const faqs = [
    {
        q: 'Does FormFix upload my photos to any server?',
        a: 'Absolutely not. FormFix processes everything directly inside your web browser using JavaScript. Your files never leave your device. This makes it 100% safe for sensitive documents like ID cards, passport photos, and bank forms.'
    },
    {
        q: 'How do I compress an image to exactly 20KB?',
        a: 'Go to the Compress Image tool, upload your photo, click the "20 KB" preset button, and hit "Compress". Our smart algorithm automatically adjusts quality until the file fits within 20KB while keeping it as sharp as possible.'
    },
    {
        q: 'Is FormFix really free?',
        a: 'Yes, 100% free, with no watermarks, no sign-up required, and no limits on the number of files you can process. We believe essential tools should be accessible to everyone.'
    },
    {
        q: 'What image formats are supported?',
        a: 'FormFix supports JPG, JPEG, PNG, WebP, and GIF for most image tools. PDF tools support any standard PDF file. The converter tool lets you switch between any of these formats.'
    },
    {
        q: 'Can I use FormFix on my phone?',
        a: 'Yes! FormFix is fully optimized for mobile browsers. All tools work on Android and iPhone. For the best experience, use Chrome on Android or Safari on iPhone.'
    },
    {
        q: 'Does it work without internet?',
        a: 'Once the page has loaded, most tools will continue to work without an active internet connection since all processing happens locally in your browser.'
    },
];
---

<BaseLayout title={PAGE_TITLE} description={PAGE_DESC} keywords={PAGE_KEYWORDS} customSchema={customSchema} active="home" canonicalPath="/">

<section class="hero-section">
    <div class="hero-bg-decoration" aria-hidden="true">
        <div class="hero-mesh"></div>
        <div class="hero-orb hero-orb-1"></div>
        <div class="hero-orb hero-orb-2"></div>
        <div class="hero-grid"></div>
    </div>

    <div class="container hero-container">
        <div class="hero-content animate-fade-up">
            <div class="hero-badge animate-fade-up">
                <span class="status-dot"></span>
                ✨ 30+ Free Tools — Zero Uploads, Always Private
            </div>

            <h1 class="hero-h1">
                Simple <br/>
                <span class="hero-gradient-text">Image & PDF Tools</span>
            </h1>

            <p class="hero-desc">
                Efficiently compress images, merge PDF documents, and generate custom QR codes—all processed locally in your browser to ensure your files remain private.
            </p>

            <div class="hero-trust-row">
                {heroFeatures.map(f => (
                    <div class="trust-chip">
                        <span>{f.icon}</span>
                        <span>{f.text}</span>
                    </div>
                ))}
            </div>

            <div class="hero-actions">
                <a href="/tools" class="primary-btn pulse-glow hero-btn-primary" id="hero-compress-btn">
                    <span>🧰</span> Open All 30+ Tools
                </a>
                <a href="/compress-image" class="secondary-btn hero-btn-secondary">
                    Compress Image →
                </a>
            </div>
        </div>

        <!-- Hero Visual Card -->
        <div class="hero-visual animate-fade-up delay-200">
            <div class="hero-card-preview">
                <div class="preview-header">
                    <div class="preview-dots">
                        <span></span><span></span><span></span>
                    </div>
                    <span class="preview-title">FormFix — Universal Tool Hub</span>
                </div>
                <div class="preview-body">
                    <div class="preview-tool-grid">
                        <div class="preview-tool-item active">🎯 Image</div>
                        <div class="preview-tool-item">📄 PDF</div>
                        <div class="preview-tool-item">📱 QR</div>
                        <div class="preview-tool-item">👔 CV</div>
                    </div>
                    <div class="preview-upload-zone">
                        <div class="preview-upload-icon">📁</div>
                        <p>Drop any file here</p>
                        <span>Images, PDFs, or Text</span>
                    </div>
                    <div class="preview-targets">
                        <div class="preview-target active">20 KB</div>
                        <div class="preview-target">50 KB</div>
                        <div class="preview-target">100 KB</div>
                        <div class="preview-target">Custom</div>
                    </div>
                    <div class="preview-result">
                        <div class="result-row">
                            <span class="result-label">Before</span>
                            <span class="result-size before">2.4 MB</span>
                        </div>
                        <div class="result-arrow">↓ 99.2% smaller</div>
                        <div class="result-row">
                            <span class="result-label">After</span>
                            <span class="result-size after">19.8 KB ✓</span>
                        </div>
                    </div>
                    <button class="preview-download-btn" disabled>⬇ Download Result</button>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ══════════════ MARQUEE SOCIAL PROOF ══════════════ -->
<div class="marquee-section" aria-hidden="true">
    <div class="marquee-track">
        <div class="marquee-inner">
            <span class="marquee-item">🎯 Compress to 20KB</span>
            <span class="marquee-sep">·</span>
            <span class="marquee-item">🛂 Passport Photo Maker</span>
            <span class="marquee-sep">·</span>
            <span class="marquee-item">✍️ Digital Signature</span>
            <span class="marquee-sep">·</span>
            <span class="marquee-item">🔗 Merge PDF</span>
            <span class="marquee-sep">·</span>
            <span class="marquee-item">🪄 Background Remover</span>
            <span class="marquee-sep">·</span>
            <span class="marquee-item">📱 QR Code Generator</span>
            <span class="marquee-sep">·</span>
            <span class="marquee-item">✂️ Crop & Resize Image</span>
            <span class="marquee-sep">·</span>
            <span class="marquee-item">📄 PDF to JPG</span>
            <span class="marquee-sep">·</span>
            <span class="marquee-item">💧 Blur & Censor</span>
            <span class="marquee-sep">·</span>
            <span class="marquee-item">📐 Resize Image</span>
            <span class="marquee-sep">·</span>
            <span class="marquee-item">🖼️ Image to PDF</span>
            <span class="marquee-sep">·</span>
            <span class="marquee-item">🔐 Password Generator</span>
            <span class="marquee-sep">·</span>
            <!-- duplicate for seamless loop -->
            <span class="marquee-item">🎯 Compress to 20KB</span>
            <span class="marquee-sep">·</span>
            <span class="marquee-item">🛂 Passport Photo Maker</span>
            <span class="marquee-sep">·</span>
            <span class="marquee-item">✍️ Digital Signature</span>
            <span class="marquee-sep">·</span>
            <span class="marquee-item">🔗 Merge PDF</span>
            <span class="marquee-sep">·</span>
            <span class="marquee-item">🪄 Background Remover</span>
            <span class="marquee-sep">·</span>
            <span class="marquee-item">📱 QR Code Generator</span>
            <span class="marquee-sep">·</span>
            <span class="marquee-item">✂️ Crop & Resize Image</span>
            <span class="marquee-sep">·</span>
            <span class="marquee-item">📄 PDF to JPG</span>
            <span class="marquee-sep">·</span>
        </div>
    </div>
</div>

<!-- ══════════════ STATS SECTION ══════════════ -->
<section class="stats-section">
    <div class="container">
        <div class="stats-grid">
            {stats.map((s, i) => (
                <div class={`stat-card animate-fade-up delay-${(i+1)*100}`}>
                    <div class="stat-icon">{s.icon}</div>
                    <div class="stat-value" data-count={s.value}>{s.value}</div>
                    <div class="stat-label">{s.label}</div>
                </div>
            ))}
        </div>
    </div>
</section>

<!-- ══════════════ TOOLS GRID ══════════════ -->
<section id="tools" class="tools-section section-spacer">
    <div class="container">
        <div class="section-head text-center animate-fade-up">
            <span class="section-label">🛠️ All Tools</span>
            <h2 class="section-h2">Everything You Need, <br/>Nothing You Don't</h2>
            <p class="section-sub">Browser-based, private, instant. Pick a tool and get started in seconds.</p>
        </div>

        <div class="tools-main-grid mt-48 animate-fade-up">
            {featuredTools.map(tool => (
                <a href={tool.href}
                   class={`tool-card-new ${tool.featured ? 'tool-featured' : ''}`}
                   id={`tool-${tool.id}`}>
                    <div class="tool-card-top">
                        <div class="tool-icon-wrap">{tool.icon}</div>
                        {tool.badge && (
                            <span class={`badge badge-${tool.badgeColor}`}>{tool.badge}</span>
                        )}
                    </div>
                    <div class="tool-card-body">
                        <h3>{tool.title}</h3>
                        <p>{tool.desc}</p>
                        <span class="tool-cta">{tool.cta} →</span>
                    </div>
                </a>
            ))}
        </div>

        <!-- Quick Access Strip -->
        <div class="more-tools-strip mt-48 animate-fade-up">
            <p class="strip-label">More Tools:</p>
            <div class="strip-grid">
                {moreTools.map(t => (
                    <a href={t.href} class="strip-card" title={t.title}>
                        <span class="strip-icon">{t.icon}</span>
                        <span class="strip-name">{t.title}</span>
                    </a>
                ))}
            </div>
        </div>

        <div class="mt-48 text-center animate-fade-up">
            <a href="/tools" class="secondary-btn" id="all-tools-link">
                View Full Tool Hub — 30+ Tools →
            </a>
        </div>
    </div>
</section>

<!-- ══════════════ EXAM SPECIAL SECTION ══════════════ -->
<section class="exam-section section-spacer" id="exam-hub">
    <div class="container">
        <div class="exam-glass p-40 rounded-3xl animate-fade-up">
            <div class="section-head text-center">
                <span class="section-label">🎓 For Aspirants</span>
                <h2 class="section-h2 text-white">Sarkari Exam Forms Hub</h2>
                <p class="section-sub text-white/60">One-click solutions for India's biggest competitive exams.</p>
            </div>
            <div class="exam-links mt-48 grid grid-cols-1 md:grid-cols-3 gap-24">
                <a href="/ssc-photo-compressor" class="exam-card">
                    <div class="exam-badge">SSC</div>
                    <h3>SSC Photo Fix</h3>
                    <p>Precise 20KB compression for CGL, CHSL, GD forms.</p>
                    <span class="exam-cta">Fix Photo Now →</span>
                </a>
                <a href="/upsc-photo-resizer" class="exam-card">
                    <div class="exam-badge">UPSC</div>
                    <h3>UPSC Photo Resizer</h3>
                    <p>OTR & Civil Services specs (20KB - 300KB).</p>
                    <span class="exam-cta">Resize Image →</span>
                </a>
                <a href="/passport-size-photo" class="exam-card">
                    <div class="exam-badge">General</div>
                    <h3>Passport Size Maker</h3>
                    <p>3.5 x 4.5 cm with auto-compress to 50KB.</p>
                    <span class="exam-cta">Create Photo →</span>
                </a>
            </div>
        </div>
    </div>
</section>

<!-- ══════════════ HOW IT WORKS ══════════════ -->
<section class="how-section section-spacer" id="how-it-works">
    <div class="container">
        <div class="section-head text-center animate-fade-up">
            <span class="section-label">⚡ Simple Process</span>
            <h2 class="section-h2">Done in 3 Steps</h2>
            <p class="section-sub">No account needed. No software to install. Works on any device.</p>
        </div>

        <div class="how-grid mt-48 animate-fade-up">
            {howItWorks.map((step, i) => (
                <div class="how-card">
                    <div class="how-step-num">{step.step}</div>
                    <div class="how-icon">{step.icon}</div>
                    <h3>{step.title}</h3>
                    <p>{step.desc}</p>
                    {i < howItWorks.length - 1 && (
                        <div class="how-connector" aria-hidden="true">→</div>
                    )}
                </div>
            ))}
        </div>
    </div>
</section>

<!-- ══════════════ WHO IS IT FOR ══════════════ -->
<section class="usecase-section section-spacer" id="who-is-it-for">
    <div class="container">
        <div class="section-head text-center animate-fade-up">
            <span class="section-label">👥 Built For Real People</span>
            <h2 class="section-h2">Who Uses FormFix?</h2>
            <p class="section-sub">From exam forms to creative projects — FormFix has you covered.</p>
        </div>

        <div class="usecase-grid mt-48 animate-fade-up">
            {useCases.map(uc => (
                <div class={`usecase-card color-${uc.color}`}>
                    <div class="uc-icon-wrap">
                        <span class="uc-icon">{uc.icon}</span>
                    </div>
                    <h3>{uc.title}</h3>
                    <p>{uc.desc}</p>
                </div>
            ))}
        </div>
    </div>
</section>

<!-- ══════════════ PRIVACY PROMISE ══════════════ -->
<section class="privacy-section section-spacer animate-fade-up">
    <div class="container">
        <div class="privacy-card">
            <div class="privacy-left">
                <div class="privacy-icon">🛡️</div>
                <div>
                    <h2>Your Privacy is Non-Negotiable</h2>
                    <p>Unlike most online tools that upload your files to a remote server for processing, <strong>FormFix does everything locally in your browser's memory</strong>. We have no servers, no storage, and no way to access your files — because they never leave your device.</p>
                    <p class="mt-16">This makes FormFix the safest choice for sensitive files like passport photos, ID documents, bank forms, and confidential PDFs.</p>
                    <div class="privacy-chips">
                        <span>✅ Zero server uploads (100% Client-Side)</span>
                        <span>✅ No account required</span>
                        <span>✅ No watermarks</span>
                        <span>✅ No ads interrupting tools</span>
                        <span>✅ Unparalleled Cryptographic Privacy</span>
                    </div>
                </div>
            </div>
            <a href="/compress-image" class="primary-btn privacy-cta" id="privacy-cta-btn">
                Try It Safely →
            </a>
        </div>
    </div>
</section>

<!-- ══════════════ FAQ SECTION ══════════════ -->
<section class="faq-section section-spacer" id="faq">
    <div class="container">
        <div class="section-head text-center animate-fade-up">
            <span class="section-label">❓ FAQ</span>
            <h2 class="section-h2">Frequently Asked Questions</h2>
            <p class="section-sub">Everything you need to know about FormFix.</p>
        </div>

        <div class="faq-grid mt-48 animate-fade-up">
            {faqs.map(item => (
                <details class="faq-item">
                    <summary>{item.q}</summary>
                    <p>{item.a}</p>
                </details>
            ))}
        </div>
    </div>
</section>

<!-- ══════════════ SEO ARTICLE ══════════════ -->
<section class="seo-section section-spacer animate-fade-up">
    <div class="container">
        <article class="seo-article">
            <h2>Reliable Image Compression and PDF Management with FormFix</h2>
            <p>FormFix offers a practical suite of utilities tailored for efficient document and image handling. Whether you are adjusting a photo for an application or organizing PDF reports, our tools provide a straightforward, no-upload solution. By utilizing modern web standards, we ensure that your data stays on your local machine throughout the entire process.</p>

            <h3>Data Privacy through Local Browser Processing</h3>
