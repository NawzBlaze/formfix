---
import BaseLayout from '../components/BaseLayout.astro';

const PAGE_TITLE = 'FormFix - 100% Private Image Compressor, Passport Photo Maker & PDF Tools';
const PAGE_DESC = 'The safest way to prepare official documents. 100% private image compressor, global passport photo maker, signature resizer, and PDF tools. No server uploads.';
---

<BaseLayout title={PAGE_TITLE} description={PAGE_DESC}>
    
    <!-- 🚀 SIGNATURE PREMIUM HERO -->
    <section class="signature-hero">
        <!-- Depth Layers -->
        <div class="hero-light-source"></div>
        <div class="hero-shape shape-1"></div>
        <div class="hero-shape shape-2"></div>
        
        <div class="container hero-content-grid">
            <div class="hero-text-wrap">
                <div class="premium-badge-row">
                    <span class="premium-pill">
                        <span class="glimmer"></span>
                        Privacy First Architecture
                    </span>
                </div>
                
                <h1 class="hero-title">
                    Digital Tools <br />
                    <span class="glow-text">Reimagined.</span>
                </h1>
                
                <p class="hero-desc">
                    A visually rich, secure digital workspace that processes your files locally. No uploads. No tracking. Just precision.
                </p>

                <div class="hero-action-row">
                    <a href="/tools" class="signature-btn-primary">
                        <span>Get Started Free</span>
                        <div class="btn-glow"></div>
                    </a>
                    <a href="#popular-tools" class="signature-btn-secondary">
                        Explore Suite
                    </a>
                </div>
            </div>

            <div class="hero-visual-premium">
                <div class="floating-mockup">
                    <div class="mockup-rim"></div>
                    <div class="mockup-content">
                        <div class="pulse-ring"></div>
                        <div class="upload-indicator">
                            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
                        </div>
                        <p>Secure Browser Node Active</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ⚡ SIGNATURE BENTO GRID -->
    <section class="bento-section section-spacer-xl" id="popular-tools">
        <div class="container">
            <div class="section-header-premium">
                <span class="section-tag">Essential Utilities</span>
                <h2 class="section-title">One Toolkit. <span class="text-gradient">Zero Compromise.</span></h2>
            </div>
            
            <div class="signature-grid">
                <a href="/compress-image" class="sig-card group">
                    <div class="sig-card-border"></div>
                    <div class="sig-card-content">
                        <div class="sig-icon blue">📸</div>
                        <h3>Smart Compressor</h3>
                        <p>Hit exact 20KB or 50KB targets with our signature rim-lighting preview.</p>
                        <div class="sig-card-footer">
                            <span class="text-link">Open Tool</span>
                        </div>
                    </div>
                </a>

                <a href="/official-passport-photo-maker" class="sig-card group">
                    <div class="sig-card-border"></div>
                    <div class="sig-card-content">
                        <div class="sig-icon purple">🛂</div>
                        <h3>Passport Studio</h3>
                        <p>Global standards for US, UK, and EU visas with AI alignment guides.</p>
                        <div class="sig-card-footer">
                            <span class="text-link">Open Tool</span>
                        </div>
                    </div>
                </a>

                <a href="/merge-pdf" class="sig-card group">
                    <div class="sig-card-border"></div>
                    <div class="sig-card-content">
                        <div class="sig-icon orange">📄</div>
                        <h3>PDF Suite</h3>
                        <p>Merge, Split, and Rotate sensitive documents with 100% local safety.</p>
                        <div class="sig-card-footer">
                            <span class="text-link">Open Tool</span>
                        </div>
                    </div>
                </a>

                <a href="/signature-maker" class="sig-card group">
                    <div class="sig-card-border"></div>
                    <div class="sig-card-content">
                        <div class="sig-icon green">✍️</div>
                        <h3>E-Signatures</h3>
                        <p>Create transparent signatures for legal documents in seconds.</p>
                        <div class="sig-card-footer">
                            <span class="text-link">Open Tool</span>
                        </div>
                    </div>
                </a>
            </div>
        </div>
    </section>

</BaseLayout>

<style>
/* ───── SIGNATURE HERO ───── */
.signature-hero {
    position: relative;
    padding: 160px 0 140px;
    background: var(--surface-1);
    overflow: hidden;
}

.hero-light-source {
    position: absolute;
    top: -20%;
    left: 50%;
    transform: translateX(-50%);
    width: 120%;
    height: 140%;
    background: radial-gradient(circle at 50% 0%, var(--accent-soft) 0%, transparent 60%);
    z-index: 0;
    pointer-events: none;
    opacity: 0.8;
}

.hero-shape {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    z-index: 0;
    opacity: 0.4;
    animation: drift 20s infinite alternate ease-in-out;
}
.shape-1 { width: 400px; height: 400px; background: #4f46e5; top: 10%; right: -5%; }
.shape-2 { width: 300px; height: 300px; background: #a855f7; bottom: 10%; left: -5%; animation-delay: -10s; }

@keyframes drift {
    from { transform: translate(0, 0) scale(1); }
    to { transform: translate(40px, 40px) scale(1.1); }
}

.hero-content-grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 80px;
    align-items: center;
    position: relative;
    z-index: 10;
}

.premium-pill {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 10px 20px;
    background: var(--surface-2);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-full);
    font-size: 0.85rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-primary);
    margin-bottom: 32px;
}

.glimmer { width: 8px; height: 8px; background: var(--accent-primary); border-radius: 50%; box-shadow: 0 0 15px var(--accent-primary); animation: glow-pulse 2s infinite; }
@keyframes glow-pulse { 0%, 100% { transform: scale(1); opacity: 1; } 50% { transform: scale(1.5); opacity: 0.5; } }

.hero-title {
    font-size: clamp(3rem, 8vw, 5rem);
    font-weight: 900;
    line-height: 0.95;
    letter-spacing: -0.06em;
    margin-bottom: 32px;
}

.glow-text {
    background: var(--accent-gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    filter: drop-shadow(0 0 10px var(--accent-glow));
}

.hero-desc {
    font-size: 1.35rem;
    line-height: 1.6;
    color: var(--text-secondary);
    max-width: 580px;
    margin-bottom: 48px;
}

/* ───── SIGNATURE BUTTONS ───── */
.hero-action-row { display: flex; gap: 20px; }

.signature-btn-primary {
    position: relative;
    padding: 18px 44px;
    background: var(--accent-gradient);
    color: #fff;
    border-radius: var(--radius-md);
    font-weight: 800;
    font-size: 1.1rem;
    transition: 0.3s;
    overflow: hidden;
    box-shadow: var(--shadow-medium);
}
.signature-btn-primary:hover { transform: translateY(-3px) scale(1.02); box-shadow: var(--shadow-lift); }

.signature-btn-secondary {
    padding: 18px 44px;
    background: var(--surface-3);
    border: 1px solid var(--border-strong);
    color: var(--text-primary);
    border-radius: var(--radius-md);
    font-weight: 800;
    font-size: 1.1rem;
    transition: 0.3s;
}
.signature-btn-secondary:hover { background: var(--surface-2); border-color: var(--accent-primary); color: var(--accent-primary); }

/* ───── SIGNATURE GRID ───── */
.section-header-premium { text-align: center; margin-bottom: 80px; }
.section-tag { font-weight: 800; text-transform: uppercase; color: var(--accent-primary); letter-spacing: 0.2em; font-size: 0.85rem; display: block; margin-bottom: 12px; }
.section-title { font-size: 3rem; font-weight: 900; letter-spacing: -0.04em; }

.signature-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 32px;
}

.sig-card {
    position: relative;
    background: var(--surface-3);
    border-radius: var(--radius-lg);
    padding: 40px;
    transition: 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: var(--shadow-medium);
    overflow: hidden;
    text-decoration: none;
}

.sig-card-border {
    position: absolute;
    inset: 0;
    border: 2px solid transparent;
    border-radius: var(--radius-lg);
    background: linear-gradient(135deg, var(--accent-primary), transparent) border-box;
    -webkit-mask: linear-gradient(#fff 0 0) padding-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    opacity: 0.1;
    transition: 0.4s;
}

.sig-card:hover {
    transform: translateY(-12px) scale(1.02);
    box-shadow: var(--shadow-lift);
}

.sig-card:hover .sig-card-border { opacity: 0.8; }

.sig-icon { font-size: 2.5rem; margin-bottom: 24px; transition: 0.4s; }
.sig-card:hover .sig-icon { transform: scale(1.2) rotate(5deg); }

.sig-card h3 { font-size: 1.75rem; font-weight: 850; margin-bottom: 12px; color: var(--text-primary); }
.sig-card p { font-size: 1.05rem; color: var(--text-secondary); line-height: 1.6; margin-bottom: 24px; }

@media (max-width: 968px) {
    .hero-content-grid { grid-template-columns: 1fr; text-align: center; gap: 48px; }
    .hero-desc { margin-inline: auto; }
    .hero-action-row { justify-content: center; flex-direction: column; }
}
</style>
