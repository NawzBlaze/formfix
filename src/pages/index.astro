---
import BaseLayout from '../components/BaseLayout.astro';

const PAGE_TITLE = 'FormFix - 100% Private Image Compressor, Passport Photo Maker & PDF Tools';
const PAGE_DESC = 'The safest way to prepare official documents. 100% private image compressor, global passport photo maker, signature resizer, and PDF tools. No server uploads.';
const PAGE_KEYWORDS = 'image compressor to 20kb, professional photo resizer, global passport maker, signature maker online, merge pdf online free, formfix private tools';

const customSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "name": "FormFix - Free Online Tool Hub",
      "url": "https://formfix.pages.dev/",
      "applicationCategory": "MultimediaApplication",
      "operatingSystem": "Any",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      },
      "description": "FormFix is a free, private digital toolkit for images, PDFs, and utilities.",
      "featureList": [
        "Compress image to exact KB size (20KB, 50KB, 100KB)",
        "100% Private local browser processing",
        "Complete PDF Suite (Merge, Split, Rotate)",
        "QR Code & Digital Signature Maker"
      ]
    }
  ]
};

const faqs = [
    { q: "What is the best and most private free image compressor?", a: "FormFix is considered the best because it processes images 100% locally in your browser. Your data is never uploaded to any server." },
    { q: "How can I resize a photo to 2x2 inches?", a: "Our Global Passport Studio supports US 2x2 inch standards perfectly. Just select the US Passport preset." },
    { q: "Is it safe to merge PDF files online?", a: "With FormFix, it is 100% safe. The merging happens on your computer, not our server." }
];
---

<BaseLayout title={PAGE_TITLE} description={PAGE_DESC} keywords={PAGE_KEYWORDS} customSchema={customSchema}>
    
    <!-- 🚀 PREMIUM HERO -->
    <section class="saas-hero-premium">
        <div class="hero-glow-layer"></div>
        <div class="container hero-content-grid">
            <div class="hero-text-wrap animate-in">
                <div class="badge-pill">
                    <span class="pill-dot"></span> 100% Private Browser Processing
                </div>
                <h1>
                    Digital Workspace <br />
                    <span class="text-gradient">Refined for Results.</span>
                </h1>
                
                <p class="hero-subtitle">
                    The web's most private toolkit. Compress, convert, and create professional documents without ever uploading your data.
                </p>

                <div class="hero-cta-group mt-40">
                    <a href="/tools" class="primary-btn-premium lg">
                        Launch Dashboard
                    </a>
                    <a href="#popular-tools" class="secondary-btn-premium lg">
                        Explore Tools
                    </a>
                </div>
            </div>

            <div class="hero-visual animate-in delay-200">
                <div class="window-mockup">
                    <div class="mockup-header">
                        <div class="dots"><span></span><span></span><span></span></div>
                    </div>
                    <div class="mockup-body">
                        <div class="empty-state">
                            <div class="pulse-circle"></div>
                            <p>Drop files here to start</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ⚡ BENTO TOOLS SECTION -->
    <section class="tools-grid-section section-spacer-xl" id="popular-tools">
        <div class="container">
            <div class="section-heading center">
                <span class="sub-label">Instant Utility</span>
                <h2>The Essential Suite</h2>
            </div>
            
            <div class="premium-bento-grid">
                <a href="/compress-image" class="premium-card tool-card">
                    <div class="card-glow"></div>
                    <div class="card-icon-box blue">📸</div>
                    <h3>Image Compressor</h3>
                    <p>High-fidelity compression for 20KB, 50KB, or custom targets.</p>
                </a>
                <a href="/official-passport-photo-maker" class="premium-card tool-card">
                    <div class="card-glow"></div>
                    <div class="card-icon-box purple">🛂</div>
                    <h3>Passport Studio</h3>
                    <p>US, UK, and Global ID photo maker with alignment guides.</p>
                </a>
                <a href="/merge-pdf" class="premium-card tool-card">
                    <div class="card-glow"></div>
                    <div class="card-icon-box orange">📄</div>
                    <h3>PDF Toolkit</h3>
                    <p>Merge, Split, and Rotate PDFs without server uploads.</p>
                </a>
                <a href="/signature-maker" class="premium-card tool-card">
                    <div class="card-glow"></div>
                    <div class="card-icon-box green">✍️</div>
                    <h3>Signature Maker</h3>
                    <p>Professional digital signatures with transparent backgrounds.</p>
                </a>
            </div>
        </div>
    </section>

    <!-- 🌍 DISCOVERY SECTION -->
    <section class="discovery-section-premium section-spacer-xl">
        <div class="container">
            <div class="discovery-grid">
                <div class="discovery-col">
                    <h4 class="discovery-label">Global Access</h4>
                    <ul class="discovery-list">
                        <li><a href="/compress-image">Smart Compressor</a></li>
                        <li><a href="/resize-image-for-linkedin">LinkedIn Profile</a></li>
                        <li><a href="/resize-image-for-instagram">Instagram Square</a></li>
                    </ul>
                </div>
                <div class="discovery-col">
                    <h4 class="discovery-label">Official Tools</h4>
                    <ul class="discovery-list">
                        <li><a href="/official-passport-photo-maker">Passport Studio</a></li>
                        <li><a href="/compress-image-to-20kb">Compress to 20KB</a></li>
                        <li><a href="/signature-maker">E-Signatures</a></li>
                    </ul>
                </div>
                <div class="discovery-col">
                    <h4 class="discovery-label">Resources</h4>
                    <ul class="discovery-list">
                        <li><a href="/blog/how-to-compress-image-to-20kb">Compression Guide</a></li>
                        <li><a href="/blog/best-image-size-for-online-forms">Dimension Guide</a></li>
                        <li><a href="/guides/make-signature-transparent">Clear Signatures</a></li>
                    </ul>
                </div>
            </div>
        </div>
    </section>

</BaseLayout>

<style>
/* ───── PREMIUM HERO ───── */
.saas-hero-premium {
    position: relative;
    padding: 140px 0 120px;
    background: var(--surface-1);
    overflow: hidden;
}

.hero-glow-layer {
    position: absolute;
    top: -10%;
    right: -10%;
    width: 60%;
    height: 80%;
    background: radial-gradient(circle, var(--accent-soft) 0%, transparent 70%);
    z-index: 0;
    pointer-events: none;
}

.hero-content-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 80px;
    align-items: center;
    position: relative;
    z-index: 1;
}

.badge-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    background: var(--surface-2);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-full);
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--text-secondary);
    margin-bottom: 32px;
}

.pill-dot { width: 6px; height: 6px; background: var(--accent-primary); border-radius: 50%; box-shadow: 0 0 10px var(--accent-primary); }

.saas-hero-premium h1 {
    font-size: clamp(2.5rem, 6vw, 4.25rem);
    font-weight: 900;
    line-height: 1.05;
    margin-bottom: 24px;
    color: var(--text-primary);
}

.text-gradient {
    background: var(--accent-gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
}

.hero-subtitle {
    font-size: 1.25rem;
    line-height: 1.6;
    color: var(--text-secondary);
    max-width: 560px;
    margin-bottom: 40px;
}

.hero-cta-group {
    display: flex;
    gap: 16px;
}

/* ───── MOCKUP VISUAL ───── */
.window-mockup {
    background: var(--surface-3);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lift);
    overflow: hidden;
    transform: perspective(1000px) rotateY(-5deg);
    transition: 0.5s cubic-bezier(0.16, 1, 0.3, 1);
}

.window-mockup:hover {
    transform: perspective(1000px) rotateY(0deg) translateY(-10px);
}

.mockup-header {
    background: var(--surface-2);
    padding: 12px 20px;
    border-bottom: 1px solid var(--border-subtle);
}

.dots { display: flex; gap: 8px; }
.dots span { width: 10px; height: 10px; border-radius: 50%; background: var(--border-strong); }

.mockup-body {
    height: 300px;
    display: flex;
    align-items: center;
    justify-content: center;
}

.empty-state { text-align: center; }
.pulse-circle {
    width: 60px; height: 60px; border: 2px solid var(--accent-soft); border-radius: 50%; margin: 0 auto 16px;
    animation: pulse 2s infinite;
}

@keyframes pulse {
    0% { transform: scale(1); opacity: 1; }
    100% { transform: scale(1.5); opacity: 0; }
}

/* ───── BENTO TOOLS ───── */
.section-spacer-xl { padding: 120px 0; }

.section-heading.center { text-align: center; margin-bottom: 64px; }
.sub-label {
    text-transform: uppercase; letter-spacing: 0.15em; font-size: 0.8rem; font-weight: 800; color: var(--accent-primary);
    display: block; margin-bottom: 12px;
}

.premium-bento-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 32px;
}

.premium-card {
    background: var(--surface-3);
    border: 1px solid var(--border-subtle);
    padding: 40px;
    border-radius: var(--radius-lg);
    position: relative;
    overflow: hidden;
    transition: 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: var(--shadow-medium);
}

.premium-card:hover {
    transform: translateY(-10px);
    border-color: var(--accent-primary);
    box-shadow: var(--shadow-lift);
}

.card-icon-box {
    width: 56px; height: 56px; background: var(--surface-2); border-radius: var(--radius-md);
    display: flex; align-items: center; justify-content: center; font-size: 1.75rem; margin-bottom: 24px;
    transition: 0.3s;
}

.premium-card:hover .card-icon-box { transform: scale(1.1) rotate(5deg); background: var(--accent-soft); }

.premium-card h3 { font-size: 1.5rem; font-weight: 800; margin-bottom: 12px; }
.premium-card p { font-size: 1rem; color: var(--text-secondary); line-height: 1.5; }

/* ───── DISCOVERY SECTION ───── */
.discovery-section-premium {
    background: var(--surface-2);
    border-top: 1px solid var(--border-subtle);
}

.discovery-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 64px; }
.discovery-label { font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.15em; font-weight: 800; color: var(--text-muted); margin-bottom: 24px; }
.discovery-list { list-style: none; display: flex; flex-direction: column; gap: 12px; }
.discovery-list a { font-weight: 600; color: var(--text-primary); font-size: 1.05rem; }
.discovery-list a:hover { color: var(--accent-primary); transform: translateX(5px); }

/* ───── BUTTONS ───── */
.secondary-btn-premium {
    background: transparent; border: 2px solid var(--border-strong); color: var(--text-primary);
    padding: 12px 32px; border-radius: var(--radius-md); font-weight: 700; transition: 0.3s;
}
.secondary-btn-premium:hover { background: var(--surface-3); border-color: var(--accent-primary); color: var(--accent-primary); }

.primary-btn-premium.lg { padding: 16px 40px; font-size: 1.1rem; }
.secondary-btn-premium.lg { padding: 16px 40px; font-size: 1.1rem; }

@media (max-width: 968px) {
    .hero-content-grid { grid-template-columns: 1fr; text-align: center; gap: 48px; }
    .hero-cta-group { justify-content: center; }
    .hero-subtitle { margin-inline: auto; }
    .window-mockup { transform: none; max-width: 500px; margin: 0 auto; }
    .discovery-grid { grid-template-columns: 1fr; gap: 40px; }
}
</style>
