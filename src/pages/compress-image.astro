---
import BaseLayout from '../components/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import CompressTool from '../components/tools/CompressTool.astro';
import ToolWrapper from '../components/ToolWrapper.astro';

const PAGE_TITLE = 'Compress Image to 20KB, 50KB & 100KB Online | Free Image Compressor | FormFix';
const PAGE_DESC = 'Free online image compressor. Compress JPG, PNG, and WebP to 20KB, 50KB, or 100KB for SSC, UPSC, and IBPS forms. 100% private.';
const PAGE_KEYWORDS = 'image compressor online, compress image to 20kb, compress photo to 50kb online, compress photo to 100kb, image size reducer, ssc photo compressor, upsc photo reducer, online photo editor, jpg compressor, png compressor';

const faqs = [
  {
    q: 'How do I compress an image to 20KB?',
    a: 'Upload your image, click the "20 KB" preset, and hit Optimize. Our smart binary-search algorithm automatically adjusts quality and dimensions until the output is exactly 20KB or less.',
  },
  {
    q: 'Does compressing reduce image quality?',
    a: 'Our smart engine (RBQS) strips invisible metadata and intelligently reduces color depth. The visual quality remains nearly identical to the original at the chosen target size.',
  },
  {
    q: 'Is my image uploaded to a server?',
    a: 'No. FormFix runs entirely in your browser. Your image never leaves your device — 100% private, zero uploads.',
  },
  {
    q: 'Can I compress to 50KB or 100KB?',
    a: 'Yes. Click the "50 KB" or "100 KB" preset buttons. The engine instantly recalibrates to fit your chosen limit while keeping the highest possible quality.',
  },
  {
    q: 'Which image formats are supported?',
    a: 'JPG, JPEG, PNG, and WebP are all supported for compression. The output is delivered as an optimized JPG for the smallest possible file size.',
  },
  {
    q: 'Is this compressor really free?',
    a: 'Yes. FormFix is 100% free forever. No sign-up, no watermark, no premium tier, no hidden fees.',
  },
];

const customSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      "name": "Compress Image to 20KB - FormFix",
      "operatingSystem": "All Platforms",
      "applicationCategory": "UtilitiesApplication",
      "description": PAGE_DESC,
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": faqs.map(({q, a}) => ({
        "@type": "Question",
        "name": q,
        "acceptedAnswer": { "@type": "Answer", "text": a }
      }))
    }
  ]
};
---

<BaseLayout title={PAGE_TITLE} description={PAGE_DESC} keywords={PAGE_KEYWORDS} customSchema={customSchema} active="compress" canonicalPath="/compress-image" faq={faqs}>
    <Breadcrumb items={[{ name: 'Home', path: '/' }, { name: 'Image Compressor', path: '/compress-image' }]} />

    <ToolWrapper title="Online Image Compressor" subtitle="Compress photos to exactly 20KB, 50KB, or 100KB for government forms. 100% private." currentTool="compress">

        <div slot="tool-ui">
             <CompressTool />
        </div>

        <div slot="tool-info">
             <h2>The Professional Image Compressor Online</h2>
             <p>FormFix is the highest-precision <strong>online image compressor</strong> for users who need to hit exact file size targets. We ensure that you keep maximum sharpness and readability.</p>
             
             <div class="how-it-works mt-32">
                  <h3>How It Works</h3>
                  <ol class="steps">
                       <li><strong>Step 1:</strong> Upload your image</li>
                       <li><strong>Step 2:</strong> Choose target size (20KB, 50KB, or 100KB)</li>
                       <li><strong>Step 3:</strong> Click Optimize</li>
                       <li><strong>Step 4:</strong> Download your compressed image</li>
                  </ol>
             </div>

             <div class="faq-grid mt-32">
                  <details class="faq-item">
                       <summary>How to compress image to 20kb?</summary>
                       <p>Simply upload your image, click on the "20 KB" preset target button, and hit optimize.</p>
                  </details>
                  <details class="faq-item">
                       <summary>Is it safe?</summary>
                       <p>Yes, it's 100% safe. Processing happens locally in your browser.</p>
                  </details>
             </div>
        </div>
    </ToolWrapper>
</BaseLayout>

<style>
    .how-it-works h3 { font-size: 1.1rem; font-weight: 600; margin-bottom: 12px; color: var(--text-primary); }
    .steps { padding-left: 20px; margin: 0; }
    .steps li { font-size: 0.95rem; line-height: 1.7; color: var(--text-secondary); margin-bottom: 8px; }
    .steps li strong { color: var(--text-primary); }
</style>
