      state.templateId = tpl.id;
      state.customization = { ...state.customization, ...tpl.config, pageSize: state.customization.pageSize || 'a4' };
      state.data.sectionOrder = tpl.config.sectionOrder.filter((id) => id !== 'personal');
      commit();
    }
    if (btn.dataset.sectionAction) sectionAction(btn);
    if (btn.dataset.entryAction) entryAction(btn);
    if (btn.dataset.addItem) addItem(btn.dataset.addItem, btn.dataset.customId);
    if (btn.dataset.action === 'add-custom') addCustomSection();
    if (btn.dataset.action === 'undo') restore(undoStack, redoStack);
    if (btn.dataset.action === 'redo') restore(redoStack, undoStack);
    if (btn.dataset.action === 'duplicate') duplicateResume();
    if (btn.dataset.action === 'export-json') exportJson();
    if (btn.dataset.action === 'download-pdf') downloadPdf();
    if (btn.dataset.ai) runAi(btn);
  });
  root.addEventListener('dragstart', (event) => {
    const section = event.target.closest('[data-section-id]');
    if (!section || section.dataset.sectionId === 'personal') return;
    draggedSectionId = section.dataset.sectionId;
    event.dataTransfer.effectAllowed = 'move';
    event.dataTransfer.setData('text/plain', draggedSectionId);
  });
  root.addEventListener('dragover', (event) => {
    const section = event.target.closest('[data-section-id]');
    if (!section || !draggedSectionId || section.dataset.sectionId === draggedSectionId) return;
    event.preventDefault();
    section.classList.add('is-drag-over');
  });
  root.addEventListener('dragleave', (event) => {
    event.target.closest('[data-section-id]')?.classList.remove('is-drag-over');
  });
  root.addEventListener('drop', (event) => {
    const section = event.target.closest('[data-section-id]');
    document.querySelectorAll('.rb-edit-section.is-drag-over').forEach((item) => item.classList.remove('is-drag-over'));
    if (!section || !draggedSectionId || section.dataset.sectionId === draggedSectionId) return;
    event.preventDefault();
    moveSectionBefore(draggedSectionId, section.dataset.sectionId);
    draggedSectionId = '';
  });
  root.addEventListener('dragend', () => {
    draggedSectionId = '';
    document.querySelectorAll('.rb-edit-section.is-drag-over').forEach((item) => item.classList.remove('is-drag-over'));
  });
  function moveSectionBefore(fromId, toId) {
    const customFrom = state.data.customSections.findIndex((section) => section.id === fromId);
    const customTo = state.data.customSections.findIndex((section) => section.id === toId);
    remember();
    if (customFrom >= 0 && customTo >= 0) {
      const [item] = state.data.customSections.splice(customFrom, 1);
      state.data.customSections.splice(state.data.customSections.findIndex((section) => section.id === toId), 0, item);
      commit();
      return;
    }
    const from = state.data.sectionOrder.indexOf(fromId);
    const to = state.data.sectionOrder.indexOf(toId);
    if (from >= 0 && to >= 0) {
      const [item] = state.data.sectionOrder.splice(from, 1);
      state.data.sectionOrder.splice(state.data.sectionOrder.indexOf(toId), 0, item);
      commit();
    }
  }
  function sectionAction(btn) {
    const id = btn.closest('[data-section-id]').dataset.sectionId;
    remember();
    if (btn.dataset.sectionAction === 'collapse') state.collapsed[id] = !state.collapsed[id];
    if (btn.dataset.sectionAction === 'toggle') state.data.sectionVisibility[id] = state.data.sectionVisibility[id] === false;
    if (btn.dataset.sectionAction === 'delete') {
      state.data.customSections = state.data.customSections.filter((section) => section.id !== id);
      delete state.collapsed[id];
      commit();
      return;
    }
    if (['up','down'].includes(btn.dataset.sectionAction) && id !== 'personal') {
      const customIndex = state.data.customSections.findIndex((section) => section.id === id);
      if (customIndex >= 0) {
        const customTo = btn.dataset.sectionAction === 'up' ? customIndex - 1 : customIndex + 1;
        if (customTo >= 0 && customTo < state.data.customSections.length) [state.data.customSections[customIndex], state.data.customSections[customTo]] = [state.data.customSections[customTo], state.data.customSections[customIndex]];
        commit();
        return;
      }
      const all = state.data.sectionOrder;
      const i = all.indexOf(id);
      const to = btn.dataset.sectionAction === 'up' ? i - 1 : i + 1;
      if (i >= 0 && to >= 0 && to < all.length) [all[i], all[to]] = [all[to], all[i]];
    }
    commit();
  }
  function entryAction(btn) {
    const entry = btn.closest('[data-entry-type]');
    const type = entry.dataset.entryType;
    const index = Number(entry.dataset.index);
    const customId = entry.dataset.customId;
    const customSection = customId ? state.data.customSections.find((s) => s.id === customId) : null;
    const arr = customId ? (customSection ? customSection.items : []) : state.data[type];
    if (!arr.length && !state.data[type]) return;
    remember();
    if (btn.dataset.entryAction === 'delete') arr.splice(index, 1);
    if (btn.dataset.entryAction === 'duplicate') arr.splice(index + 1, 0, { ...safeClone(arr[index]), id: generateId() });
    if (btn.dataset.entryAction === 'up' && index > 0) [arr[index - 1], arr[index]] = [arr[index], arr[index - 1]];
    if (btn.dataset.entryAction === 'down' && index < arr.length - 1) [arr[index + 1], arr[index]] = [arr[index], arr[index + 1]];
    commit();
  }
  function addItem(type, customId) {
    remember();
    if (type === 'custom') { const cs = state.data.customSections.find((s) => s.id === customId); if (cs) cs.items.push({ id: generateId(), title: '', subtitle: '', date: '', description: '' }); }
    else state.data[type].push(blankItem(type));
    commit();
  }
  function addCustomSection() {
    remember();
    state.data.customSections.push({ id: generateId(), title: 'Custom Section', items: [] });
    commit();
  }
  function restore(from, to) {
    if (!from.length) return;
    to.push(snapshot());
    state = normalize(JSON.parse(from.pop()));
    commit();
  }
  function duplicateResume() {
    localStorage.setItem(`${STORAGE_KEY}.${Date.now()}`, snapshot());
    notice('A duplicate copy was saved in this browser.', 'success');
  }
  function exportJson() {
    const blob = new Blob([JSON.stringify(state, null, 2)], { type: 'application/json' });
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = `${(state.data.personal.fullName || 'resume').replace(/\s+/g, '-').toLowerCase()}.json`;
    a.click();
    URL.revokeObjectURL(a.href);
  }
  function runAi(btn) {
    remember();
    if (btn.dataset.ai === 'summary') {
      const role = state.data.personal.jobTitle || 'professional';
      const skills = state.data.skills.map((s) => s.name).filter(Boolean).slice(0, 4).join(', ');
      state.data.summary = `${role} with hands-on experience delivering measurable results across ${skills || 'cross-functional priorities'}. Known for clear communication, structured problem solving, and improving outcomes through practical, user-focused execution.`;
    }
    if (btn.dataset.ai === 'bullets') {
      const item = state.data.experience[Number(btn.dataset.index)];
      const base = item.description || `Managed ${item.position || 'key responsibilities'} at ${item.company || 'the organization'}.`;
      item.description = base.split(/\n+/).filter(Boolean).map((line) => {
        const clean = line.replace(/^[-•]\s*/, '');
        return /^(Led|Built|Improved|Reduced|Increased|Launched|Managed|Designed|Implemented|Optimized)\b/i.test(clean) ? clean : `Improved ${clean.charAt(0).toLowerCase()}${clean.slice(1)}`;
      }).join('\n');
    }
    if (btn.dataset.ai === 'project') {
      const item = state.data.projects[Number(btn.dataset.index)];
      item.description = item.description || `Built ${item.name || 'this project'} using ${item.technologies || 'modern tools'} to solve a real user problem, improve workflow clarity, and demonstrate practical delivery skills.`;
    }
    commit();
    notice('Suggestion applied. You can edit it freely.', 'success');
  }
  function validate() {
    const bad = [];
    const { personal } = state.data;
    const email = personal.email;
    if (email && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) bad.push('Check the email format.');
    if (personal.phone && !/^[+()\d\s.-]{7,}$/.test(personal.phone)) bad.push('Check the phone number format.');
    ['website','linkedin','github'].forEach((key) => {
      const value = personal[key];
      if (value && !/^(https?:\/\/)?[\w.-]+\.[a-z]{2,}/i.test(value)) bad.push(`Check the ${key} link.`);
    });
    const datedItems = [...state.data.experience, ...state.data.education, ...state.data.volunteerWork];
    if (datedItems.some((item) => item.startDate && item.endDate && !item.current && item.startDate > item.endDate)) bad.push('Check date ranges. Start dates should not come after end dates.');
    if (!personal.fullName) bad.push('Add your full name.');
    return bad;
  }
  async function downloadPdf() {
    const issues = validate();
    if (issues.length) { notice(issues[0], 'error'); return; }
    try {
      const { jsPDF } = await import('jspdf');
      const page = state.customization.pageSize || 'a4';
      const doc = new jsPDF({ unit: 'pt', format: page });
      const width = doc.internal.pageSize.getWidth();
      const height = doc.internal.pageSize.getHeight();
      const margin = Number(state.customization.margin) || 48;
      const rgb = state.customization.accentColor.replace('#', '').match(/.{2}/g).map((h) => parseInt(h, 16));
      let y = margin;
      const addPageIfNeeded = (needed = 32) => { if (y + needed > height - margin) { doc.addPage(); y = margin; } };
      const text = (value, x, opts = {}) => {
        const size = opts.size || state.customization.fontSize || 10.5;
        doc.setFont('helvetica', opts.bold ? 'bold' : 'normal'); doc.setFontSize(size); doc.setTextColor(...(opts.color || [31, 41, 55]));
        const lines = doc.splitTextToSize(String(value || ''), opts.width || width - margin * 2);
        addPageIfNeeded(lines.length * size * 1.4);
        doc.text(lines, x || margin, y, opts.align ? { align: opts.align } : undefined);
        y += lines.length * size * 1.35;
      };
      text(state.data.personal.fullName || 'Your Name', margin, { size: 24, bold: true, color: [17, 24, 39] });
      text(state.data.personal.jobTitle || 'Target Role', margin, { size: 12, bold: true, color: rgb });
      text(['email','phone','location','website','linkedin','github'].map((k) => state.data.personal[k]).filter(Boolean).join(' | '), margin, { size: 9, color: [75, 85, 99] });
      doc.setDrawColor(...rgb); doc.setLineWidth(1.2); doc.line(margin, y + 4, width - margin, y + 4); y += 22;
      const section = (title, hasContent, body) => {
        if (!hasContent) return;
        addPageIfNeeded(34);
        doc.setFont('helvetica', 'bold'); doc.setFontSize(9); doc.setTextColor(...rgb); doc.text(title.toUpperCase(), margin, y); y += 8;
        doc.setDrawColor(215, 221, 232); doc.line(margin, y, width - margin, y); y += 14;
        body();
        y += Number(state.customization.sectionSpacing) * .6;
      };
      const writeItems = (items, getTitle, getMeta, getDescription) => items.forEach((item) => {
        text(getTitle(item), margin, { bold: true, size: 10 });
        const meta = getMeta(item);
        if (meta) text(meta, margin, { size: 8.5, color: [75,85,99] });
        const description = getDescription(item);
        if (description) text(description, margin, { size: 9.5 });
        y += 6;
      });
      const pdfSections = {
        summary: () => section('Professional Summary', nonEmpty(state.data.summary), () => text(state.data.summary, margin, { size: 10 })),
        experience: () => {
          const items = state.data.experience.filter((e) => e.company || e.position || e.description);
          section('Experience', items.length, () => writeItems(items, (e) => `${e.position || e.company}${e.company && e.position ? `, ${e.company}` : ''}`, (e) => [e.location, dateRange(e)].filter(Boolean).join(' | '), (e) => e.description));
        },
        education: () => {
          const items = state.data.education.filter((e) => e.institution || e.degree || e.description);
          section('Education', items.length, () => writeItems(items, (e) => [e.degree, e.field, e.institution].filter(Boolean).join(' - '), (e) => [e.location, dateRange(e), e.gpa && `GPA ${e.gpa}`].filter(Boolean).join(' | '), (e) => e.description));
        },
        projects: () => {
          const items = state.data.projects.filter((e) => e.name || e.description);
          section('Projects', items.length, () => writeItems(items, (e) => e.name || 'Project', (e) => [e.technologies, e.url, e.startDate].filter(Boolean).join(' | '), (e) => e.description));
        },
        skills: () => {
          const skills = state.data.skills.map((s) => [s.name, s.level].filter(Boolean).join(' - ')).filter(Boolean).join(', ');
          section('Skills', skills, () => text(skills, margin, { size: 10 }));
        },
        languages: () => {
          const languages = state.data.languages.map((s) => [s.name, s.proficiency].filter(Boolean).join(' - ')).filter(Boolean).join(', ');
          section('Languages', languages, () => text(languages, margin, { size: 10 }));
        },
        certificates: () => {
          const items = state.data.certificates.filter((e) => e.name || e.description);
          section('Certificates', items.length, () => writeItems(items, (e) => [e.name, e.issuer].filter(Boolean).join(' - '), (e) => e.date, (e) => e.description));
        },
        achievements: () => {
          const items = state.data.achievements.filter((e) => e.title || e.description);
          section('Achievements', items.length, () => writeItems(items, (e) => e.title || 'Achievement', (e) => e.date, (e) => e.description));
        },
        volunteerWork: () => {
          const items = state.data.volunteerWork.filter((e) => e.organization || e.role || e.description);
          section('Volunteer Work', items.length, () => writeItems(items, (e) => [e.role, e.organization].filter(Boolean).join(' - '), (e) => dateRange(e), (e) => e.description));
        },
        references: () => {
          const items = state.data.references.filter((e) => e.name || e.email || e.phone);
          section('References', items.length, () => writeItems(items, (e) => e.name || 'Reference', (e) => [e.title, e.company, e.relationship].filter(Boolean).join(' | '), (e) => [e.email, e.phone].filter(Boolean).join(' | ')));
        },
      };
      state.data.sectionOrder.filter((id) => state.data.sectionVisibility[id] !== false).forEach((id) => pdfSections[id]?.());
      state.data.customSections.forEach((custom) => {
        const items = custom.items.filter((item) => item.title || item.description);
        section(custom.title || 'Custom Section', items.length, () => writeItems(items, (item) => item.title || item.subtitle || 'Item', (item) => [item.subtitle, item.date].filter(Boolean).join(' | '), (item) => item.description));
      });
      doc.save(`${(state.data.personal.fullName || 'Resume').replace(/\s+/g, '_')}_Resume.pdf`);
      notice('PDF downloaded successfully.', 'success');
    } catch (error) {
      notice('PDF export failed. Please try the browser print option.', 'error');
    }
  }
  function notice(message, type) {
    if (window.ffNotice) window.ffNotice(message, type);
  }
  render();
</script>
