---
import BaseLayout from '../components/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import ToolWrapper from '../components/ToolWrapper.astro';
import { TEMPLATES, FONT_OPTIONS } from '../components/resume-builder/data';

const PAGE_TITLE = 'Resume Builder - Free ATS CV Maker & PDF Download | FormFix';
const PAGE_DESC = 'Build a polished, ATS-friendly resume with live A4 preview, smart writing tools, templates, customization, autosave, and PDF export. Private and free.';
const PAGE_KEYWORDS = 'resume builder, free cv maker, ATS resume checker, online resume creator, pdf resume download, resume maker online';

const customSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'SoftwareApplication',
      name: 'FormFix Resume Builder',
      operatingSystem: 'All',
      applicationCategory: 'UtilitiesApplication',
      description: PAGE_DESC,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    },
  ],
};

const faqs = [
  { q: "Does autosave upload my resume?", a: "No. Autosave uses your browser storage only." },
  { q: "Can I keep multiple versions?", a: "Yes. Use Duplicate or Export JSON before making major edits." },
  { q: "Are creative templates ATS safe?", a: "The ATS template is safest. Creative templates keep clear headings and selectable text, but one-column layouts are best for strict systems." },
];
---

<BaseLayout title={PAGE_TITLE} description={PAGE_DESC} keywords={PAGE_KEYWORDS} customSchema={customSchema} active="tools" canonicalPath="/resume-builder" faq={faqs}>
  <Breadcrumb items={[{ name: 'Home', path: '/' }, { name: 'Resume Builder', path: '/resume-builder' }]} />

  <ToolWrapper title="Resume Builder" subtitle="Choose a template, fill your details, improve the writing, check ATS fit, and download a clean PDF." currentTool="resume-builder">
    <div slot="tool-ui">
      <div class="rb-shell" data-resume-builder>
        <section class="rb-stage" aria-label="Resume builder workflow">
          <div class="rb-stage-step is-active" data-step-dot="templates"><span>1</span> Templates</div>
          <div class="rb-stage-step is-active" data-step-dot="editor"><span>2</span> Fill</div>
          <div class="rb-stage-step" data-step-dot="customize"><span>3</span> Customize</div>
          <div class="rb-stage-step" data-step-dot="download"><span>4</span> Download</div>
        </section>

        <div class="rb-toolbar" role="toolbar" aria-label="Resume actions">
          <div class="rb-toolbar-main">
            <button class="rb-tab is-active" type="button" data-panel-target="editor">Editor</button>
            <button class="rb-tab" type="button" data-panel-target="templates">Templates</button>
            <button class="rb-tab" type="button" data-panel-target="customize">Customize</button>
            <button class="rb-tab" type="button" data-panel-target="ats">ATS</button>
          </div>
          <div class="rb-toolbar-actions">
            <button class="rb-icon-btn" type="button" data-action="undo" aria-label="Undo" title="Undo">↶</button>
            <button class="rb-icon-btn" type="button" data-action="redo" aria-label="Redo" title="Redo">↷</button>
            <button class="rb-soft-btn" type="button" data-action="duplicate">Duplicate</button>
            <button class="rb-soft-btn" type="button" data-action="export-json">Export JSON</button>
            <label class="rb-soft-btn rb-file-btn">Import JSON<input type="file" accept="application/json" data-json-import /></label>
            <button class="rb-primary-btn" type="button" data-action="download-pdf">Download PDF</button>
          </div>
        </div>

        <div class="rb-workspace">
          <aside class="rb-editor" aria-label="Resume editor">
            <div class="rb-panel is-active" data-panel="editor">
              <div class="rb-panel-head">
                <p class="rb-kicker">Fast editor</p>
                <h2>Build the content</h2>
                <span data-save-state>Autosaved</span>
              </div>
              <div class="rb-section-list" data-section-list></div>
              <button class="rb-add-section" type="button" data-action="add-custom">+ Add Custom Section</button>
            </div>

            <div class="rb-panel" data-panel="templates">
              <div class="rb-panel-head">
                <p class="rb-kicker">12 designs</p>
                <h2>Choose a template</h2>
              </div>
              <div class="rb-template-grid" data-template-grid>
                {TEMPLATES.map((template) => (
                  <button class="rb-template-card" type="button" data-template-id={template.id}>
                    <span class="rb-template-preview" style={`--tpl-accent:${template.config.accentColor};--tpl-bg:${template.config.backgroundColor};`}>
                      <i></i><i></i><i></i>
                    </span>
                    <strong>{template.name}</strong>
                    <small>{template.category}</small>
                  </button>
                ))}
              </div>
            </div>

            <div class="rb-panel" data-panel="customize">
              <div class="rb-panel-head">
                <p class="rb-kicker">Design controls</p>
                <h2>Fine tune layout</h2>
              </div>
              <div class="rb-control-grid">
                <label class="rb-field">Accent Color<input type="color" data-customize="accentColor" /></label>
                <label class="rb-field">Font Family<select data-customize="fontFamily">{FONT_OPTIONS.map((font) => <option value={font.value}>{font.label}</option>)}</select></label>
                <label class="rb-field">Font Size<input type="range" min="9" max="12.5" step="0.25" data-customize="fontSize" /></label>
                <label class="rb-field">Line Height<input type="range" min="1.35" max="1.8" step="0.05" data-customize="lineHeight" /></label>
                <label class="rb-field">Section Spacing<input type="range" min="8" max="28" step="1" data-customize="sectionSpacing" /></label>
                <label class="rb-field">Margins<input type="range" min="28" max="68" step="2" data-customize="margin" /></label>
                <label class="rb-field">Header Style<select data-customize="headerStyle"><option value="centered">Centered</option><option value="left">Left</option><option value="split">Split</option><option value="stacked">Stacked</option><option value="sidebar">Sidebar</option></select></label>
                <label class="rb-field">Icon Style<select data-customize="iconStyle"><option value="line">Line</option><option value="filled">Filled</option><option value="none">None</option></select></label>
                <label class="rb-field">Divider Style<select data-customize="dividerStyle"><option value="line">Line</option><option value="dots">Dots</option><option value="double">Double</option><option value="none">None</option></select></label>
                <label class="rb-field">Columns<select data-customize="columns"><option value="1">One column</option><option value="2">Two columns</option></select></label>
                <label class="rb-field">Page Size<select data-customize="pageSize"><option value="a4">A4</option><option value="letter">Letter</option><option value="legal">Legal</option></select></label>
                <label class="rb-field">Border Radius<input type="range" min="0" max="16" step="1" data-customize="borderRadius" /></label>
                <label class="rb-check"><input type="checkbox" data-customize="photoEnabled" /> Show photo</label>
                <label class="rb-check"><input type="checkbox" data-preview-dark /> Dark preview</label>
              </div>
            </div>

            <div class="rb-panel" data-panel="ats">
              <div class="rb-panel-head">
                <p class="rb-kicker">ATS checker</p>
                <h2>Improve your score</h2>
              </div>
              <div class="rb-score-card">
                <div class="rb-score-ring"><strong data-ats-score>0</strong><span>/100</span></div>
                <div class="rb-score-bars" data-ats-bars></div>
              </div>
              <div class="rb-suggestions" data-ats-suggestions></div>
            </div>
          </aside>

          <section class="rb-preview-area" aria-label="Live resume preview">
            <div class="rb-preview-top">
              <div>
                <p class="rb-kicker">Live A4 preview</p>
                <h2 data-preview-title>Minimal</h2>
              </div>
              <div class="rb-preview-status"><span data-word-count>0 words</span><span data-page-count>1 page</span></div>
            </div>
            <div class="rb-preview-scroll">
              <article class="rb-paper" id="rb-paper" data-resume-paper></article>
            </div>
          </section>
        </div>
      </div>
    </div>

    <div slot="tool-info">
      <h2>Private Resume Builder</h2>
      <p>Your resume is edited, checked, saved, imported, exported, and rendered in your browser. The layout uses selectable text and standard section names so the result stays readable for recruiters and ATS systems.</p>
      <div class="faq-grid">
        <details class="faq-item">
          <summary>Does autosave upload my resume?</summary>
          <div class="ans">No. Autosave uses your browser storage only.</div>
        </details>
        <details class="faq-item">
          <summary>Can I keep multiple versions?</summary>
          <div class="ans">Yes. Use Duplicate or Export JSON before making major edits.</div>
        </details>
        <details class="faq-item">
          <summary>Are creative templates ATS safe?</summary>
          <div class="ans">The ATS template is safest. Creative templates keep clear headings and selectable text, but one-column layouts are best for strict systems.</div>
        </details>
      </div>
    </div>
  </ToolWrapper>
</BaseLayout>

<style>
  .rb-shell { --rb-accent: #10b981; --rb-text: #172033; --rb-muted: #667085; --rb-line: #d8dee8; --rb-soft: #f5f7fb; color: var(--rb-text); }
  .rb-stage { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; margin-bottom: 16px; }
  .rb-stage-step { min-height: 40px; display: flex; align-items: center; gap: 8px; padding: 8px 10px; border: 1px solid var(--border-subtle); border-radius: 8px; color: var(--text-muted); background: var(--surface-3); font-weight: 700; font-size: .82rem; }
  .rb-stage-step span { width: 22px; height: 22px; display: inline-grid; place-items: center; border-radius: 50%; background: var(--surface-2); }
  .rb-stage-step.is-active { border-color: color-mix(in srgb, var(--rb-accent), white 65%); color: var(--text-primary); }
  .rb-stage-step.is-active span { background: var(--rb-accent); color: #fff; }
  .rb-toolbar { display: flex; justify-content: space-between; gap: 12px; padding: 12px; margin-bottom: 16px; border: 1px solid var(--border-subtle); border-radius: 8px; background: var(--surface-3); position: sticky; top: 8px; z-index: 5; }
  .rb-toolbar-main, .rb-toolbar-actions { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
  .rb-tab, .rb-soft-btn, .rb-icon-btn, .rb-primary-btn, .rb-add-section { min-height: 44px; border-radius: 8px; border: 1px solid var(--border-subtle); background: var(--surface-3); color: var(--text-primary); font-weight: 800; cursor: pointer; }
  .rb-tab { padding: 0 14px; }
  .rb-tab.is-active { background: var(--rb-accent); border-color: var(--rb-accent); color: #fff; }
  .rb-soft-btn { padding: 0 12px; font-size: .84rem; }
  .rb-icon-btn { min-width: 44px; min-height: 44px; font-size: 1.05rem; }
  .rb-primary-btn { padding: 0 16px; border-color: var(--rb-accent); background: var(--rb-accent); color: #fff; }
  .rb-file-btn { display: inline-flex; align-items: center; }
  .rb-file-btn input { position: absolute; opacity: 0; width: 1px; height: 1px; }
  .rb-workspace { display: grid; grid-template-columns: minmax(360px, 44%) minmax(420px, 1fr); gap: 18px; align-items: start; }
  .rb-editor { border: 1px solid var(--border-subtle); border-radius: 8px; background: var(--surface-3); overflow: hidden; }
  .rb-panel { display: none; padding: 16px; }
  .rb-panel.is-active { display: block; }
  .rb-panel-head { display: flex; justify-content: space-between; align-items: end; gap: 12px; margin-bottom: 14px; }
  .rb-panel-head h2, .rb-preview-top h2 { margin: 0; font-size: 1rem; }
  .rb-kicker { margin: 0 0 3px; font-size: .72rem; color: var(--text-muted); font-weight: 800; text-transform: uppercase; letter-spacing: .06em; }
  .rb-section-list { display: flex; flex-direction: column; gap: 10px; }
  .rb-edit-section { border: 1px solid var(--border-subtle); border-radius: 8px; background: var(--surface-3); overflow: hidden; }
  .rb-edit-section.is-drag-over { border-color: var(--rb-accent); box-shadow: 0 0 0 3px color-mix(in srgb, var(--rb-accent), transparent 82%); }
  .rb-edit-head { display: grid; grid-template-columns: 1fr auto; gap: 8px; align-items: center; padding: 10px 12px; border-bottom: 1px solid var(--border-subtle); }
  .rb-edit-title { display: flex; align-items: center; gap: 8px; min-width: 0; }
  .rb-edit-title strong { font-size: .9rem; overflow-wrap: anywhere; }
  .rb-edit-actions { display: flex; gap: 4px; }
  .rb-mini { min-width: 44px; min-height: 44px; border: 1px solid var(--border-subtle); border-radius: 7px; background: var(--surface-3); color: var(--text-primary); cursor: pointer; display: inline-grid; place-items: center; }
  .rb-edit-body { padding: 12px; display: grid; gap: 10px; }
  .rb-edit-section.is-collapsed .rb-edit-body { display: none; }
  .rb-row { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .rb-field { display: grid; gap: 5px; font-size: .76rem; color: var(--text-muted); font-weight: 800; }
  .rb-field input, .rb-field textarea, .rb-field select { width: 100%; min-height: 38px; border: 1px solid var(--border-subtle); border-radius: 8px; padding: 9px 10px; background: var(--surface-1); color: var(--text-primary); font: inherit; font-weight: 600; box-sizing: border-box; }
  .rb-field textarea { min-height: 90px; resize: vertical; line-height: 1.5; }
  .rb-field input:focus, .rb-field textarea:focus, .rb-field select:focus, button:focus-visible, .rb-file-btn:focus-within { outline: 3px solid color-mix(in srgb, var(--rb-accent), transparent 72%); outline-offset: 2px; }
  .rb-entry-stack { display: grid; gap: 10px; }
  .rb-entry { border: 1px solid var(--border-subtle); border-left: 3px solid var(--rb-accent); border-radius: 8px; padding: 10px; display: grid; gap: 9px; background: var(--surface-3); }
  .rb-entry-bar { display: flex; justify-content: space-between; gap: 8px; align-items: center; }
  .rb-entry-tools { display: flex; flex-wrap: wrap; gap: 5px; }
  .rb-add-btn, .rb-ai-btn { min-height: 36px; border: 1px dashed var(--rb-accent); color: var(--rb-accent); background: transparent; border-radius: 8px; font-weight: 800; cursor: pointer; }
  .rb-ai-btn { border-style: solid; padding: 0 10px; justify-self: start; }
  .rb-add-section { width: 100%; margin-top: 12px; border-style: dashed; color: var(--rb-accent); }
  .rb-template-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
  .rb-template-card { text-align: left; border: 1px solid var(--border-subtle); border-radius: 8px; background: var(--surface-3); padding: 10px; cursor: pointer; color: var(--text-primary); }
  .rb-template-card.is-active { border-color: var(--rb-accent); box-shadow: 0 0 0 3px color-mix(in srgb, var(--rb-accent), transparent 78%); }
  .rb-template-preview { height: 92px; display: grid; align-content: start; gap: 8px; padding: 12px; margin-bottom: 8px; background: var(--tpl-bg); border: 1px solid #e5e7eb; border-radius: 6px; }
  .rb-template-preview::before { content: ""; width: 48%; height: 12px; background: var(--tpl-accent); border-radius: 2px; }
  .rb-template-preview i { display: block; height: 7px; background: #cbd5e1; border-radius: 1px; }
  .rb-template-card strong, .rb-template-card small { display: block; }
  .rb-template-card small { color: var(--text-muted); text-transform: capitalize; }
  .rb-control-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .rb-check { display: flex; align-items: center; gap: 8px; min-height: 40px; font-weight: 800; color: var(--text-primary); }
  .rb-score-card { display: grid; grid-template-columns: 120px 1fr; gap: 16px; align-items: center; padding: 14px; border: 1px solid var(--border-subtle); border-radius: 8px; background: var(--surface-3); }
  .rb-score-ring { width: 108px; height: 108px; border-radius: 50%; display: grid; place-content: center; text-align: center; border: 10px solid color-mix(in srgb, var(--rb-accent), white 72%); }
  .rb-score-ring strong { font-size: 2rem; line-height: 1; }
  .rb-score-bars, .rb-suggestions { display: grid; gap: 8px; }
  .rb-bar { display: grid; gap: 4px; font-size: .8rem; font-weight: 800; }
  .rb-bar i { height: 8px; border-radius: 99px; background: var(--surface-2); overflow: hidden; }
  .rb-bar i span { display: block; height: 100%; background: var(--rb-accent); }
  .rb-suggestion { padding: 10px; border: 1px solid var(--border-subtle); border-radius: 8px; background: var(--surface-3); font-size: .84rem; }
  .rb-preview-area { position: sticky; top: 8px; min-width: 0; }
  .rb-preview-top { display: flex; justify-content: space-between; gap: 12px; align-items: end; padding: 12px; border: 1px solid var(--border-subtle); border-radius: 8px 8px 0 0; background: var(--surface-3); }
  .rb-preview-status { display: flex; gap: 8px; flex-wrap: wrap; color: var(--text-muted); font-weight: 800; font-size: .78rem; }
  .rb-preview-scroll { display: flex; justify-content: center; padding: 24px; max-height: 86vh; overflow: auto; border: 1px solid var(--border-subtle); border-top: 0; border-radius: 0 0 8px 8px; background: #edf1f7; }
  .rb-shell.is-dark-preview .rb-preview-scroll { background: #111827; }
  .rb-paper { width: 210mm; min-height: 297mm; max-width: 100%; box-sizing: border-box; background: var(--surface-3); color: var(--text-primary); box-shadow: 0 12px 34px rgba(16,24,40,.16); font-size: 10.5pt; line-height: 1.55; overflow-wrap: break-word; }
  .cv-head { display: grid; gap: 6px; margin-bottom: var(--cv-section-gap); }
  .cv-head.centered { text-align: center; }
  .cv-head.split { grid-template-columns: 1fr auto; align-items: end; }
  .cv-head.sidebar { padding: 18px; margin: calc(var(--cv-margin) * -1) calc(var(--cv-margin) * -1) var(--cv-section-gap); background: color-mix(in srgb, var(--cv-accent), white 88%); }
  .cv-photo { width: 72px; height: 72px; border-radius: var(--cv-radius); object-fit: cover; border: 2px solid var(--cv-accent); }
  .cv-name { margin: 0; font-family: var(--cv-heading-font); font-size: 25pt; line-height: 1.05; color: var(--cv-heading); letter-spacing: 0; }
  .cv-role { margin: 0; color: var(--cv-accent); font-weight: 800; }
  .cv-contact { display: flex; flex-wrap: wrap; gap: 4px 14px; color: var(--cv-muted); font-size: .86em; }
  .cv-head.centered .cv-contact { justify-content: center; }
  .cv-grid { display: grid; gap: var(--cv-section-gap); }
  .cv-grid.cols-2 { grid-template-columns: minmax(0, 1.45fr) minmax(190px, .75fr); align-items: start; }
  .cv-section { break-inside: avoid; page-break-inside: avoid; }
  .cv-section h3 { margin: 0 0 8px; padding-bottom: 5px; color: var(--cv-accent); font-family: var(--cv-heading-font); font-size: .86em; text-transform: uppercase; letter-spacing: .08em; border-bottom: 1px solid #d7dde8; }
  .cv-section.divider-dots h3 { border-bottom-style: dotted; }
  .cv-section.divider-double h3 { border-bottom-style: double; border-bottom-width: 3px; }
  .cv-section.divider-none h3 { border-bottom: 0; padding-bottom: 0; }
  .cv-item { margin-bottom: 10px; }
  .cv-item:last-child { margin-bottom: 0; }
  .cv-line { display: flex; justify-content: space-between; gap: 12px; align-items: baseline; }
  .cv-item-title { font-weight: 900; color: var(--cv-heading); }
  .cv-date { color: var(--cv-muted); white-space: nowrap; font-size: .86em; }
  .cv-sub { color: var(--cv-muted); font-weight: 700; }
  .cv-desc { margin-top: 4px; white-space: pre-line; }
  .cv-skills { display: flex; flex-wrap: wrap; gap: 6px; }
  .cv-pill { border: 1px solid color-mix(in srgb, var(--cv-accent), white 70%); border-radius: var(--cv-radius); padding: 2px 8px; background: color-mix(in srgb, var(--cv-accent), white 94%); }
  .cv-ats .cv-pill { border: 0; padding: 0; background: transparent; }
  .cv-ats .cv-pill:not(:last-child)::after { content: ","; }
  @media print {
    body * { visibility: hidden; }
    .rb-paper, .rb-paper * { visibility: visible; }
    .rb-paper { position: absolute; inset: 0 auto auto 0; width: 210mm; box-shadow: none; }
  }
  @media (max-width: 1080px) {
    .rb-workspace { grid-template-columns: 1fr; }
    .rb-preview-area { position: static; }
  }
  @media (max-width: 720px) {
    .rb-stage { grid-template-columns: 1fr 1fr; }
    .rb-toolbar, .rb-preview-top { position: static; flex-direction: column; align-items: stretch; }
    .rb-row, .rb-control-grid, .rb-template-grid, .rb-score-card { grid-template-columns: 1fr; }
    .rb-workspace { gap: 12px; }
    .rb-preview-scroll { padding: 12px; overflow-x: auto; }
    .rb-paper { min-width: 680px; transform-origin: top center; }
  }
</style>

<script define:vars={{ templates: TEMPLATES, fontOptions: FONT_OPTIONS }}>
  const root = document.querySelector('[data-resume-builder]');
  const paper = document.querySelector('[data-resume-paper]');
  const STORAGE_KEY = 'formfix.resumeBuilder.v2';
  const sectionMeta = {
    personal: { label: 'Personal Information', icon: 'ID', kind: 'single' },
    summary: { label: 'Professional Summary', icon: 'T', kind: 'single' },
    experience: { label: 'Experience', icon: 'W', kind: 'list' },
    education: { label: 'Education', icon: 'E', kind: 'list' },
    projects: { label: 'Projects', icon: 'P', kind: 'list' },
    skills: { label: 'Skills', icon: 'S', kind: 'list' },
    languages: { label: 'Languages', icon: 'L', kind: 'list' },
    certificates: { label: 'Certificates', icon: 'C', kind: 'list' },
    achievements: { label: 'Achievements', icon: 'A', kind: 'list' },
    volunteerWork: { label: 'Volunteer Work', icon: 'V', kind: 'list' },
    references: { label: 'References', icon: 'R', kind: 'list' },
  };
  const sample = {
    personal: { fullName: 'Aarav Mehta', jobTitle: 'Product Designer', email: 'aarav@example.com', phone: '+91 98765 43210', location: 'Mumbai, India', website: 'aaravmehta.com', linkedin: 'linkedin.com/in/aarav', github: '', photo: '' },
    summary: 'Product designer with 5+ years of experience turning complex workflows into clear, conversion-focused SaaS experiences. Strong background in research, design systems, prototyping, and cross-functional delivery.',
    experience: [{ company: 'Formly Labs', position: 'Senior Product Designer', location: 'Remote', startDate: '2022', endDate: 'Present', current: true, description: 'Led redesign of a document automation workflow, reducing task completion time by 38%.\nBuilt a reusable component system used across 6 product teams.\nPartnered with engineering and support to improve onboarding activation by 21%.' }],
    education: [{ institution: 'University of Mumbai', degree: 'Bachelor of Design', field: 'Interaction Design', location: 'Mumbai', startDate: '2016', endDate: '2020', current: false, gpa: '', description: '' }],
    projects: [{ name: 'Resume Quality Auditor', technologies: 'Figma, Research, Analytics', url: '', startDate: '2024', endDate: '', description: 'Designed an ATS feedback dashboard that helps job seekers identify missing sections, weak verbs, and formatting risks.' }],
    skills: [{ name: 'Product Strategy', level: 'Expert', category: 'Design' }, { name: 'UX Research', level: 'Advanced', category: 'Design' }, { name: 'Figma', level: 'Expert', category: 'Tools' }, { name: 'Design Systems', level: 'Expert', category: 'Design' }],
    languages: [{ name: 'English', proficiency: 'Fluent' }, { name: 'Hindi', proficiency: 'Native' }],
    certificates: [],
