---
import BaseLayout from '../components/BaseLayout.astro';
import ToolWrapper from '../components/ToolWrapper.astro';

const PAGE_TITLE = 'Add Watermark to Photo Online - Free Image Protection Tool';
const PAGE_DESC = 'Protect your images by adding text watermarks online for free. Prevent image theft with custom opacity and 9-point position grid. 100% private and secure.';
const PAGE_KEYWORDS = 'add watermark to photo, prevent image theft, free online watermark tool, protect photography online, text watermark online, online image copyright';

const customSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      "name": "Image Watermark Tool",
      "operatingSystem": "All",
      "applicationCategory": "DesignApplication",
      "description": "Professional tool to add text or logo watermarks to protect images from unauthorized use.",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      }
    }
  ]
};
---

<BaseLayout title={PAGE_TITLE} description={PAGE_DESC} keywords={PAGE_KEYWORDS} customSchema={customSchema} active="tools" canonicalPath="/watermark-image">
    <ToolWrapper title="Photo Watermark" subtitle="Protect your creative work with custom text or copyright markings instantly." currentTool="watermark-image">
        
        <div slot="tool-ui">
             <div class="workspace-editor">
                  <!-- 1. Selection Step -->
                  <div id="upload-stage" class="upload-zone show">
                       <div class="upload-icon-circle">🛡️</div>
                       <h3 class="zone-title">Lock Your Photography</h3>
                       <p class="zone-sub">Add custom watermark protection locally</p>
                       <button class="primary-btn px-32" onclick="document.getElementById('wm-input').click()">Select Image</button>
                       <input type="file" id="wm-input" class="hidden" accept="image/*" />
                  </div>

                  <!-- 2. Workspace Step -->
                  <div id="editor-stage" class="hidden">
                       <div class="editor-layout">
                            <div class="preview-stage shadow-sm">
                                 <div class="preview-header">
                                      <span class="preview-badge">Live Protector</span>
                                 </div>
                                 <div class="canvas-frame checkerboard">
                                      <canvas id="wm-canvas"></canvas>
                                 </div>
                            </div>
                            
                            <div class="sidebar-controls">
                                 <div class="settings-card shadow-sm mb-24">
                                      <div class="setting-item mb-24">
                                           <label class="section-label mb-8">Watermark Content</label>
                                           <input type="text" id="wm-text" class="modern-input" placeholder="e.g. © Your Name" value="© Protected" />
                                      </div>

                                      <div class="setting-item mb-24">
                                           <div class="d-flex justify-between align-center mb-12">
                                                <label class="section-label">Layer Opacity</label>
                                                <span id="op-val" class="status-pill gray">50%</span>
                                           </div>
                                           <input type="range" id="wm-opacity" min="0" max="100" value="50" class="unified-slider" />
                                      </div>

                                      <div class="setting-item">
                                           <label class="section-label mb-12">Placement Grid</label>
                                           <div class="position-grid">
                                                <button class="pos-dot" data-pos="tl">↖</button>
                                                <button class="pos-dot" data-pos="tc">↑</button>
                                                <button class="pos-dot" data-pos="tr">↗</button>
                                                <button class="pos-dot" data-pos="cl">←</button>
                                                <button class="pos-dot active" data-pos="cc">●</button>
                                                <button class="pos-dot" data-pos="cr">→</button>
                                                <button class="pos-dot" data-pos="bl">↙</button>
                                                <button class="pos-dot" data-pos="bc">↓</button>
                                                <button class="pos-dot" data-pos="br">↘</button>
                                           </div>
                                      </div>
                                 </div>

                                 <div class="action-footer vertical">
                                      <button id="apply-btn" class="primary-btn wide-btn pulse-glow">Secure & Download</button>
                                      <button class="secondary-btn wide-btn" onclick="location.reload()">↺ Start Over</button>
                                 </div>
                                 <p class="privacy-note text-center mt-16 font-600">🔒 Processed in local browser RAM.</p>
                            </div>
                       </div>
                  </div>
             </div>
        </div>

        <div slot="tool-info">
             <h2>Secure Watermark Protection</h2>
             <p>Our <strong>Online Watermark Tool</strong> ensures your full-resolution originals never leave your device. We use browser-side canvas rendering to apply your signature or copyright text directly on the high-end copy of your image. This method is 100% private and 10x faster than cloud-based alternatives.</p>
             
             <div class="faq-grid mt-32">
                  <details class="faq-item">
                       <summary>Does this affect image quality?</summary>
                       <p>No. While the editor preview is optimized for speed, the final export uses a high-resolution canvas matching your original file's dimensions (up to 4K+), ensuring pixel-perfect clarity.</p>
                  </details>
                  <details class="faq-item">
                       <summary>Is my photo safe?</summary>
                       <p>Absolutely. FormFix uses client-side JavaScript. This means your photo is processed in your computer's temporary memory (RAM) and is never uploaded to any server.</p>
                  </details>
             </div>
        </div>
    </ToolWrapper>
</BaseLayout>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const fileInput = document.getElementById('wm-input');
        const uploadBox = document.getElementById('upload-stage');
        const editorStage = document.getElementById('editor-stage');
        
        const wmText = document.getElementById('wm-text');
        const wmOpacity = document.getElementById('wm-opacity');
        const opVal = document.getElementById('op-val');
        const posDots = document.querySelectorAll('.pos-dot');
        const applyBtn = document.getElementById('apply-btn');
        
        const canvas = document.getElementById('wm-canvas');
        const ctx = canvas.getContext('2d');
        
        let originalImg = null;
        let position = 'cc';

        fileInput.addEventListener('change', (e) => {
             const file = e.target.files?.[0];
             if (file) {
                 const reader = new FileReader();
                 reader.onload = (ev) => {
                     originalImg = new Image();
                     originalImg.onload = () => {
                         uploadBox.classList.add('hidden');
                         editorStage.classList.remove('hidden');
                         drawPreview();
                     };
                     originalImg.src = ev.target?.result;
                 };
                 reader.readAsDataURL(file);
             }
        });

        wmText.addEventListener('input', drawPreview);
        wmOpacity.addEventListener('input', () => {
             opVal.textContent = wmOpacity.value + '%';
             drawPreview();
        });

        posDots.forEach(dot => dot.addEventListener('click', () => {
             posDots.forEach(d => d.classList.remove('active'));
             dot.classList.add('active');
             position = dot.dataset.pos || 'cc';
             drawPreview();
        }));

        function drawPreview() {
             if (!originalImg) return;
             
             const maxW = 1000;
             let scale = 1;
             if (originalImg.width > maxW) scale = maxW / originalImg.width;

             canvas.width = originalImg.width * scale;
             canvas.height = originalImg.height * scale;

             ctx.clearRect(0, 0, canvas.width, canvas.height);
             ctx.drawImage(originalImg, 0, 0, canvas.width, canvas.height);

             const text = wmText.value;
             if (!text) return;

             const op = parseInt(wmOpacity.value) / 100;
             const fontSize = Math.max(20, Math.floor(canvas.width * 0.04));
             
             ctx.font = `800 ${fontSize}px sans-serif`;
             ctx.fillStyle = `rgba(255, 255, 255, ${op})`;
             ctx.textAlign = 'center';
             ctx.textBaseline = 'middle';

             const metrics = ctx.measureText(text);
             const padding = 20;

             let x = 0; let y = 0;

             if (position.includes('l')) x = (metrics.width / 2) + padding;
             else if (position.includes('r')) x = canvas.width - (metrics.width / 2) - padding;
             else x = canvas.width / 2;

             if (position.includes('t')) y = fontSize + padding;
             else if (position.includes('b')) y = canvas.height - fontSize - padding;
             else y = canvas.height / 2;

             ctx.shadowColor = `rgba(0,0,0, ${op * 0.7})`;
             ctx.shadowBlur = 4;
             ctx.shadowOffsetX = 2;
             ctx.shadowOffsetY = 2;

             ctx.fillText(text, x, y);
        }

        applyBtn.addEventListener('click', () => {
             if (!originalImg) return;
             
             const hrCanvas = document.createElement('canvas');
             hrCanvas.width = originalImg.width;
             hrCanvas.height = originalImg.height;
             const hCtx = hrCanvas.getContext('2d');

             hCtx.drawImage(originalImg, 0, 0);

             const text = wmText.value;
             if (text) {
                 const op = parseInt(wmOpacity.value) / 100;
                 const fs = Math.max(40, Math.floor(hrCanvas.width * 0.04));
                 
                 hCtx.font = `800 ${fs}px sans-serif`;
                 hCtx.fillStyle = `rgba(255, 255, 255, ${op})`;
                 hCtx.textAlign = 'center';
                 hCtx.textBaseline = 'middle';
                 hCtx.shadowColor = `rgba(0,0,0, ${op * 0.7})`;
                 hCtx.shadowBlur = 8; hCtx.shadowOffsetX = 4; hCtx.shadowOffsetY = 4;

                 const m = hCtx.measureText(text), p = 40;
                 let x = 0, y = 0;
                 if (position.includes('l')) x = (m.width/2)+p; else if (position.includes('r')) x = hrCanvas.width-(m.width/2)-p; else x = hrCanvas.width/2;
                 if (position.includes('t')) y = fs+p; else if (position.includes('b')) y = hrCanvas.height-fs-p; else y = hrCanvas.height/2;
                 
                 hCtx.fillText(text, x, y);
             }

             hrCanvas.toBlob(blob => {
                 const url = URL.createObjectURL(blob);
                 const a = document.createElement('a');
                 a.href = url;
                 a.download = `formfix-watermarked.png`;
                 a.click();
                 if (typeof window.triggerConfetti === 'function') window.triggerConfetti();
             }, 'image/png');
        });
    });
</script>

<style>
    .upload-area { background: #fff; border: 1px solid var(--border-subtle); border-radius: var(--radius-md); padding: 48px 24px; text-align: center; }
    .upload-zone { border: 2px dashed var(--border-subtle); border-radius: var(--radius-sm); padding: 40px 20px; transition: 0.2s; cursor: pointer; }
    .upload-zone:hover { border-color: var(--accent); background: var(--surface-50); }
    .upload-icon { font-size: 3rem; margin-bottom: 20px; }
    
    .workspace-editor { display: flex; flex-direction: column; }
    .editor-layout { display: grid; grid-template-columns: 320px 1fr; gap: 32px; }
    
    .settings-sidebar { background: var(--surface-50); padding: 24px; border-radius: var(--radius-md); border: 1px solid var(--border-subtle); position: sticky; top: 24px; height: fit-content; }
    .section-label { font-size: 0.72rem; font-weight: 800; color: var(--surface-500); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 12px; display: block; }
    
    .modern-input { width: 100%; padding: 14px; border-radius: 10px; border: 1px solid var(--border-subtle); font-size: 1rem; font-weight: 700; color: var(--text-main); outline: none; transition: 0.2s; }
    .modern-input:focus { border-color: var(--accent); background: #fff; }

    .status-pill { font-size: 0.72rem; font-weight: 800; color: var(--accent); background: #fff; padding: 2px 10px; border-radius: 20px; border: 1px solid var(--accent); }
    
    .unified-slider { width: 100%; height: 6px; border-radius: 100px; background: var(--surface-200); appearance: none; outline: none; }
    .unified-slider::-webkit-slider-thumb { appearance: none; width: 16px; height: 16px; background: var(--accent); border-radius: 50%; border: 3px solid #fff; box-shadow: var(--shadow-sm); cursor: pointer; }

    .pos-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; max-width: 180px; }
    .pos-btn { aspect-ratio: 1; border: 1px solid var(--border-subtle); background: #fff; border-radius: 8px; font-weight: 800; font-size: 1.1rem; display: flex; align-items: center; justify-content: center; cursor: pointer; color: var(--text-muted); transition: 0.2s; }
    .pos-btn:hover { border-color: var(--accent); color: var(--accent); }
    .pos-btn.active { background: var(--accent); color: #fff; border-color: var(--accent); box-shadow: var(--shadow-sm); }

    .wide-btn { width: 100%; height: 60px; font-size: 1.1rem; font-weight: 800; border-radius: 12px; margin-top: 16px; }

    .preview-stage { display: flex; flex-direction: column; gap: 16px; }
    .preview-header { display: flex; align-items: center; }
    .preview-badge { background: var(--text-main); color: #fff; padding: 4px 12px; border-radius: 100px; font-size: 0.75rem; font-weight: 800; text-transform: uppercase; }
    
    .preview-container { background: #fff; border: 1px solid var(--border-subtle); border-radius: var(--radius-md); overflow: hidden; display: flex; align-items: center; justify-content: center; min-height: 400px; box-shadow: var(--shadow-sm); }
    #wm-canvas { max-width: 100%; max-height: 100%; object-fit: contain; display: block; }

    /* Result Card */
    .result-card-refined { background: #fff; border: 1px solid var(--border-subtle); border-radius: var(--radius-md); padding: 32px; box-shadow: var(--shadow-md); animation: slideUp 0.4s ease-out; }
    .success-badge { display: inline-block; background: #dcfce7; color: #15803d; padding: 6px 16px; border-radius: 100px; font-size: 0.75rem; font-weight: 900; text-transform: uppercase; margin-bottom: 12px; }

    /* FAQ */
    .faq-grid { display: grid; gap: 16px; }
    .faq-item { background: #fff; border: 1px solid var(--border-subtle); border-radius: var(--radius-sm); overflow: hidden; text-align: left; }
    .faq-item summary { font-weight: 800; font-size: 1rem; padding: 16px 20px; cursor: pointer; color: var(--text-main); list-style-type: none; position: relative; }
    .faq-item summary::after { content: '+'; position: absolute; right: 20px; font-weight: bold; font-size: 1.2rem; color: var(--accent); }
    .faq-item[open] summary::after { content: '−'; }
    .faq-item p { padding: 0 20px 20px; margin: 0; font-size: 0.95rem; color: var(--text-muted); line-height: 1.6; }

    .mb-8 { margin-bottom: 8px; }
    .mb-12 { margin-bottom: 12px; }
    .mb-24 { margin-bottom: 24px; }
    .mb-32 { margin-bottom: 32px; }
    .mt-16 { margin-top: 16px; }
    .mt-32 { margin-top: 32px; }
    .d-flex { display: flex; }
    .justify-between { justify-content: space-between; }
    .align-center { align-items: center; }
    .gap-16 { gap: 16px; }
    .flex-1 { flex: 1; }
    .flex-2 { flex: 2; }
    .hidden { display: none !important; }

    @keyframes slideUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }

    @media (max-width: 800px) {
        .editor-layout { grid-template-columns: 1fr; }
        .settings-sidebar { position: static; }
        .preview-container { min-height: 300px; height: 350px; }
        .wrap-mobile { flex-direction: column; }
    }
</style>
