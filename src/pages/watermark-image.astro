---
import BaseLayout from '../components/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import ToolWrapper from '../components/ToolWrapper.astro';

const PAGE_TITLE = 'Add Watermark to Image Online - Free Photo Watermark Tool | FormFix';
const PAGE_DESC = 'Add text watermarks to your photos for free. Customizable font, color, opacity, and position. 100% browser-based, your images never leave your device.';
const PAGE_KEYWORDS = 'add watermark to image, photo watermark tool, text watermark online, free watermark maker, image copyright protection';

const customSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      "name": "Image Watermark Tool",
      "operatingSystem": "All Platforms",
      "applicationCategory": "UtilitiesApplication",
      "description": "Add customizable text watermarks to photos locally in your browser.",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      }
    }
  ]
};
---

<BaseLayout title={PAGE_TITLE} description={PAGE_DESC} keywords={PAGE_KEYWORDS} customSchema={customSchema} active="tools" canonicalPath="/watermark-image">
    <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
        const fileInput = document.getElementById('wm-file-input');
        const uploadBox = document.getElementById('wm-upload-box');
        const editor = document.getElementById('wm-editor');
        const canvas = document.getElementById('wm-canvas');
        const ctx = canvas?.getContext('2d');
        const preview = document.getElementById('wm-preview');

        const textInput = document.getElementById('wm-text');
        const sizeSlider = document.getElementById('wm-size');
        const sizeVal = document.getElementById('wm-size-val');
        const opacitySlider = document.getElementById('wm-opacity');
        const opacityVal = document.getElementById('wm-opacity-val');
        const colorInput = document.getElementById('wm-color');
        const positionSelect = document.getElementById('wm-position');
        const downloadBtn = document.getElementById('wm-download');
        const removeBtn = document.getElementById('wm-remove');

        let originalImg = null;
        let imgW = 0, imgH = 0;

        uploadBox?.addEventListener('click', () => fileInput?.click());
        uploadBox?.addEventListener('dragover', (e) => { e.preventDefault(); uploadBox?.classList.add('drag-over'); });
        uploadBox?.addEventListener('dragleave', () => uploadBox?.classList.remove('drag-over'));
        uploadBox?.addEventListener('drop', (e) => {
            e.preventDefault();
            uploadBox?.classList.remove('drag-over');
            if (e.dataTransfer.files.length) loadImage(e.dataTransfer.files[0]);
        });
        fileInput?.addEventListener('change', (e) => { if (e.target.files.length) loadImage(e.target.files[0]); });

        function loadImage(file) {
            if (!file.type.startsWith('image/')) return window.ffNotice('Please upload an image file.', 'error');
            if (file.size > 50 * 1024 * 1024) return window.ffNotice('File too large. Max 50MB.', 'error');
            const reader = new FileReader();
            reader.onload = (e) => {
                const img = new Image();
                img.onload = () => {
                    originalImg = img;
                    const maxW = 1600;
                    const scale = img.width > maxW ? maxW / img.width : 1;
                    imgW = Math.round(img.width * scale);
                    imgH = Math.round(img.height * scale);
                    canvas.width = imgW;
                    canvas.height = imgH;
                    uploadBox?.classList.add('hidden');
                    editor?.classList.remove('hidden');
                    render();
                };
                img.src = e.target.result;
            };
            reader.readAsDataURL(file);
        }

        function getPos() {
            const p = positionSelect?.value;
            const margin = 30;
            const tw = ctx.measureText(textInput.value || 'WATERMARK').width;
            const th = parseInt(sizeSlider.value) * 2;
            const positions = {
                'top-left': [margin, th + margin],
                'top-right': [imgW - tw - margin, th + margin],
                'center': [(imgW - tw) / 2, imgH / 2],
                'bottom-left': [margin, imgH - margin],
                'bottom-right': [imgW - tw - margin, imgH - margin],
                'diagonal': null
            };
            return positions[p];
        }

        function render() {
            if (!originalImg) return;
            ctx.clearRect(0, 0, imgW, imgH);
            ctx.drawImage(originalImg, 0, 0, imgW, imgH);

            const text = textInput?.value || 'WATERMARK';
            const fontSize = parseInt(sizeSlider?.value || '24');
            const opacity = parseInt(opacitySlider?.value || '40') / 100;
            const color = colorInput?.value || '#ffffff';

            ctx.font = `600 ${fontSize}px system-ui, sans-serif`;
            ctx.fillStyle = color;
            ctx.globalAlpha = opacity;

            const pos = positionSelect?.value;
            if (pos === 'diagonal') {
                ctx.save();
                ctx.translate(imgW / 2, imgH / 2);
                ctx.rotate(-Math.PI / 6);
                const spacing = fontSize * 4;
                for (let y = -imgH; y < imgH * 2; y += spacing) {
                    for (let x = -imgW; x < imgW * 2; x += spacing) {
                        ctx.fillText(text, x, y);
                    }
                }
                ctx.restore();
            } else {
                const p = getPos();
                ctx.fillText(text, p[0], p[1]);
            }
            ctx.globalAlpha = 1;

            if (preview) preview.src = canvas.toDataURL('image/png');
        }

        [textInput, sizeSlider, opacitySlider, colorInput, positionSelect].forEach(el => {
            el?.addEventListener('input', render);
        });

        sizeSlider?.addEventListener('input', () => { if (sizeVal) sizeVal.textContent = (sizeSlider?.value || '24') + 'px'; });
        opacitySlider?.addEventListener('input', () => { if (opacityVal) opacityVal.textContent = (opacitySlider?.value || '40') + '%'; });

        downloadBtn?.addEventListener('click', () => {
            if (!originalImg) return window.ffNotice('Upload an image first.', 'error');
            const link = document.createElement('a');
            link.download = 'watermarked-formfix.png';
            link.href = canvas.toDataURL('image/png');
            link.click();
            window.ffNotice('Watermarked image downloaded!', 'success');
        });

        removeBtn?.addEventListener('click', () => {
            originalImg = null;
            ctx.clearRect(0, 0, imgW, imgH);
            uploadBox?.classList.remove('hidden');
            editor?.classList.add('hidden');
            if (fileInput) fileInput.value = '';
        });
    });
    </script>

    <Breadcrumb items={[{ name: 'Home', path: '/' }, { name: 'Add Watermark to Image', path: '/watermark-image' }]} />

    <ToolWrapper title="Add Watermark to Image" subtitle="Protect your photos with customizable text watermarks. Fully browser-based and private." currentTool="watermark-image">
        <div slot="tool-ui">
            <div class="wm-layout">
                <div id="wm-upload-box" class="wm-upload-box">
                    <input type="file" id="wm-file-input" accept="image/*" style="display:none" />
                    <div class="wm-upload-icon">
                        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="var(--accent-primary)" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/></svg>
                    </div>
                    <p class="wm-upload-text">Drop an image here or click to browse</p>
                    <p class="wm-upload-hint">JPG, PNG, WebP up to 50MB</p>
                </div>

                <div id="wm-editor" class="wm-editor hidden">
                    <div class="wm-controls">
                        <div class="wm-control">
                            <label class="wm-label">Watermark Text</label>
                            <input type="text" id="wm-text" value="WATERMARK" class="wm-input" placeholder="Enter watermark text" />
                        </div>
                        <div class="wm-row">
                            <div class="wm-control">
                                <label class="wm-label">Size: <span id="wm-size-val">24px</span></label>
                                <input type="range" id="wm-size" min="8" max="80" value="24" class="wm-slider" />
                            </div>
                            <div class="wm-control">
                                <label class="wm-label">Opacity: <span id="wm-opacity-val">40%</span></label>
                                <input type="range" id="wm-opacity" min="5" max="100" value="40" class="wm-slider" />
                            </div>
                        </div>
                        <div class="wm-row">
                            <div class="wm-control">
                                <label class="wm-label">Color</label>
                                <input type="color" id="wm-color" value="#ffffff" class="wm-color" />
                            </div>
                            <div class="wm-control wm-control-grow">
                                <label class="wm-label">Position</label>
                                <select id="wm-position" class="wm-select">
                                    <option value="bottom-right">Bottom Right</option>
                                    <option value="bottom-left">Bottom Left</option>
                                    <option value="top-right">Top Right</option>
                                    <option value="top-left">Top Left</option>
                                    <option value="center">Center</option>
                                    <option value="diagonal">Tiled Diagonal</option>
                                </select>
                            </div>
                        </div>
                        <div class="wm-actions">
                            <button id="wm-remove" class="wm-btn wm-btn-secondary">New Image</button>
                            <button id="wm-download" class="wm-btn wm-btn-primary">Download Watermarked Image</button>
                        </div>
                    </div>
                    <div class="wm-preview-wrap">
                        <img id="wm-preview" class="wm-preview-img" alt="Watermarked preview" />
                    </div>
                </div>
            </div>
        </div>

        <div slot="tool-info">
            <h2>Why Add a Watermark?</h2>
            <p>Watermarks protect your photos from unauthorized use. Whether you're a photographer sharing proofs, a business protecting product images, or just want to mark ownership, a text watermark is the quickest way to assert copyright.</p>
            <div class="faq-grid mt-32">
                <details class="faq-item">
                    <summary>Does this upload my image?</summary>
                    <p>No. Everything happens in your browser. Your images are never sent to any server.</p>
                </details>
                <details class="faq-item">
                    <summary>What format is the downloaded image?</summary>
                    <p>The output is a high-quality PNG file with the watermark embedded directly into the image pixels.</p>
                </details>
            </div>
        </div>
    </ToolWrapper>
</BaseLayout>

<style>
    .wm-layout { width: 100%; }
    .wm-upload-box { border: 2px dashed var(--border-subtle); border-radius: var(--radius-lg); padding: 60px 40px; text-align: center; cursor: pointer; transition: 0.2s; background: var(--surface-50); }
    .wm-upload-box:hover, .wm-upload-box.drag-over { border-color: var(--accent-primary); background: var(--accent-soft); }
    .wm-upload-icon { margin-bottom: 16px; }
    .wm-upload-text { font-weight: 600; font-size: 1.05rem; color: var(--text-main); margin-bottom: 6px; }
    .wm-upload-hint { font-size: 0.85rem; color: var(--text-muted); }

    .wm-editor { display: flex; flex-direction: column; gap: 24px; }
    .wm-controls { display: flex; flex-direction: column; gap: 16px; }
    .wm-control { display: flex; flex-direction: column; gap: 6px; }
    .wm-control-grow { flex: 1; }
    .wm-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
    .wm-label { font-size: 0.8rem; font-weight: 600; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.03em; }
    .wm-input { width: 100%; padding: 12px 16px; border-radius: var(--radius-sm); border: 1.5px solid var(--border-subtle); background: var(--surface-50); font-size: 1rem; font-weight: 600; outline: none; transition: 0.2s; color: var(--text-main); }
    .wm-input:focus { border-color: var(--accent-primary); }
    .wm-slider { width: 100%; height: 6px; border-radius: 100px; background: var(--surface-200); appearance: none; outline: none; }
    .wm-slider::-webkit-slider-thumb { appearance: none; width: 18px; height: 18px; background: var(--accent-primary); border: 3px solid var(--border-subtle); border-radius: 50%; cursor: pointer; }
    .wm-color { width: 100%; height: 40px; border: 1.5px solid var(--border-subtle); border-radius: var(--radius-sm); cursor: pointer; background: none; }
    .wm-select { width: 100%; padding: 12px; border-radius: var(--radius-sm); border: 1.5px solid var(--border-subtle); background: var(--surface-50); font-weight: 600; font-size: 0.9rem; outline: none; cursor: pointer; color: var(--text-main); }
    .wm-actions { display: flex; gap: 12px; margin-top: 8px; }
    .wm-btn { flex: 1; padding: 14px; border-radius: var(--radius-sm); font-weight: 600; font-size: 0.95rem; cursor: pointer; border: none; transition: 0.2s; }
    .wm-btn-primary { background: var(--accent-primary); color: #fff; }
    .wm-btn-primary:hover { filter: brightness(1.1); }
    .wm-btn-secondary { background: var(--surface-100); color: var(--text-main); border: 1.5px solid var(--border-subtle); }
    .wm-btn-secondary:hover { border-color: var(--accent-primary); }

    .wm-preview-wrap { border-radius: var(--radius-md); overflow: hidden; border: 1px solid var(--border-subtle); background: var(--surface-50); }
    .wm-preview-img { width: 100%; display: block; }

    .faq-grid { display: grid; gap: 16px; }
    .faq-item { background: var(--surface-3); border: 1px solid var(--border-subtle); border-radius: var(--radius-sm); overflow: hidden; text-align: left; }
    .faq-item summary { font-weight: 600; font-size: 1rem; padding: 16px 20px; cursor: pointer; color: var(--text-main); list-style-type: none; position: relative; }
    .faq-item summary::after { content: '+'; position: absolute; right: 20px; font-weight: 600; font-size: 1.2rem; color: var(--accent-primary); }
    .faq-item[open] summary::after { content: '\2212'; }
    .faq-item p { padding: 0 20px 20px; margin: 0; font-size: 0.95rem; color: var(--text-muted); line-height: 1.6; }

    .mt-32 { margin-top: 32px; }
    .hidden { display: none !important; }

    @media (max-width: 640px) {
        .wm-row { grid-template-columns: 1fr; }
        .wm-actions { flex-direction: column; }
        .wm-upload-box { padding: 40px 20px; }
    }
</style>
