---
import BaseLayout from '../components/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import ToolWrapper from '../components/ToolWrapper.astro';

const PAGE_TITLE = 'Percentage Calculator Online Free – Instant Result';
const PAGE_DESC = 'Calculate percentages instantly in your browser. Find X% of Y, or what percentage X is of Y. Fast, free, no ads.';
const PAGE_KEYWORDS = 'percentage calculator, calculate percentage online, math calculator, percentage tool';
---

<BaseLayout title={PAGE_TITLE} description={PAGE_DESC} keywords={PAGE_KEYWORDS} active="tools" canonicalPath="/percentage-calculator">
    <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
        const calculate = () => {
             // Calc 1: X% of Y
             const c1a = parseFloat(document.getElementById('c1-a').value);
             const c1b = parseFloat(document.getElementById('c1-b').value);
             const c1res = document.getElementById('c1-res');
             if (!isNaN(c1a) && !isNaN(c1b)) c1res.textContent = ((c1a / 100) * c1b).toFixed(2).replace(/\.00$/, '');
             else c1res.textContent = '-';

             // Calc 2: X is what % of Y
             const c2a = parseFloat(document.getElementById('c2-a').value);
             const c2b = parseFloat(document.getElementById('c2-b').value);
             const c2res = document.getElementById('c2-res');
             if (!isNaN(c2a) && !isNaN(c2b) && c2b !== 0) c2res.textContent = ((c2a / c2b) * 100).toFixed(2).replace(/\.00$/, '');
             else c2res.textContent = '-';

             // Calc 3: Increase/Decrease %
             const c3a = parseFloat(document.getElementById('c3-a').value);
             const c3b = parseFloat(document.getElementById('c3-b').value);
             const c3res = document.getElementById('c3-res');
             if (!isNaN(c3a) && !isNaN(c3b) && c3a !== 0) {
                  const diff = c3b - c3a;
                  const pct = (diff / c3a) * 100;
                  c3res.textContent = pct.toFixed(2).replace(/\.00$/, '');
             } else c3res.textContent = '-';
        };

        const inputs = document.querySelectorAll('input[type="number"]');
        inputs.forEach(el => el.addEventListener('input', calculate));
    });
</script>

    <Breadcrumb items={[{ name: 'Home', path: '/' }, { name: "Percentage Calculator Online Free – Instant Result", path: "/percentage-calculator" }]} />

    <ToolWrapper title="Percentage Calculator" subtitle="Instant percentage calculations directly in your browser." currentTool="percentage-calculator">
        
        <div slot="tool-ui">
             <div class="workspace-editor">
                  <div class="calculator-stack">
                       <!-- Calc 1 -->
                       <div class="calc-section">
                            <label class="section-label m-0 mb-12">Calculate percentage of a value</label>
                            <div class="calc-card">
                                 <div class="calc-row">
                                      <div class="c-field flex-2">
                                           <span class="l-text m-0 mb-8">What is</span>
                                           <div class="input-container">
                                                <input type="number" id="c1-a" placeholder="20" class="mini-input" />
                                                <span class="i-suffix">%</span>
                                           </div>
                                      </div>
                                      <div class="c-field flex-2">
                                           <span class="l-text m-0 mb-8">of</span>
                                           <div class="input-container">
                                                <input type="number" id="c1-b" placeholder="150" class="mini-input" />
                                           </div>
                                      </div>
                                      <div class="c-arrow flex-1">=</div>
                                      <div class="c-result flex-2"><span id="c1-res">—</span></div>
                                 </div>
                            </div>
                       </div>

                       <!-- Calc 2 -->
                       <div class="calc-section">
                            <label class="section-label m-0 mb-12">Find the percentage relationship</label>
                            <div class="calc-card">
                                 <div class="calc-row">
                                      <div class="c-field flex-2">
                                           <span class="l-text m-0 mb-8 d-none d-sm-block">&nbsp;</span>
                                           <div class="input-container">
                                                <input type="number" id="c2-a" placeholder="30" class="mini-input" />
                                           </div>
                                      </div>
                                      <div class="c-field flex-3">
                                           <span class="l-text m-0 mb-8">is what % of</span>
                                           <div class="input-container">
                                                <input type="number" id="c2-b" placeholder="150" class="mini-input" />
                                           </div>
                                      </div>
                                      <div class="c-arrow flex-1">=</div>
                                      <div class="c-result flex-2"><span id="c2-res">—</span>%</div>
                                 </div>
                            </div>
                       </div>

                       <!-- Calc 3 -->
                       <div class="calc-section">
                            <label class="section-label m-0 mb-12">Percentage increase/decrease</label>
                            <div class="calc-card">
                                 <div class="calc-row">
                                      <div class="c-field flex-2">
                                           <span class="l-text m-0 mb-8">From</span>
                                           <div class="input-container">
                                                <input type="number" id="c3-a" placeholder="100" class="mini-input" />
                                           </div>
                                      </div>
                                      <div class="c-field flex-2">
                                           <span class="l-text m-0 mb-8">To</span>
                                           <div class="input-container">
                                                <input type="number" id="c3-b" placeholder="125" class="mini-input" />
                                           </div>
                                      </div>
                                      <div class="c-arrow flex-1">=</div>
                                      <div class="c-result flex-2"><span id="c3-res">—</span>%</div>
                                 </div>
                            </div>
                       </div>
                  </div>
             </div>
        </div>

        <div slot="tool-info">
             <h2>Online Percentage Calculator</h2>
             <p>Our completely free <strong>percentage calculator</strong> computes results dynamically as you type. Whether you are calculating discounts, taxes, or score differences, this tool provides instant feedback without needing to refresh.</p>
             
             <div class="faq-grid mt-32">
                  <details class="faq-item">
                       <summary>How to find the percentage of a number?</summary>
                       <p>To find X% of Y, multiply the number (Y) by the percentage (X) and then divide by 100.</p>
                  </details>
                  <details class="faq-item">
                       <summary>Is this calculator accurate for finance?</summary>
                       <p>Yes, our calculator uses high-precision JavaScript floating-point math, making it perfect for VAT calculations and discount planning.</p>
                  </details>
             </div>
        </div>
    </ToolWrapper>
</BaseLayout><style>
    .workspace-editor { display: flex; flex-direction: column; width: 100%; max-width: 800px; margin: 0 auto; background: var(--surface-3); border: 1px solid var(--border-subtle); border-radius: 24px; padding: 32px; }

    .calculator-stack { display: flex; flex-direction: column; gap: 32px; }
    .section-label { font-size: 0.75rem; font-weight:600; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em; display: block; }
    
    .calc-card { background:var(--surface-3); border: 1px solid var(--border-subtle); border-radius: 16px; padding: 24px; box-shadow: var(--shadow-sm); }
    .calc-row { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; }
    
    .c-field { display: flex; flex-direction: column; }
    .l-text { font-size: 0.85rem; font-weight:600; color: var(--text-muted); display: block; }
    
    .input-container { display: flex; align-items: center; background:var(--surface-3); border: 1px solid var(--border-subtle); border-radius: 12px; overflow: hidden; transition: 0.2s; box-shadow: inset 0 2px 4px rgba(0,0,0,0.02); box-sizing: border-box; }
    .input-container:focus-within { border-color: var(--accent-primary); background:var(--surface-3); box-shadow: 0 0 0 3px rgba(var(--accent-rgb), 0.1); }
    .mini-input { width: 100%; padding: 16px; border: none; outline: none; font-size: 1.2rem; font-weight:600; color: var(--text-primary); background: transparent; }
    .i-suffix { padding-right: 16px; font-weight:600; color: var(--text-muted); font-size: 1.1rem; }

    .c-arrow { font-size: 1.5rem; font-weight:600; color: var(--text-muted); text-align: center; }
    .c-result { font-size: 2rem; font-weight:600; color: var(--accent-primary); text-align: right; word-break: break-all; line-height: 1; }

    /* FAQ */
    .faq-grid { display: grid; gap: 16px; }
    .faq-item { background:var(--surface-3); border: 1px solid var(--border-subtle); border-radius: var(--radius-sm); overflow: hidden; text-align: left; }
    .faq-item summary { font-weight:600; font-size: 1rem; padding: 16px 20px; cursor: pointer; color: var(--text-primary); list-style-type: none; position: relative; }
    .faq-item summary::after { content: '+'; position: absolute; right: 20px; font-weight:600; font-size: 1.2rem; color: var(--accent-primary); }
    .faq-item[open] summary::after { content: '−'; }
    .faq-item p { padding: 0 20px 20px; margin: 0; font-size: 0.95rem; color: var(--text-muted); line-height: 1.6; }


    @media (min-width: 641px) {
        .d-sm-block { display: block; }
    }

    @media (max-width: 640px) {
        .workspace-editor { padding: 24px; }
        .c-arrow { display: none; }
        .c-result { text-align: left; width: 100%; border-top: 1px solid var(--border-subtle); padding-top: 16px; margin-top: 8px; font-size: 1.75rem; }
        .calc-row { flex-direction: column; align-items: stretch; gap: 12px; }
        .c-field { width: 100%; }
        .d-sm-block { display: none; }
    }
</style>
