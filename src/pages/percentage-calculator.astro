---
import BaseLayout from '../components/BaseLayout.astro';
import RelatedTools from '../components/RelatedTools.astro';

const PAGE_TITLE = 'Percentage Calculator Online Free – Instant Result';
const PAGE_DESC = 'Calculate percentages instantly in your browser. Find X% of Y, or what percentage X is of Y. Fast, free, no ads.';
const PAGE_KEYWORDS = 'percentage calculator, calculate percentage online, math calculator, percentage tool';
---

<BaseLayout title={PAGE_TITLE} description={PAGE_DESC} keywords={PAGE_KEYWORDS} active="tools" canonicalPath="/percentage-calculator">
    <div class="tool-wrapper animate-in">
        <header class="tool-intro text-center">
             <div class="brand-badge shadow-sm">🧮 Smart Calculator</div>
             <h1 class="main-h1">Percentage <span class="highlight">Calculator</span></h1>
             <p class="hero-sub">Instant percentage calculations directly in your browser without reloading.</p>
        </header>

        <div class="glass-card tool-content shadow-lg">
            
             <!-- Calc 1 -->
             <div class="calc-row">
                  <div class="c-group">
                       <label>What is</label>
                       <div class="input-wrap">
                           <input type="number" id="c1-a" placeholder="20" />
                           <span class="suffix">%</span>
                       </div>
                  </div>
                  <div class="c-group">
                       <label>of</label>
                       <div class="input-wrap">
                           <input type="number" id="c1-b" placeholder="150" />
                       </div>
                  </div>
                  <div class="equal-sign">=</div>
                  <div class="c-res"><span id="c1-res">30</span></div>
             </div>

             <!-- Calc 2 -->
             <div class="calc-row mt-32">
                  <div class="c-group">
                       <div class="input-wrap">
                           <input type="number" id="c2-a" placeholder="30" />
                       </div>
                  </div>
                  <div class="c-group">
                       <label>is what % of</label>
                       <div class="input-wrap">
                           <input type="number" id="c2-b" placeholder="150" />
                       </div>
                  </div>
                  <div class="equal-sign">=</div>
                  <div class="c-res"><span id="c2-res">20</span>%</div>
             </div>

             <!-- Calc 3 -->
             <div class="calc-row mt-32">
                  <div class="c-group">
                       <label>Percentage increase from</label>
                       <div class="input-wrap">
                           <input type="number" id="c3-a" placeholder="100" />
                       </div>
                  </div>
                  <div class="c-group">
                       <label>to</label>
                       <div class="input-wrap">
                           <input type="number" id="c3-b" placeholder="120" />
                       </div>
                  </div>
                  <div class="equal-sign">=</div>
                  <div class="c-res"><span id="c3-res">20</span>%</div>
             </div>

        </div>

        <article class="pro-seo-article container mt-48">
             <h2>Online Percentage Calculator</h2>
             <p>Our completely free <strong>percentage calculator</strong> computes results dynamically as you type. Whether you are calculating discounts, taxes, or score differences, this tool provides instant feedback without needing to refresh or bounce pages. Understanding <strong>how to find percentage of a number</strong> is essential for finance, retail, and academics. Our <strong>percentage difference calculator</strong> handles complex increases or decreases with absolute mathematical precision.</p>
             
             <h3 class="mt-32">Frequently Asked Questions</h3>
             <details class="faq-item">
                  <summary>How to find the percentage of a number?</summary>
                  <p>To find X% of Y, multiply the number (Y) by the percentage (X) and then divide by 100. For example, 20% of 150 is (20 * 150) / 100 = 30. Our <strong>online math tool</strong> does this instantly as you type.</p>
             </details>
             <details class="faq-item">
                  <summary>How to calculate percentage increase?</summary>
                  <p>Subtract the original value from the new value, then divide that difference by the original value. Multiply the result by 100 to get the percentage. Example: Increase from 100 to 125 is a 25% increase.</p>
             </details>
             <details class="faq-item">
                  <summary>What is percentage decrease?</summary>
                  <p>Percentage decrease is the percentage reduction from an original quantity. Use our "Percentage increase/decrease" section, and if the result is negative, it represents a percentage decrease.</p>
             </details>
             <details class="faq-item">
                  <summary>Is this calculator accurate for finance?</summary>
                  <p>Yes, our calculator uses high-precision JavaScript floating-point math, making it perfect for VAT calculations, discount planning, and basic investment yield checks.</p>
             </details>
        </article>

        <RelatedTools currentTool="tools" />
    </div>
</BaseLayout>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const calculate = () => {
             // Calc 1: X% of Y
             const c1a = parseFloat((document.getElementById('c1-a') as HTMLInputElement).value);
             const c1b = parseFloat((document.getElementById('c1-b') as HTMLInputElement).value);
             const c1res = document.getElementById('c1-res') as HTMLElement;
             if (!isNaN(c1a) && !isNaN(c1b)) c1res.textContent = ((c1a / 100) * c1b).toFixed(2).replace(/\.00$/, '');
             else c1res.textContent = '-';

             // Calc 2: X is what % of Y
             const c2a = parseFloat((document.getElementById('c2-a') as HTMLInputElement).value);
             const c2b = parseFloat((document.getElementById('c2-b') as HTMLInputElement).value);
             const c2res = document.getElementById('c2-res') as HTMLElement;
             if (!isNaN(c2a) && !isNaN(c2b) && c2b !== 0) c2res.textContent = ((c2a / c2b) * 100).toFixed(2).replace(/\.00$/, '');
             else c2res.textContent = '-';

             // Calc 3: Increase/Decrease %
             const c3a = parseFloat((document.getElementById('c3-a') as HTMLInputElement).value);
             const c3b = parseFloat((document.getElementById('c3-b') as HTMLInputElement).value);
             const c3res = document.getElementById('c3-res') as HTMLElement;
             if (!isNaN(c3a) && !isNaN(c3b) && c3a !== 0) {
                  const diff = c3b - c3a;
                  const pct = (diff / c3a) * 100;
                  c3res.textContent = pct.toFixed(2).replace(/\.00$/, '');
             } else c3res.textContent = '-';
        };

        const inputs = document.querySelectorAll('input[type="number"]');
        inputs.forEach(el => el.addEventListener('input', calculate));
    });
</script>

<style>
    .main-h1 { font-size: 3rem; font-weight: 1000; letter-spacing: -0.05em; margin-bottom: 12px; color: var(--dark); line-height: 1.1; }
    .hero-sub { color: var(--slate); font-weight: 600; font-size: 1.15rem; margin-bottom: 24px; }
    .tool-wrapper { max-width: 860px; margin: 0 auto; padding-bottom: 100px; }
    
    .calc-row { display: flex; align-items: flex-end; gap: 16px; background: #f8fafc; border: 1.5px solid var(--border); border-radius: 20px; padding: 24px; flex-wrap: wrap; }
    .c-group { display: flex; flex-direction: column; gap: 8px; flex: 1; min-width: 140px; }
    .c-group label { font-size: 0.8rem; font-weight: 950; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.05em; }
    
    .input-wrap { display: flex; align-items: center; background: #fff; border: 2px solid var(--border); border-radius: 12px; overflow: hidden; transition: 0.3s; }
    .input-wrap:focus-within { border-color: var(--primary); }
    .input-wrap input { width: 100%; padding: 16px; border: none; outline: none; font-size: 1.25rem; font-weight: 900; color: var(--dark); }
    .input-wrap .suffix { padding-right: 16px; font-weight: 900; color: var(--gray); font-size: 1.2rem; }

    .equal-sign { font-size: 2rem; font-weight: bold; color: #cbd5e1; padding-bottom: 8px; }
    .c-res { flex: 1; font-size: 2rem; font-weight: 1000; color: var(--primary); text-align: right; word-break: break-all; min-width: 120px; }

    @media (max-width: 640px) {
        .equal-sign { display: none; }
        .c-res { text-align: left; width: 100%; border-top: 1.5px solid var(--border); padding-top: 16px; }
    }

    /* FAQ */
    .faq-item { background: #fff; border: 1.5px solid var(--border); border-radius: 16px; margin-bottom: 16px; overflow: hidden; text-align: left; margin-top: 16px; }
    .faq-item summary { font-weight: 900; font-size: 1.1rem; padding: 20px; cursor: pointer; color: var(--dark); list-style-type: none; position: relative; }
    .faq-item summary::after { content: '+'; position: absolute; right: 24px; font-weight: bold; font-size: 1.4rem; color: var(--primary); }
    .faq-item[open] summary::after { content: '−'; }
    .faq-item p { padding: 0 20px 20px; margin: 0; font-size: 1rem; color: var(--slate); line-height: 1.6; }

    .mt-48 { margin-top: 48px; }
    .mt-32 { margin-top: 32px; }
</style>
