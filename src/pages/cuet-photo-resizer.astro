---
import BaseLayout from '../components/BaseLayout.astro';
import RelatedTools from '../components/RelatedTools.astro';
import CompressTool from '../components/tools/CompressTool.astro';
import SocialShare from '../components/SocialShare.astro';

const PAGE_TITLE = 'CUET Photo & Signature Resizer 2024 - FormFix';
const PAGE_DESC = 'Compress your CUET online application photo (10KB - 200KB) and signature (4KB - 30KB) instantly. Free, 100% private, and works completely offline.';
const PAGE_KEYWORDS = 'cuet photo size, cuet photo compressor, cuet signature resizer, compress photo for cuet exam, nta cuet photo format';

const customSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      "name": "CUET Photo Compressor - FormFix",
      "operatingSystem": "All Platforms",
      "applicationCategory": "UtilitiesApplication",
      "description": PAGE_DESC,
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      }
    },
    {
      "@type": "Guide",
      "name": "CUET UG/PG Official Image Guidelines",
      "description": "Image format and size requirements for the Common University Entrance Test (CUET).",
      "text": "Photograph Size: 10KB to 200KB. Signature Size: 4KB to 30KB. Document/Certificate PDF: 50KB to 300KB."
    }
  ]
};
---

<BaseLayout title={PAGE_TITLE} description={PAGE_DESC} keywords={PAGE_KEYWORDS} customSchema={customSchema} active="tools" canonicalPath="/cuet-photo-resizer">
    <div class="tool-wrapper animate-in">
        <header class="tool-intro text-center">
             <div class="brand-badge shadow-sm">🎓 NTA CUET Special</div>
             <h1 class="main-h1">CUET <span class="highlight">Photo Formatter</span></h1>
             <p class="hero-sub">Resize your photograph and signature precisely for the CUET application portal. Zero server uploads to ensure absolute privacy.</p>
        </header>

        <section class="exam-guidelines mb-32 p-20 glass-inner shadow-sm rounded-2xl">
            <h2 class="text-xl font-black mb-10">CUET Official Requisites:</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div class="g-item p-16 bg-primary/5 rounded-xl border border-primary/10">
                    <strong class="block text-primary">Scanned Photograph</strong>
                    <span>10KB to 200KB | JPG or JPEG</span>
                </div>
                <div class="g-item p-16 bg-purple/5 rounded-xl border border-purple/10">
                    <strong class="block text-purple">Scanned Signature</strong>
                    <span>4KB to 30KB | JPG or JPEG</span>
                </div>
            </div>
        </section>

        <CompressTool />

        <article class="pro-seo-article container mt-48">
             <h2>The Quickest CUET Photo Settings Updater</h2>
             <p>Navigating the <strong>CUET (Common University Entrance Test)</strong> application form shouldn't be stressful because of an invalid photo size. With FormFix's dedicated <strong>CUET photo resizer</strong>, getting your files within the required 10-200KB (for photos) or 4-30KB (for signatures) interval is as easy as selecting a preset.</p>
             
             <h3 class="mt-32">Steps to properly size your CUET files:</h3>
             <ol>
                <li>Upload the relevant file: your face photograph or scanned signature.</li>
                <li>Enter the desired KB amount (we recommend 100KB for photos, 20KB for signatures).</li>
                <li>Verify the original vs new size on the screen, then download.</li>
                <li>Submit your NTA form without getting validation errors!</li>
             </ol>

             <p class="mt-20"><strong>Client-Side Processing:</strong> FormFix never sends your photos across the internet. Everything is calculated right on your mobile or desktop memory to keep you protected.</p>
        </article>

        <SocialShare title="Use this site to compress your CUET photos and signatures easily! The NTA portal accepts it right away." url="https://formfix.pages.dev/cuet-photo-resizer" />

        <RelatedTools currentTool="compress" />
    </div>
</BaseLayout>

<style>
    .main-h1 { font-size: 3rem; font-weight: 1000; letter-spacing: -0.05em; margin-bottom: 12px; color: var(--dark); line-height: 1.1; }
    .hero-sub { color: var(--slate); font-weight: 600; font-size: 1.15rem; margin-bottom: 24px; max-width: 600px; margin-inline: auto; }
    .tool-wrapper { max-width: 860px; margin: 0 auto; padding-bottom: 100px; }
    .mt-48 { margin-top: 48px; }
    .mt-32 { margin-top: 32px; }
    .mb-32 { margin-bottom: 32px; }
    .p-20 { padding: 20px; }
    .p-16 { padding: 16px; }
</style>
