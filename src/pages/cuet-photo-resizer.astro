---
import BaseLayout from '../components/BaseLayout.astro';
import ToolWrapper from '../components/ToolWrapper.astro';

const PAGE_TITLE = 'CUET Photo Resizer & Signature Maker Online | FormFix';
const PAGE_DESC = 'Official CUET (UG/PG) photo resizer. Convert your photo to 10KB-200KB and signature to 4KB-30KB exactly as per NTA CUET guidelines. 100% private and free.';
const PAGE_KEYWORDS = 'cuet photo resizer, cuet signature maker, nta cuet photo size online, compress photo for cuet, cuet ug form photo maker, cuet pg photo resize';

const customSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "CUET Form Optimizer",
  "description": "Specialized tool for NTA CUET candidates to format photos and signatures.",
  "applicationCategory": "MultimediaApplication",
  "operatingSystem": "All"
};
---

<BaseLayout title={PAGE_TITLE} description={PAGE_DESC} keywords={PAGE_KEYWORDS} customSchema={customSchema} active="tools" canonicalPath="/cuet-photo-resizer">
    <ToolWrapper 
        title="CUET Exam Optimizer" 
        subtitle="Specially built for NTA CUET candidates. Get your documents form-ready in seconds."
        currentTool="cuet-optimizer"
    >
        <div slot="tool-ui">
             <div class="cuet-workspace">
                 <div class="cuet-alert">
                     <strong>CUET Requirement:</strong> Photo (10KB-200KB) and Signature (4KB-30KB). Must be in JPG/JPEG format.
                 </div>
                 <div class="tool-actions-centered">
                     <a href="/passport-size-photo" class="primary-btn pulse-glow">Create CUET Photos →</a>
                     <a href="/compress-image" class="secondary-btn">Compress to 50KB</a>
                 </div>
             </div>
        </div>

        <div slot="tool-info">
             <article class="prose">
                 <h2>Official NTA CUET UG/PG Photo & Signature Guidelines</h2>
                 <p>The Common University Entrance Test (CUET) handled by NTA requires candidates to upload clear, recent photographs and signatures. Any deviation from the specified file size can lead to the "Image Not Uploaded" error on the CUET portal.</p>
                 
                 <div class="guideline-card">
                     <h3>CUET Photograph Specifications:</h3>
                     <ul>
                         <li><strong>File Size:</strong> 10 KB to 200 KB.</li>
                         <li><strong>Format:</strong> JPG/JPEG only.</li>
                         <li><strong>Background:</strong> White background is preferred.</li>
                         <li><strong>Visibility:</strong> 80% face coverage, no mask, both ears visible.</li>
                     </ul>
                 </div>

                 <div class="guideline-card mt-24">
                     <h3>CUET Signature Specifications:</h3>
                     <ul>
                         <li><strong>File Size:</strong> 4 KB to 30 KB.</li>
                         <li><strong>Format:</strong> JPG/JPEG only.</li>
                         <li><strong>Instruction:</strong> Sign on white paper with black ink.</li>
                     </ul>
                 </div>

                 <h2>How to Resize Photo for CUET Online</h2>
                 <ol>
                     <li><strong>Choose Tool:</strong> Click on "Create CUET Photos" above.</li>
                     <li><strong>Upload:</strong> Select your passport photo or signature image.</li>
                     <li><strong>Aspect Ratio:</strong> Use the standard 3.5x4.5cm for photos.</li>
                     <li><strong>Target KB:</strong> Set the compressor to 100KB for photos and 20KB for signatures to stay within the safe range.</li>
                     <li><strong>Download:</strong> Save the JPEG and upload it directly to the cuet.samarth.ac.in portal.</li>
                 </ol>

                 <div class="faq-section mt-48">
                     <h3>CUET Photo Upload FAQ</h3>
                     <details class="minimal-faq">
                         <summary>What is the photo size for CUET 2024? <span class="indicator">+</span></summary>
                         <div class="faq-body">
                             <p>The file size must be between 10KB and 200KB for the photograph and 4KB to 30KB for the signature.</p>
                         </div>
                     </details>
                     <details class="minimal-faq">
                         <summary>Can I upload a selfie for CUET? <span class="indicator">+</span></summary>
                         <div class="faq-body">
                             <p>No. Selfies are strictly prohibited. You must use a professional passport-sized photograph with a neutral expression.</p>
                         </div>
                     </details>
                 </div>
             </article>
        </div>
    </ToolWrapper>
</BaseLayout>

<style>
    .cuet-workspace { text-align: center; padding: 20px 0; }
    .cuet-alert { background: #eef2ff; border-left: 4px solid #6366f1; padding: 16px; border-radius: 8px; margin-bottom: 32px; color: #3730a3; font-size: 0.95rem; }
    .tool-actions-centered { display: flex; gap: 16px; justify-content: center; align-items: center; }
    .guideline-card { background: var(--surface-50); border: 1px solid var(--border-subtle); padding: 24px; border-radius: 16px; }
    .guideline-card h3 { margin-bottom: 12px; font-size: 1.1rem; }
    .guideline-card ul { padding-left: 20px; color: var(--text-muted); }
    .guideline-card li { margin-bottom: 8px; }
</style>
