---
import BaseLayout from '../components/BaseLayout.astro';
import ToolWrapper from '../components/ToolWrapper.astro';

const PAGE_TITLE = 'Compress Image to 20KB Online - Professional Size Reducer | FormFix';
const PAGE_DESC = 'Easily compress any JPEG, PNG, or WebP image to exactly 20KB or less. Perfect for official portals, passports, and ID applications globally. 100% private processing.';
const PAGE_KEYWORDS = 'compress image to 20kb, reduce image size to 20kb online, image compressor 20kb, 20kb photo resizer, official form photo compressor';

const customSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "20KB Image Compressor",
  "description": "High-precision compression tool for meeting strict 20KB file size limits on official portals.",
  "applicationCategory": "MultimediaApplication",
  "operatingSystem": "All"
};
---

<BaseLayout title={PAGE_TITLE} description={PAGE_DESC} keywords={PAGE_KEYWORDS} customSchema={customSchema} active="tools" canonicalPath="/compress-image-to-20kb">
    <ToolWrapper 
        title="20KB Precision Compressor" 
        subtitle="Hit exact file size targets for official portals and digital IDs worldwide."
        currentTool="compress-20kb"
    >
        <div slot="tool-ui">
             <div class="global-workspace">
                 <div class="global-alert">
                     <strong>Standard Requirement:</strong> Many official portals require files between 10KB and 20KB for signatures and small photos.
                 </div>
                 <div class="tool-actions-centered">
                     <a href="/compress-image" class="primary-btn pulse-glow">Open 20KB Compressor →</a>
                     <a href="/resize-image" class="secondary-btn">Resize Pixels</a>
                 </div>
             </div>
        </div>

        <div slot="tool-info">
             <article class="prose">
                 <h2>Why use a 20KB Precision Compressor?</h2>
                 <p>Most online application portals—whether for government IDs, university admissions, or professional certifications—have a strict upper limit for file uploads. The <strong>20KB limit</strong> is one of the most common and difficult to hit without losing too much image quality.</p>
                 
                 <div class="feature-grid">
                     <div class="feature-card">
                         <h3>Local Processing</h3>
                         <p>Your document never leaves your browser. We use local RAM for compression, ensuring 100% data privacy.</p>
                     </div>
                     <div class="feature-card">
                         <h3>High Fidelity</h3>
                         <p>Our algorithms prioritize facial features and text clarity even at extremely small file sizes.</p>
                     </div>
                 </div>

                 <h2>How to compress your photo to 20KB</h2>
                 <ol>
                     <li><strong>Launch the Tool:</strong> Click on "Open 20KB Compressor" to start the specialized editor.</li>
                     <li><strong>Select Image:</strong> Upload your photo, signature, or scanned document.</li>
                     <li><strong>Set Target:</strong> Our preset is optimized for the 20KB threshold.</li>
                     <li><strong>Download:</strong> Get your optimized JPG instantly.</li>
                 </ol>

                 <div class="faq-section mt-48">
                     <h3>Global Standard FAQ</h3>
                     <details class="minimal-faq">
                         <summary>Will my photo be blurry at 20KB? <span class="indicator">+</span></summary>
                         <div class="faq-body">
                             <p>While 20KB is very small, our tool uses advanced quantization to keep the image sharp enough for human and machine validation on official portals.</p>
                         </div>
                     </details>
                     <details class="minimal-faq">
                         <summary>Is this tool safe for ID documents? <span class="indicator">+</span></summary>
                         <div class="faq-body">
                             <p>Absolutely. Unlike other compressors, FormFix does NOT upload your files to any server. All processing happens on your own computer.</p>
                         </div>
                     </details>
                 </div>
             </article>
        </div>
    </ToolWrapper>
</BaseLayout>

<style>
    .global-workspace { text-align: center; padding: 20px 0; }
    .global-alert { background: #f0fdf4; border-left: 4px solid #10b981; padding: 16px; border-radius: 8px; margin-bottom: 32px; color: #065f46; font-size: 0.95rem; }
    .tool-actions-centered { display: flex; gap: 16px; justify-content: center; align-items: center; }
    .feature-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin: 32px 0; }
    .feature-card { background: var(--surface-50); border: 1px solid var(--border-subtle); padding: 24px; border-radius: 16px; }
    .feature-card h3 { font-size: 1.1rem; margin-bottom: 12px; }
    .feature-card p { font-size: 0.9rem; color: var(--text-muted); }
    
    @media (max-width: 600px) {
        .feature-grid { grid-template-columns: 1fr; }
    }
</style>
