---
import BaseLayout from '../components/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { SITE_URL } from '../seo';

const PAGE_TITLE = 'Terms of Service | FormFix';
const PAGE_DESC = 'Read the FormFix Terms of Service. Free, client-side, browser-based image and PDF tools. No uploads, no registration.';

const customSchema = {
  '@context': 'https://schema.org',
  '@type': 'TermsOfService',
  name: 'FormFix Terms of Service',
  description: PAGE_DESC,
  url: `${SITE_URL}/terms`,
  publisher: {
    '@type': 'Organization',
    name: 'FormFix',
    url: SITE_URL
  }
};
---

<BaseLayout title={PAGE_TITLE} description={PAGE_DESC} canonicalPath="/terms" customSchema={customSchema}>
    <Breadcrumb items={[{ name: 'Home', path: '/' }, { name: "Terms of Service", path: "/terms" }]} />

    <div class="page">
        <div class="container page-inner">
            <h1>Terms of Service</h1>
            <p class="updated">Effective Date: January 1, 2024</p>

            <section class="section">
                <h2>1. Acceptance of Terms</h2>
                <p>By accessing and using FormFix at <strong>formfix.pages.dev</strong>, you accept and agree to be bound by these terms. This service is provided as a public utility to assist with image processing for document uploads and web optimization.</p>
            </section>

            <section class="section">
                <h2>2. Description of Service</h2>
                <p>FormFix provides various image tools (Compression, Cropping, Resizing, Conversion) that execute entirely in your browser. The service is free and does not require registration.</p>
            </section>

            <section class="section">
                <h2>3. User Responsibilities</h2>
                <p>You are solely responsible for the images you process. Since we never upload your images to our servers, we have no record of your activities. You agree not to use the service for any illegal purposes according to your local laws.</p>
            </section>

            <section class="section">
                <h2>4. Disclaimer of Warranties</h2>
                <p>The service is provided "as is". While we use precise mathematical algorithms for compression, we cannot guarantee that the results will meet the specific requirements of all third-party submission portals.</p>
            </section>

            <section class="section">
                <h2>5. Limitation of Liability</h2>
                <p>In no event shall FormFix or its maintainers be liable for any damages arising out of the use or inability to use the tools, including but not limited to, rejection of documents by third-party systems.</p>
            </section>

            <section class="section">
                <h2>6. Changes to Terms</h2>
                <p>We may revise these terms at any time. By using this website, you agree to be bound by the then-current version of these Terms of Service.</p>
            </section>
        </div>
    </div>
</BaseLayout>

<style>
.page { padding: 32px 0 80px; }
.page-inner { max-width: 760px; }

h1 {
    font-size: clamp(1.5rem, 4vw, 2.2rem);
    font-weight: 600;
    margin-bottom: 8px;
}

.updated {
    color: var(--text-muted);
    margin-bottom: 40px;
    font-size: 0.85rem;
}

.section {
    margin-bottom: 36px;
}

.section h2 {
    font-size: 1.1rem;
    font-weight: 600;
    margin-bottom: 10px;
}

.section p {
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--text-secondary);
}

.section strong {
    color: var(--text-primary);
}
</style>
