---
import BaseLayout from '../components/BaseLayout.astro';
import RelatedTools from '../components/RelatedTools.astro';
import CompressTool from '../components/tools/CompressTool.astro';
import SocialShare from '../components/SocialShare.astro';

export function getStaticPaths() {
  const sizes = [20, 50, 100, 150, 200, 300, 500];
  return sizes.map((size) => ({
    params: { size: size.toString() }
  }));
}

const { size } = Astro.params;

const PAGE_TITLE = `Compress Image to ${size}KB Online - Free, Fast & Private | FormFix`;
const PAGE_DESC = `Reduce photo and image size to exactly ${size}KB without losing quality. 100% private, browser-based compression globally optimized for web portals and forms.`;
const PAGE_KEYWORDS = `compress image to ${size}kb, reduce photo to ${size}kb, resize picture to ${size} kb, global online image compressor`;

const customSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      "name": `${size}KB Image Compressor - FormFix`,
      "operatingSystem": "All Platforms",
      "applicationCategory": "UtilitiesApplication",
      "description": PAGE_DESC,
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      }
    },
    {
      "@type": "HowTo",
      "name": `How to compress photo exactly to ${size}kb`,
      "step": [
        {
          "@type": "HowToStep",
          "text": "Select your photo or document scan from your device."
        },
        {
          "@type": "HowToStep",
          "text": `Set the target size to ${size}KB.`
        },
        {
          "@type": "HowToStep",
          "text": `Download your perfectly sized ${size}KB image instantly without leaving your browser.`
        }
      ]
    }
  ]
};
---

<BaseLayout title={PAGE_TITLE} description={PAGE_DESC} keywords={PAGE_KEYWORDS} customSchema={customSchema} active="compress" canonicalPath={`/compress-image-to-${size}kb`}>
    <div class="tool-wrapper animate-fade-up">
        <header class="tool-intro text-center">
             <div class="brand-badge box-shadow-subtle">🎯 Precision Optimized for {size}KB</div>
             <h1 class="main-h1">Compress Image to <span class="text-gradient hover-lift">{size}KB</span></h1>
             <p class="hero-sub">Achieve pixel-perfect dimensions and precise file sizes effortlessly. We process everything completely locally in your browser for absolute privacy.</p>
        </header>

        <!-- Use the generic compress tool, we let the user type the sizes in the UI -->
        <CompressTool defaultTargetKB={size} />

        <article class="pro-seo-article container mt-64">
             <h2>Expert ${size}KB Image Compression</h2>
             <p>When you are uploading profile pictures, portfolio assets, or official documents to web portals, they almost always require strict file constraints. If you need to <strong>compress an image to exactly {size}KB</strong>, traditional software can be overly complicated and lose massive amounts of quality.</p>
             <p>FormFix is engineered to handle exactly this. By leveraging a high-performance WebAssembly browser engine, we compress your photographs perfectly down to {size} KB—all while maintaining maximum definition. Because we use a <strong>Zero-Persistence Architecture</strong>, your private documents are kept strictly on your local device and never transmitted to our servers.</p>
             
             <h3 class="mt-32">How to Reduce Photo Size to {size}KB Instantly</h3>
             <ol>
                <li>Drag and drop your image file into the dropzone above.</li>
                <li>Enter exactly <strong>{size} KB</strong> into the target constraint box.</li>
                <li>Press the optimize button to let the algorithm analyze and reduce the weight.</li>
                <li>Verify the final size and download your secure format.</li>
             </ol>

             <h3 class="mt-32">Why Use FormFix?</h3>
             <ul>
                <li><strong>Absolute Privacy:</strong> No data is ever intercepted or logged.</li>
                <li><strong>Mathematical Precision:</strong> Designed to hit the exact byte-constraints for global web platforms.</li>
                <li><strong>No Registrations:</strong> Launch directly into the workflow instantly.</li>
             </ul>
        </article>

        <SocialShare title={`Need to compress a photo to exactly ${size}KB? Use this free private tool!`} url={`https://formfix.pages.dev/compress-image-to-${size}kb`} />

        <RelatedTools currentTool="compress" />
    </div>
</BaseLayout>

<style>
    .main-h1 { font-size: clamp(2.5rem, 5vw, 3.5rem); font-weight: 800; letter-spacing: -0.04em; margin-bottom: 16px; color: #000; line-height: 1.1; }
    .hero-sub { color: var(--surface-600); font-weight: 500; font-size: 1.15rem; margin-bottom: 40px; max-width: 600px; margin-inline: auto; line-height: 1.6; }
    .tool-wrapper { max-width: 900px; margin: 0 auto; padding-bottom: 100px; padding-top: 40px; }
    .mt-64 { margin-top: 64px; }
    .mt-32 { margin-top: 32px; }
    
    .brand-badge {
        display: inline-block;
        padding: 6px 16px;
        background: #fff;
        border: 1px solid var(--border-subtle);
        border-radius: var(--radius-full);
        font-size: 0.9rem;
        font-weight: 700;
        margin-bottom: 24px;
        color: var(--surface-600);
    }
    
    .text-gradient {
        background: linear-gradient(135deg, #111 0%, #666 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        border-bottom: 4px solid #111;
        padding-bottom: 2px;
    }

    .pro-seo-article {
        background: #fff;
        padding: 48px;
        border-radius: 16px;
        border: 1px solid var(--border-subtle);
        box-shadow: 0 10px 40px -10px rgba(0,0,0,0.05);
    }
    .pro-seo-article h2, .pro-seo-article h3 {
        color: #000;
        font-weight: 800;
        letter-spacing: -0.02em;
        margin-bottom: 16px;
    }
    .pro-seo-article p { color: var(--surface-600); line-height: 1.8; margin-bottom: 24px; font-size: 1.05rem; }
    .pro-seo-article ol, .pro-seo-article ul { padding-left: 24px; color: var(--surface-600); font-size: 1.05rem; line-height: 1.8; }
    .pro-seo-article li { margin-bottom: 12px; }
    .pro-seo-article li strong { color: #000; }
    
    @media (max-width: 768px) {
        .pro-seo-article { padding: 24px; }
        .main-h1 { font-size: 2.5rem; }
    }
</style>
