---
import BaseLayout from '../components/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import ToolWrapper from '../components/ToolWrapper.astro';

const PAGE_TITLE = 'Digital Signature Maker Online | Create Free Signatures | FormFix';
const PAGE_DESC = 'Create your perfect digital signature online. Draw or type your name with 65+ professional fonts. Download as a transparent PNG.';
const PAGE_KEYWORDS = 'digital signature maker, online signature generator, draw signature online, create digital signature, signature fonts online, electronic signature free';

const customSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      "name": "FormFix Pro Signature Maker",
      "operatingSystem": "All",
      "applicationCategory": "UtilitiesApplication",
      "description": "50+ Premium Signature Fonts and an auto-enhancing draw pad to export transparent signatures.",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      }
    }
  ]
};

const fontList = [
  "Alex Brush", "Allura", "Bad Script", "Bilbo", "Caveat", "Cedarville Cursive", "Charm", "Clicker Script", 
  "Cookie", "Courgette", "Covered By Your Grace", "Damion", "Dancing Script", "Delius", "Engagement", 
  "Euphoria Script", "Felipa", "Fondamento", "Gochi Hand", "Grand Hotel", "Great Vibes", "Handlee", 
  "Herr Von Muellerhoff", "Homemade Apple", "Indie Flower", "Italianno", "Just Another Hand", "Kaushan Script", 
  "Kristi", "La Belle Aurore", "League Script", "Leckerli One", "Loved by the King", "Marck Script", "Meddon", 
  "Meie Script", "Miss Fajardose", "Monsieur La Doulaise", "Mr Bedfort", "Mr Dafoe", "Mr De Haviland", 
  "Nothing You Could Do", "Over the Rainbow", "Pacifico", "Parisienne", "Patrick Hand", "Petit Formal Script", 
  "Pinyon Script", "Qwigley", "Reenie Beanie", "Rochester", "Rouge Script", "Ruge Boogie", "Ruthie", 
  "Sacramento", "Satisfy", "Shadows Into Light", "Stalemate", "Sue Ellen Francisco", "Tangerine", 
  "Whisper", "WindSong", "Yesteryear", "Yellowtail", "Zeyada"
];

const googleFontsUrl = "https://fonts.googleapis.com/css2?" + fontList.map(font => `family=${font.replace(/ /g, '+')}`).join('&') + "&display=swap";
---

<BaseLayout title={PAGE_TITLE} description={PAGE_DESC} keywords={PAGE_KEYWORDS} customSchema={customSchema} active="tools" canonicalPath="/signature-maker">
    <Breadcrumb items={[{ name: 'Home', path: '/' }, { name: "Digital Signature Maker Online | Create Free Signatures", path: "/signature-maker" }]} />

    <link href={googleFontsUrl} rel="stylesheet" />

    <ToolWrapper title="Signature Maker" subtitle="Draw smoothly or type your name with 65+ premium professional fonts." currentTool="signature-maker">
        
        <div slot="tool-ui">
             <div class="workspace-editor">
                  <div class="tabs-group mb-24">
                       <button id="tab-draw" class="tab-pill active">🖍️ Draw Flow</button>
                       <button id="tab-type" class="tab-pill">⌨️ Type Name</button>
                  </div>

                  <div class="settings-grid mb-24">
                       <div class="config-card shadow-sm">
                            <label class="section-label mb-12">Ink Selection</label>
                            <div class="ink-selector" id="color-picker">
                                 <button class="ink-dot active" data-col="#000000" style="background:#000000;"></button>
                                 <button class="ink-dot" data-col="#1d4ed8" style="background:#1d4ed8;"></button>
                                 <button class="ink-dot" data-col="#dc2626" style="background:#dc2626;"></button>
                                 <input type="color" id="custom-color" class="ink-custom" title="Custom color" />
                            </div>
                       </div>
                       
                       <div id="draw-actions" class="config-card shadow-sm">
                            <label class="section-label mb-12">Drawing Engine</label>
                            <div class="d-flex align-center gap-12">
                                 <button id="enhance-btn" class="secondary-btn btn-sm">✨ Auto Smooth</button>
                                 <span id="enhance-pill" class="status-pill inverse hidden">Vectorized</span>
                            </div>
                       </div>
                  </div>

                   <div class="studio-workspace shadow-sm">
                        <!-- DRAW VIEW -->
                        <div id="view-draw" class="view-panel">
                            <div class="draw-pad">
                                <canvas id="sign-canvas"></canvas>
                                <div id="draw-hint" class="draw-hint">
                                    <span style="font-size:2rem;">✍️</span>
                                    <p style="margin:8px 0 0;font-size:0.85rem;font-weight:600;color:var(--text-muted);">Draw your signature here with mouse or finger</p>
                                </div>
                            </div>
                        </div>

                       <!-- TYPE VIEW -->
                       <div id="view-type" class="view-panel hidden">
                            <input type="text" id="type-input" class="signature-field" placeholder="Signature Name..." />
                            <div class="font-gallery scroll-container" id="font-selector">
                                 {fontList.map((font, idx) => (
                                     <button 
                                        class={`font-card ${idx === 0 ? 'active' : ''}`} 
                                        data-font={`'${font}', cursive`} 
                                        style={`font-family: '${font}', cursive`}
                                     >
                                         {font}
                                     </button>
                                 ))}
                            </div>
                       </div>
                  </div>

                  <div class="action-footer mt-24">
                       <button id="clear-btn" class="secondary-btn flex-1 py-16">↺ Reset Pad</button>
                       <button id="download-btn" class="primary-btn flex-2 py-16">Download Transparent PNG</button>
                  </div>
                  <p class="privacy-note text-center mt-16 font-600">🔒 100% Browser-side. Safe for legal documents.</p>
             </div>
        </div>

        <div slot="tool-info">
             <h2>Ultimate Digital Signature Studio</h2>
             <p>Our <strong>Signature Maker</strong> is the most advanced tool for creating electronic signatures. Whether you prefer hand-drawing or selecting from a professional font library, we ensure your signature looks crisp and authentic. The entire process happens locally, ensuring your personal identity data is never shared.</p>
             
             <div class="faq-grid mt-32">
                  <details class="faq-item">
                       <summary>Is this signature legally binding?</summary>
                       <p>In most jurisdictions including the US (ESIGN Act) and UK (eIDAS), digital signatures are legally recognized for most business and personal documents. We generate high-quality transparent PNGs that can be used on any electronic form.</p>
                  </details>
                  <details class="faq-item">
                       <summary>Can I use this on a phone?</summary>
                       <p>Yes. Our studio is fully touch-optimized. Using your finger or a stylus on a smartphone provides an even more natural handwriting feel than a mouse.</p>
                  </details>
             </div>
        </div>
    </ToolWrapper>
</BaseLayout>



<style>
    .workspace-editor { display: flex; flex-direction: column; width: 100%; max-width: 800px; margin: 0 auto; }
    
    .tabs-group { display: flex; background: var(--surface-100); padding: 4px; border-radius: 12px; }
    .tab-pill { flex: 1; padding: 12px; border-radius: 10px; font-weight: 600; font-size: 0.95rem; background: transparent; border: none; cursor: pointer; transition: 0.2s; color: var(--text-muted); }
    .tab-pill.active { background: var(--surface-3); color: var(--text-main); box-shadow: var(--shadow-sm); }

    .settings-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
    .config-card { padding: 16px; background: var(--surface-50); border-radius: var(--radius-md); border: 1px solid var(--border-subtle); }
    .section-label { font-size: 0.72rem; font-weight: 600; color: var(--surface-500); text-transform: uppercase; letter-spacing: 0.05em; display: block; margin-bottom: 12px; }
    
    .ink-selector { display: flex; gap: 12px; }
    .ink-dot { width: 32px; height: 32px; border-radius: 50%; border: 3px solid var(--border-subtle); cursor: pointer; transition: 0.2s; box-shadow: var(--shadow-sm); }
    .ink-dot.active { transform: scale(1.15); box-shadow: 0 0 0 2px var(--accent-primary); }

    .status-pill { background: var(--success-soft); color: var(--success); padding: 4px 12px; border-radius: 100px; font-size: 0.75rem; font-weight: 600; }
    .status-pill.inverse { background: var(--accent-soft); color: var(--accent-primary); }
    .btn-sm { padding: 8px 16px; font-size: 0.85rem; }

    .studio-workspace { background: var(--surface-3); border: 1px solid var(--border-subtle); border-radius: var(--radius-md); overflow: hidden; }
    .view-panel { }
    .draw-pad { background: #ffffff; height: 320px; display: flex; align-items: center; justify-content: center; touch-action: none; position: relative; }
    .draw-hint { position: absolute; text-align: center; pointer-events: none; transition: opacity 0.3s; }
    .draw-hint.hidden { opacity: 0; }
    #sign-canvas { max-width: 100%; max-height: 100%; cursor: crosshair; }

    .signature-field { width: 100%; padding: 24px; font-size: 2.5rem; text-align: center; border-radius: 0; border: none; border-bottom: 2px solid var(--border-subtle); background: var(--surface-3); outline: none; transition: 0.2s; }
    .signature-field:focus { border-color: var(--accent-primary); }

    .font-gallery { display: grid; grid-template-columns: repeat(auto-fill, minmax(130px, 1fr)); gap: 12px; max-height: 350px; overflow-y: auto; padding: 20px; background: var(--surface-50); }
    .font-gallery::-webkit-scrollbar { width: 6px; }
    .font-gallery::-webkit-scrollbar-thumb { background: var(--border-subtle); border-radius: 10px; }
    .font-card { padding: 12px; background: var(--surface-3); border: 1px solid var(--border-subtle); border-radius: 10px; font-size: 1.25rem; cursor: pointer; transition: 0.2s; text-align: center; color: var(--text-main); height: 60px; display: flex; align-items: center; justify-content: center; overflow: hidden; }
    .font-card:hover { border-color: var(--accent-primary); transform: translateY(-2px); }
    .font-card.active { border-color: var(--accent-primary); color: #fff; background: var(--accent-primary); }

    .action-footer { display: flex; gap: 16px; }
    .privacy-note { font-size: 0.8rem; color: var(--text-muted); }

    .faq-grid { display: grid; gap: 16px; }
    .faq-item { background: var(--surface-3); border: 1px solid var(--border-subtle); border-radius: var(--radius-sm); overflow: hidden; text-align: left; }
    .faq-item summary { font-weight: 600; font-size: 1rem; padding: 16px 20px; cursor: pointer; color: var(--text-main); list-style-type: none; position: relative; }
    .faq-item summary::after { content: '+'; position: absolute; right: 20px; font-weight:600; font-size: 1.2rem; color: var(--accent-primary); }
    .faq-item[open] summary::after { content: '−'; }
    .faq-item p { padding: 0 20px 20px; margin: 0; font-size: 0.95rem; color: var(--text-muted); line-height: 1.6; }

    .d-flex { display: flex; }
    .align-center { align-items: center; }
    .gap-12 { gap: 12px; }
    .mb-8 { margin-bottom: 8px; }
    .mb-12 { margin-bottom: 12px; }
    .mb-16 { margin-bottom: 16px; }
    .mb-24 { margin-bottom: 24px; }
    .mt-16 { margin-top: 16px; }
    .mt-24 { margin-top: 24px; }
    .mt-32 { margin-top: 32px; }
    .py-16 { padding-top: 16px; padding-bottom: 16px; }
    .flex-1 { flex: 1; }
    .flex-2 { flex: 2; }
    .text-center { text-align: center; }
    .font-600 { font-weight: 600; }
    .hidden { display: none !important; }

    @media (max-width: 640px) {
        .action-footer { flex-direction: column; }
        .settings-grid { grid-template-columns: 1fr; }
        .signature-field { font-size: 1.8rem; }
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const tabDraw = document.getElementById('tab-draw');
        const tabType = document.getElementById('tab-type');
        const viewDraw = document.getElementById('view-draw');
        const viewType = document.getElementById('view-type');
        const typeInput = document.getElementById('type-input');
        
        const canvas = document.getElementById('sign-canvas');
        const ctx = canvas?.getContext('2d');
        
        let isDrawing = false;
        let isTypeMode = false;
        let strokeColor = '#000000';
        let currentFont = "'Alex Brush', cursive";

        const enhanceBtn = document.getElementById('enhance-btn');
        const enhanceStatus = document.getElementById('enhance-pill');
        const drawActions = document.getElementById('draw-actions');

        let rawStrokes = [];
        let currentStroke = [];
        let isEnhanced = false;

        function setupCanvas() {
            const rect = canvas?.parentElement?.getBoundingClientRect();
            if (!rect || !canvas || !ctx) return;
            canvas.width = rect.width;
            canvas.height = rect.width > 400 ? 250 : 200;
            
            ctx.lineCap = 'round';
            ctx.lineJoin = 'round';
            ctx.lineWidth = 4;
            ctx.strokeStyle = strokeColor;

            rawStrokes = [];
            isEnhanced = false;
            enhanceStatus?.classList.add('hidden');
        }

        setupCanvas();
        window.addEventListener('resize', () => {
            if(!isTypeMode) {
               const oldW = canvas?.width || 0;
               const rect = canvas?.parentElement?.getBoundingClientRect();
               if(rect && Math.abs(oldW - rect.width) > 50) setupCanvas();
            }
        });

        // Tabs
        tabDraw?.addEventListener('click', () => {
            isTypeMode = false;
            tabDraw?.classList.add('active');
            tabType?.classList.remove('active');
            viewDraw?.classList.remove('hidden');
            viewType?.classList.add('hidden');
            drawActions?.classList.remove('hidden');
            setupCanvas();
        });
        tabType?.addEventListener('click', () => {
            isTypeMode = true;
            tabType?.classList.add('active');
            tabDraw?.classList.remove('active');
            viewType?.classList.remove('hidden');
            viewDraw?.classList.add('hidden');
            drawActions?.classList.add('hidden');
            typeInput?.focus();
        });

        // Colors
        const colBtns = document.getElementById('color-picker')?.querySelectorAll('.ink-dot') || [];
        colBtns.forEach(btn => {
            btn.addEventListener('click', (e) => {
                colBtns.forEach(b => b.classList.remove('active'));
                const target = e.currentTarget;
                target.classList.add('active');
                strokeColor = target.dataset.col;
                if (ctx) ctx.strokeStyle = strokeColor;
                if(isTypeMode && typeInput) typeInput.style.color = strokeColor;
            });
        });

        // Custom color picker
        const customColor = document.getElementById('custom-color');
        if (customColor) {
            customColor.addEventListener('input', (e) => {
                colBtns.forEach(b => b.classList.remove('active'));
                strokeColor = e.target.value;
                if (ctx) ctx.strokeStyle = strokeColor;
                if(isTypeMode && typeInput) typeInput.style.color = strokeColor;
            });
        }

        // Fonts
        const fontBtns = document.getElementById('font-selector')?.querySelectorAll('.font-card') || [];
        fontBtns.forEach(btn => {
            btn.addEventListener('click', (e) => {
                fontBtns.forEach(b => b.classList.remove('active'));
                const target = e.currentTarget;
                target.classList.add('active');
                currentFont = target.dataset.font;
                if (typeInput) typeInput.style.fontFamily = currentFont;
            });
        });

        // Draw Flow
        function getPos(e) {
            const rect = canvas?.getBoundingClientRect() || { left: 0, top: 0 };
            const clientX = 'touches' in e ? e.touches[0].clientX : e.clientX;
            const clientY = 'touches' in e ? e.touches[0].clientY : e.clientY;
            return { x: clientX - rect.left, y: clientY - rect.top };
        }

        function startPosition(e) {
            e.preventDefault(); 
            if (isTypeMode) return; 
            isDrawing = true;
            const hint = document.getElementById('draw-hint');
            if (hint) hint.classList.add('hidden');
            
            if (isEnhanced) {
                isEnhanced = false;
                enhanceStatus?.classList.add('hidden');
            }

            const pos = getPos(e);
            currentStroke = [pos];
            ctx?.beginPath();
            ctx?.moveTo(pos.x, pos.y);
            draw(e);
        }

        function draw(e) {
            e.preventDefault();
            if (!isDrawing || isTypeMode) return;
            const pos = getPos(e);
            currentStroke.push(pos);
            ctx?.lineTo(pos.x, pos.y);
            ctx?.stroke();
            ctx?.beginPath();
            ctx?.moveTo(pos.x, pos.y);
        }

        function endPosition() {
            if(!isDrawing) return;
            isDrawing = false;
            rawStrokes.push(currentStroke);
            currentStroke = [];
            ctx?.beginPath();
        }

        canvas?.addEventListener('mousedown', startPosition);
        canvas?.addEventListener('mousemove', draw);
        canvas?.addEventListener('mouseup', endPosition);
        canvas?.addEventListener('mouseout', endPosition);
        canvas?.addEventListener('touchstart', startPosition, { passive: false });
        canvas?.addEventListener('touchmove', draw, { passive: false });
        canvas?.addEventListener('touchend', endPosition);

        // Auto Smoother
        enhanceBtn?.addEventListener('click', () => {
             if (rawStrokes.length === 0 || isEnhanced) return;
             isEnhanced = true;
             enhanceStatus?.classList.remove('hidden');
             
             if (!canvas || !ctx) return;
             ctx.clearRect(0, 0, canvas.width, canvas.height);
             
             // Advanced downsampling filter
             function simplify(pts, tolerance) {
                 if (pts.length <= 2) return pts;
                 const simplified = [pts[0]];
                 let lastPt = pts[0];
                 for(let i=1; i<pts.length; i++) {
                     const dist = Math.hypot(pts[i].x - lastPt.x, pts[i].y - lastPt.y);
                     if (dist > tolerance) {
                         simplified.push(pts[i]);
                         lastPt = pts[i];
                     }
                 }
                 if(simplified[simplified.length-1] !== pts[pts.length-1]) simplified.push(pts[pts.length-1]);
                 return simplified;
             }

             // Render with organic fountain pen sizing
             ctx.lineWidth = 4.5; 
             rawStrokes.forEach(originalStroke => {
                 const stroke = simplify(originalStroke, 5); 
                 
                 ctx.beginPath();
                 if (stroke.length < 3) {
                     if (stroke.length > 0) {
                        ctx.moveTo(stroke[0].x, stroke[0].y);
                        if (stroke[1]) ctx.lineTo(stroke[1].x, stroke[1].y);
                        else ctx.lineTo(stroke[0].x+1, stroke[0].y+1);
                        ctx.stroke();
                     }
                     return;
                 }
                 
                 ctx.moveTo(stroke[0].x, stroke[0].y);
                 for (let i = 1; i < stroke.length - 2; i++) {
                     const cx = (stroke[i].x + stroke[i + 1].x) / 2;
                     const cy = (stroke[i].y + stroke[i + 1].y) / 2;
                     ctx.quadraticCurveTo(stroke[i].x, stroke[i].y, cx, cy);
                 }
                 ctx.quadraticCurveTo(
                     stroke[stroke.length - 2].x, stroke[stroke.length - 2].y,
                     stroke[stroke.length - 1].x, stroke[stroke.length - 1].y
                 );
                 ctx.stroke();
             });
             ctx.lineWidth = 4;
        });

        document.getElementById('clear-btn')?.addEventListener('click', () => {
            if (isTypeMode) { typeInput.value = ''; } 
            else {
                setupCanvas();
                const hint = document.getElementById('draw-hint');
                if (hint) hint.classList.remove('hidden');
            }
        });

        // Trim Transparent Canvas bounds completely
        function getTrimmedCanvas(sourceCanvas) {
            const sourceCtx = sourceCanvas.getContext('2d');
            const imgData = sourceCtx.getImageData(0, 0, sourceCanvas.width, sourceCanvas.height);
            const data = imgData.data;
            
            let minX = sourceCanvas.width, minY = sourceCanvas.height, maxX = 0, maxY = 0;
            let isEmpty = true;
            
            for (let y = 0; y < sourceCanvas.height; y++) {
                for (let x = 0; x < sourceCanvas.width; x++) {
                    if (data[(y * sourceCanvas.width + x) * 4 + 3] > 0) {
                        isEmpty = false;
                        if (x < minX) minX = x;
                        if (x > maxX) maxX = x;
                        if (y < minY) minY = y;
                        if (y > maxY) maxY = y;
                    }
                }
            }
            if (isEmpty) return sourceCanvas;

            const padding = 16;
            minX = Math.max(0, minX - padding);
            minY = Math.max(0, minY - padding);
            maxX = Math.min(sourceCanvas.width, maxX + padding);
            maxY = Math.min(sourceCanvas.height, maxY + padding);
            
            const trmWidth = maxX - minX;
            const trmHeight = maxY - minY;
            
            const trmCanvas = document.createElement('canvas');
            trmCanvas.width = trmWidth;
            trmCanvas.height = trmHeight;
            const trmCtx = trmCanvas.getContext('2d');
            trmCtx.drawImage(sourceCanvas, minX, minY, trmWidth, trmHeight, 0, 0, trmWidth, trmHeight);
            
            return trmCanvas;
        }

        document.getElementById('download-btn')?.addEventListener('click', () => {
            let exportCanvas = canvas;
            if (isTypeMode) {
                const text = typeInput.value.trim();
                const tc = document.createElement('canvas');
                tc.width = 1000; tc.height = 400; // Big space for long names
                const tctx = tc.getContext('2d');
                tctx.fillStyle = strokeColor;
                tctx.font = `80px ${currentFont}`;
                tctx.textAlign = 'center';
                tctx.textBaseline = 'middle';
                if(!text) return window.ffNotice("Please type your signature first.", "error");
                tctx.fillText(text, 500, 200);
                exportCanvas = getTrimmedCanvas(tc);
            } else {
                exportCanvas = getTrimmedCanvas(canvas);
            }
            const dataURL = exportCanvas.toDataURL('image/png');
            const link = document.createElement('a');
            link.download = 'formfix-signature.png';
            link.href = dataURL;
            link.click();
            if (typeof window.triggerConfetti === 'function') window.triggerConfetti();
            var shareTxt = encodeURIComponent("I just created my digital signature using FormFix! 100% private, browser-based. Try it: " + window.__SITE_URL + "/signature-maker");
            const existing = document.getElementById('post-sig-share');
            if (!existing) {
                var div = document.createElement('div');
                div.id = 'post-sig-share';
                div.style.cssText = 'margin-top:20px;text-align:center;';
                div.innerHTML = '<p style="font-weight:600;margin-bottom:10px;color:var(--success);">Love FormFix? Share it!</p><div style="display:flex;gap:8px;justify-content:center;"><a href="https://twitter.com/intent/tweet?text=' + shareTxt + '" target="_blank" style="padding:8px 16px;border-radius:8px;background:#000;color:#fff;text-decoration:none;font-weight:600;font-size:0.85rem;">Share on X</a><a href="https://wa.me/?text=' + shareTxt + '" target="_blank" style="padding:8px 16px;border-radius:8px;background:#25D366;color:#fff;text-decoration:none;font-weight:600;font-size:0.85rem;">WhatsApp</a></div>';
                document.querySelector('.action-footer')?.appendChild(div);
            }
        });
    });
</script>


