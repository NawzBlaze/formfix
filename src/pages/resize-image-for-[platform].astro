---
import BaseLayout from '../components/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import RelatedTools from '../components/RelatedTools.astro';
// Reusing a tool component if exists or prompting to upload. Here we just use a generic wrapper 
// for the user to visit the actual tool, or ideally embed the actual resize tool here.

export function getStaticPaths() {
  const platforms = [
    { platform: 'passport', title: 'Passport Photo', dims: '3.5 x 4.5 cm' },
    { platform: 'instagram', title: 'Instagram', dims: '1080 x 1080 px' },
    { platform: 'linkedin', title: 'LinkedIn Profile', dims: '400 x 400 px' },

  ];
  return platforms.map((p) => ({
    params: { platform: p.platform },
    props: { title: p.title, dims: p.dims }
  }));
}

const { platform } = Astro.params;
const { title, dims } = Astro.props;

const PAGE_TITLE = `Resize Image for ${title} (${dims}) Online Free | FormFix`;
const PAGE_DESC = `Instantly crop and resize any profile photo or image perfectly for ${title}. No quality loss, completely browser based with 100% privacy.`;
const PAGE_KEYWORDS = `resize image for ${platform}, ${title} strict image size, crop photo to ${dims}`;

const customSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      "name": `${title} Image Resizer - FormFix`,
      "operatingSystem": "All Platforms",
      "applicationCategory": "UtilitiesApplication",
      "description": PAGE_DESC,
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      }
    }
  ]
};
---

<BaseLayout title={PAGE_TITLE} description={PAGE_DESC} keywords={PAGE_KEYWORDS} customSchema={customSchema} active="tools" canonicalPath={`/resize-image-for-${platform}`}>
    <Breadcrumb items={[{ name: 'Home', path: '/' }, { name: "Resize Image For [Platform]", path: "/" }]} />

    <div class="tool-wrapper animate-fade-up">
        <header class="tool-intro text-center">
             <div class="brand-badge box-shadow-subtle">✨ Formatted for {dims}</div>
             <h1 class="main-h1">Resize Image for <span class="text-gradient hover-lift">{title}</span></h1>
             <p class="hero-sub">Get absolute pixel-perfect results locally in your browser. Complete privacy without risking your personal imagery to cloud servers.</p>
        </header>

        <div class="redirect-box text-center mt-32">
            <!-- Instead of duplicating the entire complex resize logic, we funnel high-intent SEO traffic directly into the primary optimized tool with pre-set context -->
            <a href="/resize-image" class="primary-btn pulse-soft" style="padding: 16px 48px; font-size: 1.25rem;">
                Launch the Resizer Studio
            </a>
            <p class="mt-16" style="color: var(--surface-500);">The studio natively supports custom dimensions (<strong>{dims}</strong>).</p>
        </div>

        <article class="pro-seo-article container mt-64">
             <h2>The Official Guideline for {title} Sizes</h2>
             <p>Social algorithms and official portals inherently compress and scale your data, often ruining high-quality photography if it isn't specifically cropped to exact constraints. For a <strong>{title}</strong>, the globally recommended dimension is specifically <strong>{dims}</strong>.</p>
             <p>Our tool runs completely on-device, saving you the hassle of using heavy desktop software like Photoshop just to perform a simple pixel crop. Avoid blurry artifacting dynamically.</p>

             <h3 class="mt-32">How to Format for {title} Privacy</h3>
             <ul>
                <li><strong>No Network Logging:</strong> Never risk sharing your personal portraits.</li>
                <li><strong>Retina Optimized:</strong> Preserves original metadata while cleanly scaling.</li>
                <li><strong>Exact Ratios:</strong> Set your crop factor to lock identically onto the {dims} requirement grid.</li>
             </ul>
        </article>

        <RelatedTools />
    </div>
</BaseLayout>

<style>
    .main-h1 { font-size: clamp(2.5rem, 5vw, 3.5rem); font-weight:600; letter-spacing: -0.04em; margin-bottom: 16px; color: var(--text-primary); line-height: 1.1; }
    .hero-sub { color: var(--text-secondary); font-weight: 500; font-size: 1.15rem; margin-bottom: 40px; max-width: 600px; margin-inline: auto; line-height: 1.6; }
    .tool-wrapper { max-width: 900px; margin: 0 auto; padding-bottom: 100px; padding-top: 40px; }
    .mt-64 { margin-top: 64px; }
    .mt-32 { margin-top: 32px; }
    .mt-16 { margin-top: 16px; }
    
    .brand-badge {
        display: inline-block;
        padding: 6px 16px;
        background:var(--surface-3);
        border: 1px solid var(--border-subtle);
        border-radius: var(--radius-full);
        font-size: 0.9rem;
        font-weight:600;
        margin-bottom: 24px;
        color: var(--text-secondary);
    }
    
    .text-gradient {
        background: linear-gradient(135deg, #111 0%, #666 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        border-bottom: 4px solid #111;
        padding-bottom: 2px;
    }

    .redirect-box {
        background: var(--surface-100);
        padding: 64px;
        border-radius: 16px;
        border: 1px dashed var(--surface-300);
    }
    .pulse-soft { animation: floatIcon 3s ease-in-out infinite; }
    @keyframes floatIcon { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-4px); } }

    .pro-seo-article {
        background:var(--surface-3);
        padding: 48px;
        border-radius: 16px;
        border: 1px solid var(--border-subtle);
        box-shadow: 0 10px 40px -10px rgba(0,0,0,0.05);
    }
    .pro-seo-article h2, .pro-seo-article h3 {
        color: var(--text-primary);
        font-weight:600;
        letter-spacing: -0.02em;
        margin-bottom: 16px;
    }
    .pro-seo-article p { color: var(--text-secondary); line-height: 1.8; margin-bottom: 24px; font-size: 1.05rem; }
    .pro-seo-article ul { padding-left: 24px; color: var(--text-secondary); font-size: 1.05rem; line-height: 1.8; }
    .pro-seo-article li { margin-bottom: 12px; }
    .pro-seo-article li strong { color: var(--text-primary); }
    
    @media (max-width: 768px) {
        .pro-seo-article { padding: 24px; }
        .main-h1 { font-size: 2.5rem; }
    }
</style>
