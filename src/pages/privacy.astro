---
import BaseLayout from '../components/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { SITE_URL } from '../seo';

const PAGE_TITLE = 'Privacy Policy | FormFix';
const PAGE_DESC = 'Read the FormFix privacy policy. All processing happens in your browser. We never upload or store your files.';

const customSchema = {
  '@context': 'https://schema.org',
  '@type': 'PrivacyPolicy',
  name: 'FormFix Privacy Policy',
  description: PAGE_DESC,
  url: `${SITE_URL}/privacy`,
  publisher: {
    '@type': 'Organization',
    name: 'FormFix',
    url: SITE_URL
  }
};
---

<BaseLayout title={PAGE_TITLE} description={PAGE_DESC} canonicalPath="/privacy" customSchema={customSchema}>
    <Breadcrumb items={[{ name: 'Home', path: '/' }, { name: "Privacy Policy", path: "/privacy" }]} />

    <div class="page">
        <div class="container page-inner">
            <h1>Privacy Policy</h1>
            <p class="updated">Effective Date: January 1, 2024</p>

            <section class="section">
                <h2>1. Introduction</h2>
                <p>Welcome to FormFix. We respect your privacy and are committed to protecting any information that could identify you. This Privacy Policy explains how we handle your data when you visit and use our website at <strong>formfix.pages.dev</strong>.</p>
            </section>

            <section class="section">
                <h2>2. Client-Side Processing</h2>
                <p>FormFix is designed from the ground up to respect your privacy. <strong>We do not upload, store, or transmit your images to any servers.</strong></p>
                <p>All image processing, resizing, and compression happen directly within your web browser using your device's resources. Once you close the tab, the uploaded image data is cleared from your browser's memory. We have no access to the files you process.</p>
            </section>

            <section class="section">
                <h2>3. Analytics</h2>
                <p>We use two privacy-friendly analytics tools to understand aggregate usage patterns:</p>
                <ul>
                    <li><strong>Plausible Analytics</strong> — A lightweight, cookie-free analytics service. Plausible does not use cookies, does not collect personal data, and is fully compliant with GDPR, CCPA, and PECR. It processes pageview statistics entirely on its own servers without tracking individual users.</li>
                    <li><strong>Microsoft Clarity</strong> — Used to understand how visitors interact with our tools through session heatmaps and aggregate behavior analysis. Clarity uses cookies to identify unique sessions. No personally identifiable information is collected or stored. You can learn more at <a href="https://clarity.microsoft.com" target="_blank" rel="noopener noreferrer">clarity.microsoft.com</a>.</li>
                </ul>
                <p>Both services only see aggregate, anonymized data. We never use them to collect or store personal information about you.</p>
            </section>

            <section class="section">
                <h2>4. Cookies</h2>
                <p>FormFix uses minimal cookies solely for functionality:</p>
                <ul>
                    <li><strong>Cookie consent</strong> — A localStorage entry to remember whether you accepted or declined analytics.</li>
                    <li><strong>Theme preference</strong> — A localStorage entry to remember your dark/light mode choice.</li>
                </ul>
                <p>No third-party advertising cookies are set. Microsoft Clarity may set a session cookie for its analytics purposes as described above.</p>
            </section>

            <section class="section">
                <h2>5. Changes to This Policy</h2>
                <p>We may update this Privacy Policy from time to time. The updated version will be indicated by an updated "Effective Date" at the top of this page. Your continued use of the website after any changes constitutes your acceptance of the new Privacy Policy.</p>
            </section>

            <section class="section">
                <h2>6. Contact Us</h2>
                <p>If you have any questions about this Privacy Policy, please contact us at: <a href="mailto:formfix.support@gmail.com">formfix.support@gmail.com</a></p>
            </section>
        </div>
    </div>
</BaseLayout>

<style>
.page { padding: 32px 0 80px; }
.page-inner { max-width: 760px; }

h1 {
    font-size: clamp(1.5rem, 4vw, 2.2rem);
    font-weight: 600;
    margin-bottom: 8px;
}

.updated {
    color: var(--text-muted);
    margin-bottom: 40px;
    font-size: 0.85rem;
}

.section {
    margin-bottom: 36px;
}

.section h2 {
    font-size: 1.1rem;
    font-weight: 600;
    margin-bottom: 10px;
}

.section p {
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--text-secondary);
    margin-bottom: 10px;
}

.section strong {
    color: var(--text-primary);
}

.section a {
    color: var(--accent-primary);
    font-weight: 500;
}

.section a:hover {
    text-decoration: underline;
}
</style>
