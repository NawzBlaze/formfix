---
import BaseLayout from '../components/BaseLayout.astro';

const PAGE_TITLE = 'Privacy Policy | formfix Image Editor';
const PAGE_DESC = 'Read the privacy policy for formfix. We do not upload your images. All image processing happens entirely in your web browser, ensuring 100% privacy and security.';
---

<BaseLayout title={PAGE_TITLE} description={PAGE_DESC}>
    <div class="legal-page card">
        <h1>Privacy Policy</h1>
        <p class="updated"><strong>Effective Date:</strong> {new Date().toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</p>
        
        <section class="legal-section">
            <h2>1. Introduction</h2>
            <p>Welcome to formfix. We respect your privacy and are committed to protecting any information that could identify you. This Privacy Policy explains how we handle your data when you visit and use our website at <strong>formfix.pages.dev</strong>.</p>
        </section>

        <section class="legal-section">
            <h2>2. 100% Client-Side Processing</h2>
            <p>formfix is designed from the ground up to respect your privacy. <strong>We do not upload, store, or transmit your images to any servers.</strong></p>
            <p>All image processing, resizing, and compression happen directly within your web browser using your device's resources (Canvas API). Once you close the tab, the uploaded image data is cleared from your browser's memory. We literally have no access to the files you process.</p>
        </section>

        <section class="legal-section">
            <h2>3. Analytics and Tracking</h2>
            <p>We believe in minimal tracking. We may use basic, privacy-friendly analytics tools to see aggregate data (like how many people visit the site or which browsers are used) to improve the tool. We do not use intrusive trackers or sell your data to third parties.</p>
        </section>

        <section class="legal-section">
            <h2>4. Cookies</h2>
            <p>formfix itself does not require or set any tracking cookies to function.</p>
        </section>

        <section class="legal-section">
            <h2>5. Changes to This Privacy Policy</h2>
            <p>We may update this Privacy Policy from time to time. The updated version will be indicated by an updated "Effective Date" at the top of this page. Your continued use of the website after any changes constitutes your acceptance of the new Privacy Policy.</p>
        </section>

        <section class="legal-section">
            <h2>6. Contact Us</h2>
            <p>If you have any questions or concerns about this Privacy Policy, please contact us at: <a href="mailto:support@formfix.pages.dev">support@formfix.pages.dev</a></p>
        </section>
    </div>
</BaseLayout>

<style>
    .legal-page {
        max-width: 900px !important;
        margin: 60px auto;
        padding: 60px !important;
        background: #fff;
        border: 1px solid var(--border-subtle);
        border-radius: 24px;
    }

    h1 {
        font-size: 3rem;
        font-weight: 800;
        margin-bottom: 12px;
        letter-spacing: -0.05em;
        color: var(--text-main);
    }

    .updated {
        color: var(--text-muted);
        margin-bottom: 48px;
        font-size: 0.95rem;
    }

    .legal-section {
        margin-bottom: 48px;
    }

    .legal-section h2 {
        font-size: 1.75rem;
        margin-bottom: 16px;
        color: var(--text-main);
        font-weight: 800;
        letter-spacing: -0.03em;
    }

    .legal-section p {
        font-size: 1.1rem;
        line-height: 1.7;
        color: var(--surface-700);
    }

    .legal-section strong {
        color: var(--text-main);
    }

    .legal-section a {
        color: var(--accent);
        text-decoration: none;
        font-weight: 700;
    }

    .legal-section a:hover {
        text-decoration: underline;
    }

    @media (max-width: 768px) {
        .legal-page { 
            padding: 32px 20px !important; 
            margin: 20px auto;
            border: none;
        }
        h1 { font-size: 2.2rem; }
        .legal-section h2 { font-size: 1.5rem; }
    }
</style>
