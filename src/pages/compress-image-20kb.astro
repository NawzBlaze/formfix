---
import BaseLayout from '../components/BaseLayout.astro';
import RelatedTools from '../components/RelatedTools.astro';
import CompressTool from '../components/tools/CompressTool.astro';
import SocialShare from '../components/SocialShare.astro';

const PAGE_TITLE = 'Compress Image to 20KB Online - Free & Private | FormFix';
const PAGE_DESC = 'The most accurate tool to compress photo to 20kb online for UPSC, SSC, NEET and other government exam forms. 100% private browser processing.';
const PAGE_KEYWORDS = 'compress image to 20kb, photo size reducer to 20kb, ssc photo compressor 20kb, upsc signature 20kb, 20kb photo converter';

const customSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      "name": "20KB Image Compressor - FormFix",
      "operatingSystem": "All Platforms",
      "applicationCategory": "UtilitiesApplication",
      "description": PAGE_DESC,
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      }
    },
    {
      "@type": "HowTo",
      "name": "How to compress photo to 20kb for UPSC/SSC",
      "step": [
        {
          "@type": "HowToStep",
          "text": "Select your passport photo or signature image from your device."
        },
        {
          "@type": "HowToStep",
          "text": "The 20KB limit is pre-selected. Click 'Optimize & Compress'."
        },
        {
          "@type": "HowToStep",
          "text": "Download your perfectly sized 20KB file instantly."
        }
      ]
    }
  ]
};
---

<BaseLayout title={PAGE_TITLE} description={PAGE_DESC} keywords={PAGE_KEYWORDS} customSchema={customSchema} active="compress" canonicalPath="/compress-image-20kb">
    <div class="tool-wrapper animate-in">
        <header class="tool-intro text-center">
             <div class="brand-badge shadow-sm">🎯 Optimized for 20KB</div>
             <h1 class="main-h1">Compress Image to <span class="highlight">20KB</span></h1>
             <p class="hero-sub">Perfect for UPSC, SSC, and NEET application forms. Your photo stays 100% private on your device.</p>
        </header>

        <CompressTool />

        <article class="pro-seo-article container mt-48">
             <h2>Expert 20KB Image Compression for Government Exams</h2>
             <p>Need to <strong>compress photo to 20kb</strong> for a government job portal? Most online tools upload your sensitive passport photos and signatures to their servers. FormFix is different. Our <strong>20kb photo compressor</strong> runs entirely in your local browser. This means your private documents never leave your device, ensuring total security while meeting strict portal requirements like those for <strong>SSC, UPSC, NEET</strong>, and more.</p>
             
             <h3 class="mt-32">How to Compress Photo to 20KB for SSC/UPSC</h3>
             <ol>
                <li>Upload your passport photo or signature.</li>
                <li>The "20 KB" target will be pre-selected for you.</li>
                <li>Click the "Optimize & Compress" button.</li>
                <li>The tool will automatically find the best quality that fits under 20KB.</li>
             </ol>

             <h3 class="mt-32">Why use FormFix for 20KB Compression?</h3>
             <ul>
                <li><strong>Strict Compliance:</strong> We ensure the file is always below the 20KB boundary.</li>
                <li><strong>No Sign-up:</strong> Start compressing immediately without an account.</li>
                <li><strong>Batch Mode:</strong> (Coming soon) for multiple photos.</li>
             </ul>
        </article>

        <SocialShare title="Need to compress your UPSC/SSC photo to 20KB? Use this private tool!" url="https://formfix.pages.dev/compress-image-20kb" />

        <RelatedTools currentTool="compress" />
    </div>
</BaseLayout>

<style>
    .main-h1 { font-size: 3rem; font-weight: 1000; letter-spacing: -0.05em; margin-bottom: 12px; color: var(--dark); line-height: 1.1; }
    .hero-sub { color: var(--slate); font-weight: 600; font-size: 1.15rem; margin-bottom: 24px; max-width: 600px; margin-inline: auto; }
    .tool-wrapper { max-width: 860px; margin: 0 auto; padding-bottom: 100px; }
    .mt-48 { margin-top: 48px; }
    .mt-32 { margin-top: 32px; }
</style>
