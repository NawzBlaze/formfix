---
import BaseLayout from '../components/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import ToolWrapper from '../components/ToolWrapper.astro';

const PAGE_TITLE = 'Online OCR Tool - Extract Text from Images & Documents Free';
const PAGE_DESC = 'Convert images of documents, books, and receipts into editable text instantly. Fast, private, and browser-based OCR technology.';
const PAGE_KEYWORDS = 'image to text converter, online ocr tools, extract text from doc, photo to text converter, tesseract ocr online, scan document to text';

const customSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      "name": "FormFix OCR Studio",
      "operatingSystem": "All Platforms",
      "applicationCategory": "UtilitiesApplication",
      "description": "Professional-grade OCR tool for extracting text from images 100% locally.",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      }
    }
  ]
};

const faqs = [
  { q: "What languages can it recognize?", a: "Currently, our tool is optimized for the English language using the latest LSTM deep learning models. This ensures high accuracy for both printed documents and high-quality scans." },
  { q: "Is there a file size limit?", a: "Since the processing happens in your browser, the limit depends on your device's RAM. We recommend images under 10MB for the smoothest experience." },
];
---

<BaseLayout title={PAGE_TITLE} description={PAGE_DESC} keywords={PAGE_KEYWORDS} customSchema={customSchema} active="tools" canonicalPath="/image-to-text" faqs={faqs}>
    <script src="https://cdn.jsdelivr.net/npm/tesseract.js@5/dist/tesseract.min.js" is:inline></script>
<script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
    try {
        const fileInput = document.getElementById('image-upload');
        const uploadStage = document.getElementById('upload-stage');
        const editorStage = document.getElementById('editor-stage');
        const sourcePreview = document.getElementById('source-preview');
        const resultText = document.getElementById('result-text');
        const extractBtn = document.getElementById('extract-btn');
        const resultArea = document.getElementById('result-stage');
        const copyBtn = document.getElementById('copy-btn');
        
        const overlay = document.getElementById('processing-overlay');
        const progressText = document.getElementById('progress-text');
        const overlayStatus = document.getElementById('overlay-status');

        const procCanvas = document.createElement('canvas');
        const procCtx = procCanvas.getContext('2d', { willReadFrequently: true });
        let originalImg = new Image();

        fileInput?.addEventListener('change', (e) => {
            const file = e.target.files[0];
            if(!file) return;
            if (!['image/png','image/jpeg','image/webp'].includes(file.type)) {
                if (typeof window.ffNotice === 'function') window.ffNotice('Please select a PNG, JPG, or WebP image.', 'error');
                return;
            }
            
            const reader = new FileReader();
            reader.onload = (event) => {
                sourcePreview.src = event.target.result;
                originalImg.src = event.target.result;
                uploadStage?.classList.add('hidden');
                editorStage?.classList.remove('hidden');
            };
            reader.readAsDataURL(file);
        });

        async function preProcessImage() {
            procCanvas.width = originalImg.width;
            procCanvas.height = originalImg.height;
            procCtx.drawImage(originalImg, 0, 0);

            const imgData = procCtx.getImageData(0, 0, procCanvas.width, procCanvas.height);
            const data = imgData.data;

            for (let i = 0; i < data.length; i += 4) {
                const avg = (data[i] * 0.299 + data[i+1] * 0.587 + data[i+2] * 0.114);
                let finalV = avg;
                if (avg > 200) finalV = 255;
                if (avg < 50) finalV = 0;

                data[i] = finalV; data[i+1] = finalV; data[i+2] = finalV;
            }
            procCtx.putImageData(imgData, 0, 0);
            return procCanvas.toDataURL('image/png');
        }

        extractBtn?.addEventListener('click', async () => {
             if (typeof Tesseract === 'undefined') {
                 if (typeof window.ffNotice === 'function') window.ffNotice('OCR library failed to load. Please check your internet connection and refresh.', 'error');
                 else alert('OCR library failed to load. Please check your internet connection and refresh.');
                 return;
             }
             overlay?.classList.remove('hidden');
             extractBtn.disabled = true;
             overlayStatus.textContent = 'Enhancing Document Clarity...';
             
             let worker = null;
             try {
                const processedImgBase64 = await preProcessImage();
                resultText.value = "";
                overlayStatus.textContent = 'Initializing OCR Engine...';
                
                worker = await Tesseract.createWorker('eng', 1, {
                    logger: m => {
                        if (m.status === 'recognizing text') {
                            const prog = Math.round(m.progress * 100);
                            progressText.textContent = prog + '%';
                            overlayStatus.textContent = 'Extracting Characters...';
                        }
                    }
                });

                const ret = await worker.recognize(processedImgBase64);
                
                let cleanText = ret.data.text
                    .replace(/\n\s*\n/g, '\n\n')
                    .replace(/[ \t]+/g, ' ')
                    .trim();

                resultText.value = cleanText || "Could not detect any text. Is the image clear?";
                
                overlay?.classList.add('hidden');
                resultArea?.classList.remove('hidden');
                extractBtn.style.display = 'none';
             } catch (err) {
                 console.error(err);
                 overlay?.classList.add('hidden');
                 if (typeof window.ffNotice === 'function') window.ffNotice('Extraction failed. Ensure the document is clear.', 'error');
                 else console.error('OCR failed');
             } finally {
                 if (worker) { try { await worker.terminate(); } catch (e) {} }
                 extractBtn.disabled = false;
             }
        });

        copyBtn?.addEventListener('click', () => {
            resultText?.select();
            document.execCommand('copy');
            copyBtn.textContent = '✅ Copied!';
            setTimeout(() => copyBtn.textContent = '📋 Copy all text', 2000);
        });

        if (uploadStage) {
            uploadStage.addEventListener('dragover', (e) => { e.preventDefault(); uploadStage.classList.add('drag-active'); });
            uploadStage.addEventListener('dragleave', () => uploadStage.classList.remove('drag-active'));
            uploadStage.addEventListener('drop', (e) => {
                e.preventDefault();
                uploadStage.classList.remove('drag-active');
                if (e.dataTransfer?.files.length) {
                    const fileInput = document.getElementById('image-upload');
                    if (fileInput) {
                        fileInput.files = e.dataTransfer.files;
                        fileInput.dispatchEvent(new Event('change'));
                    }
                }
            });
        }
    } catch (err) {
        console.error('Failed to initialize OCR tool:', err);
    }
    });
</script>

    <Breadcrumb items={[{ name: 'Home', path: '/' }, { name: "Online OCR Tool - Extract Text from Images & Documents Free", path: "/image-to-text" }]} />

    <ToolWrapper title="OCR Image to Text" subtitle="Extract editable text from document photos privately using local browser OCR." currentTool="image-to-text">
        
        <div slot="tool-ui">
             <div class="workspace-editor">
                  <!-- 1. Selection Step -->
                  <div id="upload-stage" class="upload-container">
                       <div class="upload-box shadow-sm" onclick="document.getElementById('image-upload').click()">
                            <input type="file" id="image-upload" class="hidden" accept="image/png, image/jpeg, image/webp" />
                            <div class="upload-content">
                                 <div class="upload-icon">🔍</div>
                                 <h3 class="font-850 m-0 mb-8">Scan Document for Text</h3>
                                 <p class="text-muted m-0 mb-24 font-600">Upload a JPG, PNG, or WebP photo</p>
                                 <button class="primary-btn px-40">Browse Document</button>
                            </div>
                       </div>
                  </div>

                  <!-- 2. Workspace Step -->
                  <div id="editor-stage" class="hidden">
                       <div class="editor-grid">
                            <div class="preview-panel shadow-sm">
                                 <div class="doc-frame checkerboard">
                                      <img id="source-preview" alt="OCR Source Document Preview" loading="lazy" decoding="async" />
                                      <div id="processing-overlay" class="loader-overlay hidden">
                                           <div class="loader-content">
                                                <div class="pulse-loader"></div>
                                                <div id="progress-text" class="progress-pct">0%</div>
                                           </div>
                                           <p id="overlay-status" class="loader-status m-0 font-600">Analyzing text...</p>
                                      </div>
                                 </div>
                                 <div class="hint-badge mt-16 font-600">
                                      <span>💡 High contrast images yield better OCR results</span>
                                 </div>
                            </div>

                            <div class="controls-sidebar">
                                 <div class="settings-card shadow-sm mb-24">
                                      <div class="info-alert">
                                           <p class="m-0 mb-8 font-600">🔒 Privacy First</p>
                                           <p class="m-0 text-muted small">Every character is processed 100% locally in your browser RAM. Your documents never touch our servers.</p>
                                      </div>
                                 </div>

                                 <div class="action-stack">
                                      <button id="extract-btn" class="primary-btn wide-btn pulse-glow mb-12">⬇️ Extract Text Now</button>
                                      <button class="secondary-btn wide-btn" onclick="location.reload()">↺ Change Image</button>
                                 </div>
                            </div>
                       </div>

                       <!-- 3. Result Section -->
                       <div id="result-stage" class="result-area mt-32 hidden">
                            <div class="textarea-header mb-16">
                                 <label class="section-label m-0">Extracted Result</label>
                                 <button id="copy-btn" class="copy-action-btn">📋 Copy all text</button>
                            </div>
                            <textarea id="result-text" class="ocr-result-box shadow-inner" readonly placeholder="Extraction result will appear here..."></textarea>
                       </div>
                  </div>
             </div>
        </div>

        <div slot="tool-info">
             <h2>Advanced Privacy-First OCR Technology</h2>
             <p>Our <strong>Online OCR Tool</strong> is powered by Tesseract.js engine. This means your private documents, receipts, and sensitive notes are analyzed directly on your device. We offer a professional-grade alternative to server-side scanners that respects your digital boundaries.</p>
             
             <div class="faq-grid mt-32">
                  <details class="faq-item">
                       <summary>What languages can it recognize?</summary>
                       <p>Currently, our tool is optimized for the <strong>English language</strong> using the latest LSTM deep learning models. This ensures high accuracy for both printed documents and high-quality scans.</p>
                  </details>
                  <details class="faq-item">
                       <summary>Is there a file size limit?</summary>
                       <p>Since the processing happens in your browser, the limit depends on your device's RAM. We recommend images under 10MB for the smoothest experience.</p>
                  </details>
             </div>
        </div>
    </ToolWrapper>
</BaseLayout><style>
    .workspace-editor { display: flex; flex-direction: column; width: 100%; max-width: 1000px; margin: 0 auto; }
    
    .upload-container { display: flex; justify-content: center; }
    .upload-box { background: var(--surface-3); border: 2.5px dashed var(--border-subtle); border-radius: 32px; padding: 60px 40px; text-align: center; width: 100%; cursor: pointer; transition: 0.2s; }
    .upload-box:hover { border-color: var(--accent-primary); background: var(--surface-2); }
    .upload-icon { font-size: 3.5rem; margin-bottom: 24px; line-height: 1; }

    .editor-grid { display: grid; grid-template-columns: 1fr 340px; gap: 32px; }
    .preview-panel { background:var(--surface-3); border: 1px solid var(--border-subtle); border-radius: 24px; padding: 32px; display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 480px; }
    
    .checkerboard { 
        background-color:var(--surface-3);
        background-image: linear-gradient(45deg, var(--surface-2) 25%, transparent 25%, transparent 75%, var(--surface-2) 75%, var(--surface-2)), 
                          linear-gradient(45deg, var(--surface-2) 25%, transparent 25%, transparent 75%, var(--surface-2) 75%, var(--surface-2));
        background-size: 20px 20px; background-position: 0 0, 10px 10px;
    }
    
    .doc-frame { border-radius: 12px; overflow: hidden; position: relative; border: 1px solid var(--border-subtle); width: 100%; display: flex; align-items: center; justify-content: center; min-height: 400px; }
    .doc-frame img { max-width: 100%; max-height: 500px; display: block; filter: drop-shadow(0 15px 40px rgba(0,0,0,0.1)); }
    
    .hint-badge { display: inline-block; font-size: 0.85rem; color: var(--text-muted); background: var(--surface-2); padding: 8px 20px; border-radius: 100px; border: 1px solid var(--border-subtle); }

    .loader-overlay { position: absolute; inset: 0; background: rgba(255,255,255,0.92); backdrop-filter: blur(8px); display: flex; flex-direction: column; align-items: center; justify-content: center; z-index: 10; text-align: center; border-radius: 12px; }
    .loader-content { position: relative; width: 90px; height: 90px; display: flex; align-items: center; justify-content: center; margin-bottom: 20px; }
    .pulse-loader { width: 100%; height: 100%; border: 4px solid var(--border-subtle); border-top-color: var(--accent-primary); border-radius: 50%; animation: spin 1s linear infinite; }
    .progress-pct { position: absolute; font-size: 1rem; font-weight:600; color: var(--text-primary); }
    .loader-status { font-weight:600; color: var(--text-primary); font-size: 0.95rem; }

    .controls-sidebar { display: flex; flex-direction: column; gap: 24px; }
    .settings-card { background: var(--surface-3); padding: 24px; border-radius: 24px; border: 1px solid var(--border-subtle); }
    .info-alert { font-size: 0.85rem; color: var(--text-primary); background:var(--surface-3); padding: 16px; border-radius: 12px; border: 1px solid var(--border-subtle); line-height: 1.5; }

    .action-stack { display: flex; flex-direction: column; }
    .wide-btn { width: 100%; height: 60px; font-weight:600; font-size: 1rem; border-radius: 16px; box-sizing: border-box; display: flex; justify-content: center; align-items: center; }

    /* Result Area */
    .result-area { background:var(--surface-3); border: 1px solid var(--border-subtle); border-radius: 24px; padding: 32px; box-shadow: var(--shadow-sm); animation: slideUp 0.4s ease-out; }
    .textarea-header { display: flex; justify-content: space-between; align-items: center; }
    .section-label { font-size: 0.75rem; font-weight:600; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em; display: block; }
    
    .copy-action-btn { font-size: 0.85rem; font-weight:600; color: var(--accent-primary); background: var(--surface-2); padding: 8px 20px; border-radius: 100px; border: none; cursor: pointer; transition: 0.2s; }
    .copy-action-btn:hover { background: var(--accent-primary); color: #fff; box-shadow: var(--shadow-sm); }
    
    .ocr-result-box { width: 100%; height: 350px; background: var(--surface-3); border: 1px solid var(--border-subtle); border-radius: 16px; padding: 24px; font-size: 1rem; line-height: 1.7; color: var(--text-primary); outline: none; transition: 0.2s; resize: vertical; font-family: inherit; box-sizing: border-box; }
    .ocr-result-box:focus { border-color: var(--accent-primary); background:var(--surface-3); box-shadow: var(--shadow-sm); }

    /* FAQ */
    .faq-grid { display: grid; gap: 16px; }
    .faq-item { background:var(--surface-3); border: 1px solid var(--border-subtle); border-radius: var(--radius-sm); overflow: hidden; text-align: left; }
    .faq-item summary { font-weight:600; font-size: 1rem; padding: 16px 20px; cursor: pointer; color: var(--text-primary); list-style-type: none; position: relative; }
    .faq-item summary::after { content: '+'; position: absolute; right: 20px; font-weight:600; font-size: 1.2rem; color: var(--accent-primary); }
    .faq-item[open] summary::after { content: '−'; }
    .faq-item p { padding: 0 20px 20px; margin: 0; font-size: 0.95rem; color: var(--text-muted); line-height: 1.6; }

    @keyframes spin { to { transform: rotate(360deg); } }
    @keyframes slideUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }

    .small { font-size: 0.85rem; }

    @media (max-width: 900px) {
        .editor-grid { grid-template-columns: 1fr; }
        .preview-panel { min-height: 350px; padding: 16px; }
        .controls-sidebar { position: static; }
    }
    @media (max-width: 640px) {
        .upload-box { padding: 40px 24px; }
        .result-area { padding: 20px; }
    }
</style>
