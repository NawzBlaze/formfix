---
import BaseLayout from '../components/BaseLayout.astro';
import RelatedTools from '../components/RelatedTools.astro';

const PAGE_TITLE = 'Online OCR Tool - Extract Text from Images & Documents Free';
const PAGE_DESC = 'Convert images of documents, books, and receipts into editable text instantly. Fast, private, and browser-based OCR technology.';
const PAGE_KEYWORDS = 'image to text converter, online ocr tools, extract text from doc, photo to text converter, tesseract ocr online, scan document to text';

const customSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      "name": "FormFix OCR Studio",
      "operatingSystem": "All",
      "applicationCategory": "UtilitiesApplication",
      "description": "Professional-grade OCR tool for extracting text from images 100% locally.",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      }
    }
  ]
};
---

<BaseLayout title={PAGE_TITLE} description={PAGE_DESC} keywords={PAGE_KEYWORDS} customSchema={customSchema} active="tools" canonicalPath="/image-to-text">
    <div class="tool-wrapper animate-in">
        <header class="tool-intro text-center">
             <div class="brand-badge shadow-sm">🔍 Precision OCR Engine</div>
             <h1 class="main-h1">Image to <span class="highlight">Text Extrax</span></h1>
             <p class="hero-sub">Extract editable text from any image or document photo instantly and privately.</p>
        </header>

        <div class="glass-card tool-content shadow-lg max-w-lg mx-auto">
            
            <div id="upload-stage" class="upload-container shadow-sm">
                 <div class="upload-circle mb-16"><span class="u-icon">📷</span></div>
                 <h3 class="u-title">Upload Document</h3>
                 <p class="u-sub">JPG, PNG, or WebP. Best results with clear, flat images.</p>
                 <button class="primary-btn wide-btn profile-btn pulse-glow" onclick="document.getElementById('image-upload').click()">Select Photo</button>
                 <input type="file" id="image-upload" class="hidden" accept="image/png, image/jpeg, image/webp" />
            </div>

            <div id="editor-stage" class="hidden">
                 <div class="img-preview mb-24">
                      <img id="source-preview" class="styled-img" alt="OCR source image preview" />
                      <div id="processing-overlay" class="processing-overlay hidden">
                          <div class="loader-wrap">
                               <div class="loader"></div>
                               <div id="progress-text" class="progress-text">0%</div>
                          </div>
                          <p id="overlay-status" class="font-bold">Analyzing document...</p>
                          <div class="progress-bar-wrap">
                               <div id="progress-bar-fill" class="progress-bar-fill"></div>
                          </div>
                      </div>
                 </div>
                 
                 <div class="result-area mt-24">
                      <div class="flex-between mb-12">
                           <span class="font-bold text-sm">✨ Extracted Results</span>
                           <button id="copy-btn" class="copy-pill">📋 Copy Everything</button>
                      </div>
                      <textarea id="result-text" class="modern-textarea" readonly placeholder="Your text will appear here..."></textarea>

                      <div class="performance-tag mt-16 animate-in">
                           <div class="flex-between align-center">
                                <div class="d-flex align-center gap-10">
                                     <span class="perf-dot"></span>
                                     <span class="text-xs font-bold text-slate">Engine: <span id="perf-mode" class="text-primary-mid">Tesseract Web-Worker V2</span></span>
                                </div>
                                <p class="text-tiny text-slate italic opacity-80">100% Private & Local</p>
                           </div>
                      </div>
                 </div>
                 
                 <div class="d-flex gap-16 mt-32 wrap-mobile">
                      <button id="reset-btn" class="secondary-btn wide-btn-half profile-btn">↺ Reset</button>
                      <button id="extract-btn" class="primary-btn wide-btn profile-btn pulse-glow flex-1">✨ Run Extraction</button>
                 </div>
            </div>

        </div>

        <article class="pro-seo-article container mt-48">
             <div class="divider-line mb-48"></div>
             
             <div class="seo-grid">
                <div class="seo-card">
                    <div class="seo-icon">🛡️</div>
                    <h3 class="mb-8">100% Privacy-First</h3>
                    <p>Your documents are never uploaded to any server. All processing happens locally in your browser, ensuring complete data security for sensitive documents like Aadhaar, PAN, or official letters.</p>
                </div>
                <div class="seo-card">
                    <div class="seo-icon">⚡</div>
                    <h3 class="mb-8">Instant Digitization</h3>
                    <p>Convert printed text from books, receipts, and forms into editable formats in seconds. Our engine uses advanced neural networks optimized for high-speed browser execution.</p>
                </div>
                <div class="seo-card">
                    <div class="seo-icon">📄</div>
                    <h3 class="mb-8">High Accuracy</h3>
                    <p>Tuned for diverse lighting conditions and font styles. Supports multi-column layouts and handles diverse Indian document formats with ease.</p>
                </div>
             </div>

             <h2 class="mt-48 text-center">Mastering Image-to-Text Conversion</h2>
             <p class="text-center max-w-md mx-auto mb-32">Get professional results every time by following these pro tips for document scanning.</p>
             
             <div class="tips-grid">
                <div class="tip-item">
                    <span class="tip-num">01</span>
                    <div>
                        <strong>Sharp Focus:</strong> A steady hand and sharp focus are critical. Blur is the #1 reason for OCR failure.
                    </div>
                </div>
                <div class="tip-item">
                    <span class="tip-num">02</span>
                    <div>
                        <strong>Contrast:</strong> Black text on white paper works best. If your paper is colored, try to increase the 'Exposure' on your phone before uploading.
                    </div>
                </div>
                <div class="tip-item">
                    <span class="tip-num">03</span>
                    <div>
                        <strong>Alignment:</strong> Keep the document parallel to your phone's lens. Skewed or tilted images can lead to garbled text.
                    </div>
                </div>
             </div>
        </article>

        <RelatedTools currentTool="image-to-text" />
    </div>
</BaseLayout>

<script src="https://cdn.jsdelivr.net/npm/tesseract.js@5/dist/tesseract.min.js" is:inline></script>
<script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
        const fileInput = document.getElementById('image-upload');
        const uploadStage = document.getElementById('upload-stage');
        const editorStage = document.getElementById('editor-stage');
        const sourcePreview = document.getElementById('source-preview');
        const resultText = document.getElementById('result-text');
        const extractBtn = document.getElementById('extract-btn');
        const resetBtn = document.getElementById('reset-btn');
        const copyBtn = document.getElementById('copy-btn');
        
        const overlay = document.getElementById('processing-overlay');
        const progressFill = document.getElementById('progress-bar-fill');
        const progressText = document.getElementById('progress-text');
        const overlayStatus = document.getElementById('overlay-status');

        // Hidden canvas for pre-processing
        const procCanvas = document.createElement('canvas');
        const procCtx = procCanvas.getContext('2d', { willReadFrequently: true });

        let originalImg = new Image();

        fileInput.addEventListener('change', (e) => {
            const file = e.target.files[0];
            if(!file) return;
            
            const reader = new FileReader();
            reader.onload = (event) => {
                sourcePreview.src = event.target.result;
                originalImg.src = event.target.result;
                uploadStage.classList.add('hidden');
                editorStage.classList.remove('hidden');
            };
            reader.readAsDataURL(file);
        });

        async function preProcessImage() {
            // Enhance image for better OCR: Grayscale + Contrast
            procCanvas.width = originalImg.width;
            procCanvas.height = originalImg.height;
            procCtx.drawImage(originalImg, 0, 0);

            const imgData = procCtx.getImageData(0, 0, procCanvas.width, procCanvas.height);
            const data = imgData.data;

            for (let i = 0; i < data.length; i += 4) {
                // Grayscale
                const avg = (data[i] * 0.299 + data[i+1] * 0.587 + data[i+2] * 0.114);
                
                // Increase Contrast (Thresholding-like effect)
                const v = avg > 128 ? 255 : 0; // Simple binarization often works best for Tesseract
                
                // Adaptive look but simpler: if it's middle-ish gray, keep it, if light, white it out.
                let finalV = avg;
                if (avg > 200) finalV = 255;
                if (avg < 50) finalV = 0;

                data[i] = finalV; data[i+1] = finalV; data[i+2] = finalV;
            }
            procCtx.putImageData(imgData, 0, 0);
            return procCanvas.toDataURL('image/png');
        }

        extractBtn.addEventListener('click', async () => {
             overlay.classList.remove('hidden');
             extractBtn.disabled = true;
             overlayStatus.textContent = 'Enhancing Document Clarity...';
             
             try {
                // 1. Pre-process to make text pop
                const processedImgBase64 = await preProcessImage();

                // 2. Clear previous results
                resultText.value = "";

                // 3. Initialize Worker
                overlayStatus.textContent = 'Initializing OCR Engine...';
                const worker = await Tesseract.createWorker('eng', 1, {
                    logger: m => {
                        if (m.status === 'recognizing text') {
                            const prog = Math.round(m.progress * 100);
                            progressFill.style.width = prog + '%';
                            progressText.textContent = prog + '%';
                            overlayStatus.textContent = 'Extracting Characters...';
                        }
                    }
                });

                // 4. Run OCR on processed image
                const ret = await worker.recognize(processedImgBase64);
                
                // Clean up text: replace multiple spaces/newlines with single ones
                let cleanText = ret.data.text
                    .replace(/\n\s*\n/g, '\n\n') // Fix blank line detection
                    .replace(/[ \t]+/g, ' ')      // Fix multiple spaces
                    .trim();

                resultText.value = cleanText || "Could not detect any text. Is the image clear?";
                await worker.terminate();
                
                overlay.classList.add('hidden');
                extractBtn.style.display = 'none';
             } catch (err) {
                 console.error(err);
                 (window as any).ffNotice("Extraction failed. Please ensure the document is clear and has text.", "error");
                 overlay.classList.add('hidden');
             } finally {
                 extractBtn.disabled = false;
             }
        });

        copyBtn.addEventListener('click', () => {
            resultText.select();
            document.execCommand('copy');
            copyBtn.textContent = '✅ Copied!';
            setTimeout(() => copyBtn.textContent = '📋 Copy all', 2000);
        });

        resetBtn.addEventListener('click', () => {
            location.reload();
        });
    });
</script>

<style>
    .main-h1 { font-size: 3.5rem; font-weight: 1000; letter-spacing: -0.05em; margin-bottom: 12px; color: var(--dark); line-height: 1.1; }
    .hero-sub { color: var(--slate); font-weight: 600; font-size: 1.25rem; margin-bottom: 24px; }
    .tool-wrapper { max-width: 960px; margin: 0 auto; padding-bottom: 100px; }
    .max-w-lg { max-width: 550px; margin-inline: auto; }
    
    .upload-container { background: #f8fafc; border: 2.5px dashed var(--border); border-radius: 32px; padding: 60px 20px; text-align: center; cursor: pointer; transition: 0.3s; margin-top:16px; min-height: 350px; display: flex; flex-direction: column; align-items: center; justify-content: center; }
    .upload-container:hover { border-color: var(--primary); background: #fef2f2; transform: translateY(-4px); }
    .upload-circle { width: 90px; height: 90px; background: #fff; border-radius: 50%; box-shadow: 0 10px 25px rgba(0,0,0,0.05); display: flex; align-items: center; justify-content: center; margin: 0 auto 20px; font-size: 3rem; }
    .u-title { font-size: 1.8rem; font-weight: 1000; color: var(--dark); margin-bottom: 8px; }
    .u-sub { font-size: 1.1rem; color: var(--slate); font-weight: 600; margin-bottom: 32px; }

    #editor-stage { background: #fff; padding: 24px; border-radius: 24px; border: 1.5px solid var(--border); position: relative; }
    .img-preview { width: 100%; min-height: 200px; max-height: 400px; background: #f1f5f9; border-radius: 16px; display: flex; justify-content: center; align-items: center; overflow: hidden; border: 1.5px solid var(--border); position: relative; margin-bottom: 24px; }
    .styled-img { max-width: 100%; max-height: 100%; object-fit: contain; }
    
    .processing-overlay { position: absolute; inset: 0; background: rgba(255,255,255,0.9); backdrop-filter: blur(10px); display: flex; flex-direction: column; align-items: center; justify-content: center; z-index: 10; padding: 24px; text-align: center; }
    .loader-wrap { position: relative; width: 90px; height: 90px; display: flex; align-items: center; justify-content: center; margin-bottom: 16px; }
    .loader { width: 100%; height: 100%; border: 6px solid #e2e8f0; border-top-color: var(--primary); border-radius: 50%; animation: rotation 1.4s infinite; }
    @keyframes rotation { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
    .progress-text { position: absolute; font-size: 1.1rem; font-weight: 1000; color: var(--dark); }
    
    .progress-bar-wrap { width: 100%; max-width: 200px; height: 6px; background: #e2e8f0; border-radius: 100px; overflow: hidden; margin-top: 12px; }
    .progress-bar-fill { height: 100%; background: var(--gradient-primary); width: 0%; transition: width 0.3s ease; }

    .modern-textarea { width: 100%; height: 180px; border-radius: 14px; border: 1.5px solid var(--border); padding: 16px; font-size: 1rem; color: var(--dark); background: #f8fafc; outline: none; transition: 0.3s; resize: vertical; }

    .performance-tag { background: #f8fafc; padding: 10px 14px; border-radius: 12px; border: 1px solid var(--border-light); }
    .perf-dot { width: 8px; height: 8px; background: #10b981; border-radius: 50%; }

    .flex-between { display: flex; justify-content: space-between; align-items: center; }
    .copy-pill { background: var(--bg-subtle); border: 1.5px solid var(--primary-light); padding: 6px 14px; border-radius: 100px; font-size: 0.72rem; font-weight: 1000; color: var(--primary); cursor: pointer; transition: 0.2s; }
    .copy-pill:hover { background: var(--primary); color: #fff; transform: scale(1.05); }
    .flex-1 { flex: 1; }
    .font-bold { font-weight: 900; color: var(--dark); }
    .text-sm { font-size: 0.85rem; }
    .text-xs { font-size: 0.75rem; }
    .text-tiny { font-size: 0.7rem; }
    .text-primary { color: var(--primary); }
    .text-primary-mid { color: var(--primary-mid); }
    .text-slate { color: var(--slate); }
    .mb-8 { margin-bottom: 8px; }
    .mb-12 { margin-bottom: 12px; }
    .mb-16 { margin-bottom: 16px; }
    .mt-16 { margin-top: 16px; }
    .mt-24 { margin-top: 24px; }
    .mt-48 { margin-top: 48px; }
    .gap-10 { gap: 10px; }
    .gap-16 { gap: 16px; }
    .p-24 { padding: 24px; }
    .bg-subtle { background: #f8fbff; }
    .rounded-2xl { border-radius: 20px; }
    .border-solid { border-style: solid; border-width: 1.5px; }
    .border-primary-light { border-color: var(--primary-light); }
    
    .seo-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; margin-bottom: 60px; }
    .seo-card { background: #fff; border: 1.5px solid var(--border-light); border-radius: 20px; padding: 32px; transition: 0.3s; }
    .seo-card:hover { border-color: var(--primary-light); transform: translateY(-4px); box-shadow: var(--shadow-md); }
    .seo-icon { font-size: 2.5rem; margin-bottom: 16px; }

    .tips-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px; }
    .tip-item { display: flex; gap: 20px; }
    .tip-num { font-size: 1.8rem; font-weight: 1000; color: var(--primary-light); opacity: 0.8; line-height: 1; }
    .tip-item strong { display: block; margin-bottom: 4px; color: var(--dark); font-size: 1rem; }
    .tip-item div { color: var(--slate); font-size: 0.95rem; line-height: 1.6; font-weight: 500; }

    .divider-line { width: 100%; height: 1.5px; background: #eee; border-radius: 10px; }
    .max-w-md { max-width: 600px; }
    .text-center { text-align: center; }
    .mx-auto { margin-inline: auto; }

    .wide-btn { padding: 22px 24px; font-weight: 1000; font-size: 1.25rem; border-radius: 100px; display: block; border: none; cursor: pointer; transition: 0.3s; }
    .wide-btn:hover { transform: translateY(-2px); box-shadow: var(--shadow-lg); filter: brightness(1.1); }
    .wide-btn:active { transform: translateY(0); }
    .wide-btn:disabled { opacity: 0.5; pointer-events: none; }
    
    .secondary-btn { background: #f1f5f9; color: var(--slate); border: 1.5px solid var(--border); }

    @media (max-width: 900px) {
        .seo-grid, .tips-grid { grid-template-columns: 1fr; }
    }
    @media (max-width: 640px) {
        .wrap-mobile { flex-direction: column; }
        .wide-btn, .wide-btn-half { width: 100%; }
        .main-h1 { font-size: 2.4rem; }
    }
</style>
