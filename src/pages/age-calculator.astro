---
import BaseLayout from '../components/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import ToolWrapper from '../components/ToolWrapper.astro';

const PAGE_TITLE = 'Age Calculator Free – Exact Age in Years, Months, Days';
const PAGE_DESC = 'Calculate your exact age in years, months, and days instantly. Free online age calculator for birthdays, anniversaries, and date differences.';
const PAGE_KEYWORDS = 'age calculator, calculate age, exact age, date difference, birthday calculator';
---

<BaseLayout title={PAGE_TITLE} description={PAGE_DESC} keywords={PAGE_KEYWORDS} active="tools" canonicalPath="/age-calculator">
    <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
        const dobInput = document.getElementById('dob-input');
        const targetInput = document.getElementById('target-input');
        const ry = document.getElementById('res-years');
        const rm = document.getElementById('res-months');
        const rd = document.getElementById('res-days');

        // Set to today
        const today = new Date();
        targetInput.value = today.toISOString().split('T')[0];
        
        // Example DOB 20 years ago
        const defaultDob = new Date();
        defaultDob.setFullYear(defaultDob.getFullYear() - 20);
        dobInput.value = defaultDob.toISOString().split('T')[0];

        function calculateAge() {
            if (!dobInput.value || !targetInput.value) return;

            let birthDate = new Date(dobInput.value);
            let targetDate = new Date(targetInput.value);

            if (birthDate > targetDate) {
                 ry.textContent = '0'; rm.textContent = '0'; rd.textContent = '0';
                 return;
            }

            let years = targetDate.getFullYear() - birthDate.getFullYear();
            let months = targetDate.getMonth() - birthDate.getMonth();
            let days = targetDate.getDate() - birthDate.getDate();

            if (days < 0) {
                 months--;
                 const lastMonth = new Date(targetDate.getFullYear(), targetDate.getMonth(), 0);
                 days += lastMonth.getDate();
            }

            if (months < 0) {
                 years--;
                 months += 12;
            }

            ry.textContent = years.toString();
            rm.textContent = months.toString();
            rd.textContent = days.toString();
        }

        dobInput.addEventListener('input', calculateAge);
        targetInput.addEventListener('input', calculateAge);
        calculateAge();
    });
</script>

    <Breadcrumb items={[{ name: 'Home', path: '/' }, { name: "Age Calculator Free – Exact Age in Years, Months, Days", path: "/age-calculator" }]} />

    <ToolWrapper title="Age Calculator" subtitle="Precisely measure how long you've been on this planet, down to the day." currentTool="age-calculator">
        
        <div slot="tool-ui">
             <div class="workspace-editor">
                  <div class="settings-card shadow-sm mb-24">
                       <div class="date-grid">
                           <div class="setting-item">
                                <label class="section-label m-0 mb-8">Date of Birth</label>
                                <input type="date" id="dob-input" class="modern-input" />
                           </div>
                           <div class="setting-item">
                                <label class="section-label m-0 mb-8">Calculate Age At</label>
                                <input type="date" id="target-input" class="modern-input" />
                           </div>
                       </div>
                  </div>

                  <div class="result-box shadow-sm px-24 py-32">
                       <div class="result-header text-center mb-32">
                            <span class="status-pill mb-16">LIVE CALCULATION</span>
                            <h3 class="h3-age m-0 font-850">Your Exact Age</h3>
                       </div>

                       <div class="age-stats-grid">
                            <div class="age-block shadow-sm">
                                 <span id="res-years" class="age-n">0</span>
                                 <label class="age-l">Years</label>
                            </div>
                            <div class="age-block shadow-sm">
                                 <span id="res-months" class="age-n">0</span>
                                 <label class="age-l">Months</label>
                            </div>
                            <div class="age-block shadow-sm">
                                 <span id="res-days" class="age-n">0</span>
                                 <label class="age-l">Days</label>
                            </div>
                       </div>
                  </div>

                  <p class="privacy-note text-center mt-24 mb-0 text-muted font-600">🔒 Your private dates never leave this browser.</p>
             </div>
        </div>

        <div slot="tool-info">
             <h2>Accurate Age Measurement</h2>
             <p>Our <strong>Universal Age Calculator</strong> handles complex calendar logic—including leap years and varying month lengths—to output your precise chronological age. Ideal for checking eligibility, calculating service length, or birth anniversaries.</p>
             
             <div class="faq-grid mt-32">
                  <details class="faq-item">
                       <summary>How does the calculation handle leap years?</summary>
                       <p>We use the standard gregorian calendar logic. If you were born on Feb 29, the calculator correctly accounts for the extra day in leap years during every 4-year cycle.</p>
                  </details>
                  <details class="faq-item">
                       <summary>Can I calculate age for historical dates?</summary>
                       <p>Absolutely. You can change the "Calculate Age At" field to any date in the past or future to see exactly how old you would be on that specific day.</p>
                  </details>
             </div>
        </div>
    </ToolWrapper>
</BaseLayout><style>
    .workspace-editor { display: flex; flex-direction: column; width: 100%; max-width: 800px; margin: 0 auto; }
    
    .settings-card { background: var(--surface-50); border: 1px solid var(--border-subtle); border-radius: 24px; padding: 24px; }
    .date-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
    
    .section-label { font-size: 0.72rem; font-weight:600; color: var(--surface-500); text-transform: uppercase; letter-spacing: 0.05em; display: block; }
    
    .modern-input { width: 100%; padding: 16px; border-radius: 12px; border: 1px solid var(--border-subtle); background:var(--surface-3); font-size: 1.1rem; font-weight:600; color: var(--text-main); outline: none; transition: 0.2s; cursor: pointer; box-sizing: border-box; }
    .modern-input:focus { border-color: var(--accent-primary); box-shadow: 0 0 0 3px rgba(var(--accent-rgb), 0.1); }

    .result-box { background:var(--surface-3); border: 1px solid var(--border-subtle); border-radius: 32px; }
    
    .status-pill { display: inline-block; background: var(--accent-soft); color: var(--accent-primary); padding: 6px 16px; border-radius: 100px; font-size: 0.75rem; font-weight:600; text-transform: uppercase; letter-spacing: 0.05em; }
    .h3-age { font-size: 1.8rem; }

    .age-stats-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
    .age-block { background: var(--surface-50); padding: 32px 16px; border-radius: 20px; border: 1px solid var(--border-subtle); text-align: center; }
    .age-block.shadow-sm { box-shadow: var(--shadow-sm); }
    
    .age-n { display: block; font-size: 3.5rem; font-weight:600; color: var(--accent-primary); line-height: 1; margin-bottom: 12px; }
    .age-l { display: block; font-size: 0.85rem; font-weight:600; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.1em; }

    /* FAQ */
    .faq-grid { display: grid; gap: 16px; }
    .faq-item { background:var(--surface-3); border: 1px solid var(--border-subtle); border-radius: var(--radius-sm); overflow: hidden; text-align: left; }
    .faq-item summary { font-weight:600; font-size: 1rem; padding: 16px 20px; cursor: pointer; color: var(--text-main); list-style-type: none; position: relative; }
    .faq-item summary::after { content: '+'; position: absolute; right: 20px; font-weight:600; font-size: 1.2rem; color: var(--accent-primary); }
    .faq-item[open] summary::after { content: '−'; }
    .faq-item p { padding: 0 20px 20px; margin: 0; font-size: 0.95rem; color: var(--text-muted); line-height: 1.6; }

    .m-0 { margin: 0; }
    .mb-0 { margin-bottom: 0; }
    .mb-8 { margin-bottom: 8px; }
    .mb-16 { margin-bottom: 16px; }
    .mb-24 { margin-bottom: 24px; }
    .mb-32 { margin-bottom: 32px; }
    .mt-24 { margin-top: 24px; }
    .mt-32 { margin-top: 32px; }
    .py-32 { padding-top: 32px; padding-bottom: 32px; }
    .px-24 { padding-left: 24px; padding-right: 24px; }
    .text-center { text-align: center; }
    .font-850 { font-weight:600; }
    .font-600 { font-weight: 600; }
    .text-muted { color: var(--text-muted); }

    @media (max-width: 640px) {
        .date-grid { grid-template-columns: 1fr; gap: 16px; }
        .age-stats-grid { grid-template-columns: 1fr; gap: 16px; }
        .age-n { font-size: 3rem; }
        .age-block { padding: 24px 16px; }
    }
</style>
