---
import BaseLayout from '../components/BaseLayout.astro';
import ToolWrapper from '../components/ToolWrapper.astro';

const PAGE_TITLE = 'Official Form Optimizer';
const PAGE_DESC = 'Ensure your documents meet strict government and institutional requirements.';
const PAGE_KEYWORDS = 'ssc photo compressor, ssc signature resizer, ssc cgl photo size, ssc chsl photo resize online, compress photo for ssc exam, ssc photo maker';

const customSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Precision Document Resizer",
  "description": "Optimized for high-stakes application portals and official standard sizes.",
  "applicationCategory": "MultimediaApplication",
  "operatingSystem": "All"
};
---

<ToolWrapper 
    title="Precision Document Resizer" 
    subtitle="Optimized for high-stakes application portals and official standard sizes."
    currentTool="ssc-optimizer"
>

<style>
    .ssc-workspace { text-align: center; padding: 20px 0; }
    .ssc-alert { background: #fff8e1; border-left: 4px solid #ffc107; padding: 16px; border-radius: 8px; margin-bottom: 32px; color: #856404; font-size: 0.95rem; }
    .tool-actions-centered { display: flex; gap: 16px; justify-content: center; align-items: center; }
    .guideline-card { background: var(--surface-50); border: 1px solid var(--border-subtle); padding: 24px; border-radius: 16px; }
    .guideline-card h3 { margin-bottom: 12px; font-size: 1.1rem; }
    .guideline-card ul { padding-left: 20px; color: var(--text-muted); }
    .guideline-card li { margin-bottom: 8px; }
</style>
