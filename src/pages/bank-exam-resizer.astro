---
import BaseLayout from '../components/BaseLayout.astro';
import ToolWrapper from '../components/ToolWrapper.astro';

const PAGE_TITLE = 'Bank Exam Photo & Signature Resizer (IBPS/SBI/RBI) | FormFix';
const PAGE_DESC = 'Official Bank Exam photo resizer for IBPS, SBI, and RBI. Convert photo to 4.5cm x 3.5cm and signature to 140x60 pixels. Instant 20KB-50KB compression. 100% private.';
const PAGE_KEYWORDS = 'ibps photo resizer, sbi po photo size, bank exam signature maker, resize photo for bank form online, ibps clerk signature size, 4.5x3.5 photo resizer';

const customSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Bank Exam Form Optimizer",
  "description": "Tailored tool for Banking (IBPS, SBI, RBI) candidates to format photos, signatures, and left thumb impressions.",
  "applicationCategory": "MultimediaApplication",
  "operatingSystem": "All"
};
---

<BaseLayout title={PAGE_TITLE} description={PAGE_DESC} keywords={PAGE_KEYWORDS} customSchema={customSchema} active="tools" canonicalPath="/bank-exam-resizer">
    <ToolWrapper 
        title="Bank Exam Optimizer" 
        subtitle="Specially designed for IBPS, SBI PO/Clerk, and RBI aspirants. 100% compliant."
        currentTool="bank-optimizer"
    >
        <div slot="tool-ui">
             <div class="bank-workspace">
                 <div class="bank-alert">
                     <strong>Bank Exam Requirement:</strong> Photo (20-50KB), Signature (10-20KB), and Thumb Impression (20-50KB).
                 </div>
                 <div class="tool-actions-centered">
                     <a href="/passport-size-photo" class="primary-btn pulse-glow">Open Bank Photo Maker →</a>
                     <a href="/compress-image" class="secondary-btn">Compress to 20KB</a>
                 </div>
             </div>
        </div>

        <div slot="tool-info">
             <article class="prose">
                 <h2>IBPS/SBI/RBI Bank Exam Photo & Signature Guidelines</h2>
                 <p>Banking recruitment boards like IBPS and SBI have extremely strict upload portals. If your "Left Thumb Impression" or "Handwritten Declaration" is not the correct size, the system will not let you proceed to the payment page.</p>
                 
                 <div class="guideline-card">
                     <h3>1. Photograph Specifications:</h3>
                     <ul>
                         <li><strong>Dimensions:</strong> 4.5 cm × 3.5 cm.</li>
                         <li><strong>File Size:</strong> 20 KB to 50 KB.</li>
                         <li><strong>Orientation:</strong> Portrait.</li>
                     </ul>
                 </div>

                 <div class="guideline-card mt-24">
                     <h3>2. Signature & Thumb Impression:</h3>
                     <ul>
                         <li><strong>Signature Size:</strong> 10 KB to 20 KB (140 x 60 pixels).</li>
                         <li><strong>Thumb Impression:</strong> 20 KB to 50 KB (240 x 240 pixels).</li>
                         <li><strong>Format:</strong> JPG/JPEG only.</li>
                     </ul>
                 </div>

                 <h2>How to Prepare Bank Exam Documents</h2>
                 <ol>
                     <li><strong>Photograph:</strong> Use our "Bank Photo Maker" to crop your photo to exactly 4.5x3.5cm.</li>
                     <li><strong>Left Thumb Impression:</strong> Scan your thumb impression on white paper with blue/black ink, upload here, and compress to 40KB.</li>
                     <li><strong>Handwritten Declaration:</strong> Ensure the declaration is in English and written with black ink on white paper. Compress to under 100KB.</li>
                     <li><strong>Privacy:</strong> Since these are sensitive identity documents, FormFix processes them entirely in your browser. No data is sent to our servers.</li>
                 </ol>

                 <div class="faq-section mt-48">
                     <h3>Banking Portal FAQ</h3>
                     <details class="minimal-faq">
                         <summary>What is the photo size for IBPS 2024? <span class="indicator">+</span></summary>
                         <div class="faq-body">
                             <p>IBPS requires a 4.5cm x 3.5cm photograph between 20KB and 50KB. Our tool handles these dimensions and sizes automatically.</p>
                         </div>
                     </details>
                     <details class="minimal-faq">
                         <summary>Can I use a signature in CAPITAL LETTERS? <span class="indicator">+</span></summary>
                         <div class="faq-body">
                             <p>No. IBPS and SBI will reject signatures written in block/capital letters. It must be in a running hand.</p>
                         </div>
                     </details>
                 </div>
             </article>
        </div>
    </ToolWrapper>
</BaseLayout>

<style>
    .bank-workspace { text-align: center; padding: 20px 0; }
    .bank-alert { background: #fdf2f8; border-left: 4px solid #db2777; padding: 16px; border-radius: 8px; margin-bottom: 32px; color: #9d174d; font-size: 0.95rem; }
    .tool-actions-centered { display: flex; gap: 16px; justify-content: center; align-items: center; }
    .guideline-card { background: var(--surface-50); border: 1px solid var(--border-subtle); padding: 24px; border-radius: 16px; }
    .guideline-card h3 { margin-bottom: 12px; font-size: 1.1rem; }
    .guideline-card ul { padding-left: 20px; color: var(--text-muted); }
    .guideline-card li { margin-bottom: 8px; }
</style>
