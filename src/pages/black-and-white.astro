---
import BaseLayout from '../components/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import ToolWrapper from '../components/ToolWrapper.astro';

const PAGE_TITLE = 'Convert Photo to Black & White - Free B&W Filter Online | FormFix';
const PAGE_DESC = 'Turn your photos into black and white images or create a scanned document effect. High contrast B&W converter, 100% free and offline.';
const PAGE_KEYWORDS = 'photo to black and white, black and white converter, scan effect online, document scanner effect, make photo bw';

const customSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      "name": "FormFix Pro B&W Converter",
      "operatingSystem": "All Platforms",
      "applicationCategory": "UtilitiesApplication",
      "description": "Convert images to true black and white or create high-contrast scanned document effects.",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      }
    }
  ]
};

const faqs = [
  { q: "How can I create a \"Scanner\" effect?", a: "To simulate a high-quality document scan, simply slide the Contrast bar to the right (above 150%). This will bleach mid-tones, making text sharp black and paper pure white." },
  { q: "Is this better than typical photo filters?", a: "Yes. Typical filters often lose detail in the shadows. Our algorithm allows manual control over the Dynamic Range, giving you professional control over clarity and artistic mood." },
];
---

<BaseLayout title={PAGE_TITLE} description={PAGE_DESC} keywords={PAGE_KEYWORDS} customSchema={customSchema} active="tools" canonicalPath="/black-and-white" faqs={faqs}>
    <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
        try {
        const input = document.getElementById('img-input'), canvas = document.getElementById('bw-canvas'), ctx = canvas.getContext('2d', { willReadFrequently: true });
        const contrastSlider = document.getElementById('contrast-slider'), contrastLabel = document.getElementById('contrast-label');
        const brightSlider = document.getElementById('brightness-slider'), brightLabel = document.getElementById('bright-label');
        
        let originalImage = new Image(), originalData = null, fileName = 'image.png';
        let sourceFileType = 'image/jpeg';

        const dropZone = document.getElementById('drop-zone');
        if (dropZone) {
            dropZone.addEventListener('dragover', (e) => { e.preventDefault(); e.stopPropagation(); dropZone.style.borderColor = 'var(--accent-primary)'; dropZone.style.background = 'var(--surface-2)'; });
            dropZone.addEventListener('dragleave', (e) => { e.preventDefault(); e.stopPropagation(); dropZone.style.borderColor = ''; dropZone.style.background = ''; });
            dropZone.addEventListener('drop', (e) => {
                e.preventDefault(); e.stopPropagation();
                dropZone.style.borderColor = ''; dropZone.style.background = '';
                const file = e.dataTransfer.files[0];
                if (file && file.type.startsWith('image/')) {
                    input.files = e.dataTransfer.files;
                    input.dispatchEvent(new Event('change'));
                } else {
                    if (typeof window.ffNotice === 'function') window.ffNotice('Please drop a PNG, JPG, or WebP image.', 'error');
                }
            });
        }

        input.onchange = (e) => {
            const file = e.target.files[0]; if (!file) return;
            if (!['image/png','image/jpeg','image/webp'].includes(file.type)) {
                if (typeof window.ffNotice === 'function') window.ffNotice('Please select a PNG, JPG, or WebP image.', 'error');
                return;
            }
            fileName = file.name;
            sourceFileType = file.type === 'image/png' ? 'image/png' : file.type === 'image/webp' ? 'image/webp' : 'image/jpeg';
            const r = new FileReader(); r.onload = (ev) => {
                originalImage.onload = () => {
                    const max = 1200; let w = originalImage.width, h = originalImage.height;
                    if (w > max) { h = (max/w)*h; w = max; }
                    canvas.width = w; canvas.height = h;
                    ctx.drawImage(originalImage, 0, 0, w, h);
                    originalData = ctx.getImageData(0, 0, w, h);
                    document.getElementById('upload-stage').classList.add('hidden');
                    document.getElementById('editor-stage').classList.remove('hidden'); applyFilters();
                };
                originalImage.src = ev.target.result;
            };
            r.readAsDataURL(file);
        };

        const applyFilters = () => {
            if (!originalImage.src || !originalData) return;
            const contrast = parseInt(contrastSlider.value);
            const brightness = parseInt(brightSlider.value) / 100;
            
            brightLabel.innerText = parseInt(brightSlider.value) + '%';
            if (contrast <= 110) contrastLabel.textContent = "Normal";
            else if (contrast <= 150) contrastLabel.textContent = "High Contrast";
            else contrastLabel.textContent = "Doc Scan";

            const factor = (259 * (contrast + 255)) / (255 * (259 - contrast));
            
            const idata = new ImageData(new Uint8ClampedArray(originalData.data), canvas.width, canvas.height);
            const data = idata.data;

            const doInvert = document.getElementById('invert-toggle')?.checked;
            for (let i = 0; i < data.length; i += 4) {
                let gray = 0.299 * data[i] + 0.587 * data[i + 1] + 0.114 * data[i + 2];
                gray = factor * (gray - 128) + 128;
                gray = gray * brightness;
                if (doInvert) gray = 255 - gray;
                
                if (gray > 255) gray = 255;
                if (gray < 0) gray = 0;
                
                data[i] = gray; data[i + 1] = gray; data[i + 2] = gray;
            }
            
            ctx.putImageData(idata, 0, 0);
        };

        let selectedFormat = 'image/jpeg';
        let selectedExt = 'jpg';

        document.querySelectorAll('.fmt-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                document.querySelectorAll('.fmt-btn').forEach(b => b.classList.remove('active'));
                btn.classList.add('active');
                selectedFormat = 'image/' + btn.dataset.fmt;
                selectedExt = btn.dataset.fmt === 'jpeg' ? 'jpg' : btn.dataset.fmt;
                applyFilters();
            });
        });

        contrastSlider.oninput = applyFilters;
        brightSlider.oninput = applyFilters;
        document.getElementById('invert-toggle').addEventListener('change', applyFilters);

        document.getElementById('dl-btn').onclick = () => {
            const baseName = fileName ? fileName.replace(/\.[^/.]+$/, "") : 'image';
            const finalName = baseName + "_bw." + selectedExt;
            const a = document.createElement('a'); a.download = finalName; a.href = canvas.toDataURL(selectedFormat, 0.95); a.click();
            var shareTxt = encodeURIComponent("I just converted my photo to black & white using FormFix! 100% private. Try it: " + window.__SITE_URL + "/black-and-white");
            var existing = document.getElementById('post-bw-share');
            if (!existing) {
                var div = document.createElement('div');
                div.id = 'post-bw-share';
                div.style.cssText = 'margin-top:20px;text-align:center;';
                div.innerHTML = '<p style="font-weight:600;margin-bottom:10px;color:var(--success);">Love FormFix? Share it!</p><div style="display:flex;gap:8px;justify-content:center;"><a href="https://x.com/intent/tweet?text=' + shareTxt + '" target="_blank" style="padding:8px 16px;border-radius:8px;background:#000;color:#fff;text-decoration:none;font-weight:600;font-size:0.85rem;">Share on X</a><a href="https://wa.me/?text=' + shareTxt + '" target="_blank" style="padding:8px 16px;border-radius:8px;background:#25D366;color:#fff;text-decoration:none;font-weight:600;font-size:0.85rem;">WhatsApp</a></div>';
                document.querySelector('.action-stack')?.appendChild(div);
            }
        };
        } catch(err) { console.error('B&W tool error:', err); if (typeof window.ffNotice === 'function') window.ffNotice('Something went wrong. Please try a different image.', 'error'); }
    });
</script>

    <Breadcrumb items={[{ name: 'Home', path: '/' }, { name: "Convert Photo to Black & White - Free B&W Filter Online", path: "/black-and-white" }]} />

    <ToolWrapper title="Black & White Filter" subtitle="Create moody grayscale photos or high-contrast scanned document effects instantly." currentTool="black-and-white">
        
        <div slot="tool-ui">
             <div class="workspace-editor">
                  <!-- 1. Selection Stage -->
                  <div id="upload-stage" class="upload-container">
                       <div class="upload-box shadow-sm" id="drop-zone" onclick="document.getElementById('img-input').click()">
                            <input type="file" id="img-input" accept="image/png, image/jpeg, image/webp" class="hidden" />
                            <div class="upload-content">
                                 <div class="upload-icon">🎞️</div>
                                 <h3 class="font-850 m-0 mb-8">Select Image to Fix</h3>
                                 <p class="text-muted m-0 mb-24 font-600">Create moody photography or clean document scans.</p>
                                 <button class="primary-btn px-40">Upload Photo</button>
                            </div>
                       </div>
                  </div>

                  <!-- 2. Editor Stage -->
                  <div id="editor-stage" class="hidden">
                       <div class="filter-grid">
                            <div class="preview-panel shadow-sm">
                                 <div class="preview-header mb-16">
                                      <span class="preview-badge">Live Grayscale Result</span>
                                 </div>
                                 <div class="canvas-viewport checkerboard scroll-container">
                                      <canvas id="bw-canvas"></canvas>
                                 </div>
                            </div>

                            <div class="controls-sidebar">
                                 <div class="settings-card shadow-sm mb-24">
                                      <div class="section mb-24">
                                           <div class="d-flex justify-between align-center mb-16">
                                                <label class="section-label m-0">Contrast Mode</label>
                                                <span id="contrast-label" class="status-pill highlight m-0" style="padding: 4px 12px;">Normal</span>
                                           </div>
                                           <input type="range" id="contrast-slider" min="0" max="200" value="100" class="unified-slider w-100" />
                                      </div>
                                      
                                       <div class="section mb-24">
                                            <div class="d-flex justify-between align-center mb-16">
                                                 <label class="section-label m-0">Brightness</label>
                                                 <span id="bright-label" class="status-pill highlight m-0" style="padding: 4px 12px;">100%</span>
                                            </div>
                                            <input type="range" id="brightness-slider" min="50" max="150" value="100" class="unified-slider w-100" />
                                       </div>
                                       <div class="section mb-24">
                                            <label class="section-label m-0 mb-12">Output Format</label>
                                            <div class="toggle-pill-group">
                                                 <button class="setting-pill active fmt-btn" data-fmt="jpeg">JPG</button>
                                                 <button class="setting-pill fmt-btn" data-fmt="png">PNG</button>
                                                 <button class="setting-pill fmt-btn" data-fmt="webp">WebP</button>
                                            </div>
                                       </div>
                                       <div class="section">
                                            <label class="toggle-container" style="justify-content:center;">
                                                 <input type="checkbox" id="invert-toggle" style="width:18px;height:18px;accent-color:var(--accent-primary);" />
                                                 Invert Colors
                                            </label>
                                       </div>
                                 </div>

                                 <div class="action-stack">
                                      <button id="dl-btn" class="primary-btn wide-btn pulse-glow mb-12">⬇️ Download B&W Image</button>
                                      <button class="secondary-btn wide-btn" onclick="location.reload()">↺ Change Photo</button>
                                 </div>
                                 <p class="privacy-note text-center mt-16 mb-0 font-600 text-muted">🔒 Local Grayscale Processing.</p>
                            </div>
                       </div>
                  </div>
             </div>
        </div>

        <div slot="tool-info">
             <h2>Pro Grayscale Conversion Technology</h2>
             <p>Our <strong>Online B&W Tool</strong> uses advanced luminance weighting (0.299R + 0.587G + 0.114B) to ensure the most natural transition to grayscale, mimicking high-end digital SLR sensors. Use the contrast slider to simulate hard-boiled noir film or create a "clean white" effect for document scans.</p>
             
             <div class="faq-grid mt-32">
                  <details class="faq-item">
                       <summary>How can I create a "Scanner" effect?</summary>
                       <p>To simulate a high-quality document scan, simply slide the <strong>Contrast</strong> bar to the right (above 150%). This will bleach mid-tones, making text sharp black and paper pure white.</p>
                  </details>
                  <details class="faq-item">
                       <summary>Is this better than typical photo filters?</summary>
                       <p>Yes. Typical filters often lose detail in the shadows. Our algorithm allows manual control over the <strong>Dynamic Range</strong>, giving you professional control over clarity and artistic mood.</p>
                  </details>
             </div>
        </div>
    </ToolWrapper>
</BaseLayout><style>
    .filter-grid { display: grid; grid-template-columns: 1fr 340px; gap: 32px; }
    #bw-canvas { max-width: 100%; max-height: 600px; display: block; filter: drop-shadow(0 15px 40px rgba(0,0,0,0.1)); }

    @media (max-width: 900px) {
        .filter-grid { grid-template-columns: 1fr; }
        .preview-panel { min-height: 350px; padding: 16px; }
    }
    @media (max-width: 640px) {
        .upload-box { padding: 40px 24px; }
    }
</style>
