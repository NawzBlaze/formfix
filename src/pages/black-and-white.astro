---
import BaseLayout from '../components/BaseLayout.astro';
import RelatedTools from '../components/RelatedTools.astro';

const PAGE_TITLE = 'Convert Photo to Black & White - Free B&W Filter Online';
const PAGE_DESC = 'Turn your photos into black and white images or create a scanned document effect. High contrast B&W converter, 100% free and offline.';
const PAGE_KEYWORDS = 'photo to black and white, black and white converter, scan effect online, document scanner effect, make photo bw';

const customSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      "name": "FormFix Pro B&W Converter",
      "operatingSystem": "All",
      "applicationCategory": "UtilitiesApplication",
      "description": "Convert images to true black and white or create high-contrast scanned document effects.",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      }
    }
  ]
};
---

<BaseLayout title={PAGE_TITLE} description={PAGE_DESC} keywords={PAGE_KEYWORDS} customSchema={customSchema} active="tools" canonicalPath="/black-and-white">
    <div class="tool-wrapper animate-in">
        <header class="tool-intro text-center">
             <div class="brand-badge shadow-sm">📸 B&W Vision Engine</div>
             <h1 class="main-h1">Photo to <span class="highlight">Black & White</span></h1>
             <p class="hero-sub">Convert photos to elegant grayscale, or boost contrast to simulate a scanned document for official forms.</p>
        </header>

        <div class="glass-card tool-content shadow-lg max-w-lg mx-auto">
            
            <div id="upload-stage" class="upload-container shadow-sm">
                 <div class="upload-circle mb-16"><span class="u-icon">🔲</span></div>
                 <h3 class="u-title">Upload an Image</h3>
                 <p class="u-sub">JPG, PNG, or WebP. Try a photo or homework scan.</p>
                 <button class="primary-btn wide-btn profile-btn pulse-glow" onclick="document.getElementById('image-upload').click()">Browse Photo</button>
                 <input type="file" id="image-upload" class="hidden" accept="image/png, image/jpeg, image/webp" />
            </div>

            <div id="editor-stage" class="hidden">
                 <div class="img-preview mb-24">
                     <canvas id="bw-canvas" class="styled-canvas"></canvas>
                 </div>
                 
                 <div class="control-panel">
                      <div class="d-flex justify-between mb-12">
                           <span class="font-bold">Contrast (Scanner Effect)</span>
                           <span id="contrast-val" class="font-bold text-primary">Normal</span>
                      </div>
                      <input type="range" id="contrast-slider" min="0" max="200" value="100" class="modern-slider mb-24" />
                      
                      <div class="d-flex justify-between mb-12">
                           <span class="font-bold">Brightness</span>
                      </div>
                      <input type="range" id="brightness-slider" min="50" max="150" value="100" class="modern-slider mb-24" />
                 </div>
                 
                 <div class="d-flex gap-16 mt-24 wrap-mobile">
                      <button id="reset-btn" class="secondary-btn wide-btn-half profile-btn">Start Over</button>
                      <button id="download-btn" class="primary-btn wide-btn profile-btn pulse-glow" style="flex:1;">⬇️ Download B&W</button>
                 </div>
            </div>

        </div>

        <article class="pro-seo-article container mt-48">
             <h2>The Best B&W Filter Online</h2>
             <p>Our <strong>Black & White Image Converter</strong> does more than just remove color. Whether you are an artist trying to create moody grayscale photography, or a student trying to simulate a "black and white scanned copy" of homework or documents, this tool gives you absolute control. By tweaking the <strong>Contrast & Brightness</strong> sliders, you can either achieve soft grayscale imagery or crank up the contrast to perfectly simulate a hardware office scanner.</p>
             
             <h3 class="mt-32">Private & Client-Side</h3>
             <ul style="color:var(--slate); line-height:1.8; margin-left:20px; font-size:1.1rem">
                <li><strong>100% Secure:</strong> Processing is done entirely using your browser's graphics engine. Your personal pictures and ID documents are never sent over the internet.</li>
                <li><strong>Instant Output:</strong> Tweak the contrast to get the perfect scan and download instantly—no watermarks and no signups required.</li>
             </ul>
        </article>

        <RelatedTools currentTool="black-and-white" />
    </div>
</BaseLayout>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const fileInput = document.getElementById('image-upload') as HTMLInputElement;
        const uploadStage = document.getElementById('upload-stage') as HTMLElement;
        const editorStage = document.getElementById('editor-stage') as HTMLElement;
        const downloadBtn = document.getElementById('download-btn') as HTMLButtonElement;
        const resetBtn = document.getElementById('reset-btn') as HTMLButtonElement;
        
        const canvas = document.getElementById('bw-canvas') as HTMLCanvasElement;
        const ctx = canvas.getContext('2d', { willReadFrequently: true })!;
        
        const contrastSlider = document.getElementById('contrast-slider') as HTMLInputElement;
        const brightnessSlider = document.getElementById('brightness-slider') as HTMLInputElement;
        const contrastVal = document.getElementById('contrast-val') as HTMLElement;

        let originalImage = new Image();
        let fileName = 'image.png';

        fileInput.addEventListener('change', (e: any) => {
            const file = e.target.files[0];
            if(!file) return;
            fileName = file.name;
            
            const reader = new FileReader();
            reader.onload = (event) => {
                originalImage.onload = () => {
                    canvas.width = originalImage.width;
                    canvas.height = originalImage.height;
                    
                    uploadStage.classList.add('hidden');
                    editorStage.classList.remove('hidden');
                    
                    applyFilters();
                };
                originalImage.src = event.target?.result as string;
            };
            reader.readAsDataURL(file);
        });

        function applyFilters() {
            if(!originalImage.src) return;
            
            // Draw original
            ctx.drawImage(originalImage, 0, 0);
            
            // Get Image Data
            const imageData = ctx.getImageData(0, 0, canvas.width, canvas.height);
            const data = imageData.data;
            
            const contrast = parseInt(contrastSlider.value);
            const brightness = parseInt(brightnessSlider.value) / 100;
            
            // Contrast Factor Formula
            const factor = (259 * (contrast + 255)) / (255 * (259 - contrast));
            
            if (contrast <= 110) contrastVal.textContent = "Normal";
            else if (contrast <= 150) contrastVal.textContent = "High Contrast";
            else contrastVal.textContent = "Document Scan";
            
            for (let i = 0; i < data.length; i += 4) {
                // Grayscale luminance
                let r = data[i];
                let g = data[i + 1];
                let b = data[i + 2];
                let gray = 0.299 * r + 0.587 * g + 0.114 * b;
                
                // Apply Contrast
                gray = factor * (gray - 128) + 128;
                
                // Apply Brightness
                gray = gray * brightness;
                
                // Clamp
                if (gray > 255) gray = 255;
                if (gray < 0) gray = 0;
                
                // Assign B&W values back
                data[i] = gray;
                data[i + 1] = gray;
                data[i + 2] = gray;
            }
            
            ctx.putImageData(imageData, 0, 0);
        }

        contrastSlider.addEventListener('input', applyFilters);
        brightnessSlider.addEventListener('input', applyFilters);

        resetBtn.addEventListener('click', () => {
            originalImage = new Image();
            fileInput.value = '';
            contrastSlider.value = '100';
            brightnessSlider.value = '100';
            uploadStage.classList.remove('hidden');
            editorStage.classList.add('hidden');
        });

        downloadBtn.addEventListener('click', () => {
            const ext = fileName.split('.').pop() || 'jpg';
            const mimeType = ext.toLowerCase() === 'png' ? 'image/png' : 'image/jpeg';
            const finalName = fileName.replace(/\.[^/.]+$/, "") + "_bw." + ext;
            
            const link = document.createElement('a');
            link.download = finalName;
            link.href = canvas.toDataURL(mimeType, 0.95);
            link.click();
        });
    });
</script>

<style>
    .main-h1 { font-size: 3.5rem; font-weight: 1000; letter-spacing: -0.05em; margin-bottom: 12px; color: var(--dark); line-height: 1.1; }
    .hero-sub { color: var(--slate); font-weight: 600; font-size: 1.25rem; margin-bottom: 24px; }
    .tool-wrapper { max-width: 960px; margin: 0 auto; padding-bottom: 100px; }
    .max-w-lg { max-width: 550px; margin-inline: auto; }
    
    .upload-container { background: #f8fafc; border: 2.5px dashed var(--border); border-radius: 32px; padding: 60px 20px; text-align: center; cursor: pointer; transition: 0.3s; margin-top:16px; min-height: 380px; display: flex; flex-direction: column; align-items: center; justify-content: center; }
    .upload-container:hover { border-color: var(--primary); background: #f0fdf4; transform: translateY(-4px); }
    .upload-circle { width: 90px; height: 90px; background: #fff; border-radius: 50%; box-shadow: 0 10px 25px rgba(0,0,0,0.05); display: flex; align-items: center; justify-content: center; margin: 0 auto 20px; font-size: 3rem; }
    .u-title { font-size: 1.8rem; font-weight: 1000; color: var(--dark); margin-bottom: 8px; }
    .u-sub { font-size: 1.1rem; color: var(--slate); font-weight: 600; margin-bottom: 32px; }

    #editor-stage { background: #fff; padding: 24px; border-radius: 24px; border: 1.5px solid var(--border); }
    .img-preview { width: 100%; max-height: 350px; background: #f1f5f9; border-radius: 16px; display: flex; justify-content: center; align-items: center; overflow: hidden; border: 2px dashed var(--gray); padding: 8px; }
    .styled-canvas { max-width: 100%; max-height: 100%; object-fit: contain; border-radius: 8px; box-shadow: 0 4px 10px rgba(0,0,0,0.1); }
    
    .control-panel { background: #f8fafc; padding: 20px; border-radius: 16px; border: 1px solid var(--border); }
    .modern-slider { -webkit-appearance: none; width: 100%; height: 8px; border-radius: 5px; background: #e2e8f0; outline: none; margin-top: 8px; }
    .modern-slider::-webkit-slider-thumb { -webkit-appearance: none; appearance: none; width: 24px; height: 24px; border-radius: 50%; background: var(--primary); cursor: pointer; border: 4px solid #fff; box-shadow: 0 2px 6px rgba(0,0,0,0.2); }
    
    .d-flex { display: flex; }
    .justify-between { justify-content: space-between; }
    .font-bold { font-weight: 900; color: var(--dark); }
    .text-primary { color: var(--primary); }
    .mb-12 { margin-bottom: 12px; }
    .mb-16 { margin-bottom: 16px; }
    .mb-24 { margin-bottom: 24px; }
    .mt-24 { margin-top: 24px; }
    .mt-32 { margin-top: 32px; }
    .mt-48 { margin-top: 48px; }
    .gap-16 { gap: 16px; }
    
    .wide-btn { padding: 22px 24px; font-weight: 1000; font-size: 1.25rem; border-radius: 100px; display: block; }
    .wide-btn-half { padding: 20px 32px; font-weight: 1000; font-size: 1.15rem; border-radius: 100px; min-width: 140px; }
    .hidden { display: none !important; }

    @media (max-width: 640px) {
        .wrap-mobile { flex-direction: column; }
        .wide-btn, .wide-btn-half { width: 100%; }
        .img-preview { max-height: 250px; }
    }
</style>
