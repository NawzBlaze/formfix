---
import BaseLayout from '../components/BaseLayout.astro';
import ToolWrapper from '../components/ToolWrapper.astro';

const PAGE_TITLE = 'NEET Photo Compressor (Postcard & Passport Size) | FormFix';
const PAGE_DESC = 'Official NEET photo compressor and postcard size (4x6) maker. Get the perfect 10KB to 200KB photo and signature for NTA NEET UG applications. 100% private.';
const PAGE_KEYWORDS = 'neet photo compressor, neet postcard size photo maker online, neet 4x6 photo resize, nta neet photo size converter, neet signature resizer, neet photo maker';

const customSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "name": "NEET Form Optimizer",
      "description": "Specialized tool for NTA NEET UG candidates for passport and postcard size photos.",
      "applicationCategory": "MultimediaApplication"
    }
  ]
};
---

<BaseLayout title={PAGE_TITLE} description={PAGE_DESC} keywords={PAGE_KEYWORDS} customSchema={customSchema} active="tools" canonicalPath="/neet-photo-compressor">
    <ToolWrapper 
        title="NEET Application Optimizer" 
        subtitle="Create both Passport (2x2) and Postcard (4x6) photos for NTA NEET registration."
        currentTool="neet-optimizer"
    >
        <div slot="tool-ui">
             <div class="neet-workspace">
                 <div class="neet-alert">
                     <strong>NEET Requirement:</strong> Passport size (10KB-200KB) and Postcard size (4"x6") (10KB-200KB). Background must be WHITE.
                 </div>
                 <div class="tool-actions-centered">
                     <a href="/passport-size-photo" class="primary-btn pulse-glow">Create NEET Photos →</a>
                     <a href="/compress-image" class="secondary-btn">Compress to 50KB</a>
                 </div>
             </div>
        </div>

        <div slot="tool-info">
             <article class="prose">
                 <h2>Official NTA NEET UG Photo & Signature Guidelines</h2>
                 <p>The National Testing Agency (NTA) for NEET UG has very specific requirements for candidate photographs. Failure to upload the correct size or format can lead to the rejection of your application. FormFix helps you create 100% compliant photos locally in your browser.</p>
                 
                 <div class="guideline-grid">
                     <div class="guideline-card">
                         <h3>1. Passport Size Photo</h3>
                         <ul>
                             <li><strong>Dimensions:</strong> 3.5 cm x 4.5 cm (or 2" x 2").</li>
                             <li><strong>File Size:</strong> 10 KB to 200 KB.</li>
                             <li><strong>Background:</strong> Plain white background only.</li>
                             <li><strong>Face Coverage:</strong> 80% face coverage with ears clearly visible.</li>
                         </ul>
                     </div>
                     <div class="guideline-card">
                         <h3>2. Postcard Size Photo (4"x6")</h3>
                         <ul>
                             <li><strong>Dimensions:</strong> 4 inches x 6 inches (Postcard size).</li>
                             <li><strong>File Size:</strong> 10 KB to 200 KB.</li>
                             <li><strong>Details:</strong> Must have the candidate's name and date of photo taken at the bottom.</li>
                         </ul>
                     </div>
                 </div>

                 <h2>How to Create Your NEET Photo Online</h2>
                 <ol>
                     <li><strong>Choose the Tool:</strong> Click on "Create NEET Photos" above to open our specialized maker.</li>
                     <li><strong>Upload Photo:</strong> Select a clear photo with a white background.</li>
                     <li><strong>Adjust and Crop:</strong> Use the aspect ratio lock for "Passport" or "Postcard" size.</li>
                     <li><strong>Add Text (for Postcard):</strong> Ensure you add your name and today's date at the bottom as per NTA rules.</li>
                     <li><strong>Compress and Download:</strong> Set your target size to 50KB-100KB for maximum safety and download your JPEG.</li>
                 </ol>

                 <div class="warning-card mt-24">
                     <p><strong>⚠️ Critical NTA Rule:</strong> Do not wear spectacles or caps in the photo. Both ears must be visible. Photos with dark or colorful backgrounds will be summarily rejected.</p>
                 </div>

                 <div class="faq-section mt-48">
                     <h3>NEET Photo Upload FAQ</h3>
                     <details class="minimal-faq">
                         <summary>What is the postcard size for NEET in pixels? <span class="indicator">+</span></summary>
                         <div class="faq-body">
                             <p>For a high-quality 4x6 inch postcard photo, you should aim for at least 1200 x 1800 pixels. Our tool handles these dimensions automatically when you select the Postcard preset.</p>
                         </div>
                     </details>
                     <details class="minimal-faq">
                         <summary>Can I upload a photo with a blue background for NEET? <span class="indicator">+</span></summary>
                         <div class="faq-body">
                             <p>No. NTA strictly requires a WHITE background. Photos with any other background color are the #1 reason for NEET application rejection.</p>
                         </div>
                     </details>
                     <details class="minimal-faq">
                         <summary>Is a date mandatory on the NEET postcard photo? <span class="indicator">+</span></summary>
                         <div class="faq-body">
                             <p>Yes. The candidate's name and the date of taking the photograph must be printed clearly at the bottom of the postcard-sized photograph.</p>
                         </div>
                     </details>
                 </div>
             </article>
        </div>
    </ToolWrapper>
</BaseLayout>

<style>
    .neet-workspace { text-align: center; padding: 20px 0; }
    .neet-alert { background: #fff1f2; border-left: 4px solid #f43f5e; padding: 16px; border-radius: 8px; margin-bottom: 32px; color: #9f1239; font-size: 0.95rem; }
    .tool-actions-centered { display: flex; gap: 16px; justify-content: center; align-items: center; }
    .guideline-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 24px; }
    .guideline-card { background: var(--surface-50); border: 1px solid var(--border-subtle); padding: 24px; border-radius: 16px; }
    .guideline-card h3 { margin-bottom: 12px; font-size: 1.1rem; }
    .guideline-card ul { padding-left: 20px; color: var(--text-muted); text-align: left; }
    .guideline-card li { margin-bottom: 8px; }
    .warning-card { background: #fffbeb; border: 1px solid #fef3c7; padding: 20px; border-radius: 16px; color: #92400e; font-size: 0.9rem; }
    
    @media (max-width: 600px) {
        .guideline-grid { grid-template-columns: 1fr; }
    }
</style>
