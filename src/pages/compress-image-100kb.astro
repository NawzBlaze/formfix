---
import BaseLayout from '../components/BaseLayout.astro';
import RelatedTools from '../components/RelatedTools.astro';
import CompressTool from '../components/tools/CompressTool.astro';

const PAGE_TITLE = 'Compress Image to 100KB Online - High Quality & Private | FormFix';
const PAGE_DESC = 'Easily compress JPG and PNG to 100kb online. Best for resume uploads, LinkedIn profile photos, and official documents. 100% private browser tool.';
const PAGE_KEYWORDS = 'compress image to 100kb, photo size reducer to 100kb, 100kb jpg converter, resize photo to 100kb online, compress scan 100kb';

const customSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      "name": "100KB Image Compressor - FormFix",
      "operatingSystem": "All Platforms",
      "applicationCategory": "UtilitiesApplication",
      "description": PAGE_DESC,
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      }
    }
  ]
};
---

<BaseLayout title={PAGE_TITLE} description={PAGE_DESC} keywords={PAGE_KEYWORDS} customSchema={customSchema} active="compress" canonicalPath="/compress-image-100kb">
    <div class="tool-wrapper animate-in">
        <header class="tool-intro text-center">
             <div class="brand-badge shadow-sm">💠 Optimized for 100KB</div>
             <h1 class="main-h1">Compress Image to <span class="highlight">100KB</span></h1>
             <p class="hero-sub">Perfect for resumes, official portal uploads, and sharp LinkedIn headshots. Always private.</p>
        </header>

        <CompressTool />

        <article class="pro-seo-article container mt-48">
             <h2>High-Quality 100KB Image Compression Online</h2>
             <p>Need to <strong>compress photo to 100kb</strong> without making it look blurry? FormFix uses an advanced mathematical optimization engine to hit exactly 100KB while preserving high detail for text and portraits. Whether it's a scanned document, a professional resume photo, or an ID card, our <strong>100kb photo compressor</strong> ensures your file meets upload requirements on any platform without compromising on professional look.</p>
             
             <h3 class="mt-32">How to Compress JPG to 100KB</h3>
             <ol>
                <li>Select the image you want to optimize.</li>
                <li>Pick the "100 KB" target button or enter 100 in the custom box.</li>
                <li>Wait 1 second for the local browser engine to optimize.</li>
                <li>Download your 100KB file immediately.</li>
             </ol>

             <h3 class="mt-32">Why FormFix for 100KB Resizing?</h3>
             <ul>
                <li><strong>Retina Quality:</strong> We aim for the best balance of size and clarity.</li>
                <li><strong>No Uploads:</strong> Your documents stay on your machine.</li>
                <li><strong>Unlimited usage:</strong> Compress as many 100KB photos as you need for free.</li>
             </ul>
        </article>

        <RelatedTools currentTool="compress" />
    </div>
</BaseLayout>

<style>
    .main-h1 { font-size: 3rem; font-weight: 1000; letter-spacing: -0.05em; margin-bottom: 12px; color: var(--dark); line-height: 1.1; }
    .hero-sub { color: var(--slate); font-weight: 600; font-size: 1.15rem; margin-bottom: 24px; max-width: 600px; margin-inline: auto; }
    .tool-wrapper { max-width: 860px; margin: 0 auto; padding-bottom: 100px; }
    .mt-48 { margin-top: 48px; }
    .mt-32 { margin-top: 32px; }
</style>
