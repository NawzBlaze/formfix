# FormFix — Cloudflare Pages Headers
# Security + Performance + SEO-friendly caching

# ─── Security Headers (all pages) ───────────────────────────────────
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=()
  X-XSS-Protection: 1; mode=block
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://unpkg.com https://www.clarity.ms https://plausible.io; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self' https://cdn.jsdelivr.net https://www.clarity.ms https://plausible.io blob:; worker-src 'self' blob:; frame-ancestors 'self'; base-uri 'self'; form-action 'self';

# ─── Static Assets — Long-term caching ──────────────────────────────
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/favicon.png
  Cache-Control: public, max-age=31536000, immutable

/favicon.ico
  Cache-Control: public, max-age=31536000, immutable

/favicon-16.png
  Cache-Control: public, max-age=31536000, immutable

/favicon-32.png
  Cache-Control: public, max-age=31536000, immutable

/favicon-48.png
  Cache-Control: public, max-age=31536000, immutable

/favicon-96.png
  Cache-Control: public, max-age=31536000, immutable

/favicon-192.png
  Cache-Control: public, max-age=31536000, immutable

/favicon-512.png
  Cache-Control: public, max-age=31536000, immutable

/favicon.svg
  Cache-Control: public, max-age=31536000, immutable

/apple-touch-icon.png
  Cache-Control: public, max-age=31536000, immutable

/og-image.png
  Cache-Control: public, max-age=31536000, immutable

/og-banner.png
  Cache-Control: public, max-age=31536000, immutable

/manifest.json
  Cache-Control: public, max-age=0, must-revalidate
  Content-Type: application/manifest+json

/browserconfig.xml
  Cache-Control: public, max-age=86400
  Content-Type: application/xml; charset=utf-8

# ─── Fonts / JS in /public ──────────────────────────────────────────
/js/*
  Cache-Control: public, max-age=31536000, immutable

/models/*
  Cache-Control: public, max-age=2592000

/workers/*
  Cache-Control: public, max-age=2592000

# ─── SEO files — Always fresh ───────────────────────────────────────
/master-sitemap-index.xml
  Content-Type: application/xml; charset=utf-8
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=0, must-revalidate

/sitemap-0.xml
  Content-Type: application/xml; charset=utf-8
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=0, must-revalidate

/sitemap-index.xml
  Content-Type: application/xml; charset=utf-8
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=0, must-revalidate

/sitemap.txt
  Content-Type: text/plain; charset=utf-8
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=0, must-revalidate

/llms.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=86400

/llms-full.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=86400

/robots.txt
  Content-Type: text/plain; charset=utf-8
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600, must-revalidate

/.well-known/security.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=86400

# ─── HTML Pages — Short cache, always validate ──────────────────────
/*.html
  Cache-Control: public, max-age=0, must-revalidate
  X-Robots-Tag: index, follow
  Content-Encoding-Options: identity

# ─── Compression hint for assets ─────────────────────────────────────
/*.js
  Cache-Control: public, max-age=31536000, immutable

/*.css
  Cache-Control: public, max-age=31536000, immutable

# ─── 404 page ────────────────────────────────────────────────────────
/404.html
  Cache-Control: public, max-age=0, must-revalidate
  X-Robots-Tag: noindex, nofollow